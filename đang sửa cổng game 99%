        arena.classList.remove('hot-theme');
        document.getElementById('arena-title-text').innerText = 'SẢNH TÀI XỈU MD5 REAL 3D';
      }
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      document.getElementById('lobby-screen').classList.add('active');
    }

    // Camera 3D Toggle
    function toggleCamera3D() {
      isCamera3D = !isCamera3D;
      const stage = document.getElementById('arena-stage');
      if (isCamera3D) {
        stage.classList.add('pan-angle');
        showToast('Đã bật góc nhìn Camera 3D nghiêng');
      } else {
        stage.classList.remove('pan-angle');
        showToast('Đã về góc nhìn 2D chuẩn');
      }
    }

    // BẬT / TẮT CHẾ ĐỘ NẶN VÀ HIỆU ỨNG SÁNG VÀNG CAM
    function toggleNanMode() {
      isNanMode = !isNanMode;
      const centerPlate = document.getElementById('center-plate');
      const smallBtn = document.getElementById('small-nan-btn');
      const slash = document.getElementById('slash-overlay');

      if (isNanMode) {
        centerPlate.classList.add('nan-glow');
        smallBtn.classList.add('nan-glow');
        slash.classList.remove('show');
        showToast('ĐÃ BẬT CHẾ ĐỘ NẶN 10 GIÂY!');
      } else {
        centerPlate.classList.remove('nan-glow');
        smallBtn.classList.remove('nan-glow');
        slash.classList.add('show');
        setTimeout(() => slash.classList.remove('show'), 2500);
        showToast('ĐÃ TẮT CHẾ ĐỘ NẶN!');
      }
    }

    // MAIN GAME LOOP (Đếm ngược phiên 45s)
    function startGlobalGameLoop() {
      gameInterval = setInterval(() => {
        timerValue--;

        if (timerValue < 0) {
          timerValue = 45;
          resetNewRound();
        }

        // Render Timer UI
        document.getElementById('timer').innerText = timerValue < 10 ? '0' + timerValue : timerValue;
        document.getElementById('lobby-time-1').innerText = `00:${timerValue < 10 ? '0' + timerValue : timerValue}`;
        document.getElementById('lobby-time-2').innerText = `00:${timerValue < 10 ? '0' + timerValue : timerValue}`;

        // Biến động tiền cân cửa tự động
        if (timerValue > 5) {
          updateDynamicBets();
        }

        // Bắt đầu gieo xúc xắc ở giây thứ 5
        if (timerValue === 5) {
          triggerShakeDice();
        }

      }, 1000);
    }

    function updateDynamicBets() {
      let taiAmt = parseInt(document.getElementById('tai-amount').innerText.replace(/,/g, '')) + Math.floor(Math.random() * 3000000);
      let xiuAmt = parseInt(document.getElementById('xiu-amount').innerText.replace(/,/g, '')) + Math.floor(Math.random() * 3000000);
      document.getElementById('tai-amount').innerText = formatMoney(taiAmt);
      document.getElementById('xiu-amount').innerText = formatMoney(xiuAmt);
      document.getElementById('lobby-tai-1').innerText = (taiAmt / 1000000).toFixed(0) + 'M';
      document.getElementById('lobby-xiu-1').innerText = (xiuAmt / 1000000).toFixed(0) + 'M';
    }

    // HIỆU ỨNG LẮN ĐẢO XÚC XẮC 3D REALISTIC
    function triggerShakeDice() {
      for (let i = 1; i <= 3; i++) {
        document.getElementById(`wrap${i}`).classList.add(`rolling-${i}`);
        document.getElementById(`cube${i}`).classList.add('rolling');
      }

      // Roll random kết quả
      diceResults = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];

      setTimeout(() => {
        // Dừng lắc và đặt mặt xúc xắc
        for (let i = 1; i <= 3; i++) {
          document.getElementById(`wrap${i}`).classList.remove(`rolling-${i}`);
          let cube = document.getElementById(`cube${i}`);
          cube.classList.remove('rolling');
          
          let rot = faceRotations[diceResults[i - 1]];
          // Xoay thêm vòng tròn ngẫu nhiên cho đẹp mắt
          cube.style.transform = `rotateX(${rot.x + 1440}deg) rotateY(${rot.y + 1440}deg)`;
        }

        // Kiểm tra chế độ nặn
        if (isNanMode) {
          startNanProcess();
        } else {
          finishRoundAndShowResult();
        }
      }, 1200);
    }

    // BẮT ĐẦU CƠ CHẾ NẶN 10S THỜI GIAN THỰC
    function startNanProcess() {
      isNanPhase = true;
      const lid = document.getElementById('plate-lid');
      lid.style.display = 'flex';
      lid.style.transform = 'translate(0px, 0px)';
      showToast('NẶN TỰ DO TRONG 10 GIÂY!');

      nanTimer = 10;
      document.getElementById('timer').innerText = '10s';

      nanInterval = setInterval(() => {
        nanTimer--;
        document.getElementById('timer').innerText = nanTimer + 's';

        if (nanTimer <= 0) {
          endNanPhase();
        }
      }, 1000);
    }

    // KẾT THÚC CƠ CHẾ NẶN & CHO XÚC XẮC LẮN ĐẢO TỐC ĐỘ NHANH LẦN CUỐI
    function endNanPhase() {
      if (!isNanPhase) return;
      isNanPhase = false;
      clearInterval(nanInterval);

      const lid = document.getElementById('plate-lid');
      lid.style.display = 'none';

      // Xúc xắc lăn đảo nhanh 1 lần nữa cho đẹp mắt khi mở nắp
      for (let i = 1; i <= 3; i++) {
        let cube = document.getElementById(`cube${i}`);
        cube.style.transition = 'transform 0.4s ease-out';
        let rot = faceRotations[diceResults[i - 1]];
        cube.style.transform = `rotateX(${rot.x + 720}deg) rotateY(${rot.y + 720}deg)`;
      }

      setTimeout(() => {
        finishRoundAndShowResult();
      }, 450);
    }

    // CÔNG BỐ KẾT QUẢ PHIÊN
    function finishRoundAndShowResult() {
      let sum = diceResults[0] + diceResults[1] + diceResults[2];
      let resultStr = sum >= 11 ? 'TAI' : 'XIU';

      // Highlight cửa thắng
      if (resultStr === 'TAI') {
        document.getElementById('side-tai').classList.add('active-win');
      } else {
        document.getElementById('side-xiu').classList.add('active-win');
      }

      // Xử lý Trả Thưởng
      let myWin = 0;
      if (resultStr === 'TAI' && myBets.TAI > 0) {
        myWin = myBets.TAI * 1.98;
      } else if (resultStr === 'XIU' && myBets.XIU > 0) {
        myWin = myBets.XIU * 1.98;
      }

      if (myWin > 0) {
        userBalance += myWin;
        updateBalanceUI();
        document.getElementById('win-money-text').innerText = '+' + formatMoney(Math.floor(myWin));
        document.getElementById('win-banner').classList.add('show');
        setTimeout(() => document.getElementById('win-banner').classList.remove('show'), 3500);
      }

      // Thêm điểm lịch sử
      addHistoryDot(resultStr);
    }

    function addHistoryDot(res) {
      const container = document.getElementById('history-dots');
      let dot = document.createElement('div');
      dot.className = `dot ${res.toLowerCase()}`;
      container.appendChild(dot);
      if (container.children.length > 12) {
        container.removeChild(container.firstChild);
      }
    }

    function resetNewRound() {
      document.getElementById('side-tai').classList.remove('active-win');
      document.getElementById('side-xiu').classList.remove('active-win');
      myBets = { TAI: 0, XIU: 0 };
      document.getElementById('my-tai-bet').style.display = 'none';
      document.getElementById('my-xiu-bet').style.display = 'none';
    }

    // MODAL ĐẶT CƯỢC LOGIC
    function openBetModal(side) {
      if (timerValue <= 5) {
        showToast('Đã hết thời gian đặt cược!');
        return;
      }
      currentBetChoice = side;
      document.getElementById('bet-modal-title').innerText = `ĐẶT CƯỢC ${side}`;
      document.getElementById('bet-modal').style.display = 'flex';
    }

    function closeBetModal() {
      document.getElementById('bet-modal').style.display = 'none';
    }

    function addBetAmount(amt) {
      let input = document.getElementById('bet-input-amount');
      let current = parseInt(input.value) || 0;
      input.value = current + amt;
    }

    function setAllIn() {
      document.getElementById('bet-input-amount').value = userBalance;
    }

    function confirmBet() {
      let amt = parseInt(document.getElementById('bet-input-amount').value) || 0;

      if (amt <= 0) {
        showToast('Số tiền cược không hợp lệ!');
        return;
      }
      if (amt > userBalance) {
        showToast('Số dư tài khoản không đủ!');
        return;
      }

      userBalance -= amt;
      updateBalanceUI();

      if (currentBetChoice === 'TÀI') {
        myBets.TAI += amt;
        let tag = document.getElementById('my-tai-bet');
        tag.innerText = 'Đã cược: ' + formatMoney(myBets.TAI);
        tag.style.display = 'block';
      } else {
        myBets.XIU += amt;
        let tag = document.getElementById('my-xiu-bet');
        tag.innerText = 'Đã cược: ' + formatMoney(myBets.XIU);
        tag.style.display = 'block';
      }

      showToast(`Cược thành công ${formatMoney(amt)} vào ${currentBetChoice}`);
      closeBetModal();
    }

    // CO CẤU KÉO THẢ NẮP NẶN REAL-TIME (DRAG SYSTEM)
    const lid = document.getElementById('plate-lid');
    let isDragging = false;
    let startX, startY, initialX = 0, initialY = 0;

    lid.addEventListener('mousedown', startDrag);
    lid.addEventListener('touchstart', startDrag, { passive: false });

    window.addEventListener('mousemove', drag);
    window.addEventListener('touchmove', drag, { passive: false });

    window.addEventListener('mouseup', endDrag);
    window.addEventListener('touchend', endDrag);

    function startDrag(e) {
      if (!isNanPhase) return;
      isDragging = true;
      let clientX = e.touches ? e.touches[0].clientX : e.clientX;
      let clientY = e.touches ? e.touches[0].clientY : e.clientY;
      startX = clientX - initialX;
      startY = clientY - initialY;
    }

    function drag(e) {
      if (!isDragging) return;
      e.preventDefault();
      let clientX = e.touches ? e.touches[0].clientX : e.clientX;
      let clientY = e.touches ? e.touches[0].clientY : e.clientY;

      initialX = clientX - startX;
      initialY = clientY - startY;

      lid.style.transform = `translate(${initialX}px, ${initialY}px)`;

      // Nếu kéo nắp đi quá xa (hơn 110px) -> Tự động kết thúc nặn
      let dist = Math.sqrt(initialX * initialX + initialY * initialY);
      if (dist > 110) {
        isDragging = false;
        endNanPhase();
      }
    }

    function endDrag() {
      isDragging = false;
    }
  </script>
</body>
</html>
