  <script>
    // --- KHỞI TẠO BIẾN TOÀN CỤC & TRẠNG THÁI ---
    let userBalance = 57300755;
    let selectedChip = 0;
    let currentSide = null; // 'TAI' hoặc 'XIU'
    let bets = { TAI: 0, XIU: 0 };
    let currentMode = 'MD5';
    let isSqueezeMode = false;
    let timer = 26;
    let timerInterval = null;
    let diceResults = [1, 2, 3];
    let historyResults = [
      { sum: 14, side: 'TAI' }, { sum: 12, side: 'TAI' }, { sum: 8, side: 'XIU' },
      { sum: 6, side: 'XIU' }, { sum: 15, side: 'TAI' }, { sum: 16, side: 'TAI' },
      { sum: 17, side: 'TAI' }, { sum: 9, side: 'XIU' }, { sum: 4, side: 'XIU' }
    ];

    // --- HIỆU ỨNG LOADING MÀN HÌNH ---
    window.addEventListener('load', () => {
      let fill = document.getElementById('loader-fill');
      let w = 0;
      let interval = setInterval(() => {
        w += 5;
        fill.style.width = w + '%';
        if (w >= 100) {
          clearInterval(interval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
        }
      }, 30);
    });

    function formatMoney(num) {
      return '$ ' + num.toLocaleString('en-US');
    }

    function updateBalanceDisplay() {
      document.getElementById('user-balance').innerText = formatMoney(userBalance);
      document.getElementById('arena-balance').innerText = formatMoney(userBalance);
    }

    function showToast(msg, duration = 2500) {
      let toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), duration);
    }

    // --- LỰA CHỌN SẢNH GAME ---
    function enterArena(mode) {
      currentMode = mode;
      let board = document.getElementById('main-board');
      let title = document.getElementById('arena-title');

      if (mode === 'MD5') {
        board.className = 'real-taixiu-board theme-md5';
        title.innerText = 'TÀI XỈU MD5';
      } else {
        board.className = 'real-taixiu-board theme-thuong';
        title.innerText = 'TÀI XỈU THƯỜNG';
      }

      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 50);

      resetBoardState();
      startTimer();
      renderRoadmap();
    }

    function exitArena() {
      clearInterval(timerInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      closeRoadmapModal();
    }

    // --- LOGIC GAME & TIMER ---
    function startTimer() {
      clearInterval(timerInterval);
      timer = 26;
      document.getElementById('timer-text').innerText = timer;
      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('bowl-cover').style.display = 'none';

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer;

        // Cập nhật ngẫu nhiên số lượng người chơi & số tiền tổng cược tăng sống động
        document.getElementById('tai-players').innerText = Math.floor(300 + Math.random() * 150);
        document.getElementById('xiu-players').innerText = Math.floor(300 + Math.random() * 150);

        if (timer <= 0) {
          clearInterval(timerInterval);
          finishSession();
        }
      }, 1000);
    }

    function finishSession() {
      document.getElementById('timer-text').style.display = 'none';
      document.getElementById('chip-bar').classList.add('hidden-bet');

      // Lắc xúc xắc ngẫu nhiên 3D
      diceResults = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];

      let sum = diceResults.reduce((a, b) => a + b, 0);
      let winSide = sum >= 11 ? 'TAI' : 'XIU';

      // Xoay 3D xúc xắc
      let c1 = document.getElementById('cube1');
      let c2 = document.getElementById('cube2');
      let c3 = document.getElementById('cube3');

      c1.classList.add('rolling');
      c2.classList.add('rolling');
      c3.classList.add('rolling');

      document.getElementById('dice-container').style.display = 'block';

      setTimeout(() => {
        c1.classList.remove('rolling');
        c2.classList.remove('rolling');
        c3.classList.remove('rolling');

        setCubeFace(c1, diceResults[0]);
        setCubeFace(c2, diceResults[1]);
        setCubeFace(c3, diceResults[2]);

        if (isSqueezeMode) {
          // Bật nắp nặn
          let bowl = document.getElementById('bowl-cover');
          bowl.style.display = 'flex';
          bowl.style.transform = 'translate(0px, 0px)';
          showToast('Mời bạn nặn bát!', 2000);
        } else {
          showResult(winSide, sum);
        }
      }, 1200);
    }

    function setCubeFace(cubeEl, val) {
      let rotations = {
        1: 'rotateY(0deg)',
        6: 'rotateY(180deg)',
        2: 'rotateY(90deg)',
        5: 'rotateY(-90deg)',
        3: 'rotateX(-90deg)',
        4: 'rotateX(90deg)'
      };
      cubeEl.style.transform = rotations[val];
    }

    function showResult(winSide, sum) {
      // Nhấp nháy cửa thắng
      let titleWin = document.getElementById('title-' + winSide);
      titleWin.classList.add('blink-winner');

      // Thêm kết quả vào lịch sử soi cầu
      historyResults.push({ sum: sum, side: winSide });
      renderRoadmap();

      // Cập nhật trả thưởng realtime
      let winBet = bets[winSide];
      let loseBet = bets[winSide === 'TAI' ? 'XIU' : 'TAI'];

      if (winBet > 0) {
        let winMoney = winBet * 2;
        userBalance += winMoney;
        updateBalanceDisplay();

        document.getElementById('win-amount-text').innerText = '+' + winMoney.toLocaleString('en-US');
        let winPop = document.getElementById('win-popup');
        winPop.classList.add('show');
        setTimeout(() => winPop.classList.remove('show'), 3500);
      } else if (loseBet > 0) {
        let losePop = document.getElementById('lose-popup');
        losePop.classList.add('show');
        setTimeout(() => losePop.classList.remove('show'), 3500);
      }

      // Chuẩn bị phiên mới sau 4 giây
      setTimeout(() => {
        titleWin.classList.remove('blink-winner');
        resetBoardState();
        startTimer();
      }, 4000);
    }

    function resetBoardState() {
      bets = { TAI: 0, XIU: 0 };
      document.getElementById('val-TAI').innerText = '0';
      document.getElementById('val-XIU').innerText = '0';
      document.getElementById('btn-bet-TAI').classList.remove('active-bet');
      document.getElementById('btn-bet-XIU').classList.remove('active-bet');
      currentSide = null;
    }

    // --- LOGIC ĐẶT CƯỢC & CHIP ---
    function handleBetClick(side) {
      if (timer <= 3) {
        showToast('Hết thời gian đặt cược!');
        return;
      }
      currentSide = side;
      document.getElementById('btn-bet-TAI').classList.toggle('active-bet', side === 'TAI');
      document.getElementById('btn-bet-XIU').classList.toggle('active-bet', side === 'XIU');
      document.getElementById('chip-bar').classList.remove('hidden-bet');
    }

    function selectChip(val, el) {
      document.querySelectorAll('.chip-item-sq').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      selectedChip = val;
    }

    function confirmBet() {
      if (!currentSide || selectedChip <= 0) {
        showToast('Vui lòng chọn cửa và mệnh giá chip!');
        return;
      }
      if (userBalance < selectedChip) {
        showToast('Số dư không đủ!');
        return;
      }

      userBalance -= selectedChip;
      bets[currentSide] += selectedChip;
      document.getElementById('val-' + currentSide).innerText = bets[currentSide].toLocaleString('en-US');
      updateBalanceDisplay();
      showToast('Đặt cược thành công ' + selectedChip.toLocaleString('en-US') + ' vào ' + currentSide);
    }

    function cancelBet() {
      document.getElementById('chip-bar').classList.add('hidden-bet');
    }

    function doAllIn(side) {
      if (timer <= 3) {
        showToast('Hết thời gian đặt cược!');
        return;
      }
      if (userBalance <= 0) {
        showToast('Số dư đã hết!');
        return;
      }

      currentSide = side;
      bets[side] += userBalance;
      showToast('ALL-IN ' + userBalance.toLocaleString('en-US') + ' vào ' + side);
      userBalance = 0;
      document.getElementById('val-' + side).innerText = bets[side].toLocaleString('en-US');
      updateBalanceDisplay();
    }

    function toggleSqueezeMode() {
      isSqueezeMode = !isSqueezeMode;
      let btn = document.getElementById('btn-squeeze-toggle');
      btn.classList.toggle('active-squeeze', isSqueezeMode);
      showToast(isSqueezeMode ? 'Đã BẬT Chế độ Nặn' : 'Đã TẮT Chế độ Nặn');
    }

    // --- NÂU LOGIC SOI CẦU (5 Ô CỘT DỌC THỰC TẾ & BỆT SANG BÊN CẠNH) ---
    function renderRoadmap() {
      let grid = document.getElementById('roadmap-grid');
      grid.innerHTML = '';

      // Khởi tạo ma trận 5 hàng x 20 cột (Vuông Nâu)
      let matrix = Array(5).fill(null).map(() => Array(20).fill(null));

      let col = 0;
      let row = 0;
      let lastSide = null;

      historyResults.forEach(item => {
        if (!lastSide) {
          lastSide = item.side;
          matrix[row][col] = item;
        } else if (item.side === lastSide) {
          // Chuỗi bệt cùng màu
          if (row + 1 < 5 && matrix[row + 1][col] === null) {
            row++;
          } else {
            // Bệt dài quá 5 ô dốc dọc -> Bệt sang bên cạnh (phải)
            col++;
          }
          if (col < 20) matrix[row][col] = item;
        } else {
          // Đổi màu -> Sang cột mới hàng 0
          col++;
          row = 0;
          lastSide = item.side;
          if (col < 20) matrix[row][col] = item;
        }
      });

      // Render ma trận ra DOM 20 Cột x 5 Hàng
      for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 20; c++) {
          let cell = document.createElement('div');
          cell.className = 'roadmap-cell';

          let data = matrix[r][c];
          if (data) {
            let dot = document.createElement('div');
            dot.className = 'dot-result ' + (data.side === 'TAI' ? 'tai' : 'xiu');
            dot.innerText = data.sum; // Hiện số chấm tròn tổng điểm thực tế
            cell.appendChild(dot);
          }
          grid.appendChild(cell);
        }
      }
    }

    // --- LOGIC MỞ & KÉO BẢNG SOI CẦU TRONG VÙNG AN TOÀN SẢNH ---
    let isRoadmapOpen = false;

    function toggleRoadmapModal(e) {
      if (e) e.stopPropagation();
      if (isRoadmapOpen) {
        closeRoadmapModal();
      } else {
        openRoadmapModal();
      }
    }

    function openRoadmapModal() {
      let modal = document.getElementById('roadmap-modal');
      let icon = document.getElementById('btn-chart-icon');
      let rect = icon.getBoundingClientRect();

      // Đặt vị trí xuất phát ngay cạnh hình tròn nhỏ 📊
      let left = rect.left - 280;
      let top = rect.top + 45;

      // Đảm bảo không bị chéo văng ra bên ngoài màn hình sảnh
      left = Math.max(10, Math.min(left, window.innerWidth - 640));
      top = Math.max(10, Math.min(top, window.innerHeight - 280));

      modal.style.left = left + 'px';
      modal.style.top = top + 'px';

      modal.classList.add('show');
      isRoadmapOpen = true;
      renderRoadmap();
    }

    function closeRoadmapModal() {
      let modal = document.getElementById('roadmap-modal');
      modal.classList.remove('show');
      isRoadmapOpen = false;
    }

    // --- DRAG MƯỢT MÀ CHO BẢNG SOI CẦU (KHÔNG CHO VƯỚNG RA NGOÀI SẢNH) ---
    const roadmapModal = document.getElementById('roadmap-modal');
    let isDraggingModal = false;
    let modalStartX, modalStartY, modalInitLeft, modalInitTop;

    roadmapModal.addEventListener('pointerdown', (e) => {
      if (e.target.classList.contains('roadmap-close')) return;
      isDraggingModal = true;
      modalStartX = e.clientX;
      modalStartY = e.clientY;
      modalInitLeft = roadmapModal.offsetLeft;
      modalInitTop = roadmapModal.offsetTop;
      roadmapModal.setPointerCapture(e.pointerId);
    });

    roadmapModal.addEventListener('pointermove', (e) => {
      if (!isDraggingModal) return;
      let dx = e.clientX - modalStartX;
      let dy = e.clientY - modalStartY;

      let newLeft = modalInitLeft + dx;
      let newTop = modalInitTop + dy;

      // Khóa biên không cho văng ra ngoài sảnh
      let maxLeft = window.innerWidth - roadmapModal.offsetWidth - 10;
      let maxTop = window.innerHeight - roadmapModal.offsetHeight - 10;

      newLeft = Math.max(10, Math.min(newLeft, maxLeft));
      newTop = Math.max(10, Math.min(newTop, maxTop));

      roadmapModal.style.left = newLeft + 'px';
      roadmapModal.style.top = newTop + 'px';
    });

    roadmapModal.addEventListener('pointerup', (e) => {
      isDraggingModal = false;
      try { roadmapModal.releasePointerCapture(e.pointerId); } catch (err) {}
    });

    // --- KÉO BÀN TÀI XỈU SẢNH CHÍNH & NẮP BÁT NẶN REAL---
    const mainBoard = document.getElementById('main-board');
    let isBoardDragging = false;
    let boardStartX, boardStartY, boardX = 0, boardY = 0;

    mainBoard.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.circle-btn') || e.target.closest('.bet-side') || e.target.closest('.center-plate')) return;
      isBoardDragging = true;
      boardStartX = e.clientX - boardX;
      boardStartY = e.clientY - boardY;
      mainBoard.setPointerCapture(e.pointerId);
    });

    mainBoard.addEventListener('pointermove', (e) => {
      if (!isBoardDragging) return;
      boardX = e.clientX - boardStartX;
      boardY = e.clientY - boardStartY;
      mainBoard.style.transform = `translate3d(${boardX}px, ${boardY}px, 0px)`;
    });

    mainBoard.addEventListener('pointerup', (e) => {
      isBoardDragging = false;
      try { mainBoard.releasePointerCapture(e.pointerId); } catch (err) {}
    });

    // --- KÉO NẮP BÁT NẶN ---
    const bowlCover = document.getElementById('bowl-cover');
    let isBowlDragging = false;
    let bowlStartX, bowlStartY, bowlX = 0, bowlY = 0;

    bowlCover.addEventListener('pointerdown', (e) => {
      isBowlDragging = true;
      bowlStartX = e.clientX - bowlX;
      bowlStartY = e.clientY - bowlY;
      bowlCover.setPointerCapture(e.pointerId);
    });

    bowlCover.addEventListener('pointermove', (e) => {
      if (!isBowlDragging) return;
      bowlX = e.clientX - bowlStartX;
      bowlY = e.clientY - bowlStartY;
      bowlCover.style.transform = `translate(${bowlX}px, ${bowlY}px)`;

      // Nếu kéo xa quá 120px -> Mở nắp hiển thị kết quả
      let dist = Math.hypot(bowlX, bowlY);
      if (dist > 120) {
        isBowlDragging = false;
        bowlCover.style.display = 'none';
        bowlX = 0; bowlY = 0;
        let sum = diceResults.reduce((a, b) => a + b, 0);
        showResult(sum >= 11 ? 'TAI' : 'XIU', sum);
      }
    });

    bowlCover.addEventListener('pointerup', (e) => {
      isBowlDragging = false;
      try { bowlCover.releasePointerCapture(e.pointerId); } catch (err) {}
    });

    // --- CHAT SYSTEM ---
    function toggleChat() {
      let chat = document.getElementById('chat-box');
      chat.style.display = (chat.style.display === 'flex') ? 'none' : 'flex';
    }

    function sendChat() {
      let input = document.getElementById('chat-input');
      let val = input.value.trim();
      if (val) {
        let box = document.getElementById('chat-messages');
        let div = document.createElement('div');
        div.className = 'chat-item';
        div.innerHTML = `<span class="chat-user">Bạn:</span> <span class="chat-text">${val}</span>`;
        box.appendChild(div);
        box.scrollTop = box.scrollHeight;
        input.value = '';
      }
    }
  </script>
</body>
