    <!-- GAME SCRIPT ENGINE -->
    <script>
        /* =========================================================================
           1. CẤU HÌNH GAME & TRẠNG THÁI (GAME CONFIG & STATE)
           ========================================================================= */
        const GAME_CONFIG = {
            BET_TIME: 26,     // 26 giây đếm ngược đặt cược chuẩn
            RESULT_TIME: 15,  // 15 giây xem kết quả
            DICE_SIZE: 0.82,  // Kích thước xúc xắc 3D
            PLATE_RADIUS: 3.2 // Bán kính đĩa
        };

        let gameState = {
            phase: 'BETTING', // 'BETTING' hoặc 'RESULT'
            timeLeft: GAME_CONFIG.BET_TIME,
            session: 1001,
            balance: 1000000,
            selectedSide: null, // 'TAI' hoặc 'XIU'
            pendingBetAmount: 0,
            confirmedBets: { TAI: 0, XIU: 0 },
            diceValues: [1, 1, 1],
            timerInterval: null,
            isNanMode: false,      // Chế độ nặn
            hasUncoveredNan: false,// Đã kéo mở nắp chưa
            notificationsEnabled: true
        };

        // Góc xoay chuẩn mặt xúc xắc Three.js (1..6)
        const FACE_ROTATIONS = {
            1: { x: 0, y: 0, z: 0 },
            6: { x: Math.PI, y: 0, z: 0 },
            2: { x: -Math.PI / 2, y: 0, z: 0 },
            5: { x: Math.PI / 2, y: 0, z: 0 },
            3: { x: 0, y: 0, z: -Math.PI / 2 },
            4: { x: 0, y: 0, z: Math.PI / 2 }
        };

        /* =========================================================================
           2. KHỞI TẠO TEXTURE ĐỘ PHÂN GIẢI CAO (MẶT 1 & 4 ĐỎ, MẶT 2,3,5,6 XANH ĐEN)
           ========================================================================= */
        function createDiceTextures() {
            const materials = [];
            const canvasSize = 512;

            const dotConfigs = {
                1: { count: 1, color: '#dc2626', positions: [[0.5, 0.5]], radius: 0.19 }, // Chấm đỏ lớn
                2: { count: 2, color: '#0f172a', positions: [[0.28, 0.28], [0.72, 0.72]], radius: 0.09 }, // Chấm xanh đen
                3: { count: 3, color: '#0f172a', positions: [[0.25, 0.25], [0.5, 0.5], [0.75, 0.75]], radius: 0.085 },
                4: { count: 4, color: '#dc2626', positions: [[0.28, 0.28], [0.72, 0.28], [0.28, 0.72], [0.72, 0.72]], radius: 0.085 }, // Chấm đỏ
                5: { count: 5, color: '#0f172a', positions: [[0.25, 0.25], [0.75, 0.25], [0.5, 0.5], [0.25, 0.75], [0.75, 0.75]], radius: 0.08 },
                6: { count: 6, color: '#0f172a', positions: [[0.28, 0.22], [0.28, 0.5], [0.28, 0.78], [0.72, 0.22], [0.72, 0.5], [0.72, 0.78]], radius: 0.075 }
            };

            for (let face = 1; face <= 6; face++) {
                const canvas = document.createElement('canvas');
                canvas.width = canvasSize;
                canvas.height = canvasSize;
                const ctx = canvas.getContext('2d');

                // Nền ngà phủ bóng ngọc trai
                const grad = ctx.createRadialGradient(canvasSize/2, canvasSize/2, 50, canvasSize/2, canvasSize/2, canvasSize*0.7);
                grad.addColorStop(0, '#ffffff');
                grad.addColorStop(1, '#f1f5f9');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, canvasSize, canvasSize);

                // Viền cạnh chìm nhẹ
                ctx.strokeStyle = 'rgba(0,0,0,0.08)';
                ctx.lineWidth = 10;
                ctx.strokeRect(5, 5, canvasSize-10, canvasSize-10);

                const cfg = dotConfigs[face];
                cfg.positions.forEach(([px, py]) => {
                    const x = px * canvasSize;
                    const y = py * canvasSize;
                    const r = cfg.radius * canvasSize;

                    // Bóng đổ dưới chấm
                    ctx.save();
                    ctx.beginPath();
                    ctx.arc(x + 2, y + 2, r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';
                    ctx.fill();

                    // Chấm màu
                    ctx.beginPath();
                    ctx.arc(x, y, r, 0, Math.PI * 2);
                    ctx.fillStyle = cfg.color;
                    ctx.fill();

                    // Highlight nổi 3D
                    ctx.beginPath();
                    ctx.arc(x - r*0.3, y - r*0.3, r*0.25, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
                    ctx.fill();
                    ctx.restore();
                });

                const texture = new THREE.CanvasTexture(canvas);
                texture.anisotropy = 16;
                materials[face] = new THREE.MeshStandardMaterial({
                    map: texture,
                    roughness: 0.2,
                    metalness: 0.05
                });
            }

            // Thứ tự mặt BoxGeometry: [+X:3, -X:4, +Y:1, -Y:6, +Z:2, -Z:5]
            return [
                materials[3], materials[4],
                materials[1], materials[6],
                materials[2], materials[5]
            ];
        }

        /* =========================================================================
           3. THREE.JS SCENE SETUP (LÒNG ĐĨA ĐEN THỰC TẾ & XÚC XẮC 3D)
           ========================================================================= */
        let scene, camera, renderer, controls;
        let diceMeshes = [];

        function initThreeJS() {
            const container = document.getElementById('three-container');
            const width = container.clientWidth;
            const height = container.clientHeight;

            scene = new THREE.Scene();

            // Góc nhìn nghiêng chuẩn theo nét phác thảo
            camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
            camera.position.set(0, 7.2, 7.2);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            container.appendChild(renderer.domElement);

            // OrbitControls cho phép người dùng xoay đĩa 360 độ linh hoạt bằng chuột hoặc vuốt tay
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.maxPolarAngle = Math.PI / 2 - 0.05;
            controls.minDistance = 5;
            controls.maxDistance = 14;
            controls.target.set(0, 0, 0);

            // Ánh sáng VIP
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.85);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 1.1);
            dirLight.position.set(6, 12, 8);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 1024;
            dirLight.shadow.mapSize.height = 1024;
            scene.add(dirLight);

            // Tạo Đĩa Tròn Với Lòng Đĩa Màu Đen Thực Tế
            createBlackPlate();

            // Tạo 3 Viên Xúc Xắc nằm gọn trong đĩa
            createDices();

            // Animation Loop
            function animate(time) {
                requestAnimationFrame(animate);
                TWEEN.update(time);
                controls.update();
                renderer.render(scene, camera);
            }
            animate();

            window.addEventListener('resize', onWindowResize);
        }

        function createBlackPlate() {
            const plateGroup = new THREE.Group();

            // 1. Đế đĩa bên ngoài
            const dishGeo = new THREE.CylinderGeometry(GAME_CONFIG.PLATE_RADIUS, GAME_CONFIG.PLATE_RADIUS - 0.3, 0.35, 64);
            const dishMat = new THREE.MeshStandardMaterial({
                color: 0x1e293b,
                roughness: 0.3,
                metalness: 0.2
            });
            const dishMesh = new THREE.Mesh(dishGeo, dishMat);
            dishMesh.position.y = -0.18;
            dishMesh.receiveShadow = true;
            plateGroup.add(dishMesh);

            // 2. LÒNG ĐĨA ĐEN THỰC TẾ (Black Obsidian Velvet)
            const innerGeo = new THREE.CylinderGeometry(GAME_CONFIG.PLATE_RADIUS - 0.25, GAME_CONFIG.PLATE_RADIUS - 0.4, 0.06, 64);
            const innerMat = new THREE.MeshStandardMaterial({
                color: 0x09090b, // Đen sang trọng thực tế
                roughness: 0.6,
                metalness: 0.1
            });
            const innerMesh = new THREE.Mesh(innerGeo, innerMat);
            innerMesh.position.y = -0.01;
            innerMesh.receiveShadow = true;
            plateGroup.add(innerMesh);

            // 3. Viền vàng bo xung quanh
            const rimGeo = new THREE.TorusGeometry(GAME_CONFIG.PLATE_RADIUS, 0.08, 16, 64);
            const rimMat = new THREE.MeshStandardMaterial({
                color: 0xf59e0b,
                metalness: 0.9,
                roughness: 0.2
            });
            const rimMesh = new THREE.Mesh(rimGeo, rimMat);
            rimMesh.rotation.x = Math.PI / 2;
            rimMesh.position.y = -0.01;
            plateGroup.add(rimMesh);

            scene.add(plateGroup);
        }

        function createDices() {
            const materials = createDiceTextures();
            const size = GAME_CONFIG.DICE_SIZE;
            const diceGeo = new THREE.BoxGeometry(size, size, size);

            // Vị trí 3 viên nằm gọn trong đĩa tròn theo nét phác thảo
            const positions = [
                { x: 0, z: -0.65 },
                { x: -0.75, z: 0.65 },
                { x: 0.75, z: 0.65 }
            ];

            for (let i = 0; i < 3; i++) {
                const dice = new THREE.Mesh(diceGeo, materials);
                dice.castShadow = true;
                dice.receiveShadow = true;
                dice.position.set(positions[i].x, size / 2, positions[i].z);
                scene.add(dice);
                diceMeshes.push(dice);
            }
        }

        function onWindowResize() {
            const container = document.getElementById('three-container');
            if (!container || !renderer || !camera) return;
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        function resetCamera() {
            new TWEEN.Tween(camera.position)
                .to({ x: 0, y: 7.2, z: 7.2 }, 800)
                .easing(TWEEN.Easing.Cubic.Out)
                .start();
            controls.target.set(0, 0, 0);
            showToast("Đã đặt lại góc nhìn đĩa!", "info");
        }

        /* =========================================================================
           4. GAME PHASES & TIMER LOGIC (26s Cược / 15s Kết Quả)
           ========================================================================= */
        function startTimer() {
            clearInterval(gameState.timerInterval);
            gameState.timerInterval = setInterval(() => {
                gameState.timeLeft--;
                updateTimerUI();

                if (gameState.timeLeft <= 0) {
                    if (gameState.phase === 'BETTING') {
                        switchPhase('RESULT');
                    } else {
                        switchPhase('BETTING');
                    }
                }
            }, 1000);
        }

        function switchPhase(newPhase) {
            gameState.phase = newPhase;

            if (newPhase === 'BETTING') {
                gameState.timeLeft = GAME_CONFIG.BET_TIME;
                gameState.session++;
                gameState.confirmedBets = { TAI: 0, XIU: 0 };
                gameState.hasUncoveredNan = false;
                resetPendingBet();
                updateBetsUI();
                hideResultBar();
                hideNanOverlay();

                document.getElementById('phase-label').innerText = 'ĐANG ĐẶT CƯỢC';
                document.getElementById('phase-label').className = 'text-[9px] md:text-[11px] font-bold uppercase tracking-widest text-amber-400';
            } else if (newPhase === 'RESULT') {
                gameState.timeLeft = GAME_CONFIG.RESULT_TIME;
                document.getElementById('phase-label').innerText = 'KẾT QUẢ PHIÊN';
                document.getElementById('phase-label').className = 'text-[9px] md:text-[11px] font-bold uppercase tracking-widest text-emerald-400';

                // Lắc xúc xắc nảy rơi rồi DỪNG TĨNH KHÔNG RUNG LẮC NỮA
                rollDiceAndStop();
            }

            document.getElementById('session-id').innerText = '#' + gameState.session;
            updateTimerUI();
        }

        function updateTimerUI() {
            const timerEl = document.getElementById('timer-display');
            timerEl.innerText = gameState.timeLeft + 's';

            if (gameState.timeLeft <= 5 && gameState.phase === 'BETTING') {
                timerEl.classList.add('timer-warning');
            } else {
                timerEl.classList.remove('timer-warning');
            }
        }

        // Lắc xúc xắc nảy rơi rồi DỪNG TĨNH HOÀN TOÀN
        function rollDiceAndStop() {
            const v1 = Math.floor(Math.random() * 6) + 1;
            const v2 = Math.floor(Math.random() * 6) + 1;
            const v3 = Math.floor(Math.random() * 6) + 1;
            gameState.diceValues = [v1, v2, v3];

            const rollDuration = 1800; // 1.8 giây hiệu ứng xoay nảy

            diceMeshes.forEach((dice, index) => {
                const targetRot = FACE_ROTATIONS[gameState.diceValues[index]];
                const extraX = (Math.floor(Math.random() * 2) + 2) * Math.PI * 2;
                const extraY = (Math.floor(Math.random() * 2) + 2) * Math.PI * 2;

                // Nảy xúc xắc rơi trên đĩa
                new TWEEN.Tween(dice.position)
                    .to({ y: [2.2, 0.41, 0.9, GAME_CONFIG.DICE_SIZE / 2] }, rollDuration)
                    .easing(TWEEN.Easing.Bounce.Out)
                    .start();

                // Xoay góc mặt
                new TWEEN.Tween(dice.rotation)
                    .to({
                        x: targetRot.x + extraX,
                        y: targetRot.y + extraY,
                        z: targetRot.z
                    }, rollDuration)
                    .easing(TWEEN.Easing.Cubic.Out)
                    .onComplete(() => {
                        // KHÓA TĨNH HOÀN TOÀN KHÔNG RUNG LẮC BÊN TRONG
                        dice.rotation.x = targetRot.x;
                        dice.rotation.y = targetRot.y;
                        dice.rotation.z = targetRot.z;

                        if (index === 2) {
                            if (gameState.isNanMode) {
                                // Nếu bật chế độ nặn -> Hiện nắp úp để kéo
                                showNanOverlay();
                            } else {
                                // Công bố kết quả & cộng tiền trực tiếp
                                revealFinalResult();
                            }
                        }
                    })
                    .start();
            });
        }

        function revealFinalResult() {
            gameState.hasUncoveredNan = true;
            const sum = gameState.diceValues.reduce((a, b) => a + b, 0);
            const isTai = sum >= 11 && sum <= 17;
            const resultSide = isTai ? 'TAI' : 'XIU';

            // Hiển thị thanh thông báo nhẹ không che đĩa
            showResultBar(resultSide, sum, gameState.diceValues);

            // CỘNG TIỀN THẮNG THỰC TẾ (1 ăn 0.98 -> Cược 50k nhận 99k)
            let totalWin = 0;
            if (gameState.confirmedBets[resultSide] > 0) {
                const betAmt = gameState.confirmedBets[resultSide];
                const winAmount = betAmt * 1.98; // Tiền gốc + 98% lãi
                totalWin = winAmount;
                gameState.balance += winAmount;
                updateBalanceDisplay();
                showToast(`Chúc mừng! Bạn đã thắng +${formatNumber(winAmount)} $!`, "success");
            } else if (gameState.confirmedBets.TAI > 0 || gameState.confirmedBets.XIU > 0) {
                showToast(`Rất tiếc! Kết quả về ${resultSide} (${sum} điểm)`, "info");
            }
        }

        /* =========================================================================
           5. CHỨC NĂNG NẶN NẮP (ÚP NẮP & CHẤM TRÒN KÉO THẢ TỰ DO)
           ========================================================================= */
        function toggleNanMode() {
            gameState.isNanMode = !gameState.isNanMode;
            const statusEl = document.getElementById('nan-status');
            const iconEl = document.getElementById('nan-icon');

            if (gameState.isNanMode) {
                statusEl.innerText = "BẬT";
                statusEl.className = "text-emerald-400 font-bold";
                iconEl.className = "fa-solid fa-hand-pointer text-emerald-400";
                showToast("Đã BẬT chế độ Nặn Nắp!", "info");
            } else {
                statusEl.innerText = "TẮT";
                statusEl.className = "text-rose-400 font-bold";
                iconEl.className = "fa-solid fa-hand-pointer text-gray-400";
                showToast("Đã TẮT chế độ Nặn Nắp!", "info");
            }
        }

        function showNanOverlay() {
            const overlay = document.getElementById('nan-overlay');
            const indicator = document.getElementById('nan-hand-indicator');
            const lid = document.getElementById('nan-lid-draggable');

            lid.style.transform = `translate(0px, 0px)`;
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            indicator.classList.remove('hidden');
            indicator.classList.add('flex');

            initLidDrag();
        }

        function hideNanOverlay() {
            document.getElementById('nan-overlay').classList.add('hidden');
            document.getElementById('nan-overlay').classList.remove('flex');
            document.getElementById('nan-hand-indicator').classList.add('hidden');
        }

        function initLidDrag() {
            const lid = document.getElementById('nan-lid-draggable');
            let isDragging = false;
            let startX, startY, currentX = 0, currentY = 0;

            function onPointerDown(e) {
                if (gameState.hasUncoveredNan) return;
                isDragging = true;
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                startX = clientX - currentX;
                startY = clientY - currentY;
            }

            function onPointerMove(e) {
                if (!isDragging || gameState.hasUncoveredNan) return;
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                currentX = clientX - startX;
                currentY = clientY - startY;

                lid.style.transform = `translate(${currentX}px, ${currentY}px)`;

                // Tính khoảng cách nặn đã kéo ra xa
                const dist = Math.sqrt(currentX * currentX + currentY * currentY);
                if (dist > 140) {
                    // Thả nắp ra xa -> Nắp biến mất thực tế & Mở kết quả
                    isDragging = false;
                    hideNanOverlay();
                    revealFinalResult();
                }
            }

            function onPointerUp() {
                isDragging = false;
            }

            lid.onmousedown = onPointerDown;
            window.onmousemove = onPointerMove;
            window.onmouseup = onPointerUp;

            lid.ontouchstart = onPointerDown;
            window.ontouchmove = onPointerMove;
            window.ontouchend = onPointerUp;
        }

        /* =========================================================================
           6. LOGIC ĐẶT CƯỢC CỔNG GAME LỚN & CHIP SELECTOR
           ========================================================================= */
        function selectBetSide(side) {
            if (gameState.phase !== 'BETTING') {
                showToast("Đã hết thời gian đặt cược!", "error");
                return;
            }

            gameState.selectedSide = side;

            document.getElementById('bet-tai').classList.remove('selected-side');
            document.getElementById('bet-xiu').classList.remove('selected-side');

            if (side === 'TAI') {
                document.getElementById('bet-tai').classList.add('selected-side');
                document.getElementById('tai-pending-box').classList.remove('hidden');
                document.getElementById('xiu-pending-box').classList.add('hidden');
            } else {
                document.getElementById('bet-xiu').classList.add('selected-side');
                document.getElementById('xiu-pending-box').classList.remove('hidden');
                document.getElementById('tai-pending-box').classList.add('hidden');
            }
        }

        function addChip(amount) {
            if (gameState.phase !== 'BETTING') {
                showToast("Đã hết thời gian đặt cược!", "error");
                return;
            }

            if (!gameState.selectedSide) {
                showToast("Vui lòng chọn ô TÀI hoặc XỈU trước!", "info");
                return;
            }

            if (gameState.balance < gameState.pendingBetAmount + amount) {
                showToast("Số dư trong ví không đủ!", "error");
                return;
            }

            gameState.pendingBetAmount += amount;
            updatePendingDisplay();
        }

        function updatePendingDisplay() {
            const side = gameState.selectedSide;
            if (side === 'TAI') {
                document.getElementById('tai-pending-val').innerText = formatNumber(gameState.pendingBetAmount) + ' $';
            } else if (side === 'XIU') {
                document.getElementById('xiu-pending-val').innerText = formatNumber(gameState.pendingBetAmount) + ' $';
            }
        }

        function confirmBet() {
            if (gameState.phase !== 'BETTING') {
                showToast("Đã hết thời gian đặt cược!", "error");
                return;
            }

            if (!gameState.selectedSide || gameState.pendingBetAmount <= 0) {
                showToast("Chưa chọn mức cược!", "info");
                return;
            }

            const side = gameState.selectedSide;
            gameState.balance -= gameState.pendingBetAmount;
            gameState.confirmedBets[side] += gameState.pendingBetAmount;

            showToast(`Đặt cược thành công ${formatNumber(gameState.pendingBetAmount)} $ vào ô ${side}!`, "success");

            gameState.pendingBetAmount = 0;
            updateBalanceDisplay();
            updateBetsUI();
            resetPendingBetUI();
        }

        function resetPendingBet() {
            gameState.pendingBetAmount = 0;
            resetPendingBetUI();
            showToast("Đã xóa tiền cược đang chọn!", "info");
        }

        function cancelCurrentBet() {
            if (gameState.pendingBetAmount > 0) {
                gameState.pendingBetAmount = 0;
                resetPendingBetUI();
                showToast("Đã hủy lượt cược chưa xác nhận!", "info");
            } else {
                showToast("Không có tiền cược chờ hủy!", "info");
            }
        }

        function resetPendingBetUI() {
            document.getElementById('tai-pending-val').innerText = '0 $';
            document.getElementById('xiu-pending-val').innerText = '0 $';
        }

        function updateBetsUI() {
            document.getElementById('tai-amount').innerText = formatNumber(gameState.confirmedBets.TAI) + ' $';
            document.getElementById('xiu-amount').innerText = formatNumber(gameState.confirmedBets.XIU) + ' $';
        }

        function updateBalanceDisplay() {
            document.getElementById('user-balance').innerText = formatNumber(gameState.balance) + ' $';
        }

        /* =========================================================================
           7. UTILITIES & TOAST NOTIFICATIONS
           ========================================================================= */
        function showResultBar(side, sum, dices) {
            const bar = document.getElementById('result-bar');
            const textEl = document.getElementById('result-text');
            const subEl = document.getElementById('result-sub');

            textEl.innerText = `${side} - ${sum} ĐIỂM`;
            textEl.className = side === 'TAI' ? 'text-base md:text-lg font-black text-red-500 tracking-wider glow-red' : 'text-base md:text-lg font-black text-blue-400 tracking-wider glow-blue';
            subEl.innerText = `(${dices[0]} - ${dices[1]} - ${dices[2]})`;

            bar.style.opacity = '1';
        }

        function hideResultBar() {
            document.getElementById('result-bar').style.opacity = '0';
        }

        function toggleNotification() {
            gameState.notificationsEnabled = !gameState.notificationsEnabled;
            const icon = document.getElementById('notify-icon');
            if (gameState.notificationsEnabled) {
                icon.className = "fa-solid fa-bell text-amber-400";
                showToast("Đã BẬT thông báo!", "info");
            } else {
                icon.className = "fa-solid fa-bell-slash text-gray-500";
            }
        }

        function showToast(message, type = "info") {
            if (!gameState.notificationsEnabled) return;

            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');

            let bgColors = "bg-slate-900/90 border-slate-600 text-white";
            if (type === "success") bgColors = "bg-emerald-950/90 border-emerald-500 text-emerald-200";
            if (type === "error") bgColors = "bg-rose-950/90 border-rose-500 text-rose-200";

            toast.className = `toast-animate px-4 py-2 rounded-xl border text-xs md:text-sm font-semibold shadow-2xl backdrop-blur-md flex items-center gap-2 ${bgColors}`;
            toast.innerHTML = `<i class="fa-solid fa-circle-info"></i> <span>${message}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        function formatNumber(num) {
            return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        /* =========================================================================
           8. KHỞI CHẠY GAME KHI TRANG TẢI XONG
           ========================================================================= */
        window.onload = function() {
            initThreeJS();
            startTimer();
            updateBalanceDisplay();
            showToast("Chào mừng bạn đến với Tài Xỉu 3D VIP!", "success");
        };
    </script>
</body>
</html>
