    function toggleCamera3D() {
      document.getElementById('arena-stage').classList.toggle('pan-angle');
      showToast('Đã xoay góc nhìn Camera 3D');
    }

    // Luồng Đếm Giờ Đĩa Lắc 100% Thực Tế
    function startGlobalTimer() {
      if (mainLoop) clearInterval(mainLoop);
      mainLoop = setInterval(() => {
        timerVal--;

        if (timerVal < 0) {
          timerVal = 45;
          resetRoundUI();
        }

        // Cập nhật giao diện đếm ngược
        document.getElementById('timer').innerText = timerVal < 10 ? '0' + timerVal : timerVal;
        document.getElementById('lobby-time-1').innerText = `00:${timerVal < 10 ? '0' + timerVal : timerVal}`;
        document.getElementById('lobby-time-2').innerText = `00:${timerVal < 10 ? '0' + timerVal : timerVal}`;

        // Bắt đầu Lắc đảo sinh động ở giây thứ 5 trước khi trả kết quả
        if (timerVal === 5) {
          triggerPhysicalRoll();
        }

        // Nhảy số ngẫu nhiên tiền cược giả lập
        if (timerVal > 5) {
          let addTai = Math.floor(Math.random() * 5000000);
          let addXiu = Math.floor(Math.random() * 5000000);
          let currTai = parseInt(document.getElementById('tai-amount').innerText.replace(/,/g, '')) + addTai;
          let currXiu = parseInt(document.getElementById('xiu-amount').innerText.replace(/,/g, '')) + addXiu;
          document.getElementById('tai-amount').innerText = formatNum(currTai);
          document.getElementById('xiu-amount').innerText = formatNum(currXiu);
        }
      }, 1000);
    }

    // Thực Hiện Hiệu Ứng Lắc Xúc Xắc Vật Lý 100% Thực Tế
    function triggerPhysicalRoll() {
      isRolling = true;
      let w1 = document.getElementById('wrap1');
      let w2 = document.getElementById('wrap2');
      let w3 = document.getElementById('wrap3');
      let c1 = document.getElementById('cube1');
      let c2 = document.getElementById('cube2');
      let c3 = document.getElementById('cube3');

      // Kích hoạt animation tung bổng và xoay cuộn tít
      w1.classList.add('rolling-1');
      w2.classList.add('rolling-2');
      w3.classList.add('rolling-3');
      c1.classList.add('rolling');
      c2.classList.add('rolling');
      c3.classList.add('rolling');

      // Tạo âm thanh lắc xúc xắc chân thực
      playDiceSound();

      setTimeout(() => {
        // Tạo 3 kết quả ngẫu nhiên (1 - 6)
        let r1 = Math.floor(Math.random() * 6) + 1;
        let r2 = Math.floor(Math.random() * 6) + 1;
        let r3 = Math.floor(Math.random() * 6) + 1;

        // Dừng xoay tít & áp dụng góc xoay chính xác của mặt xúc xắc
        w1.classList.remove('rolling-1');
        w2.classList.remove('rolling-2');
        w3.classList.remove('rolling-3');
        c1.classList.remove('rolling');
        c2.classList.remove('rolling');
        c3.classList.remove('rolling');

        // Thêm góc xoay vòng phụ ngẫu nhiên để tăng sự linh hoạt sinh động
        let extraRot1 = 720 * 2;
        let extraRot2 = 720 * 2;
        let extraRot3 = 720 * 2;

        c1.style.transform = `rotateX(${rotationMap[r1].x + extraRot1}deg) rotateY(${rotationMap[r1].y + extraRot1}deg)`;
        c2.style.transform = `rotateX(${rotationMap[r2].x + extraRot2}deg) rotateY(${rotationMap[r2].y + extraRot2}deg)`;
        c3.style.transform = `rotateX(${rotationMap[r3].x + extraRot3}deg) rotateY(${rotationMap[r3].y + extraRot3}deg)`;

        // Tính toán thắng thua
        setTimeout(() => {
          let total = r1 + r2 + r3;
          let isTai = total >= 11;
          let resultStr = isTai ? 'TÀI' : 'XỈU';

          // Phát sáng bên thắng
          if (isTai) {
            document.getElementById('side-tai').classList.add('active-win');
          } else {
            document.getElementById('side-xiu').classList.add('active-win');
          }

          // Cập nhật chấm lịch sử
          addHistoryDot(isTai);

          // Trả thưởng cho người chơi nếu thắng
          let winAmount = 0;
          if (isTai && userBets.TAI > 0) {
            winAmount = userBets.TAI * 1.98;
          } else if (!isTai && userBets.XIU > 0) {
            winAmount = userBets.XIU * 1.98;
          }

          if (winAmount > 0) {
            balance += winAmount;
            updateBalanceUI();
            showWinBanner(winAmount);
          }

          showToast(`KẾT QUẢ: ${r1} - ${r2} - ${r3} => ${total} NÚT (${resultStr})`);
          isRolling = false;
        }, 800);

      }, 3500); // Thời gian lắc tung bổng 3.5s sinh động
    }

    function playDiceSound() {
      try {
        let ctx = new (window.AudioContext || window.webkitAudioContext)();
        for (let i = 0; i < 12; i++) {
          setTimeout(() => {
            let osc = ctx.createOscillator();
            let gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.value = 300 + Math.random() * 600;
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.08);
          }, i * 180);
        }
      } catch (e) {}
    }

    function addHistoryDot(isTai) {
      let hist = document.getElementById('history-dots');
      let newDot = document.createElement('div');
      newDot.className = `dot ${isTai ? 'tai' : 'xiu'}`;
      hist.appendChild(newDot);
      if (hist.children.length > 10) hist.removeChild(hist.children[0]);
    }

    function resetRoundUI() {
      document.getElementById('side-tai').classList.remove('active-win');
      document.getElementById('side-xiu').classList.remove('active-win');
      document.getElementById('my-tai-bet').style.display = 'none';
      document.getElementById('my-xiu-bet').style.display = 'none';
      document.getElementById('win-banner').classList.remove('show');
      userBets = { TAI: 0, XIU: 0 };
    }

    function updateBalanceUI() {
      document.getElementById('user-balance').innerText = formatNum(Math.floor(balance));
      document.getElementById('arena-balance').innerText = formatNum(Math.floor(balance));
    }

    function showWinBanner(amount) {
      document.getElementById('win-money-text').innerText = '+' + formatNum(Math.floor(amount));
      let banner = document.getElementById('win-banner');
      banner.classList.add('show');
      setTimeout(() => banner.classList.remove('show'), 3000);
    }

    // Modal & Thao Tác Đặt Cược
    function openBetModal(side) {
      if (isRolling || timerVal <= 5) {
        showToast('Đang lắc đĩa, vui lòng chờ phiên tiếp theo!');
        return;
      }
      currentSideBet = side;
      document.getElementById('modal-bet-title').innerText = `ĐẶT CƯỢC ${side}`;
      document.getElementById('bet-input-value').value = '';
      document.getElementById('bet-modal').style.display = 'flex';
    }

    function closeBetModal() {
      document.getElementById('bet-modal').style.display = 'none';
    }

    function addBetVal(val) {
      let input = document.getElementById('bet-input-value');
      let curr = parseInt(input.value) || 0;
      input.value = curr + val;
    }

    function setBetAllIn() {
      document.getElementById('bet-input-value').value = balance;
    }

    function confirmBet() {
      let val = parseInt(document.getElementById('bet-input-value').value);
      if (!val || val <= 0) {
        showToast('Vui lòng nhập số tiền hợp lệ!');
        return;
      }
      if (val > balance) {
        showToast('Số dư tài khoản không đủ!');
        return;
      }

      balance -= val;
      updateBalanceUI();

      if (currentSideBet === 'TÀI') {
        userBets.TAI += val;
        let tag = document.getElementById('my-tai-bet');
        tag.innerText = `Đã cược: ${formatNum(userBets.TAI)}`;
        tag.style.display = 'block';
      } else {
        userBets.XIU += val;
        let tag = document.getElementById('my-xiu-bet');
        tag.innerText = `Đã cược: ${formatNum(userBets.XIU)}`;
        tag.style.display = 'block';
      }

      showToast(`Đặt thành công ${formatNum(val)} vào cửa ${currentSideBet}`);
      closeBetModal();
    }
  </script>
</body>
</html>
