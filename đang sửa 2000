<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Go88 Real - Tài Xỉu MD5 VIP</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Arial Black', 'Arial', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #000002;
      color: #ffffff;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #0c0c12 0%, #000000 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 40px; font-weight: 900;
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 45%, #e65c00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 20px rgba(245, 166, 35, 0.7));
      letter-spacing: 2px; text-transform: uppercase;
    }

    .loader-box {
      width: 320px; height: 14px; background: rgba(0,0,0,0.9);
      border: 1.5px solid #ffb703; border-radius: 10px; padding: 2px; margin-top: 20px;
      box-shadow: 0 0 15px rgba(255, 183, 3, 0.3);
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff8000, #ffea00);
      border-radius: 10px; transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffea00;
    }

    /* 2. LOBBY */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #101018 0%, #050508 60%, #000000 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 24px; background: rgba(5, 5, 8, 0.98);
      border-bottom: 2px solid #ffb703; z-index: 20;
      box-shadow: 0 4px 20px rgba(0,0,0,0.9);
    }

    .user-info { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 42px; height: 42px; border-radius: 10px; border: 2px solid #ffb703; background-size: cover; box-shadow: 0 0 8px rgba(255,183,3,0.5); }
    .balance-box {
      background: #000000; border: 1.5px solid #ffb703;
      border-radius: 18px; padding: 4px 16px; color: #ffea00;
      font-weight: bold; font-size: 15px; text-shadow: 0 0 8px rgba(255, 234, 0, 0.5);
      box-shadow: inset 0 0 8px rgba(0,0,0,0.9);
    }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 210px; height: 270px; border-radius: 18px; border: 2px solid #ffb703;
      display: flex; flex-direction: column; justify-content: space-between; padding: 18px;
      cursor: pointer; transition: transform 0.25s, box-shadow 0.25s;
      background: linear-gradient(180deg, #151520 0%, #040407 100%);
      box-shadow: 0 0 25px rgba(255, 183, 3, 0.25), inset 0 0 15px rgba(255, 255, 255, 0.05);
    }
    .game-card:hover { transform: translateY(-5px) scale(1.03); box-shadow: 0 0 35px rgba(255, 183, 3, 0.5); }

    .card-title {
      font-size: 20px; font-weight: 900; text-align: center;
      background: linear-gradient(180deg, #ffffff 0%, #ffea00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }
    .card-sub { font-size: 11px; text-align: center; color: #00ffcc; font-weight: bold; letter-spacing: 1px; }

    /* 3. ARENA GAME PLAY */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0, 0, 0, 0.98); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between; overflow: hidden;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(5, 5, 8, 0.98); border-bottom: 1.5px solid #ffb703;
      z-index: 20; box-shadow: 0 4px 15px rgba(0,0,0,0.9);
    }

    .btn-back-lobby {
      background: linear-gradient(180deg, #80000a, #4a0005);
      color: #fff; border: 1.5px solid #ffea00; padding: 6px 16px; border-radius: 16px;
      font-weight: bold; cursor: pointer; box-shadow: 0 3px 6px #000;
    }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; overflow: hidden; }

    /* DIM OVERLAY KHI NẶN */
    .dim-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.85);
      z-index: 11; opacity: 0; pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .dim-overlay.active { opacity: 1; }

    /* BÀN TÀI XỈU THU NHỎ GỌN GÀNG VỪA ĐỦ 100% */
    .real-taixiu-board {
      position: absolute; width: 680px; height: 320px;
      border-radius: 160px; display: flex; justify-content: space-between; align-items: center;
      padding: 15px 35px;
      background: radial-gradient(circle at center, #12121a 0%, #08080c 60%, #000000 100%);
      border: 3.5px solid #f5a623;
      box-shadow: 0 0 50px rgba(245, 166, 35, 0.35), inset 0 0 30px rgba(0, 0, 0, 0.95), inset 0 0 10px rgba(255, 234, 0, 0.3);
      cursor: grab; touch-action: none; z-index: 12;
    }
    .real-taixiu-board:active { cursor: grabbing; }

    .board-logo {
      position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
      font-size: 15px; font-weight: 900; letter-spacing: 2px;
      background: linear-gradient(180deg, #ffffff 0%, #ffb703 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 8px rgba(255, 183, 3, 0.6));
      z-index: 5; pointer-events: none;
    }

    /* NÚT TRÒN VIỀN BÀN CƯỢC */
    .circle-btn {
      position: absolute; width: 34px; height: 34px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 13px; font-weight: bold; cursor: pointer;
      background: linear-gradient(180deg, #22222e, #0a0a10);
      border: 1.5px solid #ffea00; z-index: 25; box-shadow: 0 4px 8px #000, 0 0 8px rgba(255,234,0,0.3);
      transition: transform 0.15s;
    }
    .circle-btn:active { transform: scale(0.9); }

    .btn-info { top: 18px; left: 135px; }
    .btn-chart { top: 78px; left: 55px; background: linear-gradient(180deg, #0077b6, #023e8a); }
    .btn-help { top: 142px; left: 22px; }
    .btn-history { top: 206px; left: 55px; }

    .btn-close { top: 18px; right: 135px; background: linear-gradient(180deg, #9e1a22, #500000); }
    .btn-rank { top: 78px; right: 55px; }
    .btn-chat-toggle { top: 142px; right: 22px; }

    .btn-nan-hand {
      position: absolute; right: 95px; bottom: 20px; width: 42px; height: 42px;
      border-radius: 50%; background: radial-gradient(circle, #ff9d00, #804000);
      border: 2px solid #fff3a1; box-shadow: 0 0 12px #ff9d00, 0 4px 8px #000;
      display: flex; justify-content: center; align-items: center; font-size: 20px;
      cursor: pointer; z-index: 26; transition: transform 0.2s, background 0.3s;
    }
    .btn-nan-hand.active { background: radial-gradient(circle, #00ffcc, #005544); border-color: #00ffff; box-shadow: 0 0 15px #00ffff; }

    /* CỬA CƯỢC TÀI / XỈU */
    .bet-side {
      width: 180px; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 15;
    }

    .player-count { font-size: 12px; color: #ffea00; font-weight: bold; margin-bottom: 2px; text-shadow: 0 0 5px #ffea00; display: inline-block; }

    .bet-title {
      font-size: 50px; font-weight: 900; color: #ffffff;
      text-shadow: 0 4px 10px rgba(0,0,0,0.9), 0 0 15px rgba(255,255,255,0.3);
      letter-spacing: 3px; transition: all 0.3s ease;
    }
    .bet-title.highlight-pulse {
      color: #ffea00; text-shadow: 0 0 25px #ffea00, 0 0 50px #ffea00;
      animation: pulseGlow 0.6s infinite alternate;
    }
    @keyframes pulseGlow {
      from { transform: scale(1); }
      to { transform: scale(1.12); }
    }

    .bet-amount {
      font-size: 16px; font-weight: 900; color: #00ffcc;
      text-shadow: 0 0 8px rgba(0, 255, 204, 0.6), 0 2px 4px #000; margin-bottom: 6px;
      display: inline-block;
      transition: transform 0.1s ease;
    }

    .bounce-anim { animation: bounceValue 0.18s ease-out; }
    @keyframes bounceValue {
      0% { transform: scale(1); }
      50% { transform: scale(1.25); color: #ffffff; }
      100% { transform: scale(1); }
    }

    .btn-cuoc-oval {
      width: 135px; height: 36px;
      background: radial-gradient(circle, #1a1a24 0%, #08080d 100%);
      border: 2px solid #ffb703; border-radius: 18px;
      display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: inset 0 0 8px rgba(0,0,0,0.9), 0 4px 10px rgba(0,0,0,0.8), 0 0 10px rgba(255, 183, 3, 0.2);
      transition: transform 0.1s, border-color 0.2s;
    }
    .btn-cuoc-oval:active { transform: scale(0.95); }

    .bet-text-val { font-size: 15px; font-weight: 900; color: #8888a0; text-shadow: 0 1px 2px #000; }
    .bet-text-val.label-cuoc {
      color: #ff9d00;
      background: linear-gradient(180deg, #fff3a1 0%, #ff9d00 60%, #b35900 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 3px rgba(0, 0, 0, 0.9));
      font-size: 16px; letter-spacing: 1px;
    }
    .bet-text-val.active-bet { color: #ffea00; text-shadow: 0 0 8px rgba(255, 234, 0, 0.9); }

    /* BÁT / ĐĨA TRUNG TÂM */
    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 195px; height: 195px; border-radius: 50%;
      background: radial-gradient(circle, #08080c 0%, #12121a 70%, #000000 100%);
      border: 3.5px solid #ffb703; display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 35px rgba(0,0,0,0.95), inset 0 0 18px rgba(255,183,3,0.3); z-index: 16;
    }

    /* NẮP BÁT CÓ THỂ KÉO RA TỰ DO KHI NẶN THỰC TẾ 100% */
    .plate-cover {
      position: absolute; width: 190px; height: 190px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #3a3a48 0%, #121218 60%, #000000 100%);
      border: 3px solid #ffea00; box-shadow: 0 10px 30px rgba(0,0,0,0.95), inset 0 2px 10px rgba(255,255,255,0.4);
      z-index: 30; display: none; cursor: grab; justify-content: center; align-items: center;
      touch-action: none; transition: opacity 0.5s ease;
    }
    .plate-cover:active { cursor: grabbing; filter: drop-shadow(0px 0px 18px rgba(255, 234, 0, 0.9)); }
    .plate-cover-knob { width: 44px; height: 44px; border-radius: 50%; background: radial-gradient(circle, #ffd700, #b8860b); border: 2px solid #fff; box-shadow: 0 4px 8px #000; }

    .timer-display { font-size: 58px; font-weight: 900; color: #ffea00; text-shadow: 0 0 20px rgba(255, 234, 0, 0.9); z-index: 6; }

    .dice-triangle-container { position: absolute; width: 130px; height: 110px; display: none; z-index: 8; }
    .dice-real {
      position: absolute; width: 42px; height: 42px;
      background: linear-gradient(145deg, #ffffff, #e6e6e6);
      border: 2px solid #b3b3b3; border-radius: 8px;
      box-shadow: inset 0 0 6px rgba(0,0,0,0.2), 0 5px 10px rgba(0,0,0,0.8);
      display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 3px; align-items: center; justify-items: center;
    }

    #dice1 { top: 5px; left: 44px; }
    #dice2 { bottom: 5px; left: 12px; }
    #dice3 { bottom: 5px; right: 12px; }

    .pip { width: 7px; height: 7px; background: #111111; border-radius: 50%; display: none; }
    .pip.center-red { background: #ff0000; width: 11px; height: 11px; grid-column: 2; grid-row: 2; display: block; }
    .p-1 { grid-column: 1; grid-row: 1; } .p-3 { grid-column: 3; grid-row: 1; }
    .p-4 { grid-column: 1; grid-row: 2; } .p-5 { grid-column: 2; grid-row: 2; } .p-6 { grid-column: 3; grid-row: 2; }
    .p-7 { grid-column: 1; grid-row: 3; } .p-9 { grid-column: 3; grid-row: 3; }

    .win-text-overlay {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-size: 34px; font-weight: 900; color: #ffea00;
      text-shadow: 0 0 15px #ffea00, 0 4px 10px #000; z-index: 20; display: none; white-space: nowrap;
      animation: popWin 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popWin {
      0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    /* BANNER CHIP CƯỢC */
    .chip-panel-real {
      position: absolute; bottom: 0px; left: 50%; transform: translate(-50%, 80%);
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      background: rgba(0, 0, 0, 0) !important; border: none !important; box-shadow: none !important;
      padding: 8px 20px 10px 20px; border-radius: 16px; z-index: 100;
      transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 1;
    }

    .chip-panel-real.hidden { opacity: 0; pointer-events: none; transform: translate(-50%, 130%); }
    .chip-list { display: flex; gap: 6px; }

    .chip-btn {
      width: 54px; height: 35px; border-radius: 8px;
      background: linear-gradient(180deg, #ffb300 0%, #ff8000 60%, #cc5200 100%);
      border: 1.5px solid #ffe066; color: #ffffff; font-size: 12px; font-weight: 900;
      display: flex; justify-content: center; align-items: center; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(255,255,255,0.8), 0 4px 8px #000;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); transition: transform 0.1s, box-shadow 0.1s;
    }
    .chip-btn:active { transform: translateY(-2px); box-shadow: 0 0 12px #ffea00; }

    .chip-actions { display: flex; gap: 10px; width: 100%; justify-content: center; margin-top: 2px; }

    .btn-action-x2 {
      background: linear-gradient(180deg, #3a7bd5, #3a6073); border: 1px solid #fff;
      color: #fff; padding: 5px 16px; border-radius: 16px; font-weight: 900; font-size: 12px; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.6);
    }

    .btn-action-bet {
      background: linear-gradient(180deg, #fff3b0 0%, #f5a623 50%, #d47a00 100%);
      border: 1.5px solid #ffffff;
      color: #3d1e00; padding: 5px 28px; border-radius: 16px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: 0 0 15px rgba(245, 166, 35, 0.9), 0 3px 6px rgba(0,0,0,0.6);
      text-shadow: 0 1px 0 rgba(255,255,255,0.6);
    }

    .btn-action-cancel {
      background: linear-gradient(180deg, #b8121f 0%, #80000a 60%, #4a0005 100%);
      border: 1.5px solid #ff9999;
      color: #fff; padding: 5px 16px; border-radius: 16px; font-weight: 900; font-size: 12px; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(255,255,255,0.4), 0 3px 6px rgba(0,0,0,0.8);
      text-shadow: 0 1px 2px #000;
    }

    /* 4. BẢNG SOI CẦU VIP GIAO DIỆN NÂU XÁM KẺ VẠCH ĐẬM ĐÚNG REAL 100% KIỂU CŨ */
    .chart-modal-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0, 0, 0, 0.82); z-index: 1000; display: none;
      justify-content: center; align-items: center; backdrop-filter: blur(5px);
    }
    .chart-modal-overlay.active { display: flex; }

    .chart-modal-box {
      width: 780px; height: 420px;
      background: linear-gradient(180deg, #3d3430 0%, #221c19 100%); /* Màu Nâu Xám VIP kiểu cũ */
      border: 3px solid #ffb703; border-radius: 18px;
      box-shadow: 0 0 50px rgba(0,0,0,0.95), 0 0 20px rgba(245, 166, 35, 0.4);
      display: flex; flex-direction: column; overflow: hidden; position: relative;
    }

    .chart-header {
      height: 44px; background: linear-gradient(180deg, #4f423c, #2b2320);
      border-bottom: 2px solid #ffb703; display: flex; justify-content: space-between;
      align-items: center; padding: 0 18px;
    }

    .chart-title {
      font-size: 15px; font-weight: 900; color: #ffea00;
      text-shadow: 0 2px 4px #000; letter-spacing: 1px;
    }

    .btn-close-chart {
      width: 26px; height: 26px; border-radius: 50%; background: #a00; border: 1.5px solid #fff;
      color: #fff; font-weight: bold; display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: 0 2px 4px #000;
    }

    .chart-body-wrapper {
      flex: 1; padding: 12px; overflow-x: auto; overflow-y: hidden;
      display: flex; flex-direction: column; gap: 10px;
      cursor: grab; touch-action: none;
    }
    .chart-body-wrapper:active { cursor: grabbing; }

    /* LƯỚI BẢNG CẦU KIỂU CŨ CÓ KẺ VẠCH ĐẬM SẮC NẾT TẠO CỘT DỌC HÀNG NGANG 5 Ô CHUẨN */
    .grid-cau-container {
      display: grid;
      grid-template-rows: repeat(5, 38px);
      grid-auto-columns: 38px;
      grid-auto-flow: column;
      gap: 0px;
      background: #191412;
      border: 2px solid #ffb703;
      padding: 3px;
      border-radius: 6px;
      width: max-content;
      min-width: 100%;
    }

    .grid-cell {
      width: 38px; height: 38px;
      background: #28211d;
      border: 1.5px solid #5a4b43; /* Kẻ vạch nâu đậm sắc nét */
      display: flex; justify-content: center; align-items: center;
    }

    /* CHẤM TRÒN TÀI (ĐEN VIỀN VÀNG) VÀ XỈU (TRẮNG VIỀN XÁM) ĐÚNG REAL KIỂU CŨ */
    .dot-result {
      width: 30px; height: 30px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      font-size: 13px; font-weight: 900;
      box-shadow: 0 2px 5px rgba(0,0,0,0.9);
    }
    .dot-result.tai {
      background: radial-gradient(circle at 35% 35%, #2a2a2a, #050505);
      border: 2px solid #ffea00; color: #ffea00; text-shadow: 0 0 3px #ffea00;
    }
    .dot-result.xiu {
      background: radial-gradient(circle at 35% 35%, #ffffff, #cccccc);
      border: 2px solid #444444; color: #000000; font-weight: 900;
    }

    .toast-msg {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-50px);
      background: rgba(5,5,10,0.98); border: 2px solid #ffb703; color: #ffea00;
      padding: 8px 22px; border-radius: 18px; font-weight: bold; font-size: 13px;
      z-index: 9999; opacity: 0; transition: all 0.3s ease; pointer-events: none;
      box-shadow: 0 0 20px rgba(255,183,3,0.5);
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

  <div id="toast" class="toast-msg">Thông báo hệ thống</div>

  <!-- 1. LOADING SCREEN -->
  <div id="loading-screen" class="app-screen active">
    <div class="loader-brand">GO88 MD5 REAL</div>
    <div class="loader-box"><div class="loader-fill" id="loader-fill"></div></div>
  </div>

  <!-- 2. GAME LOBBY -->
  <div id="lobby-screen" class="app-screen game-lobby">
    <div class="top-bar">
      <div class="user-info">
        <div class="avatar" style="background-image: url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100');"></div>
        <div>
          <div style="font-size: 11px; color: #aaa;">Go88TrumBai</div>
          <div class="balance-box" id="user-balance">$ 1,096,000</div>
        </div>
      </div>
      <div>
        <button class="btn-action-bet" style="padding: 5px 18px; font-size: 12px;" onclick="showToast('Cổng Nạp Tự Động 24/7')">NẠP TIỀN</button>
      </div>
    </div>

    <div class="lobby-content">
      <div class="game-card" onclick="enterArena('MD5')">
        <div class="card-title">TÀI XỈU MD5</div>
        <div class="card-sub">MINH BẠCH 100%</div>
        <div style="text-align: center; color:#ffea00; font-size:12px; font-weight:bold;">#13217</div>
      </div>
    </div>
  </div>

  <!-- 3. ARENA GAME PLAY -->
  <div id="arena-screen" class="arena-screen">
    <div class="arena-header">
      <button class="btn-back-lobby" onclick="exitArena()">◄ RỜI SẢNH</button>
      <div style="font-weight:900; color:#ffea00; font-size: 18px;" id="arena-title">TÀI XỈU MD5</div>
      <div class="balance-box" id="arena-balance">$ 1,096,000</div>
    </div>

    <div class="arena-stage" id="arena-stage">
      <div class="dim-overlay" id="dim-overlay"></div>

      <!-- BÀN TÀI XỈU (CÓ THỂ KÉO THẢ DI CHUYỂN TỰ DO REAL 100%) -->
      <div class="real-taixiu-board" id="draggable-board">
        <div class="board-logo">GO88 MD5</div>

        <!-- Các nút tiện ích viền bàn cược -->
        <div class="circle-btn btn-info" onclick="showToast('Phiên cược mã hóa MD5')">i</div>
        <div class="circle-btn btn-chart" onclick="openChartModal()">📊</div>
        <div class="circle-btn btn-help" onclick="showToast('Luật chơi: Tài (11-17), Xỉu (3-10)')">?</div>
        <div class="circle-btn btn-history" onclick="showToast('Lịch sử cược cá nhân')">📜</div>

        <div class="circle-btn btn-close" onclick="exitArena()">X</div>
        <div class="circle-btn btn-rank" onclick="showToast('Bảng vinh danh Top')">🏆</div>
        <div class="circle-btn btn-chat-toggle" onclick="showToast('Mở khung Chat')">💬</div>

        <div class="btn-nan-hand" id="btn-nan" onclick="toggleNanMode()" title="Bật/Tắt chế độ Nặn">✋</div>

        <!-- CỬA TÀI -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="tai-players">0</span></div>
          <div class="bet-title" id="title-TAI">TÀI</div>
          <div class="bet-amount" id="tai-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('TAI')">
            <span class="bet-text-val label-cuoc" id="val-TAI">CƯỢC</span>
          </div>
        </div>

        <!-- BÁT / ĐĨA TRUNG TÂM -->
        <div class="center-plate" id="center-plate">
          <div class="timer-display" id="timer-text">15</div>

          <!-- NẮP KÉO RA TỰ DO KHI NẶN THỰC TẾ 100% -->
          <div class="plate-cover" id="plate-cover">
            <div class="plate-cover-knob"></div>
          </div>

          <div class="dice-triangle-container" id="dice-container">
            <div class="dice-real" id="dice1"></div>
            <div class="dice-real" id="dice2"></div>
            <div class="dice-real" id="dice3"></div>
          </div>

          <div class="win-text-overlay" id="win-overlay">+0</div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="xiu-players">0</span></div>
          <div class="bet-title" id="title-XIU">XỈU</div>
          <div class="bet-amount" id="xiu-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('XIU')">
            <span class="bet-text-val label-cuoc" id="val-XIU">CƯỢC</span>
          </div>
        </div>

        <!-- BANNER CHIP CƯỢC -->
        <div class="chip-panel-real hidden" id="chip-panel">
          <div class="chip-list">
            <div class="chip-btn" onclick="addChip(1000)">1K</div>
            <div class="chip-btn" onclick="addChip(10000)">10K</div>
            <div class="chip-btn" onclick="addChip(50000)">50K</div>
            <div class="chip-btn" onclick="addChip(100000)">100K</div>
            <div class="chip-btn" onclick="addChip(500000)">500K</div>
            <div class="chip-btn" onclick="addChip(1000000)">1M</div>
            <div class="chip-btn" onclick="addChip(10000000)">10M</div>
            <div class="chip-btn" onclick="addChip(50000000)">50M</div>
          </div>
          <div class="chip-actions">
            <button class="btn-action-x2" onclick="allInBet()">ALL IN</button>
            <button class="btn-action-bet" onclick="confirmBet()">ĐẶT CƯỢC</button>
            <button class="btn-action-cancel" onclick="cancelBet()">HỦY</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- POPUP BẢNG SOI CẦU (GIAO DIỆN KIỂU CŨ NÂU XÁM KẺ VẠCH) -->
  <div class="chart-modal-overlay" id="chart-modal">
    <div class="chart-modal-box">
      <div class="chart-header">
        <div class="chart-title">📊 BẢNG SOI CẦU TÀI XỈU MD5 - GO88 VIP</div>
        <div class="btn-close-chart" onclick="closeChartModal()">X</div>
      </div>
      <div class="chart-body-wrapper" id="chart-scroll-area">
        <div class="grid-cau-container" id="grid-cau"></div>
      </div>
    </div>
  </div>

  <script>
    // State System
    let balance = 1096000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    let timer = 15;
    let timerInterval = null;
    let autoBetInterval = null;

    // Bet Jump State Simulation
    let taiMoney = 15200000;
    let xiuMoney = 14800000;
    let taiUsers = 142;
    let xiuUsers = 138;
    let betMultiplier = 1;

    // Lịch sử kết quả cầu kiểu cũ
    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 },
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 },
      { side: 'XIU', total: 4 }, { side: 'TAI', total: 16 }, { side: 'TAI', total: 11 }
    ];

    // Chế độ nặn & Dữ liệu Xúc xắc
    let isNanMode = false;
    let currentDice = [1, 1, 1];
    let currentResultSide = 'XIU';

    // Initializer Loading
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      startTimer();
      startAutoBetIncrements();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
      clearInterval(autoBetInterval);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn tay');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    /* DRAGGABLE BOARD (KÉO BÀN TỰ DO REAL 100%) */
    const board = document.getElementById('draggable-board');
    let isDraggingBoard = false;
    let boardStartX = 0, boardStartY = 0;
    let boardInitialLeft = 0, boardInitialTop = 0;

    board.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.circle-btn') || e.target.closest('.btn-cuoc-oval') || e.target.closest('.chip-panel-real') || e.target.closest('.btn-nan-hand') || e.target.closest('#plate-cover')) return;
      
      isDraggingBoard = true;
      boardStartX = e.clientX;
      boardStartY = e.clientY;
      
      const style = window.getComputedStyle(board);
      const matrix = new WebKitCSSMatrix(style.transform);
      boardInitialLeft = matrix.m41;
      boardInitialTop = matrix.m42;
      
      board.setPointerCapture(e.pointerId);
    });

    board.addEventListener('pointermove', (e) => {
      if (!isDraggingBoard) return;
      const dx = e.clientX - boardStartX;
      const dy = e.clientY - boardStartY;
      board.style.transform = `translate(${boardInitialLeft + dx}px, ${boardInitialTop + dy}px)`;
    });

    board.addEventListener('pointerup', (e) => {
      if (isDraggingBoard) {
        isDraggingBoard = false;
        try { board.releasePointerCapture(e.pointerId); } catch(err){}
      }
    });

    /* KÉO NẮP TỰ DO KHI NẶN & GIỮ NGUYÊN VẸN 2.5 GIÂY RỒI TỰ BIẾN MẤT REAL 100% */
    const cover = document.getElementById('plate-cover');
    let isDraggingCover = false;
    let coverStartX = 0, coverStartY = 0;
    let coverX = 0, coverY = 0;
    let coverVanishedTimer = null;

    cover.addEventListener('pointerdown', (e) => {
      if (!isNanMode || timer > 0) return;
      isDraggingCover = true;
      coverStartX = e.clientX - coverX;
      coverStartY = e.clientY - coverY;
      cover.setPointerCapture(e.pointerId);
    });

    cover.addEventListener('pointermove', (e) => {
      if (!isDraggingCover) return;
      coverX = e.clientX - coverStartX;
      coverY = e.clientY - coverStartY;
      cover.style.transform = `translate(${coverX}px, ${coverY}px)`;

      // Tính khoảng cách nắp đã rời khỏi tâm đĩa
      const dist = Math.sqrt(coverX * coverX + coverY * coverY);
      
      // Kéo nắp ra hết khỏi đĩa hình tròn (> 95px) -> Giữ nguyên vẹn đứng yên rồi biến mất sau 2.5 giây
      if (dist > 95 && !coverVanishedTimer) {
        coverVanishedTimer = setTimeout(() => {
          cover.style.opacity = '0';
          setTimeout(() => {
            cover.style.display = 'none';
            document.getElementById('dim-overlay').classList.remove('active');
            finishRoundDisplay();
          }, 500);
        }, 2500); // Giữ nguyên vẹn đúng 2.5 giây thực tế rồi biến mất
      }
    });

    cover.addEventListener('pointerup', (e) => {
      if (isDraggingCover) {
        isDraggingCover = false;
        try { cover.releasePointerCapture(e.pointerId); } catch(err){}
      }
    });

    /* TĂNG TIỀN CƯỢC 2 BÊN LIÊN TỤC 3S -> CHẬM 2S -> TĂNG GẤP ĐÔI REAL 100% */
    function startAutoBetIncrements() {
      let phaseTime = 0;
      clearInterval(autoBetInterval);
      
      autoBetInterval = setInterval(() => {
        if (timer <= 0) return;
        phaseTime += 0.2;
        const cycle = phaseTime % 5; // Chu kỳ 5 giây: 3s nảy nhanh, 2s nảy chậm
        
        let isFastPhase = cycle < 3;
        
        // Cứ mỗi 5s chu kỳ trôi qua thì tiền cược nảy tăng gấp đôi
        betMultiplier = 1 + Math.floor(phaseTime / 5) * 0.8;

        if (isFastPhase || Math.random() < 0.35) {
          let taiInc = Math.floor((Math.random() * 850000 + 150000) * betMultiplier);
          let xiuInc = Math.floor((Math.random() * 850000 + 150000) * betMultiplier);
          
          taiMoney += taiInc;
          xiuMoney += xiuInc;
          
          if (Math.random() > 0.4) taiUsers += Math.floor(Math.random() * 3 + 1);
          if (Math.random() > 0.4) xiuUsers += Math.floor(Math.random() * 3 + 1);

          updateArenaBoardUI(true);
        }
      }, 200);
    }

    function updateArenaBoardUI(triggerBounce = false) {
      document.getElementById('tai-players').innerText = taiUsers.toLocaleString();
      document.getElementById('xiu-players').innerText = xiuUsers.toLocaleString();
      
      const taiAmtEl = document.getElementById('tai-amount');
      const xiuAmtEl = document.getElementById('xiu-amount');

      taiAmtEl.innerText = taiMoney.toLocaleString();
      xiuAmtEl.innerText = xiuMoney.toLocaleString();

      if (triggerBounce) {
        taiAmtEl.classList.remove('bounce-anim');
        xiuAmtEl.classList.remove('bounce-anim');
        void taiAmtEl.offsetWidth; // Reflow animation
        taiAmtEl.classList.add('bounce-anim');
        xiuAmtEl.classList.add('bounce-anim');
      }
    }

    /* BẮT ĐẦU VÒNG ĐẾM GIỜ PHIÊN CƯỢC */
    function startTimer() {
      timer = 15;
      document.getElementById('timer-text').innerText = timer;
      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('win-overlay').style.display = 'none';
      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');
      
      // Reset nắp bát
      coverX = 0; coverY = 0;
      coverVanishedTimer = null;
      cover.style.transform = 'translate(0px, 0px)';
      cover.style.opacity = '1';
      cover.style.display = 'none';
      document.getElementById('dim-overlay').classList.remove('active');

      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timer--;
        if (timer >= 0) {
          document.getElementById('timer-text').innerText = timer;
        } else {
          clearInterval(timerInterval);
          rollDiceAndFinish();
        }
      }, 1000);
    }

    function rollDiceAndFinish() {
      document.getElementById('timer-text').style.display = 'none';
      
      // Tạo kết quả ngẫu nhiên 3 xúc xắc
      currentDice = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];
      const sum = currentDice[0] + currentDice[1] + currentDice[2];
      currentResultSide = sum >= 11 ? 'TAI' : 'XIU';

      // Render các chấm xúc xắc
      renderDice('dice1', currentDice[0]);
      renderDice('dice2', currentDice[1]);
      renderDice('dice3', currentDice[2]);
      document.getElementById('dice-container').style.display = 'block';

      if (isNanMode) {
        // Hiện nắp đậy & Làm tối màn hình chờ người chơi nặn kéo nắp
        cover.style.display = 'flex';
        document.getElementById('dim-overlay').classList.add('active');
        showToast('Hãy kéo nắp đĩa ra ngoài để nặn kết quả!');
      } else {
        // Tự động mở kết quả
        finishRoundDisplay();
      }
    }

    function renderDice(id, val) {
      const el = document.getElementById(id);
      el.innerHTML = '';
      if (val === 1) {
        el.innerHTML = '<div class="pip center-red"></div>';
      } else {
        const pips = {
          2: [1, 9],
          3: [1, 5, 9],
          4: [1, 3, 7, 9],
          5: [1, 3, 5, 7, 9],
          6: [1, 3, 4, 6, 7, 9]
        }[val];
        pips.forEach(p => {
          const pDiv = document.createElement('div');
          pDiv.className = 'pip p-' + p;
          pDiv.style.display = 'block';
          el.appendChild(pDiv);
        });
      }
    }

    function finishRoundDisplay() {
      const sum = currentDice[0] + currentDice[1] + currentDice[2];
      const resultSide = currentResultSide;

      // Highlight cửa thắng
      document.getElementById('title-' + resultSide).classList.add('highlight-pulse');

      // Tính thưởng tiền cược
      let winAmount = 0;
      if (confirmedBets[resultSide] > 0) {
        winAmount = confirmedBets[resultSide] * 2;
        balance += winAmount;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        const winOv = document.getElementById('win-overlay');
        winOv.innerText = '+' + winAmount.toLocaleString();
        winOv.style.display = 'block';
      }

      // Lưu lịch sử cầu
      historyResults.push({ side: resultSide, total: sum });

      // Chờ 5 giây bắt đầu ván mới
      setTimeout(() => {
        confirmedBets = { TAI: 0, XIU: 0 };
        document.getElementById('val-TAI').innerText = 'CƯỢC';
        document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
        document.getElementById('val-XIU').innerText = 'CƯỢC';
        document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';
        startTimer();
      }, 5000);
    }

    /* THAO TÁC CƯỢC */
    function openBetPanel(side) {
      if (timer <= 0) {
        showToast('Hết thời gian đặt cược!');
        return;
      }
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Đã chọn cửa ' + side + '. Chọn chip cược!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược hợp lệ!');
        return;
      }
      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;

      if (currentBetSide === 'TAI') taiMoney += tempBetAmount;
      else xiuMoney += tempBetAmount;

      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

      showToast('Đặt cược thành công ' + tempBetAmount.toLocaleString() + ' vào ' + currentBetSide);
      document.getElementById('chip-panel').classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    function cancelBet() {
      showToast('Đã hủy thao tác cược!');
      if (currentBetSide && confirmedBets[currentBetSide] === 0) {
        const el = document.getElementById('val-' + currentBetSide);
        el.innerText = 'CƯỢC';
        el.className = 'bet-text-val label-cuoc';
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    /* BẢNG SOI CẦU GIAO DIỆN KIỂU CŨ NÂU XÁM KẺ VẠCH 5 Ô CHUẨN */
    function openChartModal() {
      renderGridCau();
      document.getElementById('chart-modal').classList.add('active');
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function renderGridCau() {
      const grid = document.getElementById('grid-cau');
      grid.innerHTML = '';

      // Tự động phân cột 5 hàng kiểu cũ
      let colIndex = 0;
      let rowIndex = 0;
      let prevSide = null;

      historyResults.forEach((res) => {
        if (prevSide !== null && res.side !== prevSide) {
          colIndex++;
          rowIndex = 0;
        } else if (rowIndex >= 5) {
          colIndex++;
          rowIndex = 0;
        }

        const cell = document.createElement('div');
        cell.className = 'grid-cell';
        cell.style.gridRow = (rowIndex + 1);
        cell.style.gridColumn = (colIndex + 1);

        const dot = document.createElement('div');
        dot.className = 'dot-result ' + res.side.toLowerCase();
        dot.innerText = res.total;

        cell.appendChild(dot);
        grid.appendChild(cell);

        prevSide = res.side;
        rowIndex++;
      });
    }
  </script>
</body>
</html>
