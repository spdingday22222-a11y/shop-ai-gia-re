        <div class="card-title">TÀI XỈU MD5</div>
        <div class="card-sub">MINH BẠCH 100%</div>
        <div style="text-align: center; color:#ffea00; font-size:12px; font-weight:bold;">#13217</div>
      </div>
    </div>
  </div>

  <!-- 3. ARENA GAME PLAY -->
  <div id="arena-screen" class="arena-screen">
    <div class="arena-header">
      <button class="btn-back-lobby" onclick="exitArena()">◄ RỜI SẢNH</button>
      <div style="font-weight:900; color:#ffea00; font-size: 18px;" id="arena-title">TÀI XỈU MD5 VIP</div>
      <div class="balance-box" id="arena-balance">$ 2,450,000,000</div>
    </div>

    <div class="arena-stage">
      <div class="dim-overlay" id="dim-overlay"></div>

      <!-- BÀN CƯỢC KÉO THẢ TỰ DO THỰC TẾ -->
      <div class="real-taixiu-board" id="draggable-board">
        <div class="board-logo">GO88 MD5</div>

        <!-- Các nút tiện ích xung quanh viền -->
        <div class="circle-btn btn-info" onclick="showToast('Phiên cược mã hóa MD5')">i</div>
        <div class="circle-btn btn-chart" onclick="openChartModal()">📊</div>
        <div class="circle-btn btn-help" onclick="showToast('Luật chơi: Tài (11-17), Xỉu (3-10)')">?</div>
        <div class="circle-btn btn-history" onclick="showToast('Lịch sử cược cá nhân')">📜</div>

        <div class="circle-btn btn-close" onclick="exitArena()">X</div>
        <div class="circle-btn btn-rank" onclick="showToast('Bảng vinh danh Top')">🏆</div>
        <div class="circle-btn btn-chat-toggle" onclick="showToast('Mở khung Chat')">💬</div>

        <div class="btn-nan-hand" id="btn-nan" onclick="toggleNanMode()" title="Bật/Tắt chế độ Nặn">✋</div>

        <!-- CỬA TÀI -->
        <div class="bet-side">
          <div class="player-count" id="tai-players-box">👤 <span id="tai-players">0</span></div>
          <div class="bet-title" id="title-TAI">TÀI</div>
          <div class="bet-amount" id="tai-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('TAI')">
            <span class="bet-text-val label-cuoc" id="val-TAI">CƯỢC</span>
          </div>
        </div>

        <!-- BÁT / ĐĨA TRUNG TÂM -->
        <div class="center-plate" id="center-plate">
          <div class="timer-display" id="timer-text">15</div>

          <div class="plate-cover" id="plate-cover">
            <div class="plate-cover-knob"></div>
          </div>

          <!-- 3 VIÊN XÚC SẮC KHỐI HỘP ĐỨNG THẲNG TRÒN CHUẨN TÂM -->
          <div class="dice-triangle-container" id="dice-container">
            <div class="dice-real-box" id="dice1"></div>
            <div class="dice-real-box" id="dice2"></div>
            <div class="dice-real-box" id="dice3"></div>
          </div>

          <div class="win-text-overlay" id="win-overlay">+0</div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count" id="xiu-players-box">👤 <span id="xiu-players">0</span></div>
          <div class="bet-title" id="title-XIU">XỈU</div>
          <div class="bet-amount" id="xiu-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('XIU')">
            <span class="bet-text-val label-cuoc" id="val-XIU">CƯỢC</span>
          </div>
        </div>

        <!-- CHIP CƯỢC -->
        <div class="chip-panel-real hidden" id="chip-panel">
          <div class="chip-list">
            <div class="chip-btn" onclick="addChip(1000)">1K</div>
            <div class="chip-btn" onclick="addChip(10000)">10K</div>
            <div class="chip-btn" onclick="addChip(50000)">50K</div>
            <div class="chip-btn" onclick="addChip(100000)">100K</div>
            <div class="chip-btn" onclick="addChip(500000)">500K</div>
            <div class="chip-btn" onclick="addChip(1000000)">1M</div>
            <div class="chip-btn" onclick="addChip(10000000)">10M</div>
            <div class="chip-btn" onclick="addChip(50000000)">50M</div>
          </div>
          <div class="chip-actions">
            <button class="btn-action-x2" onclick="allInBet()">ALL IN</button>
            <button class="btn-action-bet" onclick="confirmBet()">ĐẶT CƯỢC</button>
            <button class="btn-action-cancel" onclick="cancelBet()">HỦY</button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- BẢNG SOI CẦU MỞ RỘNG - NÂU XÁM VIP 5 Ô HÀNG NGANG CỘT DỌC -->
  <div class="chart-modal-overlay" id="chart-modal">
    <div class="chart-modal-box">
      <div class="chart-header">
        <div class="chart-title">📊 BẢNG SOI CẦU TÀI XỈU MD5 - GO88 VIP</div>
        <div class="btn-close-chart" onclick="closeChartModal()">X</div>
      </div>
      <div class="chart-body-wrapper" id="chart-scroll-area">
        <div class="grid-cau-container" id="grid-cau"></div>
      </div>
    </div>
  </div>

  <script>
    // State Game
    let balance = 2450000000; // Giới hạn số dư lên đến ~2.5 tỷ
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    let timer = 15;
    let timerInterval = null;
    let autoBetInterval = null;

    // Số dư cược hệ thống hai bên (Reset 0 mỗi phiên)
    let sysTaiBet = 0;
    let sysXiuBet = 0;
    let sysTaiPlayers = 0;
    let sysXiuPlayers = 0;

    // Lịch sử kết quả cầu
    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 },
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 }
    ];

    // Chế độ nặn & Kéo đĩa
    let isNanMode = false;
    let isDraggingCover = false;
    let coverStartX = 0, coverStartY = 0;

    // Kéo thả bàn cược mượt mà tự do
    const board = document.getElementById('draggable-board');
    let isDraggingBoard = false;
    let boardStartX = 0, boardStartY = 0;
    let boardPosX = 0, boardPosY = 0;

    function initDraggableBoard() {
      const onStart = (e) => {
        if (e.target.closest('.circle-btn') || e.target.closest('.btn-cuoc-oval') || e.target.closest('.chip-panel-real') || e.target.closest('.plate-cover')) return;
        isDraggingBoard = true;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        boardStartX = clientX - boardPosX;
        boardStartY = clientY - boardPosY;
      };

      const onMove = (e) => {
        if (!isDraggingBoard) return;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        boardPosX = clientX - boardStartX;
        boardPosY = clientY - boardStartY;
        board.style.transform = `translate(${boardPosX}px, ${boardPosY}px)`;
      };

      const onEnd = () => { isDraggingBoard = false; };

      board.addEventListener('mousedown', onStart);
      window.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      board.addEventListener('touchstart', onStart, { passive: true });
      window.addEventListener('touchmove', onMove, { passive: true });
      window.addEventListener('touchend', onEnd);
    }

    // Loading Bar
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
        initDraggableBoard();
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      startTimer();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
      clearInterval(autoBetInterval);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn tay');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    function openBetPanel(side) {
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Đã chọn cửa ' + side + '. Chọn chip cược!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      showToast('Đã hủy thao tác cược!');
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược!');
        return;
      }

      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
      
      showToast('Đặt cược ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      const el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      document.getElementById('chip-panel').classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    /* ĐỒNG HỒ ĐẾM NGƯỢC & HỆ THỐNG TỰ ĐỘNG CƯỢC NHẢY NẢY THỰC TẾ */
    function startTimer() {
      clearInterval(timerInterval);
      clearInterval(autoBetInterval);

      // RESET CƯỢC HAI BÊN VỀ 0 BAN ĐẦU
      sysTaiBet = 0; sysXiuBet = 0;
      sysTaiPlayers = 0; sysXiuPlayers = 0;
      confirmedBets = { TAI: 0, XIU: 0 };

      document.getElementById('val-TAI').innerText = 'CƯỢC';
      document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
      document.getElementById('val-XIU').innerText = 'CƯỢC';
      document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';

      updateSystemBetUI();

      timer = 15;
      document.getElementById('timer-text').innerText = '15';
      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('win-overlay').style.display = 'none';
      document.getElementById('plate-cover').style.display = 'none';
      document.getElementById('dim-overlay').classList.remove('active');
      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');

      // TỰ ĐỘNG CƯỢC TĂNG DẦN TỪ NHỎ ĐẾN VÀI TRĂM TRIỆU -> VÀI TỶ (MAX 2.5 TỶ)
      autoBetInterval = setInterval(() => {
        if (timer <= 1) return;

        // Tăng ngẫu nhiên từ vài chục ngàn lên đến hàng trăm triệu
        let addTai = Math.floor(Math.random() * 45000000) + 500000;
        let addXiu = Math.floor(Math.random() * 45000000) + 500000;

        if (sysTaiBet + addTai < 2450000000) sysTaiBet += addTai;
        if (sysXiuBet + addXiu < 2450000000) sysXiuBet += addXiu;

        sysTaiPlayers += Math.floor(Math.random() * 6) + 1;
        sysXiuPlayers += Math.floor(Math.random() * 6) + 1;

        updateSystemBetUI(true);
      }, 350);

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer < 10 ? '0' + timer : timer;

        if (timer <= 0) {
          clearInterval(timerInterval);
          clearInterval(autoBetInterval);
          renderDiceResult();
        }
      }, 1000);
    }

    function updateSystemBetUI(bounce = false) {
      const taiAmtEl = document.getElementById('tai-amount');
      const xiuAmtEl = document.getElementById('xiu-amount');
      const taiPlrEl = document.getElementById('tai-players');
      const xiuPlrEl = document.getElementById('xiu-players');

      taiAmtEl.innerText = sysTaiBet.toLocaleString();
      xiuAmtEl.innerText = sysXiuBet.toLocaleString();
      taiPlrEl.innerText = sysTaiPlayers;
      xiuPlrEl.innerText = sysXiuPlayers;

      if (bounce) {
        taiAmtEl.classList.add('bounce');
        xiuAmtEl.classList.add('bounce');
        document.getElementById('tai-players-box').classList.add('bounce');
        document.getElementById('xiu-players-box').classList.add('bounce');

        setTimeout(() => {
          taiAmtEl.classList.remove('bounce');
          xiuAmtEl.classList.remove('bounce');
          document.getElementById('tai-players-box').classList.remove('bounce');
          document.getElementById('xiu-players-box').classList.remove('bounce');
        }, 150);
      }
    }

    /* HIỂN THỊ KẾT QUẢ XÚC SẮC CHUẨN THỰC TẾ */
    function renderDiceResult() {
      document.getElementById('timer-text').style.display = 'none';

      // Sinh ngẫu nhiên 3 viên
      const d1 = Math.floor(Math.random() * 6) + 1;
      const d2 = Math.floor(Math.random() * 6) + 1;
      const d3 = Math.floor(Math.random() * 6) + 1;
      const total = d1 + d2 + d3;
      const side = total >= 11 ? 'TAI' : 'XIU';

      historyResults.push({ side, total });

      renderSingleDice('dice1', d1);
      renderSingleDice('dice2', d2);
      renderSingleDice('dice3', d3);

      const diceBox = document.getElementById('dice-container');
      diceBox.style.display = 'block';

      if (isNanMode) {
        const cover = document.getElementById('plate-cover');
        cover.style.display = 'flex';
        cover.style.transform = 'translate(0px, 0px)';
        document.getElementById('dim-overlay').classList.add('active');
        initPlateDrag(side, total);
      } else {
        finishRoundDisplay(side, total);
      }
    }

    /* VẼ MẶT XÚC SẮC CHUẨN TÂM TỪNG CHẤM TRÒN */
    function renderSingleDice(id, val) {
      const el = document.getElementById(id);
      el.innerHTML = '';

      if (val === 1) {
        const p = document.createElement('div');
        p.className = 'pip center-red';
        el.appendChild(p);
      } else {
        const positions = {
          2: ['p-1', 'p-9'],
          3: ['p-1', 'p-5', 'p-9'],
          4: ['p-1', 'p-3', 'p-7', 'p-9'],
          5: ['p-1', 'p-3', 'p-5', 'p-7', 'p-9'],
          6: ['p-1', 'p-3', 'p-4', 'p-6', 'p-7', 'p-9']
        };
        positions[val].forEach(posClass => {
          const p = document.createElement('div');
          p.className = 'pip ' + posClass;
          p.style.display = 'block';
          el.appendChild(p);
        });
      }
    }

    /* TÍNH NĂNG KÉO MỞ BÁT NẶN TAY */
    function initPlateDrag(side, total) {
      const cover = document.getElementById('plate-cover');
      let curX = 0, curY = 0;

      const onStart = (e) => {
        isDraggingCover = true;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        coverStartX = clientX - curX;
        coverStartY = clientY - curY;
      };

      const onMove = (e) => {
        if (!isDraggingCover) return;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        curX = clientX - coverStartX;
        curY = clientY - coverStartY;
        cover.style.transform = `translate(${curX}px, ${curY}px)`;

        const dist = Math.sqrt(curX * curX + curY * curY);
        if (dist > 85) {
          isDraggingCover = false;
          cover.style.display = 'none';
          document.getElementById('dim-overlay').classList.remove('active');
          finishRoundDisplay(side, total);
        }
      };

      const onEnd = () => { isDraggingCover = false; };

      cover.onmousedown = onStart;
      window.onmousemove = onMove;
      window.onmouseup = onEnd;

      cover.ontouchstart = onStart;
      window.ontouchmove = onMove;
      window.ontouchend = onEnd;
    }

    function finishRoundDisplay(side, total) {
      document.getElementById('title-' + side).classList.add('highlight-pulse');

      const userBet = confirmedBets[side];
      if (userBet > 0) {
        const winAmt = userBet * 1.98;
        balance += winAmt;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        const winOverlay = document.getElementById('win-overlay');
        winOverlay.innerText = '+' + Math.floor(winAmt).toLocaleString();
        winOverlay.style.display = 'block';
      }

      setTimeout(() => { startTimer(); }, 5000);
    }

    /* BẢNG SOI CẦU NÂU XÁM VIP 5 HÀNG NGANG CỘT DỌC */
    function openChartModal() {
      renderGridCau();
      document.getElementById('chart-modal').classList.add('active');
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function renderGridCau() {
      const container = document.getElementById('grid-cau');
      container.innerHTML = '';

      let columns = [];
      let currentCol = [];
      let currentSide = null;

      historyResults.forEach(res => {
        if (!currentSide) {
          currentSide = res.side;
          currentCol.push(res);
        } else if (res.side === currentSide && currentCol.length < 5) {
          currentCol.push(res);
        } else {
          columns.push(currentCol);
          currentCol = [res];
          currentSide = res.side;
        }
      });
      if (currentCol.length > 0) columns.push(currentCol);

      columns.forEach(col => {
        for (let row = 0; row < 5; row++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';

          if (col[row]) {
            const dot = document.createElement('div');
            dot.className = 'dot-result ' + (col[row].side === 'TAI' ? 'tai' : 'xiu');
            dot.innerText = col[row].total;
            cell.appendChild(dot);
          }
          container.appendChild(cell);
        }
      });

      setTimeout(() => {
        const scrollArea = document.getElementById('chart-scroll-area');
        scrollArea.scrollLeft = scrollArea.scrollWidth;
      }, 50);
    }
  </script>
</body>
