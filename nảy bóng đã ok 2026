<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHROMA JUMP 3D - NINJA SHOCK VIP EDITION</title>
    <style>
        :root {
            --rank-color: #b45309;
            --gold: #eab308;
            --vip-border: rgba(234, 179, 8, 0.4);
        }
        * { box-sizing: border-box; }
        body { 
            margin: 0; 
            background: #05070f; 
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; 
            overflow: hidden; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            color: #e2e8f0; 
            user-select: none;
            -webkit-user-select: none;
        }
        
        #game-wrap { 
            position: relative; 
            box-shadow: 0 10px 40px rgba(0,0,0,0.8); 
            border-radius: 24px; 
            overflow: hidden; 
            border: 1.5px solid rgba(255, 255, 255, 0.1); 
            background: #090d16; 
            width: 400px; 
            height: 700px;
            will-change: transform;
            transform: translateZ(0);
        }
        
        canvas { display: block; width: 100%; height: 100%; }
        #ui { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }

        .logo-text {
            font-size: 34px; font-weight: 900; letter-spacing: 3px; margin-bottom: 2px;
            background: linear-gradient(180deg, #ffffff 0%, var(--gold) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        #current-rank-display {
            position: absolute; top: 18px; left: 18px; font-weight: 800; font-size: 11px;
            letter-spacing: 1px; text-transform: uppercase; padding: 6px 14px 6px 38px;
            background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); border-radius: 20px; 
            border: 1px solid var(--rank-color); color: #fff;
            display: flex; align-items: center;
        }

        .rank-badge-icon {
            position: absolute; left: 6px; width: 24px; height: 24px;
        }

        .score-box { 
            position: absolute; top: 16px; right: 20px; text-align: right; 
            font-size: 30px; font-weight: 900; color: #ffffff; 
            z-index: 10;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
            font-family: 'Arial Black', sans-serif;
        }

        .lives-container {
            position: absolute; top: 56px; left: 20px;
            display: flex; gap: 6px; z-index: 10;
        }
        .life-icon {
            width: 14px; height: 14px; background: #ef4444;
            clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 50% 75%, 18% 100%, 0% 38%);
            transition: all 0.3s ease;
        }
        .life-icon.lost {
            background: #334155;
            opacity: 0.3;
            transform: scale(0.75);
        }

        .essence-wrapper {
            position: absolute; top: 56px; right: 20px;
            width: 110px; height: 7px; background: rgba(15, 23, 42, 0.8); border-radius: 10px;
            overflow: hidden; border: 1px solid rgba(255,255,255,0.15);
        }
        #essence-fill { 
            width: 0%; height: 100%; background: linear-gradient(90deg, var(--rank-color), var(--gold)); 
            border-radius: 10px; transition: width 0.15s linear;
        }

        .screen { 
            position: absolute; width: 100%; height: 100%; 
            background: rgba(9, 13, 22, 0.94); backdrop-filter: blur(12px); 
            display: flex; flex-direction: column; justify-content: center; 
            align-items: center; pointer-events: all; z-index: 20; text-align: center; 
        }
        
        .list-container { 
            width: 88%; background: rgba(255,255,255,0.03); border-radius: 16px; 
            padding: 8px; margin: 15px 0; max-height: 380px; overflow-y: auto;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .list-container::-webkit-scrollbar { width: 4px; }
        .list-container::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 4px; }

        .entry { display: flex; justify-content: space-between; align-items: center; padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 13px; }
        .entry-rank { font-size: 11px; opacity: 0.9; text-transform: uppercase; display: block; margin-top: 2px; font-weight: 800;}

        button { 
            padding: 13px 26px; border: 1px solid var(--gold); 
            background: rgba(234, 179, 8, 0.1); 
            color: #fff; cursor: pointer; letter-spacing: 2px; text-transform: uppercase; 
            font-weight: 800; border-radius: 12px; transition: all 0.2s ease; margin: 6px; width: 220px;
        }
        button:hover { 
            background: var(--gold); color: #020617; transform: translateY(-2px); 
        }
        button:active { transform: translateY(1px); }
        .btn-small { font-size: 11px; border-color: rgba(255,255,255,0.2); width: 180px; background: rgba(255,255,255,0.03); }

        .rank-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; font-size: 13px; font-weight: 800; border-bottom: 1px solid rgba(255,255,255,0.05); border-radius: 8px; margin-bottom: 4px; background: rgba(255,255,255,0.02); }
        .rank-badge-preview { width: 30px; height: 30px; margin-right: 10px; }
        .rank-info { display: flex; align-items: center; }
    </style>
</head>
<body>

<div id="game-wrap">
    <canvas id="c"></canvas>
    <div id="ui">
        <div id="current-rank-display">
            <svg class="rank-badge-icon" id="rank-icon-svg" viewBox="0 0 100 100"></svg>
            <span id="rank-text-val">ĐỒNG</span>
        </div>
        <div class="lives-container" id="lives-box">
            <div class="life-icon"></div>
            <div class="life-icon"></div>
            <div class="life-icon"></div>
            <div class="life-icon"></div>
        </div>
        <div class="score-box" id="sb">0</div>
        <div class="essence-wrapper"><div id="essence-fill"></div></div>
        
        <!-- MENU CHÍNH -->
        <div id="menu" class="screen">
            <div class="logo-text">CHROMA 3D</div>
            <p style="font-size: 11px; letter-spacing: 2px; color: #eab308; margin-top: 0px; margin-bottom: 25px; font-weight: 700;">NINJA SHOCK VIP EDITION</p>
            <button onclick="startGame()">BẮT ĐẦU LEO RANK</button>
            <button class="btn-small" onclick="showLeaderboard()">TOP CAO THỦ</button>
            <button class="btn-small" onclick="showRankList()">DANH SÁCH BẬC HẠNG</button>
        </div>

        <!-- DANH SÁCH HẠNG -->
        <div id="rank-list-screen" class="screen" style="display:none;">
            <h3 style="letter-spacing: 2px; color: var(--gold); margin-bottom: 5px;">HỆ THỐNG BẬC HẠNG</h3>
            <div class="list-container" id="rank-wiki-list"></div>
            <button onclick="closeScreens()">QUAY LẠI</button>
        </div>

        <!-- BẢNG XẾP HẠNG -->
        <div id="leaderboard-screen" class="screen" style="display:none;">
            <h3 style="letter-spacing: 2px; color: var(--gold); margin-bottom: 5px;">BẢNG VÀNG CAO THỦ</h3>
            <div class="list-container" id="lb-list"></div>
            <button onclick="closeScreens()">QUAY LẠI</button>
        </div>

        <!-- GAME OVER PANEL -->
        <div id="game-over" class="screen" style="display:none;">
            <div style="font-size: 11px; letter-spacing: 3px; opacity: 0.7; color: #f8fafc;">TỔNG ĐIỂM LEO RANK</div>
            <div style="font-size: 48px; font-weight: 900; color: var(--gold);" id="fs">0</div>
            <div id="rank-badge-over-wrap" style="margin: 10px 0;">
                <svg id="rank-svg-over" style="width:80px; height:80px;" viewBox="0 0 100 100"></svg>
            </div>
            <div id="rank-name-over" style="font-size: 20px; font-weight: 900; margin-bottom: 20px; letter-spacing: 1px;">RANK: ---</div>
            <button onclick="startGame()">CHƠI LẠI NGAY</button>
            <button class="btn-small" onclick="backToMenu()">MENU CHÍNH</button>
        </div>
    </div>
</div>

<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d', { alpha: false, desynchronized: true });
canvas.width = 400; canvas.height = 700;

let gameActive = false, gameOverSequence = false;
let score = 0, displayScore = 0, essence = 0;
let lives = 4;
let invulnerableTimer = 0; // Thời gian khiên lá chắn (tính bằng ms)
let daggerSpawnTimer = 0;
let meteorSpawnTimer = 0;
let deathAnimTimer = 0;

let platforms = [], particles = [], spaceParticles = [], trail = [], collectables = [], shields = [];
let daggers = [], meteors = [], shards = []; 
let floatingTexts = [], pulseWaves = [];
let highScores = JSON.parse(localStorage.getItem('chroma_v8_vip_scores')) || [];
let lastTime = performance.now();
let currentRankIdx = 0;

const RANK_SVGS = {
    dong: `<path d="M50 5 L82 20 L82 58 L50 95 L18 58 L18 20 Z" fill="url(#grad-dong)" stroke="#a3a3a3" stroke-width="2"/><polygon points="50,28 60,45 50,62 40,45" fill="url(#grad-dong-inner)"/>`,
    bac: `<path d="M50 5 L88 18 L80 62 L50 95 L20 62 L12 18 Z" fill="url(#grad-bac)" stroke="#ffffff" stroke-width="2"/><polygon points="50,30 63,48 50,66 37,48" fill="#38bdf8" stroke="#ffffff" stroke-width="1.5"/>`,
    vang: `<path d="M22 15 C35 5, 65 5, 78 15 L86 55 L50 96 L14 55 Z" fill="url(#grad-vang)" stroke="#fef08a" stroke-width="2"/><path d="M43 28 H57 V42 H72 V56 H57 V75 H43 V56 H28 V42 H43 Z" fill="url(#grad-vang-cross)" stroke="#ffffff" stroke-width="1.5"/>`,
    bachkim: `<path d="M50 8 L85 22 L78 68 L50 96 L22 68 L15 22 Z" fill="url(#grad-bachkim)" stroke="#a5f3fc" stroke-width="2"/><polygon points="50,26 62,48 50,70 38,48" fill="url(#grad-bk-gem)" stroke="#ffffff" stroke-width="1.5"/>`,
    kimcuong: `<path d="M50 4 L88 20 L82 72 L50 98 L18 72 L12 20 Z" fill="url(#grad-kimcuong)" stroke="#f0abfc" stroke-width="2"/><polygon points="50,22 68,46 50,75 32,46" fill="url(#grad-kc-gem)" stroke="#ffffff" stroke-width="2"/>`,
    caothu: `<path d="M50 6 L88 22 L80 75 L50 98 L20 75 L12 22 Z" fill="url(#grad-caothu-bg)" stroke="#f97316" stroke-width="2"/><circle cx="50" cy="36" r="8" fill="#a855f7" stroke="#fff" stroke-width="1.5"/>`,
    thachdau: `<circle cx="50" cy="50" r="45" fill="url(#grad-td-glow)" opacity="0.8"/><path d="M50 2 L92 18 L84 80 L50 100 L16 80 L8 18 Z" fill="url(#grad-thachdau-bg)" stroke="#fef08a" stroke-width="2.5"/><polygon points="50,30 58,40 50,50 42,40" fill="#e0e7ff" stroke="#a855f7" stroke-width="1.5"/>`
};

const SVG_DEFINITIONS = `
<defs>
    <linearGradient id="grad-dong" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#78350f"/><stop offset="100%" stop-color="#27272a"/></linearGradient>
    <linearGradient id="grad-dong-inner" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#f59e0b"/><stop offset="100%" stop-color="#b45309"/></linearGradient>
    <linearGradient id="grad-bac" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#f1f5f9"/><stop offset="100%" stop-color="#475569"/></linearGradient>
    <linearGradient id="grad-vang" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#fde047"/><stop offset="100%" stop-color="#854d0e"/></linearGradient>
    <linearGradient id="grad-vang-cross" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#facc15"/><stop offset="100%" stop-color="#ca8a04"/></linearGradient>
    <linearGradient id="grad-bachkim" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#e0f2fe"/><stop offset="100%" stop-color="#0369a1"/></linearGradient>
    <linearGradient id="grad-bk-gem" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#0284c7"/></linearGradient>
    <linearGradient id="grad-kimcuong" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#f5d0fe"/><stop offset="100%" stop-color="#6b21a8"/></linearGradient>
    <linearGradient id="grad-kc-gem" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#e9d5ff"/><stop offset="100%" stop-color="#a855f7"/></linearGradient>
    <linearGradient id="grad-caothu-bg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#ffedd5"/><stop offset="100%" stop-color="#9a3412"/></linearGradient>
    <radialGradient id="grad-td-glow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#f43f5e" stop-opacity="0.4"/><stop offset="100%" stop-color="#f43f5e" stop-opacity="0"/></radialGradient>
    <linearGradient id="grad-thachdau-bg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#fff1f2"/><stop offset="100%" stop-color="#881337"/></linearGradient>
</defs>
`;

const RANKS = [
    { name: "Đồng I", min: 0, color: '#d97706', svgKey: 'dong', maxDaggers: 1, daggerSpeed: 3.5 },
    { name: "Bạc I", min: 500, color: '#94a3b8', svgKey: 'bac', maxDaggers: 2, daggerSpeed: 4.5 },
    { name: "Vàng I", min: 1200, color: '#eab308', svgKey: 'vang', maxDaggers: 3, daggerSpeed: 5.5 },
    { name: "Bạch Kim I", min: 2500, color: '#06b6d4', svgKey: 'bachkim', maxDaggers: 4, daggerSpeed: 6.5 },
    { name: "Kim Cương I", min: 4500, color: '#a855f7', svgKey: 'kimcuong', maxDaggers: 5, daggerSpeed: 7.2 },
    { name: "Cao Thủ", min: 7500, color: '#f97316', svgKey: 'caothu', maxDaggers: 6, daggerSpeed: 8.0 },
    { name: "Thách Đấu", min: 11000, color: '#f43f5e', svgKey: 'thachdau', maxDaggers: 7, daggerSpeed: 9.0 }
];

const player = { 
    x: 200, y: 450, r: 13, vy: 0, g: 0.38, jump: -11.8, 
    left: false, right: false, scaleX: 1, scaleY: 1
};

function initSpaceParticles() {
    spaceParticles = [];
    for (let i = 0; i < 60; i++) {
        const depth = Math.random();
        spaceParticles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            z: depth * 2 + 0.2,
            size: depth * 2 + 0.5,
            speedY: (depth * 0.4 + 0.1),
            alpha: depth * 0.4 + 0.1,
            color: Math.random() > 0.5 ? `#eab308` : `#38bdf8`
        });
    }
}
initSpaceParticles();

function getRank(p) { 
    for (let i = RANKS.length - 1; i >= 0; i--) {
        if (p >= RANKS[i].min) return RANKS[i];
    }
    return RANKS[0];
}

function getRankIndex(p) {
    for (let i = RANKS.length - 1; i >= 0; i--) {
        if (p >= RANKS[i].min) return i;
    }
    return 0;
}

function updateUIMode() {
    const rankIdx = getRankIndex(score);
    const rank = RANKS[rankIdx];

    if (gameActive && rankIdx > currentRankIdx) {
        spawnFloatingText(player.x, player.y - 40, "THĂNG HẠNG!", "#ef4444");
        spawnPulseWave(player.x, player.y, rank.color);
    }
    currentRankIdx = rankIdx;

    document.documentElement.style.setProperty('--rank-color', rank.color);
    document.getElementById('rank-text-val').innerText = rank.name;
    document.getElementById('current-rank-display').style.borderColor = rank.color;

    document.getElementById('rank-icon-svg').innerHTML = SVG_DEFINITIONS + (RANK_SVGS[rank.svgKey] || '');
    
    const icons = document.querySelectorAll('.life-icon');
    icons.forEach((icon, idx) => {
        if (idx < lives) icon.classList.remove('lost');
        else icon.classList.add('lost');
    });
}

function spawnDagger() {
    const rankInfo = getRank(score);
    if (daggers.length >= rankInfo.maxDaggers) return;

    const fromBottom = Math.random() > 0.5;
    const speed = rankInfo.daggerSpeed;

    daggers.push({
        x: Math.random() * (canvas.width - 60) + 30,
        y: fromBottom ? canvas.height + 50 : -50,
        vy: fromBottom ? -(Math.random() * 2 + speed) : (Math.random() * 2 + speed),
        vx: (Math.random() - 0.5) * 2,
        rot: Math.random() * Math.PI * 2,
        vRot: (Math.random() > 0.5 ? 1 : -1) * (0.15 + Math.random() * 0.2),
        trail: []
    });
}

function spawnMeteor() {
    meteors.push({
        x: Math.random() * (canvas.width - 80) + 40,
        y: -60,
        vx: (Math.random() - 0.5) * 1.5,
        vy: Math.random() * 3 + 6,
        r: 15,
        trail: []
    });
}

function createExplosion(x, y, color, count = 12) {
    for(let i = 0; i < count; i++) {
        const ang = Math.random() * Math.PI * 2;
        const spd = Math.random() * 5 + 1;
        particles.push({
            x, y, 
            vx: Math.cos(ang) * spd, 
            vy: Math.sin(ang) * spd, 
            life: 1, 
            color: color,
            size: Math.random() * 2.5 + 1
        });
    }
}

function createPlatformBreak(p) {
    const cols = 4, rows = 2;
    const sw = p.w / cols, sh = p.h / rows;
    for(let i = 0; i < cols; i++) {
        for(let j = 0; j < rows; j++) {
            shards.push({
                x: p.x + i * sw,
                y: p.y + j * sh,
                w: sw, h: sh,
                vx: (Math.random() - 0.5) * 6,
                vy: (Math.random() - 0.5) * 6 - 2,
                rot: 0, vRot: (Math.random() - 0.5) * 0.3,
                life: 1, color: getRank(score).color
            });
        }
    }
    spawnPulseWave(p.x + p.w/2, p.y + p.h/2, "#ef4444");
}

function spawnFloatingText(x, y, text, color) {
    floatingTexts.push({ x, y, text, color, alpha: 1, vy: -1.5 });
}

function spawnPulseWave(x, y, color) {
    pulseWaves.push({ x, y, r: 5, maxR: 40, color, alpha: 1 });
}

function spawnPlatform(y) {
    const w = 75 + Math.random() * 35;
    const x = Math.random() * (canvas.width - w);
    const isMoving = Math.random() > 0.4;
    const speed = isMoving ? (Math.random() > 0.5 ? 1 : -1) * (1.0 + Math.random() * 1.2) : 0;
    
    platforms.push({ 
        x, y, w, h: 14, speed, bounce: 0,
        hits: 0, maxHits: 3,
        scale: 1
    });
    
    const rand = Math.random();
    if(rand > 0.88) {
        // Xuất hiện vật phẩm khiên 7 giây (Lâu lâu xuất hiện)
        shields.push({ x: x + w/2, y: y - 22, collected: false });
    } else if(rand > 0.60) {
        collectables.push({ x: x + w/2, y: y - 22, collected: false });
    }
}

function startGame() {
    document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
    score = 0; displayScore = 0; essence = 0; lives = 4; invulnerableTimer = 0;
    currentRankIdx = 0; daggerSpawnTimer = 0; meteorSpawnTimer = 0; deathAnimTimer = 0;
    gameOverSequence = false;

    player.x = 200; player.y = 450; player.vy = 0; player.scaleX = 1; player.scaleY = 1;
    platforms = []; trail = []; collectables = []; shields = []; particles = []; floatingTexts = []; pulseWaves = []; 
    daggers = []; meteors = []; shards = [];

    document.getElementById('essence-fill').style.width = '0%';
    document.getElementById('sb').innerText = "0";
    
    platforms.push({ x: 140, y: 550, w: 120, h: 14, speed: 0, bounce: 0, hits: 0, maxHits: 3, scale: 1 });
    for(let i = 0; i < 8; i++) spawnPlatform(i * 85);
    
    gameActive = true;
    updateUIMode();
}

function triggerRespawn() {
    lives--;
    updateUIMode();
    if (lives <= 0) {
        startGameOverSequence();
    } else {
        // Nhận khiên lá chắn 7 giây thực tế chống chết/mất mạng khi hồi sinh
        invulnerableTimer = 7000; 
        player.vy = player.jump * 1.1;
        player.y = Math.min(player.y, canvas.height - 150);
        createExplosion(player.x, player.y, '#38bdf8', 25);
        spawnPulseWave(player.x, player.y, '#38bdf8');
        spawnFloatingText(player.x, player.y - 40, "LÁ CHẮN 7S!", "#38bdf8");
    }
}

function startGameOverSequence() {
    gameActive = false;
    gameOverSequence = true;
    deathAnimTimer = 1000; 
    createExplosion(player.x, player.y, '#ef4444', 30);
    spawnPulseWave(player.x, player.y, '#eab308');
}

function finalizeGameOver() {
    gameOverSequence = false;
    const rank = getRank(score);
    document.getElementById('fs').innerText = score;
    document.getElementById('rank-name-over').innerText = "RANK: " + rank.name;
    document.getElementById('rank-name-over').style.color = rank.color;
    document.getElementById('rank-svg-over').innerHTML = SVG_DEFINITIONS + (RANK_SVGS[rank.svgKey] || '');
    
    highScores.push({ score: score, rank: rank.name, date: new Date().toLocaleDateString('vi-VN') });
    highScores.sort((a,b) => b.score - a.score);
    highScores = highScores.slice(0, 10);
    localStorage.setItem('chroma_v8_vip_scores', JSON.stringify(highScores));
    
    document.getElementById('game-over').style.display = 'flex';
}

function closeScreens() {
    document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
    document.getElementById('menu').style.display = 'flex';
}

function showLeaderboard() {
    document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
    const lbList = document.getElementById('lb-list');
    lbList.innerHTML = highScores.length === 0 ? `<div style="padding:20px;opacity:0.6;">Chưa có dữ liệu</div>` :
        highScores.map((item, idx) => `
            <div class="entry">
                <div>
                    <strong>#${idx + 1} - ${item.score} PTS</strong>
                    <span class="entry-rank" style="color:${getRank(item.score).color}">${item.rank}</span>
                </div>
                <div style="opacity:0.5;font-size:11px;">${item.date}</div>
            </div>
        `).join('');
    document.getElementById('leaderboard-screen').style.display = 'flex';
}

function showRankList() {
    document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
    const wikiList = document.getElementById('rank-wiki-list');
    wikiList.innerHTML = RANKS.map(r => `
        <div class="rank-item" style="color:${r.color}; border-left: 3px solid ${r.color}">
            <div class="rank-info">
                <svg class="rank-badge-preview" viewBox="0 0 100 100">${SVG_DEFINITIONS + RANK_SVGS[r.svgKey]}</svg>
                <span>${r.name}</span>
            </div>
            <span>>= ${r.min} PTS</span>
        </div>
    `).join('');
    document.getElementById('rank-list-screen').style.display = 'flex';
}

function backToMenu() {
    closeScreens();
}

window.addEventListener('keydown', e => {
    if(e.code === 'ArrowLeft' || e.code === 'KeyA') player.left = true;
    if(e.code === 'ArrowRight' || e.code === 'KeyD') player.right = true;
});
window.addEventListener('keyup', e => {
    if(e.code === 'ArrowLeft' || e.code === 'KeyA') player.left = false;
    if(e.code === 'ArrowRight' || e.code === 'KeyD') player.right = false;
});

canvas.addEventListener('touchstart', e => {
    const touchX = e.touches[0].clientX;
    const rect = canvas.getBoundingClientRect();
    if (touchX - rect.left < canvas.width / 2) player.left = true;
    else player.right = true;
}, {passive: true});
canvas.addEventListener('touchend', () => { player.left = false; player.right = false; }, {passive: true});

// CẬP NHẬT LOGIC CHỐNG KHỰNG HÌNH GIẬT LAG
function updateLogic(dtMs) {
    const dt = dtMs / 16.666; // Chuẩn hóa Delta Time theo 60FPS

    spaceParticles.forEach(sp => {
        sp.y += sp.speedY * sp.z * dt;
        if(sp.y > canvas.height) {
            sp.y = -10;
            sp.x = Math.random() * canvas.width;
        }
    });

    if (gameOverSequence) {
        deathAnimTimer -= dtMs;
        if (deathAnimTimer <= 0) finalizeGameOver();
        return;
    }

    if(!gameActive) return;

    if (invulnerableTimer > 0) invulnerableTimer -= dtMs;

    daggerSpawnTimer += dtMs;
    if (daggerSpawnTimer > 1200) {
        daggerSpawnTimer = 0;
        spawnDagger();
    }

    meteorSpawnTimer += dtMs;
    if (meteorSpawnTimer > 7000) {
        meteorSpawnTimer = 0;
        spawnMeteor();
        spawnFloatingText(canvas.width/2 - 50, 80, "CẢNH BÁO: TÊN LỬA!", "#f43f5e");
    }

    const slowAutoScroll = 0.2 * dt;
    platforms.forEach(p => p.y += slowAutoScroll);
    collectables.forEach(c => c.y += slowAutoScroll);
    shields.forEach(s => s.y += slowAutoScroll);

    if (displayScore < score) {
        displayScore += Math.ceil((score - displayScore) * 0.2 * dt);
        if (displayScore > score) displayScore = score;
        document.getElementById('sb').innerText = displayScore;
    }

    player.scaleX += (1 - player.scaleX) * 0.15 * dt;
    player.scaleY += (1 - player.scaleY) * 0.15 * dt;

    player.vy += player.g * dt;
    player.y += player.vy * dt;

    if(player.left) player.x -= 6.5 * dt;
    if(player.right) player.x += 6.5 * dt;
    
    if(player.x < 0) player.x = canvas.width;
    if(player.x > canvas.width) player.x = 0;

    trail.unshift({ x: player.x, y: player.y, r: player.r * player.scaleX });
    if(trail.length > 12) trail.pop();

    // VA CHẠM THANH ĐỠ
    if(player.vy > 0) {
        platforms.forEach((p, idx) => {
            if(player.x + player.r * 0.5 > p.x && 
               player.x - player.r * 0.5 < p.x + p.w && 
               player.y + player.r >= p.y && 
               player.y - player.r < p.y + p.h) {
                
                player.y = p.y - player.r;
                player.vy = player.jump;
                player.scaleX = 1.3; 
                player.scaleY = 0.7;
                p.bounce = 4;
                p.hits++;

                if(p.hits >= p.maxHits) {
                    createPlatformBreak(p);
                    platforms.splice(idx, 1);
                    spawnPlatform(-20);
                } else {
                    createExplosion(player.x, p.y, getRank(score).color, 8);
                }
            }
        });
    }

    // VA CHẠM METEOR TÊN LỬA
    meteors.forEach((m, mIdx) => {
        m.x += m.vx * dt;
        m.y += m.vy * dt;

        m.trail.unshift({ x: m.x, y: m.y });
        if(m.trail.length > 14) m.trail.pop();

        if(Math.hypot(player.x - m.x, player.y - m.y) < player.r + m.r) {
            score += 500;
            essence = 100;
            createExplosion(m.x, m.y, '#eab308', 25);
            spawnPulseWave(m.x, m.y, '#eab308');
            spawnFloatingText(m.x, m.y, "+500 SIÊU TÊN LỬA!", "#eab308");
            meteors.splice(mIdx, 1);
            updateUIMode();
        }

        if(m.y > canvas.height + 60) meteors.splice(mIdx, 1);
    });

    // VA CHẠM PHI TIÊU
    daggers.forEach((d, dIdx) => {
        d.x += d.vx * dt;
        d.y += d.vy * dt;
        d.rot += d.vRot * dt;

        d.trail.unshift({ x: d.x, y: d.y });
        if(d.trail.length > 12) d.trail.pop();

        if (invulnerableTimer <= 0 && Math.hypot(player.x - d.x, player.y - d.y) < player.r + 12) {
            createExplosion(d.x, d.y, '#ef4444', 20);
            daggers.splice(dIdx, 1);
            triggerRespawn();
        }

        if(d.y < -80 || d.y > canvas.height + 80) daggers.splice(dIdx, 1);
    });

    // MẢNH VỠ
    shards.forEach((s, sIdx) => {
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        s.rot += s.vRot * dt;
        s.life -= 0.025 * dt;
        if(s.life <= 0) shards.splice(sIdx, 1);
    });

    // NHẶT NĂNG LƯỢNG
    collectables.forEach(c => {
        if(!c.collected && Math.hypot(player.x - c.x, player.y - c.y) < 22) {
            c.collected = true; 
            score += 50; 
            essence += 25;

            spawnFloatingText(c.x, c.y - 10, "+50", "#eab308");
            spawnPulseWave(c.x, c.y, "#eab308");
            createExplosion(c.x, c.y, "#eab308", 10);

            if(essence >= 100) { 
                essence = 0; 
                score += 200; 
                spawnFloatingText(player.x, player.y - 25, "COMBO MEGA! +200", "#38bdf8");
                spawnPulseWave(player.x, player.y, "#38bdf8");
                createExplosion(player.x, player.y, '#ffffff', 20); 
            }
            document.getElementById('essence-fill').style.width = essence + '%';
            updateUIMode();
        }
    });

    // NHẶT LÁ CHẮN BẢO VỆ 7 GIÂY
    shields.forEach(s => {
        if(!s.collected && Math.hypot(player.x - s.x, player.y - s.y) < 22) {
            s.collected = true;
            invulnerableTimer = 7000; // 7 giây bảo vệ thực tế
            spawnFloatingText(player.x, player.y - 30, "LÁ CHẮN 7S!", "#38bdf8");
            spawnPulseWave(player.x, player.y, "#38bdf8");
            createExplosion(s.x, s.y, "#38bdf8", 15);
        }
    });

    platforms.forEach((p, index) => {
        if (p.bounce > 0) p.bounce -= 0.4 * dt;
        else p.bounce = 0;

        if (p.speed !== 0) {
            p.x += p.speed * dt;
            if (p.x <= 0 || p.x + p.w >= canvas.width) p.speed *= -1;
        }
        if(p.y > canvas.height + 20) { 
            platforms.splice(index, 1); 
            spawnPlatform(-20); 
        }
    });

    collectables.forEach((c, index) => {
        if (c.y > canvas.height + 20) collectables.splice(index, 1);
    });

    shields.forEach((s, index) => {
        if (s.y > canvas.height + 20) shields.splice(index, 1);
    });

    // ĐỘ CAO VÀ TÍNH ĐIỂM
    const triggerHeight = 280;
    if(player.y < triggerHeight) {
        let diff = triggerHeight - player.y;
        player.y = triggerHeight;
        score += Math.round(diff * 0.15); 
        updateUIMode();
        
        platforms.forEach(p => p.y += diff);
        collectables.forEach(c => c.y += diff);
        shields.forEach(s => s.y += diff);
        particles.forEach(p => p.y += diff);
        trail.forEach(t => t.y += diff);
        daggers.forEach(d => d.y += diff);
        meteors.forEach(m => m.y += diff);
    }

    if(player.y > canvas.height + 40) {
        triggerRespawn();
    }

    particles.forEach((p, idx) => {
        p.x += p.vx * dt; p.y += p.vy * dt;
        p.life -= 0.03 * dt;
        if(p.life <= 0) particles.splice(idx, 1);
    });

    floatingTexts.forEach((ft, idx) => {
        ft.y += ft.vy * dt;
        ft.alpha -= 0.02 * dt;
        if(ft.alpha <= 0) floatingTexts.splice(idx, 1);
    });

    pulseWaves.forEach((pw, idx) => {
        pw.r += 2.0 * dt;
        pw.alpha -= 0.035 * dt;
        if(pw.alpha <= 0) pulseWaves.splice(idx, 1);
    });
}

// VẼ PHI TIÊU NINJA SHOCK 4 CÁNH SẮC BẮC
function drawShuriken(x, y, size, rot, color) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(rot);
    
    ctx.fillStyle = color || "#cbd5e1";
    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 1;

    ctx.beginPath();
    for (let i = 0; i < 4; i++) {
        ctx.rotate(Math.PI / 2);
        ctx.lineTo(0, -size);
        ctx.lineTo(size * 0.25, -size * 0.25);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = "#0f172a";
    ctx.beginPath();
    ctx.arc(0, 0, size * 0.2, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
}

// VẼ LÁ CHẮN BẢO VỆ (SHIELD ITEM)
function drawShieldItem(x, y) {
    ctx.save();
    ctx.translate(x, y);
    ctx.fillStyle = "#38bdf8";
    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 1.5;
    
    ctx.beginPath();
    ctx.moveTo(0, -10);
    ctx.lineTo(8, -5);
    ctx.lineTo(6, 6);
    ctx.lineTo(0, 10);
    ctx.lineTo(-6, 6);
    ctx.lineTo(-8, -5);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    ctx.restore();
}

function draw() {
    ctx.fillStyle = "#090d16";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Hạt nền vũ trụ dịu mắt
    spaceParticles.forEach(sp => {
        ctx.fillStyle = sp.color;
        ctx.globalAlpha = sp.alpha;
        ctx.beginPath();
        ctx.arc(sp.x, sp.y, sp.size, 0, Math.PI * 2);
        ctx.fill();
    });
    ctx.globalAlpha = 1;

    // Vệt di chuyển nhân vật
    trail.forEach((t, idx) => {
        const a = (1 - idx / trail.length) * 0.35;
        ctx.fillStyle = getRank(score).color;
        ctx.globalAlpha = a;
        ctx.beginPath();
        ctx.arc(t.x, t.y, t.r * (1 - idx / trail.length * 0.5), 0, Math.PI * 2);
        ctx.fill();
    });
    ctx.globalAlpha = 1;

    // Mảnh vỡ thanh đỡ
    shards.forEach(s => {
        ctx.save();
        ctx.translate(s.x + s.w/2, s.y + s.h/2);
        ctx.rotate(s.rot);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = Math.max(0, s.life);
        ctx.fillRect(-s.w/2, -s.h/2, s.w, s.h);
        ctx.restore();
    });
    ctx.globalAlpha = 1;

    // Các thanh đỡ 3D
    platforms.forEach(p => {
        const rankColor = getRank(score).color;
        
        ctx.fillStyle = "rgba(0, 0, 0, 0.4)";
        ctx.fillRect(p.x + 3, p.y + 3 + p.bounce, p.w, p.h);

        const grad = ctx.createLinearGradient(p.x, p.y, p.x, p.y + p.h);
        grad.addColorStop(0, rankColor);
        grad.addColorStop(1, '#0f172a');

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.roundRect(p.x, p.y + p.bounce, p.w, p.h, 6);
        ctx.fill();

        ctx.strokeStyle = p.hits > 0 ? '#ef4444' : 'rgba(255,255,255,0.3)';
        ctx.lineWidth = 1.5;
        ctx.stroke();

        if (p.hits > 0) {
            ctx.strokeStyle = '#ef4444';
            ctx.beginPath();
            ctx.moveTo(p.x + p.w * 0.3, p.y + p.bounce);
            ctx.lineTo(p.x + p.w * 0.5, p.y + p.bounce + p.h);
            ctx.stroke();
        }
    });

    // Vật phẩm Điểm & Lá chắn
    collectables.forEach(c => {
        if(!c.collected) {
            ctx.fillStyle = "#eab308";
            ctx.beginPath();
            ctx.arc(c.x, c.y, 7, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 1;
            ctx.stroke();
        }
    });

    shields.forEach(s => {
        if(!s.collected) {
            drawShieldItem(s.x, s.y);
        }
    });

    // Tên lửa Meteor
    meteors.forEach(m => {
        m.trail.forEach((t, idx) => {
            ctx.fillStyle = '#f43f5e';
            ctx.globalAlpha = (1 - idx / m.trail.length) * 0.4;
            ctx.beginPath();
            ctx.arc(t.x, t.y, m.r * (1 - idx / m.trail.length), 0, Math.PI * 2);
            ctx.fill();
        });
        ctx.globalAlpha = 1;

        ctx.fillStyle = '#f43f5e';
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
    });

    // Phi tiêu Ninja Shock
    daggers.forEach(d => {
        d.trail.forEach((t, idx) => {
            ctx.globalAlpha = (1 - idx / d.trail.length) * 0.25;
            drawShuriken(t.x, t.y, 10, d.rot, '#cbd5e1');
        });
        ctx.globalAlpha = 1;
        drawShuriken(d.x, d.y, 14, d.rot, '#f8fafc');
    });

    // VẼ NHÂN VẬT QUẢ BÓNG 3D (ĐÃ XÓA 2 CON MẮT HOÀN TOÀN)
    if (gameActive || gameOverSequence) {
        ctx.save();
        ctx.translate(player.x, player.y);
        ctx.scale(player.scaleX, player.scaleY);

        // Hiệu ứng vòng sáng Khiên lá chắn 7 giây xoay quanh
        if (invulnerableTimer > 0) {
            ctx.save();
            ctx.rotate((performance.now() / 200) % (Math.PI * 2));
            ctx.strokeStyle = "#38bdf8";
            ctx.lineWidth = 2.5;
            ctx.setLineDash([8, 6]);
            ctx.beginPath();
            ctx.arc(0, 0, player.r + 9, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();
        }

        // Bóng đổ dưới chân viên ngọc
        ctx.fillStyle = "rgba(0, 0, 0, 0.3)";
        ctx.beginPath();
        ctx.ellipse(0, player.r - 2, player.r * 0.8, player.r * 0.3, 0, 0, Math.PI * 2);
        ctx.fill();

        // Ngọc 3D Neon Clean (Không mắt)
        const pGrad = ctx.createRadialGradient(-player.r * 0.3, -player.r * 0.3, player.r * 0.1, 0, 0, player.r);
        pGrad.addColorStop(0, '#ffffff');
        pGrad.addColorStop(0.5, getRank(score).color);
        pGrad.addColorStop(1, '#020617');

        ctx.fillStyle = pGrad;
        ctx.beginPath();
        ctx.arc(0, 0, player.r, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = "rgba(255, 255, 255, 0.6)";
        ctx.lineWidth = 1.2;
        ctx.stroke();

        ctx.restore();
    }

    // Hiệu ứng Hạt Nổ & Sóng Xung
    particles.forEach(p => {
        ctx.fillStyle = p.color;
        ctx.globalAlpha = Math.max(0, p.life);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
    });
    ctx.globalAlpha = 1;

    pulseWaves.forEach(pw => {
        ctx.strokeStyle = pw.color;
        ctx.globalAlpha = Math.max(0, pw.alpha);
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(pw.x, pw.y, pw.r, 0, Math.PI * 2);
        ctx.stroke();
    });
    ctx.globalAlpha = 1;

    // Chữ nổi thông báo
    floatingTexts.forEach(ft => {
        ctx.fillStyle = ft.color;
        ctx.globalAlpha = Math.max(0, ft.alpha);
        ctx.font = "800 13px 'Segoe UI', sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(ft.text, ft.x, ft.y);
    });
    ctx.globalAlpha = 1;
}

// VÒNG LẶP GAME CHUẨN CHỐNG GIẬT LAG KHỰNG HÌNH (DELTA TIME TIME-STEP)
function gameLoop(time) {
    let dtMs = time - lastTime;
    if (dtMs > 100) dtMs = 100; // Khóa tối đa để tránh hiện tượng giật giật lag khi chuyển tab
    lastTime = time;

    updateLogic(dtMs);
    draw();

    requestAnimationFrame(gameLoop);
}

requestAnimationFrame(gameLoop);
</script>
