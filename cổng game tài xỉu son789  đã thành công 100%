<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Go88 Real - Tài Xỉu MD5 & Thường</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Arial', 'Segoe UI', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #000;
      color: #fff;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #fx-canvas {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 9999;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #2a0808 0%, #050000 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 36px; font-weight: 900;
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 50%, #8b4513 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      margin-bottom: 20px; text-shadow: 0 0 20px rgba(245, 166, 35, 0.5);
    }

    .loader-box {
      width: 300px; height: 14px;
      background: rgba(0,0,0,0.8);
      border: 1px solid #f5a623; border-radius: 10px;
      padding: 2px;
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff9000, #ffea00);
      border-radius: 10px; transition: width 0.05s linear;
    }

    /* 2. GAME LOBBY GO88 REAL */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: #0a0503 url('https://images.unsplash.com/photo-1518609878373-06d740f60d8b?w=1200') center/cover no-repeat;
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 6px 20px; background: rgba(15, 8, 5, 0.95);
      border-bottom: 2px solid #d4af37; z-index: 20;
    }

    .user-info { display: flex; align-items: center; gap: 10px; }
    .avatar { width: 40px; height: 40px; border-radius: 8px; border: 2px solid #ffd700; background-size: cover; }
    .balance-box {
      background: #110901; border: 1px solid #ffd700;
      border-radius: 15px; padding: 3px 12px; color: #ffeb3b;
      font-weight: bold; font-size: 14px;
    }

    .top-nav { display: flex; gap: 8px; font-weight: bold; font-size: 11px; text-transform: uppercase; }
    .top-nav span { padding: 5px 10px; border-radius: 4px; cursor: pointer; color: #aaa; }
    .top-nav span.active, .top-nav span:hover { color: #fff; background: rgba(212,175,55,0.3); border: 1px solid #ffd700; }

    .btn-nap { background: linear-gradient(180deg, #ffe000, #795548); color: #000; border: none; padding: 6px 15px; border-radius: 6px; font-weight: 900; cursor: pointer; }
    .btn-rut { background: linear-gradient(180deg, #888, #333); color: #fff; border: 1px solid #666; padding: 6px 15px; border-radius: 6px; font-weight: 900; cursor: pointer; }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 200px; height: 260px; border-radius: 15px; border: 2px solid #ffd700;
      display: flex; flex-direction: column; justify-content: space-between; padding: 10px;
      cursor: pointer; transition: transform 0.2s; position: relative;
      box-shadow: 0 0 15px rgba(0,0,0,0.8);
    }
    .game-card:hover { transform: scale(1.05); }

    .card-md5 { background: linear-gradient(180deg, #800f13 0%, #2b0204 100%); }
    .card-thuong { background: linear-gradient(180deg, #094a68 0%, #021a26 100%); }

    .card-title { font-size: 16px; font-weight: 900; text-align: center; color: #fff; text-shadow: 0 2px 4px #000; }
    .card-sub { font-size: 11px; text-align: center; color: #ffeb3b; font-weight: bold; }

    /* 3. ARENA GAME PLAY (MD5 & THƯỜNG) */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0,0,0,0.85); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 20px; background: rgba(10, 5, 2, 0.9); border-bottom: 1px solid #d4af37;
      z-index: 20;
    }

    .btn-back-lobby { background: #a71d1d; color: #fff; border: 1px solid #ff5252; padding: 5px 12px; border-radius: 15px; font-weight: bold; cursor: pointer; }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; overflow: hidden; }

    /* BÀN TÀI XỈU GO88 THỰC TẾ & KÉO SẢNH MƯỢT MÀ */
    .real-taixiu-board {
      position: absolute; width: 720px; height: 350px;
      border-radius: 180px; display: flex; justify-content: space-between; align-items: center;
      padding: 20px 35px; box-shadow: 0 0 50px rgba(0,0,0,0.9), inset 0 0 15px rgba(255,255,255,0.2);
      transition: background 0.3s, border 0.3s;
      cursor: grab;
      user-select: none;
      left: calc(50% - 360px);
      top: calc(50% - 175px);
    }
    .real-taixiu-board:active { cursor: grabbing; }

    /* THEME ĐỎ (MD5) */
    .real-taixiu-board.theme-md5 {
      background: radial-gradient(circle, #a81c24 0%, #63080e 60%, #300205 100%);
      border: 4px solid #f5b027;
    }

    /* THEME XANH (THƯỜNG) */
    .real-taixiu-board.theme-thuong {
      background: radial-gradient(circle, #0c6a8e 0%, #053b52 60%, #011b27 100%);
      border: 4px solid #00d2ff;
    }

    /* NÚT TRÒN XUNG QUANH */
    .circle-btn {
      position: absolute; width: 36px; height: 36px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 13px; font-weight: bold; cursor: pointer; box-shadow: 0 3px 6px rgba(0,0,0,0.6);
      border: 1px solid #ffd700; z-index: 15; transition: all 0.2s;
    }
    .theme-md5 .circle-btn { background: linear-gradient(180deg, #b81921, #570408); }
    .theme-thuong .circle-btn { background: linear-gradient(180deg, #097ca1, #02384a); }

    .btn-info { top: 30px; left: 110px; }
    .btn-chart { top: 90px; left: 45px; }
    .btn-help { top: 160px; left: 25px; }
    .btn-history { top: 230px; left: 45px; }

    .btn-close { top: 30px; right: 110px; background: #a71d1d !important; }
    .btn-rank { top: 90px; right: 45px; }
    .btn-chat-toggle { top: 160px; right: 25px; }
    
    /* BÀN TAY NẶN THAY THẾ LOA */
    .btn-squeeze { top: 230px; right: 45px; font-size: 16px; }
    .btn-squeeze.active-squeeze {
      border-color: #00ff66 !important;
      box-shadow: 0 0 12px #00ff66 !important;
      background: linear-gradient(180deg, #00b33c, #004d1a) !important;
    }

    /* CỬA CƯỢC TÀI / XỈU */
    .bet-side {
      width: 190px; height: 160px; display: flex; flex-direction: column;
      justify-content: center; align-items: center; position: relative;
      pointer-events: auto;
    }

    .bet-title { 
      font-size: 44px; font-weight: 900; letter-spacing: 2px; color: #fff; 
      text-shadow: 0 3px 6px rgba(0,0,0,0.8); transition: all 0.2s;
    }

    /* NHẤP NHÁY ẢO TÀI XỈU KHI THẮNG */
    .bet-title.blink-winner {
      animation: blinkWinGlow 0.4s infinite alternate;
    }

    @keyframes blinkWinGlow {
      0% { color: #fff; text-shadow: 0 0 5px #fff; transform: scale(1); }
      100% { color: #ffea00; text-shadow: 0 0 25px #ffea00, 0 0 40px #ff9000; transform: scale(1.15); }
    }

    .player-count { font-size: 11px; color: #ffeb3b; font-weight: bold; margin-bottom: 2px; display: flex; align-items: center; gap: 3px; }

    /* HIỆU ỨNG NẨY SỐ VÀNG CAM THỰC TẾ */
    .bet-amount {
      font-size: 16px; font-weight: 900; color: #fff;
      text-shadow: 0 2px 4px rgba(0,0,0,0.8); transition: transform 0.1s;
    }

    .bet-amount.bump-orange {
      animation: orangePop 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes orangePop {
      0% { transform: scale(0.7); color: #ff3600; text-shadow: 0 0 5px #ff3600; }
      50% { transform: scale(1.45); color: #ff9d00; text-shadow: 0 0 18px #ff9d00, 0 0 30px #ff3600; }
      100% { transform: scale(1); color: #ffffff; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
    }

    /* NÚT LOGIC ĐẶT CƯỢC & ALIN */
    .bet-action-group {
      display: flex; gap: 5px; margin-top: 6px; align-items: center;
    }

    .btn-real-bet-logo {
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 50%, #b86b00 100%);
      border: 1px solid #fff; border-radius: 12px; padding: 4px 12px;
      color: #000; font-size: 11px; font-weight: 900; cursor: pointer;
      box-shadow: 0 3px 8px rgba(0,0,0,0.6); display: flex; flex-direction: column;
      align-items: center; min-width: 95px; transition: transform 0.1s, border-color 0.2s;
    }
    .btn-real-bet-logo:active { transform: scale(0.92); }
    .btn-real-bet-logo.active-bet { border: 2px solid #00ff66; box-shadow: 0 0 10px #00ff66; }

    .btn-alin {
      background: linear-gradient(180deg, #ff416c, #ff4b2b);
      border: 1px solid #fff; border-radius: 12px; padding: 6px 10px;
      color: #fff; font-size: 11px; font-weight: 900; cursor: pointer;
      box-shadow: 0 3px 8px rgba(0,0,0,0.6); text-shadow: 0 1px 2px #000;
    }
    .btn-alin:active { transform: scale(0.92); }

    .user-bet-val {
      font-size: 10px; color: #a00; font-weight: 900; margin-top: 1px;
      background: rgba(255,255,255,0.9); padding: 1px 5px; border-radius: 4px;
      width: 100%; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* BÁT / ĐĨA TRUNG TÂM */
    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 210px; height: 210px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 30px rgba(0,0,0,0.8); z-index: 5;
      perspective: 800px; pointer-events: auto;
    }

    .theme-md5 .center-plate {
      background: radial-gradient(circle, #fff 0%, #f0f0f0 65%, #c2a353 70%, #fff 100%);
      border: 4px solid #fff;
    }

    .theme-thuong .center-plate {
      background: radial-gradient(circle, #05131a 0%, #020a0e 70%, #00d2ff 100%);
      border: 4px solid #00d2ff;
    }

    .timer-display {
      font-size: 65px; font-weight: 900; letter-spacing: -2px; z-index: 6;
      position: absolute; pointer-events: none;
    }
    .theme-md5 .timer-display { color: #f5a623; text-shadow: 0 0 10px rgba(245,166,35,0.8); }
    .theme-thuong .timer-display { color: #ffeb3b; text-shadow: 0 0 10px rgba(255,235,59,0.8); }

    /* NẮP / BÁT CÓ THỂ KÉO TỰ DO KHẮP NƠI */
    .bowl-cover {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #4a4a4a 0%, #111111 70%, #000000 100%);
      border: 6px solid #d4af37;
      box-shadow: inset 0 0 15px rgba(255,255,255,0.3), 0 8px 25px rgba(0,0,0,0.9);
      z-index: 20; cursor: grab; display: none; justify-content: center; align-items: center;
      transition: opacity 0.3s ease;
    }

    .bowl-handle {
      width: 45px; height: 45px; border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #ffd700, #8a6d0b);
      border: 2px solid #fff; box-shadow: 0 4px 8px rgba(0,0,0,0.8);
    }

    .bowl-cover:active { cursor: grabbing; }

    /* KHU VỰC XÚC XẮC 3D NẢY CAO NGHIÊNG */
    .dice-3d-arena { position: absolute; width: 110px; height: 110px; z-index: 8; transform-style: preserve-3d; display: none; }

    .cube-wrapper { position: absolute; width: 36px; height: 36px; transform-style: preserve-3d; }
    #wrap1 { top: 10px; left: 10px; } #wrap2 { top: 10px; right: 10px; } #wrap3 { bottom: 10px; left: 37px; }

    .cube { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; transition: transform 0.6s ease; }
    
    /* ANIMATION TẠO HIỆU ỨNG 3D NẢY CAO, NGHIÊNG VÀ XOAY REAL */
    .cube.rolling { animation: roll3DReal 0.18s infinite alternate ease-in-out; }

    @keyframes roll3DReal {
      0% { transform: translateY(0px) rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(0.9); }
      50% { transform: translateY(-35px) rotateX(240deg) rotateY(180deg) rotateZ(120deg) scale(1.25) rotate3d(1, 1, 0, 45deg); }
      100% { transform: translateY(5px) rotateX(480deg) rotateY(360deg) rotateZ(240deg) scale(1) rotate3d(0, 1, 1, -30deg); }
    }

    .face {
      position: absolute; width: 36px; height: 36px; background: #fff;
      border: 1px solid #ccc; border-radius: 6px; display: grid;
      grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 2px; align-items: center; justify-items: center;
      box-shadow: inset 0 0 5px rgba(0,0,0,0.2);
    }

    .face-1 { transform: rotateY(0deg) translateZ(18px); }
    .face-6 { transform: rotateY(180deg) translateZ(18px); }
    .face-2 { transform: rotateY(-90deg) translateZ(18px); }
    .face-5 { transform: rotateY(90deg) translateZ(18px); }
    .face-3 { transform: rotateX(90deg) translateZ(18px); }
    .face-4 { transform: rotateX(-90deg) translateZ(18px); }

    .dot-pip { width: 6px; height: 6px; background: #000; border-radius: 50%; display: none; }
    .face-1 .dot-pip.red-giant { display: block; width: 14px; height: 14px; background: #d32f2f; grid-column: 2; grid-row: 2; }
    .p1 { grid-column: 1; grid-row: 1; } .p3 { grid-column: 3; grid-row: 1; }
    .p4 { grid-column: 1; grid-row: 2; } .p5 { grid-column: 2; grid-row: 2; } .p6 { grid-column: 3; grid-row: 2; }
    .p7 { grid-column: 1; grid-row: 3; } .p9 { grid-column: 3; grid-row: 3; }

    .face-2 .p1, .face-2 .p9 { display: block; }
    .face-3 .p1, .face-3 .p5, .face-3 .p9 { display: block; }
    .face-4 .p1, .face-4 .p3, .face-4 .p7, .face-4 .p9 { display: block; }
    .face-5 .p1, .face-5 .p3, .face-5 .p5, .face-5 .p7, .face-5 .p9 { display: block; }
    .face-6 .p1, .face-6 .p3, .face-6 .p4, .face-6 .p6, .face-6 .p7, .face-6 .p9 { display: block; }

    /* BẢNG CHUYỂN CẦU DƯỚI BÀN */
    .history-dots {
      position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 4px; background: rgba(0,0,0,0.6); padding: 3px 10px; border-radius: 12px;
    }
    .dot { width: 10px; height: 10px; border-radius: 50%; border: 1px solid #fff; }
    .dot.tai { background: #000; } .dot.xiu { background: #fff; }

    /* KHU VỰC CƯỢC CHIP NGANG 1K - 50M CÓ MÀU NEON XANH LÁ */
    .chip-bar-container {
      position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 5px; background: rgba(5, 20, 10, 0.95);
      border: 2px solid #00ff66; box-shadow: 0 0 15px rgba(0, 255, 102, 0.4);
      padding: 6px 12px; border-radius: 10px; z-index: 100;
      transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .chip-bar-container.hidden-bet {
      opacity: 0; pointer-events: none; transform: translateX(-50%) translateY(40px);
    }

    /* CHIP VUÔNG NEON XANH LÁ ĐẬM & NHẠT THỰC TẾ */
    .chip-item-sq {
      width: 42px; height: 34px; border-radius: 6px;
      border: 1px solid #00ff66;
      background: linear-gradient(180deg, #0d381e 0%, #041f0f 100%);
      display: flex; justify-content: center; align-items: center; font-size: 11px;
      font-weight: 900; color: #00ff66; cursor: pointer; text-shadow: 0 0 4px #00ff66;
      box-shadow: inset 0 0 5px rgba(0,255,102,0.3); transition: transform 0.1s, background 0.2s;
    }
    .chip-item-sq:active { transform: scale(0.9); }
    .chip-item-sq.selected {
      background: linear-gradient(180deg, #00ff66 0%, #008033 100%);
      color: #000; text-shadow: none; border: 1px solid #fff;
      transform: translateY(-3px); box-shadow: 0 0 10px #00ff66;
    }

    .btn-chip-action { padding: 6px 12px; border-radius: 6px; border: none; font-weight: 900; font-size: 11px; cursor: pointer; }
    .btn-chip-confirm { background: linear-gradient(180deg, #ff9800, #b86b00); color: #fff; border: 1px solid #ffe066; }
    .btn-chip-cancel { background: linear-gradient(180deg, #d32f2f, #7b0000); color: #fff; border: 1px solid #ff8a8a; }

    /* CHAT BOX BÊN PHẢI GO88 REAL */
    .chat-box-real {
      position: absolute; right: 10px; top: 60px; width: 230px; height: 360px;
      background: rgba(10, 5, 2, 0.92); border: 1px solid #f5b027; border-radius: 8px;
      display: flex; flex-direction: column; justify-content: space-between; padding: 8px; z-index: 101;
    }

    .chat-messages { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; font-size: 11px; }
    .chat-item { line-height: 1.3; }
    .chat-user { color: #f5a623; font-weight: bold; }
    .chat-text { color: #fff; }

    .chat-input-row { display: flex; gap: 4px; margin-top: 5px; }
    .chat-input { flex: 1; background: #000; border: 1px solid #666; border-radius: 4px; padding: 4px 8px; color: #fff; font-size: 11px; }
    .btn-send-chat { background: #f5a623; color: #000; border: none; border-radius: 4px; padding: 4px 8px; font-weight: bold; cursor: pointer; }

    /* TOAST NOTIFICATION THỰC TẾ */
    .toast-msg {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-50px);
      background: rgba(0,0,0,0.95); border: 2px solid #ffd700; color: #ffeb3b;
      padding: 10px 24px; border-radius: 20px; font-weight: bold; font-size: 13px;
      z-index: 9999; opacity: 0; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none; box-shadow: 0 0 15px rgba(255,215,0,0.5); text-align: center;
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* KHUNG THẮNG TIỀN NỔI THỰC TẾ (7 GIÂY TỰ ĐỘNG BIẾN MẤT) */
    .win-popup {
      position: absolute; top: 20%; left: 50%; transform: translateX(-50%) scale(0);
      background: radial-gradient(circle, #ffe066 0%, #ff8c00 100%);
      border: 3px solid #fff; border-radius: 20px; padding: 15px 30px;
      color: #000; font-weight: 900; text-align: center; z-index: 200;
      box-shadow: 0 0 40px #ffea00; opacity: 0; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
    }
    .win-popup.show {
      transform: translateX(-50%) scale(1); opacity: 1;
    }
    .win-popup-title { font-size: 18px; color: #800; text-shadow: 0 1px 2px #fff; }
    .win-popup-amount { font-size: 28px; color: #000; text-shadow: 0 2px 5px #fff; margin-top: 5px; }
  </style>
</head>
<body>

  <canvas id="fx-canvas"></canvas>
  <div id="toast" class="toast-msg">Thông báo hệ thống</div>

  <!-- THẮNG CỘNG TIỀN POPUP (7s) -->
  <div id="win-popup" class="win-popup">
    <div class="win-popup-title">THẮNG CƯỢC!</div>
    <div class="win-popup-amount" id="win-amount-text">+0</div>
  </div>

  <!-- 1. LOADING SCREEN -->
  <div id="loading-screen" class="app-screen active">
    <div class="loader-brand">GO88 REAL TIME</div>
    <div class="loader-box"><div class="loader-fill" id="loader-fill"></div></div>
  </div>

  <!-- 2. GAME LOBBY -->
  <div id="lobby-screen" class="app-screen game-lobby">
    <div class="top-bar">
      <div class="user-info">
        <div class="avatar" style="background-image: url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100');"></div>
        <div>
          <div style="font-size: 10px; color: #aaa;">hilohi123</div>
          <div class="balance-box" id="user-balance">$ 57,300,755</div>
        </div>
      </div>
      <div class="top-nav">
        <span class="active">ALL GAME</span>
        <span>SLOTS</span>
        <span>LIVE</span>
        <span>KHÁC</span>
      </div>
      <div>
        <button class="btn-nap" onclick="showToast('Cổng Nạp Tự Động 24/7', 3000)">NẠP TIỀN</button>
        <button class="btn-rut" onclick="showToast('Rút Tiền Siêu Tốc 1:1', 3000)">RÚT TIỀN</button>
      </div>
