<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tài Xỉu MD5 - Game Bài Kiểu Cũ Pro 3D VIP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Thư viện MD5 chống gian lận chuẩn 100% -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/blueimp-md5/2.19.0/js/md5.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            user-select: none;
        }

        body {
            background: #050505;
            background-image: radial-gradient(circle at center, #2a0800 0%, #000000 90%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: #fff;
            overflow: hidden;
        }

        .main-container {
            display: flex;
            gap: 15px;
            align-items: center;
            position: relative;
        }

        /* --- SẢNH GAME TRÒN VIP KIỂU CŨ --- */
        .game-wrapper {
            width: 880px;
            height: 480px;
            background: radial-gradient(ellipse at center, #9a0000 0%, #3a0000 60%, #0d0000 100%);
            border: 7px solid #ffd700;
            border-radius: 240px;
            padding: 15px 40px;
            box-shadow: 
                0 0 60px rgba(255, 215, 0, 0.45),
                inset 0 0 40px rgba(0,0,0,0.95),
                inset 0 0 20px rgba(255, 215, 0, 0.7);
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
        }

        /* Logo Tiêu Đề Logic Soi Cầu */
        .header-title-outer {
            position: absolute;
            top: 10px;
            background: linear-gradient(180deg, #ffe066 0%, #b8860b 50%, #2a1c00 100%);
            padding: 5px 35px;
            border-radius: 25px;
            border: 2px solid #fff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.9), 0 0 20px rgba(255, 215, 0, 0.8);
            z-index: 25;
            cursor: pointer;
            transition: transform 0.2s, filter 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .header-title-outer:hover {
            transform: scale(1.05);
            filter: brightness(1.2);
        }

        .header-title-outer h1 {
            font-size: 20px;
            font-weight: 900;
            color: #fff;
            text-transform: uppercase;
            text-shadow: 0 2px 4px #000, 0 0 10px #ff0000;
            letter-spacing: 2px;
        }

        .logo-soicau-btn {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: radial-gradient(circle, #00ffcc, #006655);
            border: 1.5px solid #fff;
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
            box-shadow: 0 0 8px #00ffcc;
            animation: pulseGlow 1.5s infinite alternate;
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 4px #00ffcc; transform: scale(0.95); }
            100% { box-shadow: 0 0 12px #00ffcc; transform: scale(1.1); }
        }

        .session-tag-outer {
            position: absolute;
            top: 48px;
            font-size: 11px;
            font-weight: bold;
            color: #ffeb3b;
            background: rgba(0,0,0,0.85);
            padding: 2px 12px;
            border-radius: 10px;
            border: 1.5px solid #ffd700;
            box-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
            z-index: 20;
        }

        /* Nút chức năng ngoài viền */
        .icon-btn {
            position: absolute;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(145deg, #ff4d4d, #800000);
            border: 2px solid #ffe100;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.7), inset 0 2px 4px rgba(255,255,255,0.5);
            transition: all 0.2s ease;
            z-index: 30;
        }
        .icon-btn:hover { transform: scale(1.18); filter: brightness(1.25); box-shadow: 0 0 15px #ffe100; }
        .icon-btn:active { transform: scale(0.92); }

        .btn-close { top: 210px; left: -20px; background: linear-gradient(145deg, #e74c3c, #78281f); }
        .btn-help { top: 140px; left: -10px; }
        .btn-chart { top: 280px; left: -10px; background: linear-gradient(145deg, #3498db, #1d5276); }
        .btn-info { top: 70px; left: 15px; }

        .btn-trophy { top: 210px; right: -20px; background: linear-gradient(145deg, #f39c12, #965100); }
        .btn-hand { top: 140px; right: -10px; }
        .btn-hand.active-nan { background: linear-gradient(145deg, #00ffcc, #008866); color: #000; box-shadow: 0 0 15px #00ffcc; }
        .btn-history { top: 280px; right: -10px; background: linear-gradient(145deg, #9b59b6, #4a235a); }

        /* Cửa cược */
        .game-body {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
            width: 100%;
            margin-top: 75px;
        }

        .bet-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 220px;
            position: relative;
            cursor: pointer;
        }

        .bet-title {
            font-size: 50px;
            font-weight: 900;
            text-shadow: 0 4px 10px #000, 0 0 20px rgba(255, 255, 255, 0.3);
            transition: all 0.2s ease;
            padding: 2px 25px;
            border-radius: 20px;
            background: rgba(0, 0, 0, 0.65);
            border: 2px solid transparent;
            width: 100%;
            text-align: center;
            position: relative;
        }
        .bet-box:hover .bet-title {
            transform: scale(1.04);
            border-color: #ffd700;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
        }
        .bet-box.selected .bet-title {
            border-color: #00ffcc !important;
            background: rgba(0, 255, 204, 0.2) !important;
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.8) !important;
        }

        .bet-box.winner .bet-title {
            border-color: #ffeb3b !important;
            background: rgba(255, 235, 59, 0.35) !important;
            animation: winFlash 0.5s infinite alternate;
        }
        @keyframes winFlash {
            0% { box-shadow: 0 0 15px #ffeb3b; }
            100% { box-shadow: 0 0 40px #ffea00; }
        }

        .rate-badge {
            font-size: 11px;
            background: #ffd700;
            color: #000;
            padding: 1px 8px;
            border-radius: 10px;
            font-weight: 900;
            position: absolute;
            top: -10px;
            right: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        }

        .text-tai { color: #ff3333; }
        .text-xiu { color: #33ccff; }

        .player-count {
            font-size: 13px;
            color: #ffda79;
            margin: 2px 0;
            font-weight: bold;
        }

        .total-money {
            font-size: 24px;
            font-weight: 900;
            color: #fff;
            text-shadow: 0 2px 6px #000, 0 0 10px rgba(255, 215, 0, 0.5);
            margin-bottom: 4px;
            transition: transform 0.15s ease-out;
        }

        .bet-input-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 60px;
            opacity: 0.35;
            transition: all 0.3s ease;
        }
        .bet-box.selected .bet-input-container {
            opacity: 1;
        }

        .btn-cuoc {
            background: linear-gradient(180deg, #2ecc71, #196f3d);
            border: 2px solid #fff;
            color: #fff;
            font-weight: bold;
            padding: 4px 25px;
            border-radius: 20px;
            font-size: 12px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }

        .bet-input-display {
            background: #000;
            border: 1.5px solid #ffd700;
            border-radius: 12px;
            width: 140px;
            text-align: center;
            padding: 2px;
            color: #00ffcc;
            font-weight: bold;
            font-size: 15px;
            margin-top: 4px;
            box-shadow: inset 0 0 8px rgba(0, 255, 204, 0.4);
        }

        /* --- ĐĨA & THỜI GIAN TRÒN --- */
        .center-plate-outer {
            width: 190px;
            height: 190px;
            background: radial-gradient(circle, #f39c12, #8e44ad, #111);
            border: 4px solid #ffd700;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 35px rgba(0,0,0,0.9), inset 0 0 20px rgba(255, 215, 0, 0.8);
            position: relative;
            perspective: 1000px;
        }

        .timer-ring-progress {
            position: absolute;
            width: 172px;
            height: 172px;
            border-radius: 50%;
            background: conic-gradient(#00ffcc var(--progress, 360deg), rgba(255,255,255,0.08) 0deg);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.5);
            z-index: 1;
        }

        .center-plate {
            width: 148px;
            height: 148px;
            background: radial-gradient(circle, #1a1a1a, #000);
            border: 3px solid #555;
            border-radius: 50%;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 0 25px #000;
            z-index: 3;
            overflow: visible;
        }

        .timer-num {
            position: absolute;
            top: 6px;
            font-size: 24px;
            font-weight: 900;
            color: #00ffcc;
            text-shadow: 0 0 12px #00ffcc;
            z-index: 10;
        }

        .plate-lid {
            position: absolute;
            width: 148px;
            height: 148px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #ffd700 0%, #b8860b 50%, #4a3300 100%);
            border: 3px solid #fff;
            box-shadow: inset 0 0 15px rgba(255,255,255,0.8), 0 10px 25px rgba(0,0,0,0.9);
            z-index: 50;
            cursor: grab;
            display: none;
            align-items: center;
            justify-content: center;
            top: 0;
            left: 0;
            touch-action: none;
        }
        .plate-lid:active { cursor: grabbing; }
        .plate-lid-knob {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: radial-gradient(circle, #ffffff, #d4af37);
            border: 2px solid #997a00;
            box-shadow: 0 4px 8px rgba(0,0,0,0.6);
        }

        /* --- XÚC XẮC 3D THỰC TẾ VIỀN CHUẨN --- */
        .dice-container-center {
            width: 90px;
            height: 90px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -38%);
            display: flex;
            align-items: center;
            justify-content: center;
            transform-style: preserve-3d;
            perspective: 600px;
            z-index: 5;
        }

        .dice-wrapper {
            position: absolute;
            width: 34px;
            height: 34px;
            transform-style: preserve-3d;
            transition: transform 0.5s cubic-bezier(0.1, 0.8, 0.3, 1);
        }

        #dice-wrap-1 { bottom: 6px; left: 6px; }
        #dice-wrap-2 { bottom: 6px; right: 6px; }
        #dice-wrap-3 { top: 6px; left: 28px; z-index: 6; }

        .dice-cube {
            width: 34px;
            height: 34px;
            position: relative;
            transform-style: preserve-3d;
        }

        .dice-face {
            position: absolute;
            width: 34px;
            height: 34px;
            background: radial-gradient(circle at 35% 35%, #ff3333 0%, #b30000 70%, #660000 100%);
            border: 1px solid #ff6666;
            border-radius: 5px;
            box-shadow: inset 0 0 5px rgba(255,255,255,0.5), inset 0 0 8px rgba(0,0,0,0.6);
        }

        /* Tọa độ 6 mặt 3D cân đối chuẩn geometry 17px */
        .face-1 { transform: rotateY(0deg) translateZ(17px); }
        .face-6 { transform: rotateY(180deg) translateZ(17px); }
        .face-2 { transform: rotateY(-90deg) translateZ(17px); }
        .face-5 { transform: rotateY(90deg) translateZ(17px); }
        .face-3 { transform: rotateX(90deg) translateZ(17px); }
        .face-4 { transform: rotateX(-90deg) translateZ(17px); }

        /* Định vị điểm chấm (Dot) chính xác tuyệt đối */
        .pip-dot {
            width: 6.5px;
            height: 6.5px;
            background: #ffffff;
            border-radius: 50%;
            position: absolute;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.8), 0 0 2px rgba(255,255,255,0.8);
        }
        .pip-red { 
            background: #ffea00 !important; 
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.8), 0 0 4px #ffea00; 
        }

        .p-center { top: 13.75px; left: 13.75px; }
        .p-top-left { top: 4.5px; left: 4.5px; }
        .p-top-right { top: 4.5px; right: 4.5px; }
        .p-bottom-left { bottom: 4.5px; left: 4.5px; }
        .p-bottom-right { bottom: 4.5px; right: 4.5px; }
        .p-mid-left { top: 13.75px; left: 4.5px; }
        .p-mid-right { top: 13.75px; right: 4.5px; }

        .fast-rolling-3d {
            animation: roll3DReal 0.2s infinite linear !important;
        }

        @keyframes roll3DReal {
            0% { transform: translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
            25% { transform: translate3d(-8px, -10px, 8px) rotateX(180deg) rotateY(90deg) rotateZ(45deg); }
            50% { transform: translate3d(10px, 8px, -5px) rotateX(360deg) rotateY(180deg) rotateZ(120deg); }
            75% { transform: translate3d(-6px, 10px, 10px) rotateX(540deg) rotateY(270deg) rotateZ(240deg); }
            100% { transform: translate3d(0, 0, 0) rotateX(720deg) rotateY(360deg) rotateZ(360deg); }
        }

        /* Soi cầu chuỗi dưới đĩa */
        .history-dots {
            display: flex;
            gap: 5px;
            background: rgba(0,0,0,0.75);
            padding: 4px 14px;
            border-radius: 12px;
            border: 1px solid #d4a311;
            cursor: pointer;
            margin-bottom: 2px;
        }

        .dot { 
            width: 14px; 
            height: 14px; 
            border-radius: 50%; 
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 8px;
            font-weight: bold;
            color: #fff;
        }
        .dot-black { background: radial-gradient(circle, #333, #000); border: 1px solid #777; }
        .dot-white { background: radial-gradient(circle, #fff, #aaa); color: #000; box-shadow: 0 0 6px #fff; }

        /* Khung MD5 */
        .md5-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(0,0,0,0.85);
            padding: 3px 12px;
            border-radius: 10px;
            border: 1px solid #d4a311;
            font-size: 11px;
            margin-bottom: 4px;
        }

        .md5-text { color: #ffda79; font-family: monospace; }

        .btn-copy {
            background: linear-gradient(180deg, #e67e22, #d35400);
            border: none;
            color: #fff;
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .chip-bar { display: flex; gap: 6px; margin-bottom: 4px; }
        .chip {
            width: 46px;
            height: 28px;
            background: linear-gradient(180deg, #1d976c, #093637);
            border: 1px solid #fff;
            border-radius: 8px;
            font-size: 11px;
            font-weight: bold;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 3px 6px rgba(0,0,0,0.6);
            transition: all 0.1s;
        }
        .chip.active-chip {
            border: 2px solid #ff0;
            transform: translateY(-3px);
            box-shadow: 0 0 10px #ff0;
        }

        .action-bar { display: flex; gap: 10px; width: 75%; }
        .btn-act {
            flex: 1;
            padding: 7px 0;
            border-radius: 15px;
            font-weight: 900;
            font-size: 13px;
            border: 1.5px solid rgba(255,255,255,0.8);
            cursor: pointer;
            text-align: center;
            color: #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.7);
            transition: all 0.15s;
        }
        .btn-act:active { transform: translateY(2px) scale(0.96); }

        .btn-x2 { background: linear-gradient(180deg, #2980b9, #1c5980); }
        .btn-confirm { background: linear-gradient(180deg, #f39c12, #b7950b); flex: 1.8; font-size: 14px; }
        .btn-cancel { background: linear-gradient(180deg, #c0392b, #7b241c); }

        .chat-panel {
            width: 250px;
            height: 480px;
            background: rgba(15, 8, 3, 0.95);
            border: 2px solid #d4a311;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            padding: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.9);
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            font-size: 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .username { color: #f1c40f; font-weight: bold; }

        .chat-input-box { display: flex; gap: 4px; margin-top: 8px; }
        .chat-input-box input {
            flex: 1;
            background: #000;
            border: 1px solid #555;
            border-radius: 6px;
            padding: 6px;
            color: #fff;
            font-size: 11px;
            outline: none;
        }

        .btn-send {
            background: linear-gradient(180deg, #f39c12, #d35400);
            border: none;
            color: #fff;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: bold;
            cursor: pointer;
        }

        .user-footer {
            position: absolute;
            bottom: -32px;
            left: 30px;
            font-size: 13px;
            color: #ffd700;
            font-weight: bold;
        }

        /* --- MODAL SOI CẦU LƯỚI MA TRẬN TẢ THỰC --- */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 999;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
        }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        
        .modal-content-large {
            background: radial-gradient(circle, #2c0303, #0a0101);
            border: 3px solid #ffd700;
            border-radius: 20px;
            padding: 20px;
            width: 780px;
            text-align: center;
            box-shadow: 0 0 35px #ffd700;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 10px; right: 15px;
            font-size: 24px;
            cursor: pointer;
            color: #ff4d4d;
            font-weight: bold;
        }

        .tab-nav {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 12px;
        }

        .tab-btn {
            background: #111;
            border: 1.5px solid #ffd700;
            color: #ffd700;
            padding: 6px 20px;
            border-radius: 12px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn.active-tab {
            background: linear-gradient(180deg, #ffd700, #b8860b);
            color: #000;
            box-shadow: 0 0 12px #ffd700;
        }

        .chart-board {
            width: 100%;
            height: 260px;
            background: rgba(0, 0, 0, 0.9);
            border: 1.5px solid #555;
            border-radius: 10px;
            position: relative;
            overflow: hidden;
            padding: 10px;
        }

        .tab-page { display: none; width: 100%; height: 100%; position: relative; }
        .tab-page.active-page { display: block; }

        /* Lưới Cầu Tròn 16 cột x 6 dòng */
        .circle-grid-container {
            display: grid;
            grid-template-columns: repeat(16, 1fr);
            grid-template-rows: repeat(6, 1fr);
            gap: 4px;
            height: 100%;
            width: 100%;
        }

        .grid-cell {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .circle-item {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: bold;
            color: #fff;
            box-shadow: 0 0 6px rgba(0,0,0,0.8);
        }
        .circle-tai { background: radial-gradient(circle, #ff4d4d, #990000); border: 1px solid #ff9999; }
        .circle-xiu { background: radial-gradient(circle, #3498db, #1d5276); border: 1px solid #a6d5fa; }

        .win-money-anim {
            position: absolute;
            top: 40%; left: 50%;
            transform: translate(-50%, -50%);
            font-size: 32px; font-weight: 900;
            color: #ffea00;
            text-shadow: 0 0 10px #000, 0 0 20px #ffea00;
            z-index: 200; pointer-events: none;
            animation: winFloat 2.2s ease-out forwards;
        }

        @keyframes winFloat {
            0% { opacity: 0; transform: translate(-50%, 0) scale(0.5); }
            20% { opacity: 1; transform: translate(-50%, -30px) scale(1.3); }
            80% { opacity: 1; transform: translate(-50%, -70px) scale(1); }
            100% { opacity: 0; transform: translate(-50%, -100px) scale(0.8); }
        }
    </style>
</head>
<body>

    <div class="main-container">
        <!-- BÀN TÀI XỈU SẢNH TRÒN 3D PRO VIP -->
        <div class="game-wrapper" id="game-wrapper">
            
            <!-- Header Logo Tiêu Đề: Có hình tròn Soi Cầu bên trong -->
            <div class="header-title-outer" onclick="openLogicModal('Soi cầu')">
                <h1>TÀI XỈU MD5</h1>
                <div class="logo-soicau-btn" title="Soi cầu nhanh"><i class="fa-solid fa-chart-simple"></i></div>
            </div>

            <!-- Điểm Phiên -->
            <div class="session-tag-outer" id="session-id">#1453831</div>

            <!-- Nút tròn viền sảnh -->
            <div class="icon-btn btn-close" onclick="alert('Đã thoát sảnh!')" title="Đóng sảnh"><i class="fa-solid fa-xmark"></i></div>
            <div class="icon-btn btn-help" onclick="openLogicModal('Hướng dẫn')" title="Hướng dẫn"><i class="fa-solid fa-question"></i></div>
            <div class="icon-btn btn-chart" onclick="openLogicModal('Soi cầu')" title="Soi cầu"><i class="fa-solid fa-wave-square"></i></div>
            <div class="icon-btn btn-info" onclick="openLogicModal('Chống Gian Lận')" title="MD5 Minh Bạch"><i class="fa-solid fa-info"></i></div>

            <div class="icon-btn btn-trophy" onclick="openLogicModal('Top')" title="Đua Top"><i class="fa-solid fa-trophy"></i></div>
            <div class="icon-btn btn-hand" id="btn-hand-toggle" onclick="toggleNanMode()" title="Bàn tay nặn"><i class="fa-solid fa-hand"></i></div>
            <div class="icon-btn btn-history" onclick="openLogicModal('Lịch sử')" title="Lịch sử"><i class="fa-solid fa-file-lines"></i></div>

            <div class="game-body">
                <!-- Cửa Tài -->
                <div class="bet-box" id="box-tai" onclick="selectBetSide('tai')">
                    <div class="bet-title text-tai">
                        TÀI
                        <span class="rate-badge">1 : 1</span>
                    </div>
                    <div class="player-count"><i class="fa-solid fa-user"></i> <span id="tai-players">1,064</span></div>
                    <div class="total-money" id="tai-money">342,055,144</div>
                    
                    <div class="bet-input-container">
                        <button class="btn-cuoc">CƯỢC TÀI</button>
                        <div class="bet-input-display" id="tai-bet-val">0</div>
                    </div>
                </div>

                <!-- Đĩa & Xúc Xắc Chuẩn Tâm Giữa -->
                <div class="center-plate-outer">
                    <div class="timer-ring-progress" id="ring-progress"></div>
                    <div class="center-plate" id="center-plate">
                        <div class="timer-num" id="timer">50</div>
                        
                        <!-- 3 Viên xúc xắc Đỏ 3D Vuông Góc Phẳng -->
                        <div class="dice-container-center" id="dice-group">
                            <div class="dice-wrapper" id="dice-wrap-1"><div class="dice-cube" id="dice1"></div></div>
                            <div class="dice-wrapper" id="dice-wrap-2"><div class="dice-cube" id="dice2"></div></div>
                            <div class="dice-wrapper" id="dice-wrap-3"><div class="dice-cube" id="dice3"></div></div>
                        </div>

                        <!-- Nắp đậy 3D thực tế khi bật bàn tay nặn -->
                        <div class="plate-lid" id="plate-lid">
                            <div class="plate-lid-knob"></div>
                        </div>
                    </div>
                </div>

                <!-- Cửa Xỉu -->
                <div class="bet-box" id="box-xiu" onclick="selectBetSide('xiu')">
                    <div class="bet-title text-xiu">
                        XỈU
                        <span class="rate-badge">1 : 1</span>
                    </div>
                    <div class="player-count"><i class="fa-solid fa-user"></i> <span id="xiu-players">1,926</span></div>
                    <div class="total-money" id="xiu-money">675,785,446</div>

                    <div class="bet-input-container">
                        <button class="btn-cuoc">CƯỢC XỈU</button>
                        <div class="bet-input-display" id="xiu-bet-val">0</div>
                    </div>
                </div>
            </div>

            <!-- Chuỗi Soi Cầu Dưới Đĩa -->
            <div class="history-dots" id="history-dots" onclick="openLogicModal('Soi cầu')"></div>

            <!-- Mã MD5 Hash Chống Gian Lận -->
            <div class="md5-box">
                <span style="color: #f39c12; font-weight: bold;">MD5:</span>
                <span class="md5-text" id="md5-hash">--------------------------------</span>
                <button class="btn-copy" onclick="copyMD5()">COPY</button>
            </div>

            <!-- Dải phíp cược -->
            <div class="chip-bar">
                <div class="chip active-chip" onclick="setChipValue(1000, this)">1K</div>
                <div class="chip" onclick="setChipValue(10000, this)">10K</div>
                <div class="chip" onclick="setChipValue(50000, this)">50K</div>
                <div class="chip" onclick="setChipValue(100000, this)">100K</div>
                <div class="chip" onclick="setChipValue(500000, this)">500K</div>
                <div class="chip" onclick="setChipValue(1000000, this)">1M</div>
                <div class="chip" onclick="setChipValue(10000000, this)">10M</div>
            </div>

            <!-- Nút Thao Tác Cược -->
            <div class="action-bar">
                <button class="btn-act btn-x2" onclick="doubleBet()">X2</button>
                <button class="btn-act btn-confirm" onclick="confirmBet()">ĐẶT CƯỢC</button>
                <button class="btn-act btn-cancel" onclick="cancelBet()">HỦY</button>
            </div>

            <!-- Footer User -->
            <div class="user-footer">
                <i class="fa-solid fa-user-gear"></i> cocnhanheiuiu | <i class="fa-solid fa-coins" style="color: #ffd700;"></i> <span id="user-balance">539,659</span>
            </div>
        </div>

        <!-- Panel Chat Realtime -->
        <div class="chat-panel">
            <div class="chat-messages" id="chat-box">
                <div class="chat-msg"><span class="username">NhiBeo:</span> Xin con xiu hup dam</div>
                <div class="chat-msg"><span class="username">LaoDai99:</span> Bệt Tài 5 cây rồi anh em!</div>
            </div>
            <div class="chat-input-box">
                <input type="text" id="chat-input" placeholder="Chat trực tuyến..." onkeypress="if(event.key==='Enter') sendChat()">
                <button class="btn-send" onclick="sendChat()">GỬI</button>
            </div>
        </div>
    </div>

    <!-- MODAL POPUP SOI CẦU -->
    <div class="modal-overlay" id="soicau-modal">
        <div class="modal-content-large">
            <span class="close-modal" onclick="closeLogicModal()">&times;</span>
            <div class="tab-nav">
                <button class="tab-btn active-tab" onclick="switchTab(1)">LƯỚI MA TRẬN TỔNG HỢP</button>
                <button class="tab-btn" onclick="switchTab(2)">HƯỚNG DẪN & MD5</button>
            </div>
            <div class="chart-board">
                <div class="tab-page active-page" id="page-1">
                    <div class="circle-grid-container" id="matrix-grid"></div>
                </div>
                <div class="tab-page" id="page-2" style="padding:15px; text-align:left; font-size:13px; line-height:1.6;">
                    <p style="color:#ffd700; font-weight:bold;">HỆ THỐNG XÍ NGẦU RANDOM & MD5 CHỐNG GIAN LẬN</p>
                    <p>1. Kết quả xí ngầu sinh hoàn toàn ngẫu nhiên qua thuật toán mã hóa 100%.</p>
                    <p>2. Hiện tượng cầu bệt (về liên tiếp Tài hoặc Xỉu) xuất hiện hoàn toàn ngẫu nhiên theo xác suất tự nhiên.</p>
                    <p>3. Chuỗi MD5 được tạo trước mỗi phiên. Bạn có thể copy MD5 để đối soát sau khi hết phiên.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- 1. KHỞI TẠO XÚC XẮC 3D VÀ CÁC MẶT VỚI DẤU CHẤM CÂN BẰNG ---
        const diceFacesData = {
            1: ['p-center pip-red'],
            2: ['p-top-left', 'p-bottom-right'],
            3: ['p-top-left', 'p-center', 'p-bottom-right'],
            4: ['p-top-left', 'p-top-right', 'p-bottom-left', 'p-bottom-right'],
            5: ['p-top-left', 'p-top-right', 'p-center', 'p-bottom-left', 'p-bottom-right'],
            6: ['p-top-left', 'p-top-right', 'p-mid-left', 'p-mid-right', 'p-bottom-left', 'p-bottom-right']
        };

        function buildDiceCube(cubeElem) {
            cubeElem.innerHTML = '';
            for (let f = 1; f <= 6; f++) {
                const face = document.createElement('div');
                face.className = `dice-face face-${f}`;
                diceFacesData[f].forEach(cls => {
                    const dot = document.createElement('div');
                    dot.className = `pip-dot ${cls}`;
                    face.appendChild(dot);
                });
                cubeElem.appendChild(face);
            }
        }

        buildDiceCube(document.getElementById('dice1'));
        buildDiceCube(document.getElementById('dice2'));
        buildDiceCube(document.getElementById('dice3'));

        // Rotation map chính xác theo 3D Space
        const diceRotations = {
            1: { x: 0, y: 0 },
            6: { x: 0, y: 180 },
            2: { x: 0, y: 90 },
            5: { x: 0, y: -90 },
            3: { x: -90, y: 0 },
            4: { x: 90, y: 0 }
        };

        function setDiceResult(diceId, val) {
            const rot = diceRotations[val];
            const cube = document.getElementById(`dice${diceId}`);
            cube.style.transform = `rotateX(${rot.x}deg) rotateY(${rot.y}deg)`;
        }

        // --- 2. QUẢN LÝ TRẠNG THÁI GAME ---
        let currentSession = 1453831;
        let selectedSide = null;
        let currentChip = 1000;
        let myBetValue = 0;
        let isNanMode = false;
        let gameHistory = [
            { session: 1453825, d: [4, 5, 6], total: 15, side: 'tai' },
            { session: 1453826, d: [1, 2, 3], total: 6, side: 'xiu' },
            { session: 1453827, d: [6, 6, 5], total: 17, side: 'tai' },
            { session: 1453828, d: [5, 5, 4], total: 14, side: 'tai' },
            { session: 1453829, d: [6, 4, 5], total: 15, side: 'tai' }, // Ví dụ chuỗi bệt ngẫu nhiên
            { session: 1453830, d: [1, 1, 2], total: 4, side: 'xiu' }
        ];

        let currentDices = [1, 1, 1];
        let currentSecret = "";
        let currentMD5 = "";

        // --- 3. ĐẾM NGƯỢC THỜI GIAN THỰC TẾ 60FPS (KHÔNG GIẬT LẮC) ---
        const TIMER_DURATION = 50; 
        let startTime = null;
        let timerAnimId = null;
        let isRolling = false;

        function startSmoothTimer() {
            startTime = performance.now();
            cancelAnimationFrame(timerAnimId);
            generateNewSessionMD5();

            function update(now) {
                let elapsed = (now - startTime) / 1000;
                let remaining = Math.max(0, TIMER_DURATION - elapsed);
                let displaySec = Math.ceil(remaining);

                document.getElementById('timer').innerText = displaySec;

                let progressDeg = (remaining / TIMER_DURATION) * 360;
                document.getElementById('ring-progress').style.setProperty('--progress', `${progressDeg}deg`);

                // Cập nhật số người cược biến động sinh động
                if (Math.random() < 0.3) {
                    let tPlayers = parseInt(document.getElementById('tai-players').innerText.replace(/,/g, '')) + Math.floor(Math.random() * 5);
                    let xPlayers = parseInt(document.getElementById('xiu-players').innerText.replace(/,/g, '')) + Math.floor(Math.random() * 5);
                    document.getElementById('tai-players').innerText = tPlayers.toLocaleString();
                    document.getElementById('xiu-players').innerText = xPlayers.toLocaleString();
                }

                if (remaining > 5) {
                    timerAnimId = requestAnimationFrame(update);
                } else if (remaining > 0) {
                    // 5 Giây cuối khóa cược & Xoay xúc xắc 3D
                    if (!isRolling) {
                        isRolling = true;
                        trigger3DRolling(true);
                    }
                    timerAnimId = requestAnimationFrame(update);
                } else {
                    // Hết giờ -> Mở bát
                    finishSession();
                }
            }
            timerAnimId = requestAnimationFrame(update);
        }

        // --- 4. TỰ ĐỘNG SINH KẾT QUẢ NGẪU NHIÊN CHUẨN MD5 (CẦU TỰ NHIÊN) ---
        function generateNewSessionMD5() {
            // Sử dụng Crypto API sinh ngẫu nhiên thực tế chuẩn xác
            const array = new Uint8Array(3);
            window.crypto.getRandomValues(array);
            currentDices = [
                (array[0] % 6) + 1,
                (array[1] % 6) + 1,
                (array[2] % 6) + 1
            ];

            currentSecret = Math.random().toString(36).substring(2, 10);
            const rawString = `${currentDices.join('-')}-${currentSecret}`;
            currentMD5 = md5(rawString);
            document.getElementById('md5-hash').innerText = currentMD5;
        }

        function trigger3DRolling(active) {
            for (let i = 1; i <= 3; i++) {
                const el = document.getElementById(`dice${i}`);
                if (active) el.classList.add('fast-rolling-3d');
                else el.classList.remove('fast-rolling-3d');
            }
        }

        function finishSession() {
            trigger3DRolling(false);
            
            // Đặt mặt xúc xắc khớp kết quả ngẫu nhiên
            setDiceResult(1, currentDices[0]);
            setDiceResult(2, currentDices[1]);
            setDiceResult(3, currentDices[2]);

            const total = currentDices[0] + currentDices[1] + currentDices[2];
            const resultSide = total > 10 ? 'tai' : 'xiu';

            // Xử lý nặn bát hoặc mở ngay
            if (isNanMode) {
                document.getElementById('plate-lid').style.display = 'flex';
                document.getElementById('plate-lid').style.transform = 'translate(0px, 0px)';
            } else {
                showResultVisual(resultSide, total);
            }
        }

        function showResultVisual(side, total) {
            const box = document.getElementById(`box-${side}`);
            box.classList.add('winner');

            if (selectedSide === side && myBetValue > 0) {
                let winAmount = myBetValue * 2;
                let balEl = document.getElementById('user-balance');
                let currBal = parseInt(balEl.innerText.replace(/,/g, ''));
                balEl.innerText = (currBal + winAmount).toLocaleString();
                showWinAnim(`+${winAmount.toLocaleString()}`);
            }

            // Lưu lịch sử
            gameHistory.push({ session: currentSession, d: [...currentDices], total, side });
            updateHistoryDots();
            renderMatrixGrid();

            // Khởi động phiên mới sau 5 giây
            setTimeout(() => {
                box.classList.remove('winner');
                document.getElementById('plate-lid').style.display = 'none';
                currentSession++;
                document.getElementById('session-id').innerText = `#${currentSession}`;
                cancelBet();
                isRolling = false;
                startSmoothTimer();
            }, 5000);
        }

        // --- 5. LƯỚI MA TRẬN SOI CẦU TỰ ĐỘNG BÊN TRONG LOGO ---
        function updateHistoryDots() {
            const container = document.getElementById('history-dots');
            container.innerHTML = '';
            const recent = gameHistory.slice(-12);
            recent.forEach(item => {
                const dot = document.createElement('div');
                dot.className = `dot ${item.side === 'tai' ? 'dot-black' : 'dot-white'}`;
                dot.innerText = item.total;
                container.appendChild(dot);
            });
        }

        function renderMatrixGrid() {
            const grid = document.getElementById('matrix-grid');
            grid.innerHTML = '';
            
            // Lưới 16 Cột x 6 Dòng
            const totalCells = 16 * 6;
            let historyIdx = 0;
            
            for (let i = 0; i < totalCells; i++) {
                const cell = document.createElement('div');
                cell.className = 'grid-cell';
                
                if (historyIdx < gameHistory.length) {
                    const data = gameHistory[historyIdx];
                    const item = document.createElement('div');
                    item.className = `circle-item ${data.side === 'tai' ? 'circle-tai' : 'circle-xiu'}`;
                    item.innerText = data.total;
                    cell.appendChild(item);
                    historyIdx++;
                }
                grid.appendChild(cell);
            }
        }

        // --- 6. TƯƠNG TÁC CƯỢC & GIAO DIỆN ---
        function selectBetSide(side) {
            selectedSide = side;
            document.getElementById('box-tai').classList.remove('selected');
            document.getElementById('box-xiu').classList.remove('selected');
            document.getElementById(`box-${side}`).classList.add('selected');
        }

        function setChipValue(val, elem) {
            currentChip = val;
            document.querySelectorAll('.chip').forEach(c => c.classList.remove('active-chip'));
            elem.classList.add('active-chip');
        }

        function confirmBet() {
            if (!selectedSide) return alert('Vui lòng chọn cửa Tài hoặc Xỉu!');
            let balEl = document.getElementById('user-balance');
            let currBal = parseInt(balEl.innerText.replace(/,/g, ''));
            if (currBal < currentChip) return alert('Số dư không đủ!');

            currBal -= currentChip;
            myBetValue += currentChip;
            balEl.innerText = currBal.toLocaleString();
            document.getElementById(`${selectedSide}-bet-val`).innerText = myBetValue.toLocaleString();
        }

        function doubleBet() {
            if (myBetValue > 0) {
                let balEl = document.getElementById('user-balance');
                let currBal = parseInt(balEl.innerText.replace(/,/g, ''));
                if (currBal < myBetValue) return alert('Không đủ tiền nhân đôi!');
                currBal -= myBetValue;
                myBetValue *= 2;
                balEl.innerText = currBal.toLocaleString();
                document.getElementById(`${selectedSide}-bet-val`).innerText = myBetValue.toLocaleString();
            }
        }

        function cancelBet() {
            selectedSide = null;
            myBetValue = 0;
            document.getElementById('box-tai').classList.remove('selected');
            document.getElementById('box-xiu').classList.remove('selected');
            document.getElementById('tai-bet-val').innerText = '0';
            document.getElementById('xiu-bet-val').innerText = '0';
        }

        function toggleNanMode() {
            isNanMode = !isNanMode;
            document.getElementById('btn-hand-toggle').classList.toggle('active-nan', isNanMode);
        }

        // --- KÉO THẢ NẮP ĐẬY NẶN BÁT THỰC TẾ ---
        const lid = document.getElementById('plate-lid');
        let isDragging = false, startX, startY;

        lid.addEventListener('pointerdown', e => {
            isDragging = true;
            startX = e.clientX;
            startY = e.clientY;
            lid.setPointerCapture(e.pointerId);
        });

        lid.addEventListener('pointermove', e => {
            if (!isDragging) return;
            let dx = e.clientX - startX;
            let dy = e.clientY - startY;
            lid.style.transform = `translate(${dx}px, ${dy}px)`;

            // Nặn kéo xa đĩa thì mở luôn kết quả
            if (Math.hypot(dx, dy) > 80) {
                isDragging = false;
                lid.style.display = 'none';
                const total = currentDices[0] + currentDices[1] + currentDices[2];
                showResultVisual(total > 10 ? 'tai' : 'xiu', total);
            }
        });

        lid.addEventListener('pointerup', () => isDragging = false);

        // --- MODAL POPUP & CHAT ---
        function openLogicModal(title) {
            document.getElementById('soicau-modal').classList.add('active');
            renderMatrixGrid();
        }

        function closeLogicModal() {
            document.getElementById('soicau-modal').classList.remove('active');
        }

        function switchTab(idx) {
            document.querySelectorAll('.tab-btn').forEach((b, i) => b.classList.toggle('active-tab', i === idx - 1));
            document.querySelectorAll('.tab-page').forEach((p, i) => p.classList.toggle('active-page', i === idx - 1));
        }

        function copyMD5() {
            navigator.clipboard.writeText(currentMD5);
            alert('Đã sao chép mã MD5!');
        }

        function sendChat() {
            let input = document.getElementById('chat-input');
            if (!input.value.trim()) return;
            let box = document.getElementById('chat-box');
            let msg = document.createElement('div');
            msg.className = 'chat-msg';
            msg.innerHTML = `<span class="username">cocnhanheiuiu:</span> ${input.value}`;
            box.appendChild(msg);
            box.scrollTop = box.scrollHeight;
            input.value = '';
        }

        function showWinAnim(txt) {
            let anim = document.createElement('div');
            anim.className = 'win-money-anim';
            anim.innerText = txt;
            document.getElementById('game-wrapper').appendChild(anim);
            setTimeout(() => anim.remove(), 2200);
        }

        // Bắt đầu vòng quay game
        updateHistoryDots();
        startSmoothTimer();
    </script>
</body>
