    .theme-md5 .center-plate { background: radial-gradient(circle, #080304 0%, #201f20 70%, #a8232c 100%); border: 4px solid #d93843; }
    .theme-thuong .center-plate { background: radial-gradient(circle, #05131a 0%, #1f2d33 70%, #16829b 100%); border: 4px solid #00d2ff; }

