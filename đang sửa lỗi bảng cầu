  <script>
    let balance = 1096000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    let timer = 40;
    let timerInterval = null;
    let botBetInterval = null;
    let gameState = 'BETTING';

    let currentTaiBet = 0, currentXiuBet = 0;
    let currentTaiUsers = 142, currentXiuUsers = 128;
    let currentDiceResults = [1, 2, 3];

    // Mảng dữ liệu bệt sâu Tài 5 tay, Xỉu 7 tay sát thực tế
    let historyResults = [
      { side: 'TAI', total: 13 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 10 }, { side: 'XIU', total: 9 }, { side: 'TAI', total: 11 }, { side: 'XIU', total: 8 }, { side: 'TAI', total: 16 }, { side: 'TAI', total: 17 }, { side: 'TAI', total: 10 }, { side: 'TAI', total: 11 }, { side: 'XIU', total: 9 }, { side: 'TAI', total: 14 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 15 }, { side: 'XIU', total: 12 },
      { side: 'XIU', total: 10 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 12 }, { side: 'TAI', total: 9 }, { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 }, { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 12 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 11 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 10 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 },
      // Bệt 5 Tài
      { side: 'TAI', total: 12 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 15 }, { side: 'TAI', total: 13 }, { side: 'TAI', total: 16 }, 
      // Bệt 7 Xỉu
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 5 }, { side: 'XIU', total: 4 }, { side: 'XIU', total: 7 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 6 },
      { side: 'TAI', total: 13 }, { side: 'TAI', total: 14 }, { side: 'XIU', total: 8 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 }
    ];

    let isNanMode = true;
    let isDraggingCover = false;
    let coverX = 0, coverY = 0;
    let coverStartX = 0, coverStartY = 0;

    const plateCover = document.getElementById('plate-cover');
    const dragBoard = document.getElementById('draggable-board');
    const dragChart = document.getElementById('draggable-chart');
    const chartHandle = document.getElementById('chart-drag-handle');
    const dimOverlay = document.getElementById('dim-overlay');
    const chipPanel = document.getElementById('chip-panel');

    window.addEventListener('DOMContentLoaded', () => {
      let fill = document.getElementById('loader-fill');
      let w = 0;
      let loadInterval = setInterval(() => {
        w += Math.floor(Math.random() * 20) + 10;
        if (w >= 100) {
          w = 100;
          clearInterval(loadInterval);
          setTimeout(() => {
            document.getElementById('loading-screen').classList.remove('active');
            document.getElementById('lobby-screen').classList.add('active');
          }, 300);
        }
        fill.style.width = w + '%';
      }, 80);
    });

    function showToast(msg) {
      let t = document.getElementById('toast');
      t.innerText = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2500);
    }

    function enterArena(gameType) {
      document.getElementById('lobby-screen').classList.remove('active');
      let arena = document.getElementById('arena-screen');
      arena.style.display = 'flex';
      setTimeout(() => arena.classList.add('active'), 10);

      requestAnimationFrame(() => {
        initBoardPosition();
        initChartPosition();
        resetCoverPosition();
        renderChartGrids();
      });

      startCountdown();
      startBotSimulation();
    }

    function exitArena() {
      clearInterval(timerInterval);
      clearInterval(botBetInterval);
      let arena = document.getElementById('arena-screen');
      arena.classList.remove('active');
      setTimeout(() => {
        arena.style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 250);
    }

    let isDraggingBoard = false;
    let boardX = 0, boardY = 0;
    let boardStartX = 0, boardStartY = 0;

    function initBoardPosition() {
      boardX = (window.innerWidth - dragBoard.offsetWidth) / 2;
      boardY = (window.innerHeight - dragBoard.offsetHeight) / 2;
      dragBoard.style.left = boardX + 'px';
      dragBoard.style.top = boardY + 'px';
    }

    dragBoard.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.circle-btn') || e.target.closest('.btn-cuoc-oval') || 
          e.target.closest('.btn-nan-hand') || e.target.closest('.chip-panel-real') ||
          e.target.closest('.center-plate') || e.target.closest('#plate-cover')) {
        return;
      }
      isDraggingBoard = true;
      boardStartX = e.clientX - boardX;
      boardStartY = e.clientY - boardY;
      dragBoard.setPointerCapture(e.pointerId);
    });

    dragBoard.addEventListener('pointermove', (e) => {
      if (!isDraggingBoard) return;
      const prevBoardX = boardX;
      const prevBoardY = boardY;

      boardX = e.clientX - boardStartX;
      boardY = e.clientY - boardStartY;
      dragBoard.style.left = boardX + 'px';
      dragBoard.style.top = boardY + 'px';

      if (gameState === 'NAN' && isNanMode && !isDraggingCover) {
        coverX += (boardX - prevBoardX);
        coverY += (boardY - prevBoardY);
        plateCover.style.left = coverX + 'px';
        plateCover.style.top = coverY + 'px';
      }
    });

    dragBoard.addEventListener('pointerup', (e) => {
      if (!isDraggingBoard) return;
      isDraggingBoard = false;
      try { dragBoard.releasePointerCapture(e.pointerId); } catch(err){}
    });

    let isDraggingChart = false;
    let chartX = 0, chartY = 0;
    let chartStartX = 0, chartStartY = 0;

    function initChartPosition() {
      chartX = (window.innerWidth - dragChart.offsetWidth) / 2;
      chartY = (window.innerHeight - dragChart.offsetHeight) / 2;
      dragChart.style.left = chartX + 'px';
      dragChart.style.top = chartY + 'px';
    }

    chartHandle.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.btn-close-chart')) return;
      isDraggingChart = true;
      chartStartX = e.clientX - chartX;
      chartStartY = e.clientY - chartY;
      chartHandle.setPointerCapture(e.pointerId);
    });

    chartHandle.addEventListener('pointermove', (e) => {
      if (!isDraggingChart) return;
      chartX = e.clientX - chartStartX;
      chartY = e.clientY - chartStartY;
      dragChart.style.left = chartX + 'px';
      dragChart.style.top = chartY + 'px';
    });

    chartHandle.addEventListener('pointerup', (e) => {
      if (!isDraggingChart) return;
      isDraggingChart = false;
      try { chartHandle.releasePointerCapture(e.pointerId); } catch(err){}
    });

    function resetCoverPosition() {
      const centerPlate = document.getElementById('center-plate');
      const rect = centerPlate.getBoundingClientRect();
      coverX = rect.left + (rect.width - 210) / 2;
      coverY = rect.top + (rect.height - 210) / 2;
      plateCover.style.left = coverX + 'px';
      plateCover.style.top = coverY + 'px';
    }

    plateCover.addEventListener('pointerdown', (e) => {
      if (gameState === 'BETTING' || !isNanMode) return;
      e.stopPropagation();
      isDraggingCover = true;
      coverStartX = e.clientX - coverX;
      coverStartY = e.clientY - coverY;
      plateCover.setPointerCapture(e.pointerId);
    });

    plateCover.addEventListener('pointermove', (e) => {
      if (!isDraggingCover || !isNanMode) return;
      coverX = e.clientX - coverStartX;
      coverY = e.clientY - coverStartY;
      plateCover.style.left = coverX + 'px';
      plateCover.style.top = coverY + 'px';
    });

    plateCover.addEventListener('pointerup', (e) => {
      if (!isDraggingCover) return;
      isDraggingCover = false;
      try { plateCover.releasePointerCapture(e.pointerId); } catch(err){}

      const centerPlate = document.getElementById('center-plate').getBoundingClientRect();
      const coverRect = plateCover.getBoundingClientRect();
      const distance = Math.hypot((coverRect.left + 105) - (centerPlate.left + 107.5), (coverRect.top + 105) - (centerPlate.top + 107.5));
      if (distance > 110) {
        finishOpeningCover();
      }
    });

    function openBetPanel(side) {
      if (gameState !== 'BETTING') {
        showToast('⏳ Đã hết thời gian đặt cược!');
        return;
      }
      currentBetSide = side;
      tempBetAmount = 0;
      chipPanel.classList.remove('hidden');
      
      document.getElementById('val-TAI').innerText = confirmedBets.TAI > 0 ? formatMoney(confirmedBets.TAI) : 'CƯỢC';
      document.getElementById('val-XIU').innerText = confirmedBets.XIU > 0 ? formatMoney(confirmedBets.XIU) : 'CƯỢC';
      
      document.getElementById(`val-${side}`).innerText = confirmedBets[side] > 0 ? formatMoney(confirmedBets[side]) : '0';
      document.getElementById(`val-${side}`).classList.add('active-bet');
    }

    function addChip(amount) {
      if (!currentBetSide) {
        showToast('⚠️ Vui lòng chọn cửa Tài hoặc Xỉu trước!');
        return;
      }
      if (balance < tempBetAmount + amount) {
        showToast('❌ Số dư không đủ để cược mức này!');
        return;
      }
      tempBetAmount += amount;
      let totalDisplayVal = confirmedBets[currentBetSide] + tempBetAmount;
      document.getElementById(`val-${currentBetSide}`).innerText = formatMoney(totalDisplayVal);
      showToast(`🪙 Đã thêm ${formatMoney(amount)} vào vé cược`);
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('❌ Tài khoản đã hết số dư!');
        return;
      }
      tempBetAmount = balance;
      let totalDisplayVal = confirmedBets[currentBetSide] + tempBetAmount;
      document.getElementById(`val-${currentBetSide}`).innerText = formatMoney(totalDisplayVal);
      showToast('🔥 Đã All-In toàn bộ số dư!');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('⚠️ Vui lòng chọn số tiền cược hợp lệ!');
        return;
      }
      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      updateBalances();

      document.getElementById(`${currentBetSide.toLowerCase()}-amount`).innerText = formatMoney(confirmedBets[currentBetSide]);
      document.getElementById(`${currentBetSide.toLowerCase()}-amount`).classList.add('jump-glow');
      setTimeout(() => document.getElementById(`${currentBetSide.toLowerCase()}-amount`).classList.remove('jump-glow'), 400);

      showToast(`✅ Đã xác nhận cược thêm ${formatMoney(tempBetAmount)} vào ${currentBetSide}!`);
      cancelBet();
    }

    function cancelBet() {
      if (currentBetSide && confirmedBets[currentBetSide] === 0) {
        document.getElementById(`val-${currentBetSide}`).innerText = 'CƯỢC';
        document.getElementById(`val-${currentBetSide}`).classList.remove('active-bet');
      } else if (currentBetSide && confirmedBets[currentBetSide] > 0) {
        document.getElementById(`val-${currentBetSide}`).innerText = formatMoney(confirmedBets[currentBetSide]);
      }
      currentBetSide = null;
      tempBetAmount = 0;
      chipPanel.classList.add('hidden');
    }

    function updateBalances() {
      document.getElementById('user-balance').innerText = '$ ' + formatMoney(balance);
      document.getElementById('arena-balance').innerText = '$ ' + formatMoney(balance);
    }

    function formatMoney(num) {
      return num.toLocaleString('en-US');
    }

    function startCountdown() {
      clearInterval(timerInterval);
      timer = 40;
      gameState = 'BETTING';
      confirmedBets = { TAI: 0, XIU: 0 };
      tempBetAmount = 0;
      currentBetSide = null;

      currentTaiBet = 0;
      currentXiuBet = 0;
      document.getElementById('tai-amount').innerText = '0';
      document.getElementById('xiu-amount').innerText = '0';

      document.getElementById('val-TAI').innerText = 'CƯỢC';
      document.getElementById('val-XIU').innerText = 'CƯỢC';
      document.getElementById('val-TAI').classList.remove('active-bet');
      document.getElementById('val-XIU').classList.remove('active-bet');
      chipPanel.classList.add('hidden');

      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('win-overlay').style.display = 'none';
      plateCover.style.display = 'none';
      dimOverlay.classList.remove('active');

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer;

        if (timer <= 5 && timer > 0) {
          showToast(`⚠️ Sắp hết giờ: ${timer}s`);
        }

        if (timer <= 0) {
          clearInterval(timerInterval);
          lockBetsAndRoll();
        }
      }, 1000);
    }

    function lockBetsAndRoll() {
      gameState = 'NAN';
      chipPanel.classList.add('hidden');
      document.getElementById('timer-text').style.display = 'none';

      let d1 = Math.floor(Math.random() * 6) + 1;
      let d2 = Math.floor(Math.random() * 6) + 1;
      let d3 = Math.floor(Math.random() * 6) + 1;
      currentDiceResults = [d1, d2, d3];

      renderDiceFaces(d1, d2, d3);
      document.getElementById('dice-container').style.display = 'block';

      if (isNanMode) {
        dimOverlay.classList.add('active');
        plateCover.style.display = 'flex';
        resetCoverPosition();
      } else {
        setTimeout(finishOpeningCover, 800);
      }
    }

    function finishOpeningCover() {
      plateCover.style.display = 'none';
      dimOverlay.classList.remove('active');
      gameState = 'REWARD';

      let sum = currentDiceResults.reduce((a, b) => a + b, 0);
      let winSide = sum >= 11 ? 'TAI' : 'XIU';

      let winOverlay = document.getElementById('win-overlay');
      let netResult = 0;
      
      let totalBetUser = confirmedBets.TAI + confirmedBets.XIU;
      if (totalBetUser > 0) {
        if (confirmedBets[winSide] > 0) {
          let betVal = confirmedBets[winSide];
          let payout = Math.floor(betVal * 1.98); 
          balance += payout;
          netResult = payout - betVal;
          winOverlay.innerText = `+${formatMoney(netResult)}`;
        } else {
          let loseSide = winSide === 'TAI' ? 'XIU' : 'TAI';
          netResult = -confirmedBets[loseSide];
          winOverlay.innerText = `${formatMoney(netResult)}`;
        }
      } else {
        winOverlay.innerText = `${sum} - ${winSide}`;
      }
      
      updateBalances();
      winOverlay.style.display = 'block';

      historyResults.push({ side: winSide, total: sum });
      renderChartGrids();

      setTimeout(() => {
        startCountdown();
      }, 4500);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      let btnNan = document.getElementById('btn-nan');
      if (isNanMode) {
        btnNan.classList.add('active');
        showToast('✋ Đã bật chế độ Nặn Xúc Xắc');
      } else {
        btnNan.classList.remove('active');
        showToast('⚡ Đã tắt chế độ Nặn (Mở tự động)');
      }
    }

    function startBotSimulation() {
      clearInterval(botBetInterval);
      botBetInterval = setInterval(() => {
        if (gameState !== 'BETTING') return;
        currentTaiUsers += Math.floor(Math.random() * 5) - 2;
        currentXiuUsers += Math.floor(Math.random() * 5) - 2;
        document.getElementById('tai-players').innerText = Math.max(80, currentTaiUsers);
        document.getElementById('xiu-players').innerText = Math.max(75, currentXiuUsers);

        if (currentTaiBet < 2550000000) currentTaiBet += Math.floor(Math.random() * 45000000) + 15000000;
        if (currentXiuBet < 2550000000) currentXiuBet += Math.floor(Math.random() * 45000000) + 15000000;

        let taiAmtEl = document.getElementById('tai-amount');
        let xiuAmtEl = document.getElementById('xiu-amount');

        taiAmtEl.innerText = formatMoney(currentTaiBet);
        xiuAmtEl.innerText = formatMoney(currentXiuBet);

        taiAmtEl.classList.add('jump-glow');
        xiuAmtEl.classList.add('jump-glow');
        setTimeout(() => {
          taiAmtEl.classList.remove('jump-glow');
          xiuAmtEl.classList.remove('jump-glow');
        }, 300);
      }, 1000);
    }

    function renderDiceFaces(d1, d2, d3) {
      drawSingleDice('dice1', d1);
      drawSingleDice('dice2', d2);
      drawSingleDice('dice3', d3);
    }

    function drawSingleDice(elementId, value) {
      let diceEl = document.getElementById(elementId);
      diceEl.innerHTML = '';
      for (let i = 1; i <= 9; i++) {
        let pip = document.createElement('div');
        pip.className = `pip p-${i}`;
        diceEl.appendChild(pip);
      }

      let activePips = [];
      if (value === 1) activePips = [5];
      else if (value === 2) activePips = [3, 7];
      else if (value === 3) activePips = [3, 5, 7];
      else if (value === 4) activePips = [1, 3, 7, 9];
      else if (value === 5) activePips = [1, 3, 5, 7, 9];
      else if (value === 6) activePips = [1, 3, 4, 6, 7, 9];

      activePips.forEach(idx => {
        let p = diceEl.querySelector(`.p-${idx}`);
        if (p) {
          if (value === 1) {
            p.className = 'pip center-red';
          } else {
            p.style.display = 'block';
          }
        }
      });
    }

    // Mở Modal kèm thông báo tự động chuẩn thực tế
    function openChartModal() {
      document.getElementById('chart-modal').classList.add('active');
      showToast('📊 Đã tự động cập nhật Lịch Sử Phiên thành công!');
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    // Thuật toán dựng bảng cầu chính xác tuyệt đối không bị lỗi lộn xộn
    function renderChartGrids() {
      renderGridMatrix('grid-cau-top', 5, false);
      renderGridMatrix('grid-cau-bottom', 5, true);
    }

    function renderGridMatrix(containerId, rows, isColumnMode) {
      let gridContainer = document.getElementById(containerId);
      if (!gridContainer) return;
      gridContainer.innerHTML = '';

      let cols = Math.max(40, Math.ceil(historyResults.length / rows) + 5);
      let gridData = Array.from({ length: rows }, () => Array(cols).fill(null));

      let r = 0, c = 0;
      historyResults.forEach((res, index) => {
        if (index === 0) {
          r = 0; c = 0;
        } else {
          let prevRes = historyResults[index - 1];
          if (res.side === prevRes.side) {
            if (isColumnMode) {
              // Chế độ cột dọc: nếu chạm đáy hàng 5 thì rẽ sang cột bên cạnh
              if (r < rows - 1 && gridData[r + 1][c] === null) {
                r++;
              } else {
                c++;
              }
            } else {
              // Chế độ dạng lưới nối tiếp tự nhiên
              if (c < cols - 1 && gridData[r][c + 1] === null) {
                c++;
              } else if (r < rows - 1) {
                r++;
              }
            }
          } else {
            if (isColumnMode) {
              c++;
              r = 0;
              while (c < cols && gridData[r][c] !== null) {
                c++;
              }
            } else {
              c++;
              if (c >= cols) { c = 0; r = (r + 1) % rows; }
            }
          }
        }
        if (r < rows && c < cols) {
          gridData[r][c] = res;
        }
      });

      for (let rowIndex = 0; rowIndex < rows; rowIndex++) {
        for (let colIndex = 0; colIndex < cols; colIndex++) {
          let cell = document.createElement('div');
          cell.className = 'grid-cell';

          let item = gridData[rowIndex][colIndex];
          if (item) {
            let dot = document.createElement('div');
            dot.className = `dot-result ${item.side.toLowerCase()}`;
            dot.innerText = item.total;
            cell.appendChild(dot);
          }
          gridContainer.appendChild(cell);
        }
      }

      let wrapper = gridContainer.closest('.chart-section-box');
      if (wrapper) {
        wrapper.scrollLeft = wrapper.scrollWidth;
      }
    }
  </script>
