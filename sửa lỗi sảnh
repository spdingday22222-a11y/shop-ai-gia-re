      </div>
      <div>
        <button class="btn-action-bet" style="padding: 5px 18px; font-size: 12px;" onclick="showToast('Cổng Nạp Tự Động 24/7')">NẠP TIỀN</button>
      </div>
    </div>

    <div class="lobby-content">
      <div class="game-card" onclick="enterArena('MD5')">
        <div class="card-title">TÀI XỈU MD5</div>
        <div class="card-sub">MINH BẠCH 100%</div>
        <div style="text-align: center; color:#ffea00; font-size:12px; font-weight:bold;">#13217</div>
      </div>
    </div>
  </div>

  <!-- 3. ARENA GAME PLAY -->
  <div id="arena-screen" class="arena-screen">
    <div class="arena-header">
      <button class="btn-back-lobby" onclick="exitArena()">◄ RỜI SẢNH</button>
      <div style="font-weight:900; color:#ffea00; font-size: 18px;" id="arena-title">TÀI XỈU MD5</div>
      <div class="balance-box" id="arena-balance">$ 1,096,000</div>
    </div>

    <div class="arena-stage" id="arena-stage">
      <!-- Lớp Dim tối nền khi nặn -->
      <div class="dim-overlay" id="dim-overlay"></div>

      <!-- BÀN TÀI XỈU KÉO TỰ DO -->
      <div class="real-taixiu-board" id="draggable-board">
        <div class="board-logo">GO88 MD5</div>

        <!-- Các nút tiện ích xung quanh viền -->
        <div class="circle-btn btn-info" onclick="showToast('Phiên cược mã hóa MD5')">i</div>
        <div class="circle-btn btn-chart" onclick="openChartModal()">📊</div>
        <div class="circle-btn btn-help" onclick="showToast('Luật chơi: Tài (11-17), Xỉu (3-10)')">?</div>
        <div class="circle-btn btn-history" onclick="showToast('Lịch sử cược cá nhân')">📜</div>

        <div class="circle-btn btn-close" onclick="exitArena()">X</div>
        <div class="circle-btn btn-rank" onclick="showToast('Bảng vinh danh Top')">🏆</div>
        <div class="circle-btn btn-chat-toggle" onclick="showToast('Mở khung Chat')">💬</div>

        <div class="btn-nan-hand active" id="btn-nan" onclick="toggleNanMode()" title="Bật/Tắt chế độ Nặn">✋</div>

        <!-- CỬA TÀI -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="tai-players">0</span></div>
          <div class="bet-title" id="title-TAI">TÀI</div>
          <div class="bet-amount" id="tai-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('TAI')">
            <span class="bet-text-val label-cuoc" id="val-TAI">CƯỢC</span>
          </div>
        </div>

        <!-- BÁT / ĐĨA TRUNG TÂM -->
        <div class="center-plate" id="center-plate">
          <div class="timer-display" id="timer-text">15</div>

          <div class="dice-triangle-container" id="dice-container">
            <div class="dice-real" id="dice1"></div>
            <div class="dice-real" id="dice2"></div>
            <div class="dice-real" id="dice3"></div>
          </div>

          <div class="win-text-overlay" id="win-overlay">+0</div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="xiu-players">0</span></div>
          <div class="bet-title" id="title-XIU">XỈU</div>
          <div class="bet-amount" id="xiu-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('XIU')">
            <span class="bet-text-val label-cuoc" id="val-XIU">CƯỢC</span>
          </div>
        </div>

        <!-- BANNER PHÍM CHIP CƯỢC -->
        <div class="chip-panel-real hidden" id="chip-panel">
          <div class="chip-list">
            <div class="chip-btn" onclick="addChip(1000)">1K</div>
            <div class="chip-btn" onclick="addChip(10000)">10K</div>
            <div class="chip-btn" onclick="addChip(50000)">50K</div>
            <div class="chip-btn" onclick="addChip(100000)">100K</div>
            <div class="chip-btn" onclick="addChip(500000)">500K</div>
            <div class="chip-btn" onclick="addChip(1000000)">1M</div>
            <div class="chip-btn" onclick="addChip(10000000)">10M</div>
            <div class="chip-btn" onclick="addChip(50000000)">50M</div>
          </div>
          <div class="chip-actions">
            <button class="btn-action-x2" onclick="allInBet()">ALL IN</button>
            <button class="btn-action-bet" onclick="confirmBet()">ĐẶT CƯỢC</button>
            <button class="btn-action-cancel" onclick="cancelBet()">HỦY</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- POPUP BẢNG SOI CẦU MỞ RỘNG -->
  <div class="chart-modal-overlay" id="chart-modal">
    <div class="chart-modal-box">
      <div class="chart-header">
        <div class="chart-title">📊 BẢNG SOI CẦU TÀI XỈU MD5 - GO88 VIP</div>
        <div class="btn-close-chart" onclick="closeChartModal()">X</div>
      </div>
      <div class="chart-body-wrapper" id="chart-scroll-area">
        <div class="grid-cau-container" id="grid-cau"></div>
      </div>
    </div>
  </div>

  <script>
    // State Game
    let balance = 1096000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    
    // Timer System: 15s Đặt Cược + 20s Nặn
    let phase = 'BETTING'; // 'BETTING', 'NAN', 'RESULT'
    let timer = 15;
    let timerInterval = null;
    let botBetInterval = null;

    // Tiền cược bot tự động
    let taiBotAmount = 0;
    let xiuBotAmount = 0;
    let taiBotPlayers = 0;
    let xiuBotPlayers = 0;

    let diceValues = [1, 2, 3];
    let currentResultSide = null;

    // Lịch sử kết quả cầu
    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 },
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 }
    ];

    // Chế độ nặn
    let isNanMode = true;

    // Kéo nắp Bát
    const plateCover = document.getElementById('plate-cover');
    let isDraggingCover = false;
    let coverOffX = 0, coverOffY = 0;

    // Kéo Bàn Cược Tự Do
    const board = document.getElementById('draggable-board');
    let isDraggingBoard = false;
    let boardOffsetX = 0, boardOffsetY = 0;
    let currentBoardX = 0, currentBoardY = 0;

    // Loading Bar
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      
      resetBoardPosition();
      startNewSession();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
      clearInterval(botBetInterval);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã BẬT chế độ Nặn 20 giây');
      } else {
        btn.classList.remove('active');
        showToast('Đã TẮT chế độ Nặn');
      }
    }

    /* KÉO BÀN CƯỢC TỰ DO VÀ MƯỢT MÀ */
    function resetBoardPosition() {
      currentBoardX = 0;
      currentBoardY = 0;
      board.style.transform = `translate(0px, 0px)`;
    }

    board.addEventListener('pointerdown', (e) => {
      // Không kéo khi click nút chức năng hoặc chip
      if (e.target.closest('.circle-btn, .btn-cuoc-oval, .chip-panel-real, .btn-nan-hand')) return;
      isDraggingBoard = true;
      board.setPointerCapture(e.pointerId);
      boardOffsetX = e.clientX - currentBoardX;
      boardOffsetY = e.clientY - currentBoardY;
    });

    board.addEventListener('pointermove', (e) => {
      if (!isDraggingBoard) return;
      currentBoardX = e.clientX - boardOffsetX;
      currentBoardY = e.clientY - boardOffsetY;
      board.style.transform = `translate(${currentBoardX}px, ${currentBoardY}px)`;
    });

    const stopDraggingBoard = (e) => {
      if (isDraggingBoard) {
        isDraggingBoard = false;
        try { board.releasePointerCapture(e.pointerId); } catch(err){}
      }
    };
    board.addEventListener('pointerup', stopDraggingBoard);
    board.addEventListener('pointercancel', stopDraggingBoard);

    /* TỰ ĐỘNG BẮT ĐẦU PHIÊN MỚI */
    function startNewSession() {
      phase = 'BETTING';
      timer = 15;
      
      taiBotAmount = 0;
      xiuBotAmount = 0;
      taiBotPlayers = 0;
      xiuBotPlayers = 0;
      
      confirmedBets = { TAI: 0, XIU: 0 };
      document.getElementById('val-TAI').innerText = 'CƯỢC';
      document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
      document.getElementById('val-XIU').innerText = 'CƯỢC';
      document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';

      updateBotBetDisplay();

      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('win-overlay').style.display = 'none';
      document.getElementById('dim-overlay').classList.remove('active');
      
      plateCover.style.display = 'none';
      plateCover.classList.remove('fade-nan');

      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');

      startBotBetting();
      startTimer();
    }

    function startBotBetting() {
      clearInterval(botBetInterval);
      botBetInterval = setInterval(() => {
        if (phase !== 'BETTING') return;

        const addTai = Math.floor(Math.random() * 45000000) + 500000;
        const addXiu = Math.floor(Math.random() * 45000000) + 500000;

        if (taiBotAmount < 2450000000) taiBotAmount += addTai;
        if (xiuBotAmount < 2420000000) xiuBotAmount += addXiu;

        if (Math.random() > 0.4) taiBotPlayers += Math.floor(Math.random() * 4) + 1;
        if (Math.random() > 0.4) xiuBotPlayers += Math.floor(Math.random() * 4) + 1;

        updateBotBetDisplay(true);
      }, 350);
    }

    function updateBotBetDisplay(bounce = false) {
      const taiAmtEl = document.getElementById('tai-amount');
      const xiuAmtEl = document.getElementById('xiu-amount');
      const taiPlEl = document.getElementById('tai-players');
      const xiuPlEl = document.getElementById('xiu-players');

      taiAmtEl.innerText = taiBotAmount.toLocaleString();
      xiuAmtEl.innerText = xiuBotAmount.toLocaleString();
      taiPlEl.innerText = taiBotPlayers;
      xiuPlEl.innerText = xiuBotPlayers;

      if (bounce) {
        if (Math.random() > 0.5) {
          taiAmtEl.classList.add('pulse-bounce');
          setTimeout(() => taiAmtEl.classList.remove('pulse-bounce'), 150);
        } else {
          xiuAmtEl.classList.add('pulse-bounce');
          setTimeout(() => xiuAmtEl.classList.remove('pulse-bounce'), 150);
        }
      }
    }

    function startTimer() {
      clearInterval(timerInterval);
      
      timerInterval = setInterval(() => {
        timer--;

        if (phase === 'BETTING') {
          document.getElementById('timer-text').innerText = timer;
          
          if (timer <= 0) {
            clearInterval(botBetInterval);
            closeBetPanel();
            generateDiceResult();

            if (isNanMode) {
              startNanPhase();
            } else {
              showFinalResult();
            }
          }
        } 
        else if (phase === 'NAN') {
          document.getElementById('timer-text').innerText = timer;

          if (timer <= 10) {
            plateCover.classList.add('fade-nan');
          }

          if (timer <= 0) {
            showFinalResult();
          }
        }
        else if (phase === 'RESULT') {
          if (timer <= 0) {
            startNewSession();
          }
        }
      }, 1000);
    }

    function generateDiceResult() {
      diceValues = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];
      const sum = diceValues.reduce((a, b) => a + b, 0);
      currentResultSide = sum >= 11 ? 'TAI' : 'XIU';
      
      historyResults.push({ side: currentResultSide, total: sum });
      renderDiceUI();
    }

    function renderDiceUI() {
      for (let i = 1; i <= 3; i++) {
        const dEl = document.getElementById('dice' + i);
        dEl.innerHTML = '';
        const val = diceValues[i - 1];

        if (val === 1) {
          dEl.innerHTML = `<div class="pip center-red"></div>`;
        } else {
          let pips = [];
          if (val === 2) pips = [1, 9];
          else if (val === 3) pips = [1, 5, 9];
          else if (val === 4) pips = [1, 3, 7, 9];
          else if (val === 5) pips = [1, 3, 5, 7, 9];
          else if (val === 6) pips = [1, 3, 4, 6, 7, 9];

          pips.forEach(p => {
            const pipDiv = document.createElement('div');
            pipDiv.className = `pip p-${p}`;
            pipDiv.style.display = 'block';
            dEl.appendChild(pipDiv);
          });
        }
      }
    }

    function startNanPhase() {
      phase = 'NAN';
      timer = 20;
      document.getElementById('timer-text').innerText = timer;
      document.getElementById('dim-overlay').classList.add('active');

      document.getElementById('dice-container').style.display = 'block';

      // Đậy nắp đĩa đúng vị trí center plate
      const plateRect = document.getElementById('center-plate').getBoundingClientRect();
      plateCover.style.left = (plateRect.left + (plateRect.width - 210)/2) + 'px';
      plateCover.style.top = (plateRect.top + (plateRect.height - 210)/2) + 'px';
      plateCover.style.display = 'flex';
      showToast('Hãy kéo nắp đĩa để nặn kết quả!');
    }

    /* KÉO NẮP ĐĨA NẶN TỰ DO & MƯỢT MÀ */
    plateCover.addEventListener('pointerdown', (e) => {
      isDraggingCover = true;
      plateCover.setPointerCapture(e.pointerId);
      const rect = plateCover.getBoundingClientRect();
      coverOffX = e.clientX - rect.left;
      coverOffY = e.clientY - rect.top;
    });

    plateCover.addEventListener('pointermove', (e) => {
      if (!isDraggingCover) return;
      plateCover.style.left = (e.clientX - coverOffX) + 'px';
      plateCover.style.top = (e.clientY - coverOffY) + 'px';
    });

    const stopDraggingCover = (e) => {
      if (isDraggingCover) {
        isDraggingCover = false;
        try { plateCover.releasePointerCapture(e.pointerId); } catch(err){}
      }
    };
    plateCover.addEventListener('pointerup', stopDraggingCover);
    plateCover.addEventListener('pointercancel', stopDraggingCover);

    function showFinalResult() {
      phase = 'RESULT';
      timer = 5;

      document.getElementById('dim-overlay').classList.remove('active');
      plateCover.style.display = 'none';
      document.getElementById('timer-text').style.display = 'none';
      document.getElementById('dice-container').style.display = 'block';

      document.getElementById('title-' + currentResultSide).classList.add('highlight-pulse');

      const userBetOnWin = confirmedBets[currentResultSide];
      if (userBetOnWin > 0) {
        const winAmt = userBetOnWin * 2;
        balance += winAmt;
        updateBalanceDisplay();

        const winOverlay = document.getElementById('win-overlay');
        winOverlay.innerText = '+' + winAmt.toLocaleString();
        winOverlay.style.display = 'block';
      }
    }

    function updateBalanceDisplay() {
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
    }

    /* CƯỢC & CHIP PANEL */
    function openBetPanel(side) {
      if (phase !== 'BETTING') {
        showToast('Đã hết thời gian đặt cược!');
        return;
      }
      currentBetSide = side;
      tempBetAmount = 0;
      document.getElementById('chip-panel').classList.remove('hidden');
    }

    function closeBetPanel() {
      document.getElementById('chip-panel').classList.add('hidden');
      currentBetSide = null;
      tempBetAmount = 0;
    }

    function addChip(amount) {
      if (!currentBetSide) return;
      if (balance < tempBetAmount + amount) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += amount;
      updateTempBetUI();
    }

    function allInBet() {
      if (!currentBetSide) return;
      tempBetAmount = balance;
      updateTempBetUI();
    }

    function updateTempBetUI() {
      const valEl = document.getElementById('val-' + currentBetSide);
      valEl.innerText = tempBetAmount > 0 ? tempBetAmount.toLocaleString() : 'CƯỢC';
      valEl.className = 'bet-text-val active-bet';
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược');
        return;
      }
      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      updateBalanceDisplay();

      showToast(`Đã cược $${tempBetAmount.toLocaleString()} vào cửa ${currentBetSide}`);
      closeBetPanel();
    }

    function cancelBet() {
      if (currentBetSide) {
        document.getElementById('val-' + currentBetSide).innerText = 'CƯỢC';
        document.getElementById('val-' + currentBetSide).className = 'bet-text-val label-cuoc';
      }
      closeBetPanel();
    }

    /* BẢNG SOI CẦU MỞ RỘNG (5 CỘT DỌC) */
    function openChartModal() {
      renderGridCau();
      document.getElementById('chart-modal').classList.add('active');
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function renderGridCau() {
      const gridContainer = document.getElementById('grid-cau');
      gridContainer.innerHTML = '';

      let cols = [];
      let currentCol = [];
      let lastSide = null;

      historyResults.forEach(item => {
        if (!lastSide || item.side === lastSide) {
          if (currentCol.length < 5) {
            currentCol.push(item);
          } else {
            cols.push(currentCol);
            currentCol = [item];
          }
        } else {
          cols.push(currentCol);
          currentCol = [item];
        }
        lastSide = item.side;
      });
      if (currentCol.length > 0) cols.push(currentCol);

      cols.forEach(col => {
        for (let i = 0; i < 5; i++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';

          if (col[i]) {
            const dot = document.createElement('div');
            dot.className = `dot-result ${col[i].side.toLowerCase()}`;
            dot.innerText = col[i].total;
            cell.appendChild(dot);
          }
          gridContainer.appendChild(cell);
        }
      });

      const scrollArea = document.getElementById('chart-scroll-area');
      setTimeout(() => scrollArea.scrollLeft = scrollArea.scrollWidth, 50);
    }
  </script>
</body>
</html>
