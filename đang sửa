    <!-- Audio Effects (Web Audio API Synthesizer Alternative for Zero External Audio Dependency) -->
    <script>
        // --- AUDIO SYNTHESIZER ---
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioCtx();
            }
        }

        // Sound effect for shaking dice
        function playShakeSound() {
            initAudio();
            if (!audioCtx) return;

            for (let i = 0; i < 8; i++) {
                setTimeout(() => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(200 + Math.random() * 400, audioCtx.currentTime);
                    
                    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.08);
                }, i * 120 + Math.random() * 50);
            }
        }

        // Sound effect for opening bowl / win
        function playWinSound() {
            initAudio();
            if (!audioCtx) return;

            const notes = [400, 550, 700, 900];
            notes.forEach((freq, index) => {
                setTimeout(() => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                    
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.3);
                }, index * 100);
            });
        }

        // --- GAME LOGIC & STATE ---
        let balance = 1000;
        let currentBetChip = 50;
        let bets = { TAI: 0, XIU: 0 };
        let currentDiceValues = [1, 1, 1];
        let isShaking = false;
        let isBowlClosed = false;
        let history = [];

        // Matrix rotation mapping for 3D Cube faces
        // 1: front, 2: left, 3: top, 4: bottom, 5: right, 6: back
        const faceRotations = {
            1: { x: 0, y: 0 },
            2: { x: 0, y: 90 },
            3: { x: -90, y: 0 },
            4: { x: 90, y: 0 },
            5: { x: 0, y: -90 },
            6: { x: 0, y: 180 }
        };

        function selectChip(amount) {
            currentBetChip = amount;
            document.querySelectorAll('.chip-btn').forEach(btn => {
                if (parseInt(btn.innerText) === amount) {
                    btn.classList.add('bg-yellow-500', 'text-black');
                    btn.classList.remove('bg-gray-800', 'text-yellow-400');
                } else {
                    btn.classList.remove('bg-yellow-500', 'text-black');
                    btn.classList.add('bg-gray-800', 'text-yellow-400');
                }
            });
        }

        function placeBet(type) {
            if (isShaking) return;
            if (balance < currentBetChip) {
                alert("Số dư của bạn không đủ!");
                return;
            }

            balance -= currentBetChip;
            bets[type] += currentBetChip;

            updateUI();
        }

        function resetBets() {
            if (isShaking) return;
            balance += bets.TAI + bets.XIU;
            bets.TAI = 0;
            bets.XIU = 0;
            updateUI();
        }

        function updateUI() {
            document.getElementById('balance').innerText = balance.toLocaleString() + '$';
            
            // Bet amounts
            const taiBadge = document.getElementById('bet-tai-amount');
            const xiuBadge = document.getElementById('bet-xiu-amount');

            if (bets.TAI > 0) {
                taiBadge.classList.remove('hidden');
                taiBadge.querySelector('.val').innerText = bets.TAI;
            } else {
                taiBadge.classList.add('hidden');
            }

            if (bets.XIU > 0) {
                xiuBadge.classList.remove('hidden');
                xiuBadge.querySelector('.val').innerText = bets.XIU;
            } else {
                xiuBadge.classList.add('hidden');
            }
        }

        // Rotate 3D Dice to standard face
        function setDiceFace(diceId, value) {
            const dice = document.getElementById(diceId);
            const rot = faceRotations[value];
            
            // Add extra full 360 rotations for realistic rolling effect
            const extraX = (Math.floor(Math.random() * 2) + 2) * 360;
            const extraY = (Math.floor(Math.random() * 2) + 2) * 360;

            dice.style.transform = `rotateX(${rot.x + extraX}deg) rotateY(${rot.y + extraY}deg)`;
        }

        function shakeDice() {
            if (isShaking) return;

            // Close bowl lid if not closed
            const bowlLid = document.getElementById('bowl-lid');
            bowlLid.classList.remove('open');
            isBowlClosed = true;

            isShaking = true;
            playShakeSound();

            // Clear previous winner highlights
            document.getElementById('btn-tai').classList.remove('winner-active');
            document.getElementById('btn-xiu').classList.remove('winner-active');
            document.getElementById('result-text').innerText = 'Đang lắc xí ngầu...';

            // Add shake animation to plate
            const plate = document.getElementById('plate');
            plate.classList.add('shaking');

            // Generate random results
            currentDiceValues = [
                Math.floor(Math.random() * 6) + 1,
                Math.floor(Math.random() * 6) + 1,
                Math.floor(Math.random() * 6) + 1
            ];

            setTimeout(() => {
                plate.classList.remove('shaking');
                
                // Roll dice under the lid
                setDiceFace('dice1', currentDiceValues[0]);
                setDiceFace('dice2', currentDiceValues[1]);
                setDiceFace('dice3', currentDiceValues[2]);

                isShaking = false;
                
                // Switch Buttons
                document.getElementById('btn-shake').classList.add('hidden');
                document.getElementById('btn-open').classList.remove('hidden');

                document.getElementById('result-text').innerText = 'Hãy mở bát để xem kết quả!';
            }, 1200);
        }

        function openBowl() {
            if (isShaking) return;

            const bowlLid = document.getElementById('bowl-lid');
            bowlLid.classList.add('open');
            isBowlClosed = false;

            // Calculate total points
            const total = currentDiceValues.reduce((a, b) => a + b, 0);
            const isTriple = currentDiceValues[0] === currentDiceValues[1] && currentDiceValues[1] === currentDiceValues[2];
            const resultType = total >= 11 ? 'TAI' : 'XIU';

            // Highlight Winner
            if (resultType === 'TAI') {
                document.getElementById('btn-tai').classList.add('winner-active');
            } else {
                document.getElementById('btn-xiu').classList.add('winner-active');
            }

            // Payout calculation
            let winAmount = 0;
            if (bets[resultType] > 0) {
                winAmount = bets[resultType] * 2;
                balance += winAmount;
                playWinSound();
                confetti({ particleCount: 80, spread: 60, origin: { y: 0.7 } });
            }

            // Display text
            document.getElementById('result-text').innerHTML = `
                <span class="text-yellow-400">${currentDiceValues.join(' - ')}</span> | 
                <span class="text-white font-extrabold">${total} Điểm</span> - 
                <span class="${resultType === 'TAI' ? 'text-red-400' : 'text-blue-400'} font-black text-2xl">${resultType}</span>
            `;

            // Record History
            addHistory(resultType, total);

            // Reset bet amounts for next round
            bets.TAI = 0;
            bets.XIU = 0;
            updateUI();

            // Switch Buttons back
            document.getElementById('btn-shake').classList.remove('hidden');
            document.getElementById('btn-open').classList.add('hidden');
        }

        function addHistory(type, total) {
            history.unshift({ type, total });
            if (history.length > 12) history.pop();

            const historyContainer = document.getElementById('history-list');
            historyContainer.innerHTML = history.map(item => `
                <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shadow-md border ${
                    item.type === 'TAI' 
                        ? 'bg-red-900/80 border-red-500 text-red-200' 
                        : 'bg-blue-900/80 border-blue-500 text-blue-200'
                }">
                    ${item.type === 'TAI' ? 'T' : 'X'}
                </div>
            `).join('');
        }

        // Initialize default chip selection
        selectChip(50);
    </script>
</body>
</html>
