    let isRolling = false;
    let timerValue = 45;
    let timerInterval = null;
    let historyResults = ['TÀI', 'XỈU', 'TÀI', 'TÀI', 'XỈU', 'XỈU', 'XỈU', 'TÀI', 'TÀI', 'TÀI'];

    // Face Rotations for 3D Dice
    const faceRotations = {
      1: { x: 0, y: 0 },
      6: { x: 0, y: 180 },
      2: { x: 0, y: 90 },
      5: { x: 0, y: -90 },
      3: { x: -90, y: 0 },
      4: { x: 90, y: 0 }
    };

    // Toast Notification System
    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    // App Initialization
    window.addEventListener('DOMContentLoaded', () => {
      let progress = 0;
      const fill = document.getElementById('loader-fill');
      const text = document.getElementById('loader-text');
      const loaderInterval = setInterval(() => {
        progress += 4;
        fill.style.width = progress + '%';
        if (progress === 40) text.innerText = 'Đang tải Engine Vật Lý xúc xắc 3D...';
        if (progress === 80) text.innerText = 'Đang đồng bộ cổng game thực tế...';
        if (progress >= 100) {
          clearInterval(loaderInterval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
        }
      }, 50);

      renderHistoryDots();
      setupDragBowl();
    });

    // Enter & Exit Game Arena
    function enterArena(gameType) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => {
        document.getElementById('arena-screen').classList.add('active');
      }, 50);
      
      showToast('Đã vào Sảnh Tài Xỉu Thực Tế!');
      startTimer();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
    }

    // Camera 3D Toggle
    let is3DCamera = false;
    function toggleCamera3D() {
      const stage = document.getElementById('arena-stage');
      is3DCamera = !is3DCamera;
      if (is3DCamera) {
        stage.style.transform = 'rotateX(25deg)';
        showToast('Đã đổi góc nhìn 3D Thực Tế');
      } else {
        stage.style.transform = 'rotateX(0deg)';
        showToast('Đã trở về góc nhìn mặc định');
      }
    }

    // Squeeze Mode with Hand Icon & Bowl
    function toggleSqueezeMode() {
      isSqueezeMode = !isSqueezeMode;
      const bowl = document.getElementById('squeeze-bowl');
      if (isSqueezeMode) {
        bowl.style.display = 'flex';
        bowl.style.transform = 'translate(0px, 0px)';
        showToast('🤌 Bật chế độ bàn tay nặn thực tế!');
      } else {
        bowl.style.display = 'none';
        showToast('Tắt chế độ nặn, mở đĩa tự động!');
      }
    }

    // Drag Bowl Physics
    function setupDragBowl() {
      const bowl = document.getElementById('squeeze-bowl');
      let isDragging = false;
      let startX, startY;

      const onStart = (e) => {
        isDragging = true;
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        startX = pageX;
        startY = pageY;
      };

      const onMove = (e) => {
        if (!isDragging) return;
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        const deltaX = pageX - startX;
        const deltaY = pageY - startY;
        bowl.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
      };

      const onEnd = () => {
        isDragging = false;
      };

      bowl.addEventListener('mousedown', onStart);
      window.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      bowl.addEventListener('touchstart', onStart);
      window.addEventListener('touchmove', onMove);
      window.addEventListener('touchend', onEnd);
    }

    // Selection & Betting Logic
    function selectSide(side) {
      if (isRolling) return;
      selectedSide = side;
      document.getElementById('side-tai').classList.remove('selected-side');
      document.getElementById('side-xiu').classList.remove('selected-side');
      
      if (side === 'TÀI') {
        document.getElementById('side-tai').classList.add('selected-side');
      } else {
        document.getElementById('side-xiu').classList.add('selected-side');
      }
      
      document.getElementById('bottom-dock').classList.add('active-dock');
      updatePendingDisplay();
    }

    function selectChip(val) {
      selectedChipValue = val;
      const chips = document.querySelectorAll('.chip-sq');
      chips.forEach(c => c.classList.remove('selected'));
      event.currentTarget.classList.add('selected');
      
      if (selectedSide) {
        pendingBetAmount += selectedChipValue;
        updatePendingDisplay();
      }
    }

    function updatePendingDisplay() {
      const pTai = document.getElementById('pending-tai-bet');
      const pXiu = document.getElementById('pending-xiu-bet');
      
      if (selectedSide === 'TÀI') {
        pTai.style.display = 'block';
        pTai.innerText = '+' + pendingBetAmount.toLocaleString();
        pXiu.style.display = 'none';
      } else if (selectedSide === 'XỈU') {
        pXiu.style.display = 'block';
        pXiu.innerText = '+' + pendingBetAmount.toLocaleString();
        pTai.style.display = 'none';
      }
    }

    function confirmBet() {
      if (!selectedSide || pendingBetAmount <= 0) {
        showToast('Vui lòng chọn cửa cược và mức tiền!');
        return;
      }
      if (pendingBetAmount > userBalance) {
        showToast('Số dư tài khoản không đủ!');
        return;
      }

      userBalance -= pendingBetAmount;
      updateBalanceUI();

      if (selectedSide === 'TÀI') {
        myTaiBet += pendingBetAmount;
        document.getElementById('my-tai-bet').style.display = 'block';
        document.getElementById('my-tai-bet').innerText = 'Đã Cược: ' + myTaiBet.toLocaleString();
      } else {
        myXiuBet += pendingBetAmount;
        document.getElementById('my-xiu-bet').style.display = 'block';
        document.getElementById('my-xiu-bet').innerText = 'Đã Cược: ' + myXiuBet.toLocaleString();
      }

      showToast(`Đã cược ${pendingBetAmount.toLocaleString()} vào cửa ${selectedSide}!`);
      pendingBetAmount = 0;
      updatePendingDisplay();
    }

    function cancelBet() {
      pendingBetAmount = 0;
      updatePendingDisplay();
      document.getElementById('bottom-dock').classList.remove('active-dock');
      document.getElementById('side-tai').classList.remove('selected-side');
      document.getElementById('side-xiu').classList.remove('selected-side');
      selectedSide = null;
      showToast('Đã hủy thao tác đặt cược');
    }

    function doubleBet() {
      if (pendingBetAmount > 0) {
        pendingBetAmount *= 2;
        updatePendingDisplay();
      } else {
        showToast('Hãy chọn chip để nhân đôi cược');
      }
    }

    function allInBet() {
      if (!selectedSide) {
        showToast('Chọn TÀI hoặc XỈU trước khi All In!');
        return;
      }
      pendingBetAmount = userBalance;
      updatePendingDisplay();
      showToast('Đã đặt ALL IN toàn bộ số dư!');
    }

    function updateBalanceUI() {
      document.getElementById('user-balance').innerText = userBalance.toLocaleString();
      document.getElementById('arena-balance').innerText = userBalance.toLocaleString();
    }

    // Timer & Game Loop System
    function startTimer() {
      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timerValue--;
        document.getElementById('timer').innerText = timerValue;
        document.getElementById('lobby-time-1').innerText = `00:${timerValue < 10 ? '0' : ''}${timerValue}`;
        document.getElementById('lobby-time-2').innerText = `00:${timerValue < 10 ? '0' : ''}${timerValue}`;

        if (timerValue === 5) {
          showToast('Sắp hết thời gian đặt cược!');
        }

        if (timerValue <= 0) {
          rollDiceSequence();
          timerValue = 45;
        }
      }, 1000);
    }

    // Real 3D Dice Rolling Physics
    function rollDiceSequence() {
      isRolling = true;
      document.getElementById('bottom-dock').classList.remove('active-dock');

      if (isSqueezeMode) {
        const bowl = document.getElementById('squeeze-bowl');
        bowl.style.display = 'flex';
        bowl.style.transform = 'translate(0px, 0px)';
      }

      // Add Roll Animation Classes
      for (let i = 1; i <= 3; i++) {
        document.getElementById(`wrap${i}`).classList.add(`rolling-${i}`);
        document.getElementById(`cube${i}`).classList.add('rolling');
      }

      setTimeout(() => {
        // Random Result (1-6)
        const d1 = Math.floor(Math.random() * 6) + 1;
        const d2 = Math.floor(Math.random() * 6) + 1;
        const d3 = Math.floor(Math.random() * 6) + 1;
        const total = d1 + d2 + d3;
        const resultSide = total >= 11 ? 'TÀI' : 'XỈU';

        // Remove Roll Classes & Apply Rotations
        for (let i = 1; i <= 3; i++) {
          document.getElementById(`wrap${i}`).classList.remove(`rolling-${i}`);
          const cube = document.getElementById(`cube${i}`);
          cube.classList.remove('rolling');

          const val = i === 1 ? d1 : i === 2 ? d2 : d3;
          const rot = faceRotations[val];
          cube.style.transform = `rotateX(${rot.x + 1440}deg) rotateY(${rot.y + 1440}deg)`;
        }

        setTimeout(() => {
          processGameResult(resultSide, total, d1, d2, d3);
        }, 1200);

      }, 2000);
    }

    function processGameResult(resultSide, total, d1, d2, d3) {
      isRolling = false;
      historyResults.push(resultSide);
      renderHistoryDots();

      // Highlight winning side
      if (resultSide === 'TÀI') {
        document.getElementById('side-tai').classList.add('active-win');
      } else {
        document.getElementById('side-xiu').classList.add('active-win');
      }

      // Calculate Winnings
      let winMoney = 0;
      if (resultSide === 'TÀI' && myTaiBet > 0) {
        winMoney = myTaiBet * 1.98;
      } else if (resultSide === 'XỈU' && myXiuBet > 0) {
        winMoney = myXiuBet * 1.98;
      }

      if (winMoney > 0) {
        userBalance += winMoney;
        updateBalanceUI();
        showWinBanner(winMoney);
      } else {
        showToast(`Kết quả: ${resultSide} (${total} điểm: ${d1}-${d2}-${d3})`);
      }

      // Reset Board after 4 seconds
      setTimeout(() => {
        document.getElementById('side-tai').classList.remove('active-win');
        document.getElementById('side-xiu').classList.remove('active-win');
        document.getElementById('side-tai').classList.remove('selected-side');
        document.getElementById('side-xiu').classList.remove('selected-side');
        document.getElementById('my-tai-bet').style.display = 'none';
        document.getElementById('my-xiu-bet').style.display = 'none';
        myTaiBet = 0;
        myXiuBet = 0;
        selectedSide = null;
      }, 4000);
    }

    function showWinBanner(amount) {
      const banner = document.getElementById('win-banner');
      document.getElementById('win-money-text').innerText = '+' + Math.floor(amount).toLocaleString();
      banner.classList.add('show');
      setTimeout(() => {
        banner.classList.remove('show');
      }, 3500);
    }

    function renderHistoryDots() {
      const container = document.getElementById('history-dots');
      container.innerHTML = '';
      const recent = historyResults.slice(-10);
      recent.forEach(res => {
        const dot = document.createElement('div');
        dot.className = `dot ${res === 'TÀI' ? 'tai' : 'xiu'}`;
        container.appendChild(dot);
      });
    }

    // MATRIX VERTICAL 5-CELL GRID LOGIC
    function openMatrixModal() {
      renderVertical5Matrix();
      document.getElementById('matrix-modal').classList.add('active');
      showToast('Hiển thị Bảng Lưới Ma Trận Dọc 5 Ô!');
    }

    function closeMatrixModal() {
      document.getElementById('matrix-modal').classList.remove('active');
    }

    function renderVertical5Matrix() {
      const gridContainer = document.getElementById('matrix-grid');
      gridContainer.innerHTML = '';

      // Matrix array: 5 rows x 12 columns
      const rows = 5;
      const cols = 12;
      let gridData = Array(rows).fill(null).map(() => Array(cols).fill(null));

      let colIndex = 0;
      let rowIndex = 0;
      let prevResult = null;

      // Realistic Vertical 5-cell Dragon/Bệt logic
      historyResults.forEach((res) => {
        if (prevResult === null) {
          gridData[rowIndex][colIndex] = res;
        } else if (res === prevResult) {
          // Bệt cầu -> Xuống ô dưới
          if (rowIndex + 1 < rows) {
            rowIndex++;
          } else {
            // Đã chạm đáy 5 ô -> Nhảy sang cột bên cạnh thực tế (bệt đúng cạnh xỉu xỉu / tài tài)
            colIndex++;
          }
          gridData[rowIndex][colIndex] = res;
        } else {
          // Bẻ cầu -> Bắt đầu cột mới ở hàng 0
          colIndex++;
          rowIndex = 0;
          if (colIndex < cols) {
            gridData[rowIndex][colIndex] = res;
          }
        }
        prevResult = res;
      });

      // Render 5x12 Cells into DOM
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const cell = document.createElement('div');
          cell.className = 'matrix-cell';
          const val = gridData[r][c];
          if (val === 'TÀI') {
            cell.classList.add('cell-tai');
            cell.innerText = 'T';
          } else if (val === 'XỈU') {
            cell.classList.add('cell-xiu');
            cell.innerText = 'X';
          }
          gridContainer.appendChild(cell);
        }
      }
    }
  </script>
</body>
</html>
