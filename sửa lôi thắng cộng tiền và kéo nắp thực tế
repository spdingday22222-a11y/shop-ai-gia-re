        <div class="circle-btn btn-info" onclick="showToast('Phiên cược mã hóa MD5')">i</div>
        <div class="circle-btn btn-chart" onclick="openChartModal()">📊</div>
        <div class="circle-btn btn-help" onclick="showToast('Luật chơi: Tài (11-17), Xỉu (3-10)')">?</div>
        <div class="circle-btn btn-history" onclick="showToast('Lịch sử cược cá nhân')">📜</div>

        <div class="circle-btn btn-close" onclick="exitArena()">X</div>
        <div class="circle-btn btn-rank" onclick="showToast('Bảng vinh danh Top')">🏆</div>
        <div class="circle-btn btn-chat-toggle" onclick="showToast('Mở khung Chat')">💬</div>

        <div class="btn-nan-hand" id="btn-nan" onclick="toggleNanMode()" title="Bật/Tắt chế độ Nặn">✋</div>

        <!-- CỬA TÀI -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="tai-players">0</span></div>
          <div class="bet-title" id="title-TAI">TÀI</div>
          <div class="bet-amount" id="tai-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('TAI')">
            <span class="bet-text-val label-cuoc" id="val-TAI">CƯỢC</span>
          </div>
        </div>

        <!-- BÁT / ĐĨA TRUNG TÂM & 3 XÚC XẮC 3D -->
        <div class="center-plate" id="center-plate">
          <div class="timer-display" id="timer-text">50</div>

          <!-- Hệ thống 3 xúc sắc -->
          <div class="dice-3d-scene" id="dice-container">
            <div class="dice-box" id="dice1">
              <div class="dice-face face-front"></div>
              <div class="dice-face face-back"></div>
              <div class="dice-face face-right"></div>
              <div class="dice-face face-left"></div>
              <div class="dice-face face-top"></div>
              <div class="dice-face face-bottom"></div>
            </div>
            <div class="dice-box" id="dice2">
              <div class="dice-face face-front"></div>
              <div class="dice-face face-back"></div>
              <div class="dice-face face-right"></div>
              <div class="dice-face face-left"></div>
              <div class="dice-face face-top"></div>
              <div class="dice-face face-bottom"></div>
            </div>
            <div class="dice-box" id="dice3">
              <div class="dice-face face-front"></div>
              <div class="dice-face face-back"></div>
              <div class="dice-face face-right"></div>
              <div class="dice-face face-left"></div>
              <div class="dice-face face-top"></div>
              <div class="dice-face face-bottom"></div>
            </div>
          </div>

          <div class="plate-cover" id="plate-cover">
            <div class="plate-cover-knob"></div>
          </div>

          <div class="win-text-overlay" id="win-overlay">+0</div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="xiu-players">0</span></div>
          <div class="bet-title" id="title-XIU">XỈU</div>
          <div class="bet-amount" id="xiu-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('XIU')">
            <span class="bet-text-val label-cuoc" id="val-XIU">CƯỢC</span>
          </div>
        </div>

        <!-- BANNER PHÍM CHIP CƯỢC -->
        <div class="chip-panel-real hidden" id="chip-panel">
          <div class="chip-list">
            <div class="chip-btn" onclick="addChip(1000)">1K</div>
            <div class="chip-btn" onclick="addChip(10000)">10K</div>
            <div class="chip-btn" onclick="addChip(50000)">50K</div>
            <div class="chip-btn" onclick="addChip(100000)">100K</div>
            <div class="chip-btn" onclick="addChip(500000)">500K</div>
            <div class="chip-btn" onclick="addChip(1000000)">1M</div>
            <div class="chip-btn" onclick="addChip(10000000)">10M</div>
            <div class="chip-btn" onclick="addChip(50000000)">50M</div>
          </div>
          <div class="chip-actions">
            <button class="btn-action-x2" onclick="allInBet()">ALL IN</button>
            <button class="btn-action-bet" onclick="confirmBet()">ĐẶT CƯỢC</button>
            <button class="btn-action-cancel" onclick="cancelBet()">HỦY</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- POPUP BẢNG SOI CẦU MỞ RỘNG -->
  <div class="chart-modal-overlay" id="chart-modal">
    <div class="chart-modal-box">
      <div class="chart-header">
        <div class="chart-title">📊 BẢNG SOI CẦU TÀI XỈU MD5 - GO88 VIP</div>
        <div class="btn-close-chart" onclick="closeChartModal()">X</div>
      </div>
      <div class="chart-body-wrapper" id="chart-scroll-area">
        <div class="grid-cau-container" id="grid-cau"></div>
      </div>
    </div>
  </div>

  <script>
    // System & Player State
    let balance = 1500000000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    
    // Timer Realtime chuẩn hóa timestamp (tránh đơ lag / nhân đôi vòng lặp)
    let globalSessionStartTime = Date.now();
    const ROUND_BET_TIME = 50; // 50 giây cho cược
    const ROUND_TOTAL_TIME = 60; // 60 giây tổng phiên
    let currentRoundId = Math.floor(Date.now() / (ROUND_TOTAL_TIME * 1000));
    let lastProcessedRound = -1;

    // Quản lý bot tự động tăng cược
    let totalTaiAmount = 0;
    let totalXiuAmount = 0;
    let taiPlayersCount = 0;
    let xiuPlayersCount = 0;
    let targetTaiMax = 0;
    let targetXiuMax = 0;
    let targetTaiPlayersMax = 0;
    let targetXiuPlayersMax = 0;

    let currentResultSide = null;
    let currentDiceVals = [1, 2, 3];

    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 },
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 }
    ];

    let isNanMode = false;
    let isDraggingCover = false;
    let coverCurX = 0, coverCurY = 0;

    // Kéo thả bàn cược tự do mượt mà
    let isDraggingBoard = false;
    let boardStartX = 0, boardStartY = 0;
    let boardPosX = 0, boardPosY = 0;

    // Loading Screen
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
        startGlobalGameLoop();
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      initBoardDrag();
      updateBalancesUI();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn tay (Kéo thả đĩa tự do)');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    /* Kéo thả Bàn Cược mượt mà không bị giật lag */
    function initBoardDrag() {
      const board = document.getElementById('game-board-container');
      
      const onPointerDown = (e) => {
        // Tránh kéo bàn khi ấn vào các nút bấm hoặc đĩa nặn
        if (e.target.closest('.circle-btn, .btn-cuoc-oval, .btn-nan-hand, .chip-panel-real, .plate-cover')) return;
        isDraggingBoard = true;
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        boardStartX = pageX - boardPosX;
        boardStartY = pageY - boardPosY;
      };

      const onPointerMove = (e) => {
        if (!isDraggingBoard) return;
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        boardPosX = pageX - boardStartX;
        boardPosY = pageY - boardStartY;
        board.style.transform = `translate(${boardPosX}px, ${boardPosY}px)`;
      };

      const onPointerUp = () => { isDraggingBoard = false; };

      board.removeEventListener('mousedown', onPointerDown);
      board.removeEventListener('touchstart', onPointerDown);
      window.removeEventListener('mousemove', onPointerMove);
      window.removeEventListener('touchmove', onPointerMove);
      window.removeEventListener('mouseup', onPointerUp);
      window.removeEventListener('touchend', onPointerUp);

      board.addEventListener('mousedown', onPointerDown);
      board.addEventListener('touchstart', onPointerDown, { passive: false });
      window.addEventListener('mousemove', onPointerMove);
      window.addEventListener('touchmove', onPointerMove, { passive: false });
      window.addEventListener('mouseup', onPointerUp);
      window.addEventListener('touchend', onPointerUp);
    }

    /* Quản Lý Cược */
    function openBetPanel(side) {
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Đã chọn cửa ' + side + '. Chọn chip cược!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In toàn bộ số tiền!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      showToast('Đã hủy thao tác cược!');
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược!');
        return;
      }

      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      
      updateBalancesUI();
      showToast('Đặt cược thành công ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      const el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function updateBalancesUI() {
      const formatted = '$ ' + balance.toLocaleString();
      document.getElementById('user-balance').innerText = formatted;
      document.getElementById('arena-balance').innerText = formatted;
    }

    /* Vòng Lặp Game Toàn Cục Chống Đơ/Lỗi Khi Chuyển Tab/Vào Lại Sảnh */
    function startGlobalGameLoop() {
      setInterval(() => {
        const now = Date.now();
        const secondInSession = Math.floor(now / 1000) % ROUND_TOTAL_TIME;
        const timerLeft = Math.max(0, ROUND_BET_TIME - secondInSession);
        const roundId = Math.floor(now / (ROUND_TOTAL_TIME * 1000));

        // Khi sang phiên mới hoàn toàn
        if (roundId !== lastProcessedRound) {
          lastProcessedRound = roundId;
          initNewRound();
        }

        // Cập nhật đồng hồ UI
        const timerEl = document.getElementById('timer-text');
        if (secondInSession < ROUND_BET_TIME) {
          timerEl.innerText = timerLeft;
          timerEl.style.display = 'block';
          // Tự động tăng cược thực tế trong thời gian đếm ngược
          simulateBotBets(secondInSession);
        } else {
          timerEl.innerText = '0';
          timerEl.style.display = 'none';
          // Giai đoạn kết quả / nặn
          if (secondInSession === ROUND_BET_TIME && !document.getElementById('dice-container').style.display.includes('block')) {
            processRoundResult();
          }
        }
      }, 200);
    }

    /* Reset Tiền Cược Về 0 Khi Sang Ván Mới & Tạo Ngưỡng Đỉnh Tới ~2.5 Tỷ */
    function initNewRound() {
      // 1. Reset sạch tiền hai bên về 0 trước
      totalTaiAmount = 0;
      totalXiuAmount = 0;
      taiPlayersCount = 0;
      xiuPlayersCount = 0;

      triggerBounce('tai-amount');
      triggerBounce('xiu-amount');
      triggerBounce('tai-players');
      triggerBounce('xiu-players');

      document.getElementById('tai-amount').innerText = '0';
      document.getElementById('xiu-amount').innerText = '0';
      document.getElementById('tai-players').innerText = '0';
      document.getElementById('xiu-players').innerText = '0';

      // 2. Thiết lập mục tiêu tối đa đỉnh cao ngẫu nhiên (từ 1.8 tỷ đến 2.48 tỷ VNĐ mỗi bên)
      targetTaiMax = Math.floor(Math.random() * 680000000) + 1800000000;
      targetXiuMax = Math.floor(Math.random() * 680000000) + 1800000000;
      targetTaiPlayersMax = Math.floor(Math.random() * 1200) + 1800;
      targetXiuPlayersMax = Math.floor(Math.random() * 1200) + 1800;

      // Reset các trạng thái giao diện cược
      confirmedBets = { TAI: 0, XIU: 0 };
      currentBetSide = null;
      tempBetAmount = 0;

      document.getElementById('val-TAI').innerText = 'CƯỢC';
      document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
      document.getElementById('val-XIU').innerText = 'CƯỢC';
      document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';
      document.getElementById('chip-panel').classList.add('hidden');

      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');
      document.getElementById('win-overlay').style.display = 'none';
      document.getElementById('dim-overlay').classList.remove('active');
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('plate-cover').style.display = 'none';
    }

    /* Mô Phỏng Tăng Cược Tự Động Nhảy Nảy Số Tố / Nhỏ Chân Thật */
    function simulateBotBets(secondInSession) {
      if (secondInSession >= ROUND_BET_TIME) return;

      const progress = Math.min(1, secondInSession / (ROUND_BET_TIME - 2));
      
      // Tăng số ngẫu nhiên theo nhịp
      const newTaiTarget = Math.floor(targetTaiMax * Math.pow(progress, 1.2));
      const newXiuTarget = Math.floor(targetXiuMax * Math.pow(progress, 1.2));
      
      const newTaiPlayers = Math.floor(targetTaiPlayersMax * progress);
      const newXiuPlayers = Math.floor(targetXiuPlayersMax * progress);

      // Nếu có biến động tiền cược thì nảy số
      if (newTaiTarget > totalTaiAmount) {
        totalTaiAmount = newTaiTarget;
        document.getElementById('tai-amount').innerText = totalTaiAmount.toLocaleString();
        if (Math.random() > 0.4) triggerBounce('tai-amount');
      }

      if (newXiuTarget > totalXiuAmount) {
        totalXiuAmount = newXiuTarget;
        document.getElementById('xiu-amount').innerText = totalXiuAmount.toLocaleString();
        if (Math.random() > 0.4) triggerBounce('xiu-amount');
      }

      if (newTaiPlayers > taiPlayersCount) {
        taiPlayersCount = newTaiPlayers;
        document.getElementById('tai-players').innerText = taiPlayersCount.toLocaleString();
        if (Math.random() > 0.5) triggerBounce('tai-players');
      }

      if (newXiuPlayers > xiuPlayersCount) {
        xiuPlayersCount = newXiuPlayers;
        document.getElementById('xiu-players').innerText = xiuPlayersCount.toLocaleString();
        if (Math.random() > 0.5) triggerBounce('xiu-players');
      }
    }

    function triggerBounce(elementId) {
      const el = document.getElementById(elementId);
      if (!el) return;
      el.classList.remove('bounce-trigger');
      void el.offsetWidth; // Force reflow
      el.classList.add('bounce-trigger');
    }

    /* Tính Toán Kết Quả Phán Quyết & Nặn Bát */
    function processRoundResult() {
      // Tạo 3 xúc xắc ngẫu nhiên
      currentDiceVals = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];

      const sum = currentDiceVals.reduce((a, b) => a + b, 0);
      currentResultSide = sum >= 11 ? 'TAI' : 'XIU';

      // Cập nhật mặt xúc xắc 3D
      renderDiceFaces(1, currentDiceVals[0]);
      renderDiceFaces(2, currentDiceVals[1]);
      renderDiceFaces(3, currentDiceVals[2]);

      document.getElementById('dice-container').style.display = 'block';

      if (isNanMode) {
        // Hiện đĩa đậy lên xúc xắc để nặn
        const cover = document.getElementById('plate-cover');
        cover.style.transform = 'translate(0px, 0px)';
        cover.style.display = 'flex';
        initPlateDrag();
        showToast('Mời bạn kéo nặn bát để mở kết quả!');
      } else {
        // Mở thẳng kết quả
        finishResultPresentation();
      }
    }

    function initPlateDrag() {
      const cover = document.getElementById('plate-cover');
      let startX = 0, startY = 0;

      const onDown = (e) => {
        isDraggingCover = true;
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        startX = pageX - coverCurX;
        startY = pageY - coverCurY;
      };

      const onMove = (e) => {
        if (!isDraggingCover) return;
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        coverCurX = pageX - startX;
        coverCurY = pageY - startY;
        cover.style.transform = `translate(${coverCurX}px, ${coverCurY}px)`;

        // Nếu kéo xa hơn 70px thì coi như đã mở đĩa
        const dist = Math.sqrt(coverCurX * coverCurX + coverCurY * coverCurY);
        if (dist > 75) {
          isDraggingCover = false;
          cover.style.display = 'none';
          coverCurX = 0; coverCurY = 0;
          finishResultPresentation();
        }
      };

      const onUp = () => { isDraggingCover = false; };

      cover.onmousedown = onDown;
      cover.ontouchstart = onDown;
      window.onmousemove = onMove;
      window.ontouchmove = onMove;
      window.onmouseup = onUp;
      window.ontouchend = onUp;
    }

    function finishResultPresentation() {
      // Sáng rực bên thắng
      document.getElementById('title-' + currentResultSide).classList.add('highlight-pulse');
      document.getElementById('dim-overlay').classList.add('active');

      // Tính thưởng nếu đặt cược
      const userWinAmt = confirmedBets[currentResultSide] * 2;
      if (userWinAmt > 0) {
        balance += userWinAmt;
        updateBalancesUI();
        const winEl = document.getElementById('win-overlay');
        winEl.innerText = '+' + userWinAmt.toLocaleString();
        winEl.style.display = 'block';
      }

      // Lưu lịch sử soi cầu
      const sum = currentDiceVals.reduce((a, b) => a + b, 0);
      historyResults.unshift({ side: currentResultSide, total: sum });
      if (historyResults.length > 50) historyResults.pop();
    }

    /* Hiển thị điểm chấm xúc xắc */
    function renderDiceFaces(diceIdx, val) {
      const diceEl = document.getElementById('dice' + diceIdx);
      const faces = diceEl.querySelectorAll('.dice-face');
      
      const dotsMap = {
        1: [4],
        2: [0, 8],
        3: [0, 4, 8],
        4: [0, 2, 6, 8],
        5: [0, 2, 4, 6, 8],
        6: [0, 2, 3, 5, 6, 8]
      };

      faces.forEach(face => {
        face.innerHTML = '';
        for (let i = 0; i < 9; i++) {
          const gridCell = document.createElement('div');
          if (dotsMap[val].includes(i)) {
            const dot = document.createElement('div');
            dot.className = 'dot';
            gridCell.appendChild(dot);
          }
          face.appendChild(gridCell);
        }
      });
    }

    /* Popup Soi Cầu */
    function openChartModal() {
      renderGridCau();
      document.getElementById('chart-modal').classList.add('active');
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function renderGridCau() {
      const container = document.getElementById('grid-cau');
      container.innerHTML = '';

      let columns = [];
      let currentCol = [];
      let lastSide = null;

      historyResults.slice().reverse().forEach(item => {
        if (lastSide && lastSide !== item.side) {
          columns.push(currentCol);
          currentCol = [];
        }
        if (currentCol.length >= 5) {
          columns.push(currentCol);
          currentCol = [];
        }
        currentCol.push(item);
        lastSide = item.side;
      });
      if (currentCol.length > 0) columns.push(currentCol);

      columns.forEach(col => {
        for (let r = 0; r < 5; r++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';
          if (col[r]) {
            const dot = document.createElement('div');
            dot.className = 'dot-result ' + col[r].side.toLowerCase();
            dot.innerText = col[r].total;
            cell.appendChild(dot);
          }
          container.appendChild(cell);
        }
      });
    }
  </script>
