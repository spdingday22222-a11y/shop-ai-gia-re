<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Tài Xỉu Real VIP</title>
  <style>
    /* Reset & Base UI */
    * {
      box-sizing: border-box;
      margin: 0; padding: 0;
      user-select: none;
      font-family: 'Segoe UI', Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #020106;
      color: #ffffff;
      overflow: hidden;
      height: 100vh;
      display: flex; justify-content: center; align-items: center;
    }

    #fx-canvas {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none; z-index: 9999;
    }

    .app-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0; transition: opacity 0.3s ease; z-index: 1;
    }
    .app-screen.active { display: flex; opacity: 1; z-index: 10; }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #20003b 0%, #050010 100%);
      flex-direction: column; justify-content: center; align-items: center; z-index: 9999;
    }
    .loader-brand {
      font-size: 38px; font-weight: 900;
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 50%, #b86b00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      text-shadow: 0 0 20px rgba(245, 166, 35, 0.6); letter-spacing: 1px;
    }
    .loader-box {
      width: 320px; height: 14px; background: rgba(0,0,0,0.8);
      border: 1.5px solid #ffb703; border-radius: 10px; padding: 2px; margin-top: 20px;
    }
    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff9800, #ff5722);
      border-radius: 10px; transition: width 0.05s linear;
    }

    /* 2. GAME LOBBY */
    .game-lobby {
      width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #2a0845 0%, #120024 60%, #030008 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }
    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 24px; background: rgba(10, 3, 20, 0.95);
      border-bottom: 2px solid #ffb703; box-shadow: 0 4px 15px rgba(0,0,0,0.8); z-index: 20;
    }
    .user-info { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 44px; height: 44px; border-radius: 10px; border: 2px solid #ffb703; background-size: cover; background-position: center; }
    .balance-box {
      background: #0d021a; border: 1px solid #ffb703;
      border-radius: 18px; padding: 4px 14px; color: #ffea00;
      font-weight: 900; font-size: 15px; text-shadow: 0 0 8px rgba(255, 234, 0, 0.5);
    }
    .top-nav { display: flex; gap: 10px; font-weight: bold; font-size: 12px; }
    .top-nav span { padding: 6px 12px; border-radius: 6px; cursor: pointer; color: #c4b5fd; transition: 0.2s; }
    .top-nav span.active, .top-nav span:hover { color: #fff; background: rgba(157, 78, 221, 0.4); border: 1px solid #c4b5fd; }
    
    .btn-nap, .btn-rut {
      border: none; padding: 7px 18px; border-radius: 8px; font-weight: 900; cursor: pointer;
      box-shadow: 0 3px 8px rgba(0,0,0,0.5); transition: 0.15s; margin-left: 5px;
    }
    .btn-nap { background: linear-gradient(180deg, #2ec4b6, #0f7173); color: #fff; border: 1px solid #80ed99; }
    .btn-rut { background: linear-gradient(180deg, #e63946, #b00020); color: #fff; border: 1px solid #ff70a6; }
    .btn-nap:active, .btn-rut:active { transform: scale(0.95); }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 40px; flex: 1; }
    .game-card {
      width: 210px; height: 270px; border-radius: 18px; border: 2px solid #ffb703;
      display: flex; flex-direction: column; justify-content: space-between; padding: 12px;
      cursor: pointer; transition: transform 0.25s, box-shadow 0.25s; position: relative;
      box-shadow: 0 0 25px rgba(255, 183, 3, 0.25);
    }
    .game-card:hover { transform: translateY(-8px) scale(1.03); box-shadow: 0 0 35px rgba(255, 183, 3, 0.6); }
    .card-md5 { background: linear-gradient(180deg, #5c0f1b 0%, #1a0206 100%); border-color: #ff4d6d; }
    .card-thuong { background: linear-gradient(180deg, #0a4b6d 0%, #021622 100%); border-color: #00b4d8; }
    .card-title { font-size: 18px; font-weight: 900; text-align: center; color: #fff; text-shadow: 0 2px 6px #000; }
    .card-sub { font-size: 12px; text-align: center; color: #ffb703; font-weight: bold; }

    /* 3. ARENA GAME PLAY */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(2, 1, 6, 0.94); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
    }
    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 24px; background: rgba(10, 4, 20, 0.95); border-bottom: 2px solid #5a189a; z-index: 20;
    }
    .btn-back-lobby { background: #7209b7; color: #fff; border: 1px solid #b5179e; padding: 6px 14px; border-radius: 18px; font-weight: bold; cursor: pointer; }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; overflow: hidden; }

    /* BÀN TÀI XỈU */
    .real-taixiu-board {
      position: absolute; width: 740px; height: 360px; border-radius: 180px;
      display: flex; justify-content: space-between; align-items: center; padding: 20px 40px;
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.9), inset 0 0 20px rgba(255, 255, 255, 0.2);
      left: calc(50% - 370px); top: calc(50% - 180px);
      touch-action: none;
    }

    .real-taixiu-board.theme-md5 {
      background: radial-gradient(circle, #8a1523 0%, #47080f 60%, #1f0205 100%);
      border: 5px solid #ffb703; box-shadow: 0 0 50px rgba(255, 77, 109, 0.4);
    }
    .real-taixiu-board.theme-thuong {
      background: radial-gradient(circle, #0e6284 0%, #063447 60%, #01141c 100%);
      border: 5px solid #00b4d8; box-shadow: 0 0 50px rgba(0, 180, 216, 0.4);
    }

    .circle-btn {
      position: absolute; width: 38px; height: 38px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 14px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 8px rgba(0,0,0,0.6);
      border: 1.5px solid #ffb703; z-index: 15; transition: transform 0.15s, background 0.2s;
    }
    .theme-md5 .circle-btn { background: linear-gradient(180deg, #a81c25, #4a0508); }
    .theme-thuong .circle-btn { background: linear-gradient(180deg, #0c7496, #032d3c); }
    .circle-btn:active { transform: scale(0.88); }

    .btn-info { top: 22px; left: 150px; }
    .btn-chart { top: 90px; left: 60px; }
    .btn-help { top: 165px; left: 25px; }
    .btn-history { top: 240px; left: 60px; }

    .btn-close { top: 22px; right: 150px; background: #9e1a22 !important; }
    .btn-rank { top: 90px; right: 60px; }
    .btn-chat-toggle { top: 165px; right: 25px; }
    .btn-squeeze { top: 240px; right: 60px; font-size: 16px; }

    /* CỬA CƯỢC 3D */
    .bet-side {
      width: 200px; height: 170px; display: flex; flex-direction: column;
      justify-content: center; align-items: center; position: relative; z-index: 10;
    }
    .bet-title {
      font-size: 46px; font-weight: 900; letter-spacing: 2px; color: #f5a623;
      text-shadow: 0 4px 8px rgba(0,0,0,0.9), 0 0 10px rgba(245, 166, 35, 0.5);
      transition: transform 0.2s;
    }
    .bet-title.blink-winner { animation: blinkWinGlow 0.4s infinite alternate; }

    @keyframes blinkWinGlow {
      0% { color: #ffffff; text-shadow: 0 0 10px #fff; transform: scale(1); }
      100% { color: #ffea00; text-shadow: 0 0 25px #ffea00, 0 0 40px #ff9800; transform: scale(1.15); }
    }

    .player-count { font-size: 12px; color: #ffea00; font-weight: bold; margin-bottom: 2px; }
    .bet-amount { font-size: 17px; font-weight: 900; color: #fff; text-shadow: 0 2px 4px #000; }
    .bet-action-group { display: flex; gap: 6px; margin-top: 6px; align-items: center; }

    .btn-real-bet-logo {
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 45%, #b86b00 100%);
      border: 1.5px solid #fff; border-radius: 8px; padding: 4px 8px;
      color: #000; font-size: 11px; font-weight: 900; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.6); display: flex; flex-direction: column; align-items: center; min-width: 95px;
      transition: all 0.15s ease;
    }
    .btn-real-bet-logo:active { transform: scale(0.92); }
    .btn-real-bet-logo.active-side {
      border: 2px solid #ff9800;
      box-shadow: 0 0 12px #ff9800, inset 0 0 5px #ffffff;
    }

    .btn-alin {
      background: linear-gradient(180deg, #ff416c, #ff4b2b);
      border: 1px solid #fff; border-radius: 8px; padding: 6px 10px;
      color: #fff; font-size: 10px; font-weight: 900; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.6);
    }
    .btn-alin:active { transform: scale(0.92); }

    .user-bet-val {
      font-size: 11px; color: #ff9d00; font-weight: 900; margin-top: 2px;
      background: #0f0501; border: 1px solid #ff8000; padding: 1px 6px; border-radius: 4px;
      width: 100%; text-align: center; text-shadow: 0 0 4px #ff9d00; display: block;
    }

    /* BÁT ĐĨA XÚC XẮC */
    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 210px; height: 210px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 35px rgba(0,0,0,0.9); z-index: 5; perspective: 1000px;
    }
    .theme-md5 .center-plate { background: radial-gradient(circle, #080304 0%, #201f20 70%, #a8232c 100%); border: 4px solid #d93843; }
    .theme-thuong .center-plate { background: radial-gradient(circle, #05131a 0%, #1f2d33 70%, #16829b 100%); border: 4px solid #00d2ff; }

    .timer-display { font-size: 64px; font-weight: 900; z-index: 6; opacity: 0.95; pointer-events: none; }
    .theme-md5 .timer-display { color: #ffea00; text-shadow: 0 0 10px #ffea00; }
    .theme-thuong .timer-display { color: #00f0ff; text-shadow: 0 0 10px #00f0ff; }

    /* NẮP BÁT - KÉO THẢ TỰ DO */
    .bowl-cover {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #4a4a4a 0%, #111111 70%, #000000 100%);
      border: 6px solid #d4af37; box-shadow: inset 0 0 20px rgba(255,255,255,0.3), 0 10px 30px rgba(0,0,0,0.9);
      z-index: 50; cursor: grab; display: flex; justify-content: center; align-items: center; touch-action: none;
      transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .bowl-cover.dragging { transition: none; cursor: grabbing; }
    .bowl-handle { width: 48px; height: 48px; border-radius: 50%; background: radial-gradient(circle, #ffe066, #b86b00); border: 2px solid #fff; pointer-events: none;}

    /* 3 VIÊN XÚC XẮC 3D */
    .dice-3d-arena { position: absolute; width: 100px; height: 100px; z-index: 8; transform-style: preserve-3d; display: flex; justify-content: center; align-items: center; }
    .cube-wrapper { position: absolute; width: 38px; height: 38px; transform-style: preserve-3d; }
    #wrap1 { top: 8px; left: 31px; }
    #wrap2 { bottom: 12px; left: 8px; }
    #wrap3 { bottom: 12px; right: 8px; }

    .cube { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.2, 0.85, 0.32, 1.2); }
    .cube.rolling { animation: roll3d 0.2s infinite linear; }

    @keyframes roll3d {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      100% { transform: rotateX(360deg) rotateY(360deg) rotateZ(360deg); }
    }

    .face {
      position: absolute; width: 38px; height: 38px; background: linear-gradient(145deg, #e60000, #990000);
      border: 1.5px solid #ffffff; border-radius: 8px; display: grid;
      grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 3px; align-items: center; justify-items: center; backface-visibility: hidden;
      box-shadow: inset 0 0 6px rgba(255, 255, 255, 0.6), 0 2px 4px rgba(0,0,0,0.5);
    }
    .face-1 { transform: rotateY(0deg) translateZ(19px); }
    .face-6 { transform: rotateY(180deg) translateZ(19px); }
    .face-2 { transform: rotateY(-90deg) translateZ(19px); }
    .face-5 { transform: rotateY(90deg) translateZ(19px); }
    .face-3 { transform: rotateX(90deg) translateZ(19px); }
    .face-4 { transform: rotateX(-90deg) translateZ(19px); }

    .dot-pip { width: 6px; height: 6px; background: #ffffff; border-radius: 50%; display: none; box-shadow: inset 0 0 2px rgba(0,0,0,0.6); }
    .face-1 .dot-pip.red-giant { display: block; width: 12px; height: 12px; background: #ffffff; grid-column: 2; grid-row: 2; }
    .p1 { grid-column: 1; grid-row: 1; } .p3 { grid-column: 3; grid-row: 1; }
    .p4 { grid-column: 1; grid-row: 2; } .p5 { grid-column: 2; grid-row: 2; } .p6 { grid-column: 3; grid-row: 2; }
    .p7 { grid-column: 1; grid-row: 3; } .p9 { grid-column: 3; grid-row: 3; }

    .face-2 .p1, .face-2 .p9 { display: block; }
    .face-3 .p1, .face-3 .p5, .face-3 .p9 { display: block; }
    .face-4 .p1, .face-4 .p3, .face-4 .p7, .face-4 .p9 { display: block; }
    .face-5 .p1, .face-5 .p3, .face-5 .p5, .face-5 .p7, .face-5 .p9 { display: block; }
    .face-6 .p1, .face-6 .p3, .face-6 .p4, .face-6 .p6, .face-6 .p7, .face-6 .p9 { display: block; }

    /* THANH CHIP CƯỢC NEO XANH LÁ CÂY VÀ VÀNG CAM */
    .chip-bar-container {
      position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 6px; background: rgba(2, 20, 10, 0.95);
      border: 2px solid #00ff66; box-shadow: 0 0 15px rgba(0, 255, 102, 0.5);
      padding: 6px 12px; border-radius: 14px; z-index: 100; transition: all 0.3s ease;
      max-width: 98vw; overflow-x: auto;
    }
    .chip-bar-container.hidden-bet { opacity: 0; pointer-events: none; transform: translateX(-50%) translateY(40px); }
    
    .chip-item-sq {
      min-width: 42px; height: 34px; border-radius: 6px; border: 1px solid #00ff66;
      background: linear-gradient(180deg, #093318 0%, #021a0b 100%);
      display: flex; justify-content: center; align-items: center; font-size: 10px;
      font-weight: 900; color: #39ff14; cursor: pointer; transition: 0.15s;
      box-shadow: inset 0 0 5px rgba(57, 255, 20, 0.3);
    }
    .chip-item-sq.selected {
      background: linear-gradient(180deg, #00ff66, #008033);
      color: #000; border-color: #fff; transform: translateY(-4px);
      box-shadow: 0 0 10px #00ff66;
    }

    .btn-chip-action {
      border: none; color: #fff; font-weight: 900; border-radius: 6px; padding: 0 10px;
      cursor: pointer; font-size: 11px; box-shadow: 0 2px 6px rgba(0,0,0,0.5); transition: transform 0.1s;
    }
    .btn-chip-action:active { transform: scale(0.92); }
    .btn-chip-confirm { background: linear-gradient(180deg, #ff9800, #e65100); border: 1px solid #ffe082; }
    .btn-chip-cancel { background: linear-gradient(180deg, #d32f2f, #8b0000); border: 1px solid #ff8a80; }

    /* MODAL CHUNG */
    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0, 0, 0, 0.75); z-index: 1000; display: none;
      justify-content: center; align-items: center; backdrop-filter: blur(3px);
    }
    .modal-overlay.active { display: flex; }

    .real-modal-box {
      width: 720px; max-width: 95vw; background: #080305; border-radius: 16px;
      border: 2px solid #d4af37; box-shadow: 0 0 35px rgba(212, 175, 55, 0.4);
      overflow: hidden; position: relative; font-size: 12px;
    }
    .real-modal-header {
      background: linear-gradient(180deg, #3d0000 0%, #1a0000 100%);
      border-bottom: 2px solid #d4af37; padding: 10px 16px; display: flex;
      justify-content: space-between; align-items: center;
    }
    .real-modal-title { font-size: 16px; font-weight: 900; color: #ffe066; text-transform: uppercase; text-shadow: 0 1px 3px #000; }
    .close-modal-btn {
      width: 28px; height: 28px; background: #9e1a22; border: 1px solid #fff;
      border-radius: 50%; color: #fff; font-weight: 900; cursor: pointer;
      display: flex; justify-content: center; align-items: center;
    }

    /* BẢNG CẦU MA TRẬN NÂNG CẤP (5 DÒNG) & BIỂU ĐỒ ZIC ZAC */
    .board-summary-bar {
      display: flex; justify-content: space-around; background: #110500;
      padding: 6px; border-bottom: 1px solid #333; font-weight: bold; color: #ffe066; font-size: 12px;
    }
    .grid-cau-container { padding: 15px; background: #050102; overflow-x: auto; display: flex; flex-direction: column; gap: 12px; }
    
    .cau-top-graph {
      position: relative; width: 660px; height: 130px; background: #080204;
      border: 1px solid #555; border-radius: 6px; overflow: hidden; margin: 0 auto;
    }
    .canvas-line-layer { position: absolute; top:0; left:0; width: 100%; height: 100%; z-index: 1; }
    .nodes-layer { position: absolute; top:0; left:0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }
    
    .node-ball {
      position: absolute; width: 18px; height: 18px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; font-size: 9px; font-weight: 900;
      transform: translate(-50%, -50%); color: #000; box-shadow: 0 0 4px rgba(0,0,0,0.8);
      border: 1px solid #fff;
    }
    .node-ball.tai { background: radial-gradient(circle, #ffe066, #e65100); color: #000; }
    .node-ball.xiu { background: radial-gradient(circle, #00f0ff, #005f73); color: #fff; }

    .cau-matrix-5row {
      display: grid;
      grid-template-rows: repeat(5, 24px);
      grid-auto-flow: column;
      grid-auto-columns: 24px;
      gap: 1px; background: #111;
      border: 1px solid #d4af37; padding: 2px; width: max-content; margin: 0 auto;
      max-width: 100%; overflow-x: auto;
    }
    .cau-cell-5row {
      width: 24px; height: 24px; border: 1px solid rgba(212, 175, 55, 0.15);
      display: flex; justify-content: center; align-items: center; font-size: 10px; font-weight: 900;
    }
    .cau-cell-5row.tai { background: #ffe066; color: #000; border-radius: 50%; transform: scale(0.85); box-shadow: 0 0 4px #ffe066; }
    .cau-cell-5row.xiu { background: #00b4d8; color: #fff; border-radius: 50%; transform: scale(0.85); box-shadow: 0 0 4px #00b4d8; }

    /* LỊCH SỬ CƯỢC */
    .bet-history-table { width: 100%; border-collapse: collapse; text-align: center; font-size: 11px; }
    .bet-history-table th { background: #3a0007; color: #ffe066; padding: 8px; border: 1px solid #57060f; }
    .bet-history-table td { padding: 8px; border: 1px solid #260407; background: rgba(15, 2, 4, 0.85); color: #fff; }
    .txt-green { color: #00ff66; font-weight: bold; }
    .txt-red { color: #ff4d4d; font-weight: bold; }

    /* TOAST & POPUP */
    .toast-msg {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-50px);
      background: rgba(10,4,20,0.95); border: 2px solid #ffb703; color: #ffe066;
      padding: 8px 20px; border-radius: 20px; font-weight: bold; font-size: 13px;
      z-index: 9999; opacity: 0; transition: all 0.3s ease; pointer-events: none;
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    .win-popup, .lose-popup {
      position: absolute; top: 25%; left: 50%; transform: translateX(-50%) scale(0);
      border-radius: 20px; padding: 15px 30px; text-align: center; z-index: 200;
      opacity: 0; transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275); pointer-events: none;
    }
    .win-popup { background: radial-gradient(circle, #ff9800, #b86b00); border: 3px solid #fff; box-shadow: 0 0 40px #ffea00; color: #fff; }
    .lose-popup { background: radial-gradient(circle, #4a0000, #1a0000); border: 3px solid #ff2a2a; box-shadow: 0 0 40px #ff0000; color: #ff4d4d; }
    .win-popup.show, .lose-popup.show { transform: translateX(-50%) scale(1); opacity: 1; }
  </style>
</head>
<body>

  <canvas id="fx-canvas"></canvas>
  <div id="toast" class="toast-msg">Thông báo hệ thống</div>

  <!-- POPUP THẮNG / THUA -->
  <div id="win-popup" class="win-popup">
    <div style="font-size: 18px; font-weight: 900;">THẮNG CƯỢC!</div>
    <div style="font-size: 26px; font-weight: 900; color: #ffea00;" id="win-amount-text">+0</div>
  </div>
  <div id="lose-popup" class="lose-popup">
    <div style="font-size: 18px; font-weight: 900;">RẤT TIẾC! BẠN ĐÃ THUA CƯỢC</div>
    <div style="font-size: 13px; color: #ffffff;" id="lose-desc-text">Chúc may mắn phiên sau!</div>
  </div>

  <!-- 1. LOADING SCREEN -->
  <div id="loading-screen" class="app-screen active">
    <div class="loader-brand">TAI XIU VIP REAL</div>
    <div class="loader-box"><div class="loader-fill" id="loader-fill"></div></div>
  </div>

