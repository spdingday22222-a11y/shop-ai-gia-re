<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Rắn Săn Mồi 3D Đỉnh Cao</title>
    <!-- Tailwind CSS for UI Layout -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap');
        
        * {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
            font-family: 'Fredoka', cursive, sans-serif;
        }

        body {
            background: #0f172a;
            overflow: hidden;
            color: #fff;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.3);
            border-radius: 4px;
        }

        /* Wooden Texture Glassmorphism Effect */
        .wood-panel {
            background: rgba(30, 20, 10, 0.85);
            backdrop-filter: blur(12px);
            border: 3px solid #8B4513;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8), inset 0 0 15px rgba(139, 69, 19, 0.5);
        }

        .btn-wood {
            background: linear-gradient(135deg, #8B4513 0%, #5c2c06 100%);
            border: 2px solid #cd853f;
            box-shadow: 0 4px 0 #3a1c04, 0 6px 10px rgba(0,0,0,0.4);
            transition: all 0.1s ease;
        }

        .btn-wood:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 #3a1c04, 0 2px 5px rgba(0,0,0,0.4);
        }

        .btn-green {
            background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
            border: 2px solid #86efac;
            box-shadow: 0 4px 0 #14532d, 0 6px 10px rgba(0,0,0,0.4);
        }

        .btn-green:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 #14532d, 0 2px 5px rgba(0,0,0,0.4);
        }

        .btn-red {
            background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
            border: 2px solid #fca5a5;
            box-shadow: 0 4px 0 #7f1d1d, 0 6px 10px rgba(0,0,0,0.4);
        }

        .btn-red:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 #7f1d1d, 0 2px 5px rgba(0,0,0,0.4);
        }

        /* Canvas Container Glow */
        #game-container {
            position: relative;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9);
            border-radius: 16px;
            overflow: hidden;
        }

        /* Pulse Animation for Diamonds HUD */
        @keyframes pulse-glow {
            0%, 100% { filter: drop-shadow(0 0 5px #00ffff); }
            50% { filter: drop-shadow(0 0 15px #00ffff); }
        }

        .diamond-icon {
            animation: pulse-glow 2s infinite;
        }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-2 md:p-4">

    <!-- TOP HEADER / HUD -->
    <div class="w-full max-w-4xl flex justify-between items-center mb-2 px-3 py-2 wood-panel rounded-2xl">
        <div class="flex items-center gap-4">
            <!-- Logo Brand -->
            <div class="flex items-center gap-2 font-black text-xl md:text-2xl tracking-wider text-amber-400 drop-shadow-md">
                <i class="fa-solid fa-staff-snake text-emerald-400 text-2xl"></i>
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-amber-300 via-emerald-400 to-green-500">
                    SNAKE 3D
                </span>
            </div>

            <!-- Score Display -->
            <div class="flex items-center gap-2 bg-black/40 px-3 py-1 rounded-xl border border-amber-900/50">
                <i class="fa-solid fa-trophy text-amber-400 text-sm md:text-base"></i>
                <span class="text-xs text-amber-200/70 font-semibold uppercase hidden sm:inline">Điểm:</span>
                <span id="score-text" class="text-lg md:text-2xl font-bold text-white">0</span>
            </div>

            <!-- High Score Display -->
            <div class="flex items-center gap-2 bg-black/40 px-3 py-1 rounded-xl border border-amber-900/50 hidden md:flex">
                <i class="fa-solid fa-crown text-yellow-500 text-sm md:text-base"></i>
                <span class="text-xs text-amber-200/70 font-semibold uppercase">Kỷ lục:</span>
                <span id="highscore-text" class="text-lg md:text-xl font-bold text-amber-300">0</span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2">
            <!-- Theme Countdown Badge -->
            <div class="hidden sm:flex items-center gap-1.5 bg-amber-950/60 border border-amber-700/50 px-2.5 py-1 rounded-xl text-xs text-amber-300">
                <i class="fa-solid fa-cubes text-amber-400"></i>
                <span>Đổi sàn: <span id="theme-timer" class="font-bold text-white">120</span>s</span>
            </div>

            <!-- Settings Button -->
            <button id="btn-settings" class="btn-wood text-amber-100 p-2.5 rounded-xl text-lg hover:brightness-110 flex items-center justify-center">
                <i class="fa-solid fa-gear"></i>
            </button>

            <!-- Pause/Play Button -->
            <button id="btn-pause" class="btn-wood text-amber-100 p-2.5 rounded-xl text-lg hover:brightness-110 flex items-center justify-center">
                <i id="pause-icon" class="fa-solid fa-pause"></i>
            </button>
        </div>
    </div>

    <!-- GAME CANVAS CONTAINER -->
    <div id="game-container" class="relative w-full max-w-4xl aspect-[4/3] md:aspect-[16/10] bg-stone-900 border-4 border-amber-800/80">
        <canvas id="snakeCanvas" class="w-full h-full block"></canvas>

        <!-- START / PAUSE / GAMEOVER OVERLAYS -->
        
        <!-- Start / Game Over Overlay -->
        <div id="overlay-menu" class="absolute inset-0 bg-black/75 backdrop-blur-md flex flex-col items-center justify-center p-4 z-20">
            <div class="wood-panel p-6 md:p-8 rounded-3xl max-w-md w-full text-center relative border-amber-600">
                
                <!-- Close / Cross Icon to adjust speed / close overlay -->
                <button id="btn-close-overlay" class="absolute top-3 right-3 text-amber-400 hover:text-white bg-black/40 hover:bg-black/60 w-8 h-8 rounded-full flex items-center justify-center transition border border-amber-800">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>

                <h1 id="overlay-title" class="text-3xl md:text-4xl font-black text-amber-400 mb-2 drop-shadow-md">RẮN SĂN Mồi 3D</h1>
                <p id="overlay-subtitle" class="text-stone-300 text-sm mb-6">Trải nghiệm đồ họa giả 3D chân thực, chuyển động siêu mượt!</p>

                <!-- Difficulty Selector inside Overlay -->
                <div class="mb-6 bg-black/40 p-3 rounded-2xl border border-amber-900/60">
                    <label class="block text-amber-300 text-xs font-bold uppercase mb-2">Mức Độ Khó (Tốc độ)</label>
                    <div class="grid grid-cols-4 gap-1.5">
                        <button class="btn-diff btn-wood text-xs py-2 rounded-xl border border-amber-700" data-speed="140">Dễ</button>
                        <button class="btn-diff btn-green text-xs py-2 rounded-xl font-bold" data-speed="100">Thường</button>
                        <button class="btn-diff btn-wood text-xs py-2 rounded-xl border border-amber-700" data-speed="70">Khó</button>
                        <button class="btn-diff btn-red text-xs py-2 rounded-xl border border-red-700 font-bold" data-speed="45">Cực Khó</button>
                    </div>
                </div>

                <!-- Final Score Summary (When Game Over) -->
                <div id="score-summary" class="hidden mb-6 bg-black/50 p-3 rounded-2xl border border-amber-800/80">
                    <div class="flex justify-around text-center">
                        <div>
                            <span class="text-xs text-stone-400 block">ĐIỂM SỐ</span>
                            <span id="final-score" class="text-2xl font-black text-amber-400">0</span>
                        </div>
                        <div class="border-r border-stone-700"></div>
                        <div>
                            <span class="text-xs text-stone-400 block">KỶ LỤC</span>
                            <span id="final-highscore" class="text-2xl font-black text-yellow-300">0</span>
                        </div>
                    </div>
                </div>

                <!-- Action Controls -->
                <div class="flex flex-col gap-3">
                    <button id="btn-play-start" class="btn-green text-white font-bold text-lg py-3 rounded-2xl flex items-center justify-center gap-2 hover:brightness-110">
                        <i class="fa-solid fa-play"></i> BẮT ĐẦU CHƠI
                    </button>
                    <button id="btn-free-mode" class="btn-wood text-amber-200 font-bold text-sm py-2.5 rounded-2xl flex items-center justify-center gap-2 hover:brightness-110">
                        <i class="fa-solid fa-gamepad"></i> CHƠI TỰ DO (KHÔNG GIỚI HẠN)
                    </button>
                </div>
            </div>
        </div>

        <!-- SETTINGS MODAL -->
        <div id="modal-settings" class="hidden absolute inset-0 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 z-30">
            <div class="wood-panel p-6 rounded-3xl max-w-sm w-full relative">
                <button id="btn-close-settings" class="absolute top-3 right-3 text-stone-400 hover:text-white w-8 h-8 flex items-center justify-center">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
                
                <h2 class="text-2xl font-bold text-amber-400 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-sliders"></i> CÀI ĐẶT GAME
                </h2>

                <div class="space-y-4">
                    <!-- Audio Toggle -->
                    <div class="flex justify-between items-center bg-black/40 p-3 rounded-xl border border-amber-900/40">
                        <span class="text-stone-200 text-sm font-semibold">Âm Thanh / Hiệu Ứng</span>
                        <input type="checkbox" id="toggle-sound" checked class="w-5 h-5 accent-emerald-500 cursor-pointer">
                    </div>

                    <!-- Wall Collision Toggle -->
                    <div class="flex justify-between items-center bg-black/40 p-3 rounded-xl border border-amber-900/40">
                        <div>
                            <span class="text-stone-200 text-sm font-semibold block">Đâm Vào Tường</span>
                            <span class="text-xs text-stone-400">Xuyên tường hoặc Thua cuộc</span>
                        </div>
                        <input type="checkbox" id="toggle-wall" checked class="w-5 h-5 accent-emerald-500 cursor-pointer">
                    </div>

                    <!-- Manual Board Style Swap -->
                    <div class="bg-black/40 p-3 rounded-xl border border-amber-900/40">
                        <label class="text-stone-200 text-sm font-semibold block mb-2">Đổi Phong Cách Mặt Sàn</label>
                        <button id="btn-change-theme" class="btn-wood text-amber-200 text-xs w-full py-2 rounded-xl">
                            <i class="fa-solid fa-palette mr-1"></i> Đổi Khung Gỗ & Sàn Mới
                        </button>
                    </div>

                    <!-- Exit / Restart Buttons -->
                    <div class="pt-2 grid grid-cols-2 gap-2">
                        <button id="btn-restart-game" class="btn-wood text-amber-200 text-xs py-2.5 rounded-xl font-bold">
                            <i class="fa-solid fa-rotate-right mr-1"></i> Chơi Lại
                        </button>
                        <button id="btn-exit-game" class="btn-red text-white text-xs py-2.5 rounded-xl font-bold">
                            <i class="fa-solid fa-door-open mr-1"></i> Thoát
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- PAUSE INDICATOR BANNER -->
        <div id="pause-banner" class="hidden absolute top-4 left-1/2 -translate-x-1/2 bg-amber-950/90 border-2 border-amber-500 text-amber-300 font-bold px-6 py-2 rounded-full shadow-2xl z-10 flex items-center gap-2">
            <i class="fa-solid fa-pause text-amber-400"></i> ĐÃ TẠM DỪNG GAME
        </div>
    </div>

    <!-- TOUCH / ON-SCREEN CONTROLS FOR MOBILE -->
    <div class="w-full max-w-xs mt-3 grid grid-cols-3 gap-2 md:hidden">
        <div></div>
        <button id="btn-touch-up" class="btn-wood p-4 rounded-2xl text-amber-200 text-xl active:bg-amber-700 flex justify-center items-center">
            <i class="fa-solid fa-arrow-up"></i>
        </button>
        <div></div>
        <button id="btn-touch-left" class="btn-wood p-4 rounded-2xl text-amber-200 text-xl active:bg-amber-700 flex justify-center items-center">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        <button id="btn-touch-down" class="btn-wood p-4 rounded-2xl text-amber-200 text-xl active:bg-amber-700 flex justify-center items-center">
            <i class="fa-solid fa-arrow-down"></i>
        </button>
        <button id="btn-touch-right" class="btn-wood p-4 rounded-2xl text-amber-200 text-xl active:bg-amber-700 flex justify-center items-center">
            <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>

    <!-- FOOTER HINTS -->
    <div class="mt-2 text-center text-xs text-stone-400 flex flex-wrap justify-center gap-4">
        <span><i class="fa-solid fa-keyboard mr-1"></i> Điều khiển: <b>Mũi tên / WASD</b></span>
        <span><i class="fa-solid fa-space-shuttle mr-1"></i> Dấu cách: <b>Tạm dừng</b></span>
        <span><i class="fa-solid fa-bolt mr-1"></i> Kim cương: <b>+50 Điểm + Dài vượt trội</b></span>
    </div>

    <!-- GAME LOGIC SCRIPT -->
    <script>
        // --- AUDIO SYNTHESIZER (No external audio files needed) ---
        class SoundFX {
            constructor() {
                this.ctx = null;
                this.enabled = true;
            }

            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }

            playEat(isBig = false, isDiamond = false) {
                if (!this.enabled) return;
                this.init();
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);

                const now = this.ctx.currentTime;
                if (isDiamond) {
                    // Sparkling high arpeggio tone
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.2); // C6
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (isBig) {
                    // Deep juicy tone
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(200, now);
                    osc.frequency.exponentialRampToValueAtTime(450, now + 0.15);
                    gain.gain.setValueAtTime(0.4, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
                    osc.start(now);
                    osc.stop(now + 0.2);
                } else {
                    // Quick crisp bite tone
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(300, now);
                    osc.frequency.exponentialRampToValueAtTime(600, now + 0.08);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                }
            }

            playGameOver() {
                if (!this.enabled) return;
                this.init();
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);

                const now = this.ctx.currentTime;
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.linearRampToValueAtTime(60, now + 0.4);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            }
        }

        const sound = new SoundFX();

        // --- GAME ENGINE & BOARD SETUP ---
        const canvas = document.getElementById('snakeCanvas');
        const ctx = canvas.getContext('2d');

        // Grid Dimensions
        const GRID_COLS = 20;
        const GRID_ROWS = 15;
        let cellWidth = 0;
        let cellHeight = 0;

        // Game State Variables
        let gameRunning = false;
        let isPaused = false;
        let freeMode = false;
        let wallCollision = true;
        let score = 0;
        let highScore = localStorage.getItem('snake_3d_highscore') || 0;
        document.getElementById('highscore-text').textContent = highScore;

        // Speed Settings (ms per step)
        let gameSpeed = 100;
        let lastStepTime = 0;

        // Snake Representation
        // Direction: {x, y}
        let dir = { x: 1, y: 0 };
        let nextDir = { x: 1, y: 0 };
        let snake = []; // Array of grid coordinates [{x, y}]
        let snakeHeadScale = { x: 1.2, y: 0.8 }; // Stretch dynamics

        // Foods & Diamonds
        let food = null; // Normal or Big Food
        let diamond = null; // Diamond bonus item
        let diamondTimer = null;

        // Particles for 3D visual polish
        let particles = [];

        // Board Dynamic Wood Themes Configuration
        const WOOD_THEMES = [
            {
                name: 'Gỗ Sồi Cổ Hiển',
                borderOuter: '#3a1c04',
                borderInner: '#8B4513',
                tileDark: '#2c2520',
                tileLight: '#3d342d',
                gridLine: '#1a1512',
                logoColor: 'rgba(217, 119, 6, 0.18)'
            },
            {
                name: 'Gỗ Tùng Đen Băng Giá',
                borderOuter: '#0f172a',
                borderInner: '#334155',
                tileDark: '#1e293b',
                tileLight: '#334155',
                gridLine: '#0f172a',
                logoColor: 'rgba(56, 189, 248, 0.15)'
            },
            {
                name: 'Gỗ Đỏ Hoàng Gia',
                borderOuter: '#450a0a',
                borderInner: '#991b1b',
                tileDark: '#3f1d1d',
                tileLight: '#542626',
                gridLine: '#270e0e',
                logoColor: 'rgba(239, 68, 68, 0.15)'
            },
            {
                name: 'Gỗ Mẫu Rừng Già',
                borderOuter: '#052e16',
                borderInner: '#166534',
                tileDark: '#19281e',
                tileLight: '#263b2d',
                gridLine: '#0b160e',
                logoColor: 'rgba(34, 197, 94, 0.15)'
            }
        ];
        let currentThemeIndex = 0;
        let themeTimerSeconds = 120;
        let themeInterval = null;

        // --- RESIZE CANVAS HANDLING ---
        function resizeCanvas() {
            const container = document.getElementById('game-container');
            const rect = container.getBoundingClientRect();
            
            // Set canvas internal resolution to high definition scaled with aspect ratio
            canvas.width = rect.width * window.devicePixelRatio || rect.width;
            canvas.height = rect.height * window.devicePixelRatio || rect.height;

            cellWidth = canvas.width / GRID_COLS;
            cellHeight = canvas.height / GRID_ROWS;
        }

        window.addEventListener('resize', resizeCanvas);

        // --- INITIALIZE GAME STATE ---
        function initGame() {
            // Reset Snake in center
            const startX = Math.floor(GRID_COLS / 3);
            const startY = Math.floor(GRID_ROWS / 2);
            snake = [
                { x: startX, y: startY },
                { x: startX - 1, y: startY },
                { x: startX - 2, y: startY },
                { x: startX - 3, y: startY }
            ];

            dir = { x: 1, y: 0 };
            nextDir = { x: 1, y: 0 };
            score = 0;
            updateScoreUI();

            spawnFood();
            diamond = null;
            particles = [];

            gameRunning = true;
            isPaused = false;
            document.getElementById('pause-banner').classList.add('hidden');
            document.getElementById('pause-icon').className = 'fa-solid fa-pause';

            // Start theme changer timer if not running
            startThemeTimer();
        }

        // --- SPANNING FOOD & DIAMONDS ---
        function spawnFood() {
            let valid = false;
            let fx, fy;

            while (!valid) {
                fx = Math.floor(Math.random() * GRID_COLS);
                fy = Math.floor(Math.random() * GRID_ROWS);
                valid = !snake.some(seg => seg.x === fx && seg.y === fy);
            }

            // 25% chance for Big Food
            const isBig = Math.random() < 0.25;
            food = {
                x: fx,
                y: fy,
                isBig: isBig,
                points: isBig ? 30 : 10,
                pulse: 0
            };
        }

        function trySpawnDiamond() {
            if (diamond || Math.random() > 0.35) return; // 35% chance when triggered

            let valid = false;
            let dx, dy;
            while (!valid) {
                dx = Math.floor(Math.random() * GRID_COLS);
                dy = Math.floor(Math.random() * GRID_ROWS);
                valid = !snake.some(seg => seg.x === dx && seg.y === dy) &&
                        !(food && food.x === dx && food.y === dy);
            }

            diamond = {
                x: dx,
                y: dy,
                points: 50,
                life: 300, // Frames before disappearing
                sparkleAngle: 0
            };
        }

        // --- THEME SWAPPING SYSTEM ---
        function startThemeTimer() {
            if (themeInterval) clearInterval(themeInterval);
            themeTimerSeconds = 120;

            themeInterval = setInterval(() => {
                if (!gameRunning || isPaused) return;
                themeTimerSeconds--;
                document.getElementById('theme-timer').textContent = themeTimerSeconds;

                if (themeTimerSeconds <= 0) {
                    switchTheme();
                    themeTimerSeconds = 120;
                }
            }, 1000);
        }

        function switchTheme() {
            currentThemeIndex = (currentThemeIndex + 1) % WOOD_THEMES.length;
            // Add decorative particles when switching theme
            createBurstParticles(canvas.width / 2, canvas.height / 2, '#fbbf24', 30);
        }

        // --- PARTICLE EFFECT SYSTEM ---
        function createBurstParticles(x, y, color, count = 15) {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                particles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    radius: Math.random() * 4 + 2,
                    color: color,
                    life: 1.0,
                    decay: Math.random() * 0.04 + 0.02
                });
            }
        }

        function updateAndDrawParticles() {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= p.decay;

                if (p.life <= 0) {
                    particles.splice(i, 1);
                    continue;
                }

                ctx.save();
                ctx.globalAlpha = p.life;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        // --- CORE GAME LOOP & MOVEMENTS ---
        function update(time) {
            if (!gameRunning || isPaused) return;

            if (time - lastStepTime > gameSpeed) {
                lastStepTime = time;

                // Update Direction
                dir = { ...nextDir };

                // Calculate Next Head Position
                let newHead = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

                // Stretch Head Effect based on move
                snakeHeadScale = { x: Math.abs(dir.x) ? 1.35 : 0.85, y: Math.abs(dir.y) ? 1.35 : 0.85 };

                // Wall Collision Check / Wrap Around in Free Mode
                if (newHead.x < 0 || newHead.x >= GRID_COLS || newHead.y < 0 || newHead.y >= GRID_ROWS) {
                    if (wallCollision && !freeMode) {
                        gameOver();
                        return;
                    } else {
                        // Screen wrap around logic
                        if (newHead.x < 0) newHead.x = GRID_COLS - 1;
                        if (newHead.x >= GRID_COLS) newHead.x = 0;
                        if (newHead.y < 0) newHead.y = GRID_ROWS - 1;
                        if (newHead.y >= GRID_ROWS) newHead.y = 0;
                    }
                }

                // Self Collision Check
                if (!freeMode) {
                    for (let i = 0; i < snake.length; i++) {
                        if (snake[i].x === newHead.x && snake[i].y === newHead.y) {
                            gameOver();
                            return;
                        }
                    }
                }

                // Move Snake Head
                snake.unshift(newHead);

                let ate = false;

                // Check Food Collision
                if (food && newHead.x === food.x && newHead.y === food.y) {
                    score += food.points;
                    sound.playEat(food.isBig, false);
                    createBurstParticles(
                        (food.x + 0.5) * cellWidth,
                        (food.y + 0.5) * cellHeight,
                        food.isBig ? '#f59e0b' : '#ef4444',
                        food.isBig ? 25 : 12
                    );

                    // If big food, grow extra segments
                    if (food.isBig) {
                        // Add an extra segment dummy at tail
                        snake.push({ ...snake[snake.length - 1] });
                    }

                    spawnFood();
                    trySpawnDiamond();
                    updateScoreUI();
                    ate = true;
                }

                // Check Diamond Collision
                if (diamond && newHead.x === diamond.x && newHead.y === diamond.y) {
                    score += diamond.points;
                    sound.playEat(false, true);
                    createBurstParticles(
                        (diamond.x + 0.5) * cellWidth,
                        (diamond.y + 0.5) * cellHeight,
                        '#06b6d4',
                        35
                    );

                    // Diamond adds double tail growth!
                    snake.push({ ...snake[snake.length - 1] });
                    snake.push({ ...snake[snake.length - 1] });

                    diamond = null;
                    updateScoreUI();
                    ate = true;
                }

                // If no food eaten, remove tail
                if (!ate) {
                    snake.pop();
                }

                // Update Diamond Lifetime
                if (diamond) {
                    diamond.life--;
                    if (diamond.life <= 0) {
                        diamond = null;
                    }
                }
            }

            // Gradually normalize stretch scale back to normal
            snakeHeadScale.x += (1.0 - snakeHeadScale.x) * 0.15;
            snakeHeadScale.y += (1.0 - snakeHeadScale.y) * 0.15;
        }

        // --- RENDER 3D SCENE & BOARD GRAPHICS ---
        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const theme = WOOD_THEMES[currentThemeIndex];

            // 1. Draw Wooden Border / Frame around the board
            ctx.fillStyle = theme.borderOuter;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Frame Shadow
            ctx.fillStyle = theme.borderInner;
            const borderThickness = Math.min(cellWidth, cellHeight) * 0.2;
            ctx.fillRect(borderThickness, borderThickness, canvas.width - borderThickness * 2, canvas.height - borderThickness * 2);

            // 2. Draw Realistic 3D Board Tiles (Alternate Dark/Light Brown-Gray)
            for (let r = 0; r < GRID_ROWS; r++) {
                for (let c = 0; c < GRID_COLS; c++) {
                    const x = c * cellWidth;
                    const y = r * cellHeight;

                    const isEven = (r + c) % 2 === 0;
                    ctx.fillStyle = isEven ? theme.tileLight : theme.tileDark;
                    ctx.fillRect(x, y, cellWidth, cellHeight);

                    // Tile Inset 3D Bevel/Highlight
                    ctx.strokeStyle = theme.gridLine;
                    ctx.lineWidth = 1;
                    ctx.strokeRect(x, y, cellWidth, cellHeight);

                    // Soft inner highlight on light tiles
                    if (isEven) {
                        ctx.fillStyle = 'rgba(255, 255, 255, 0.03)';
                        ctx.fillRect(x + 2, y + 2, cellWidth - 4, cellHeight - 4);
                    }
                }
            }

            // 3. Draw Embossed Center Brand Logo
            ctx.save();
            ctx.translate(canvas.width / 2, canvas.height / 2);
            ctx.font = `900 ${cellHeight * 2.2}px 'Fredoka', sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = theme.logoColor;
            ctx.shadowColor = 'rgba(0,0,0,0.6)';
            ctx.shadowBlur = 10;
            ctx.shadowOffsetX = 3;
            ctx.shadowOffsetY = 3;
            ctx.fillText('SNAKE 3D', 0, 0);
            ctx.restore();

            // 4. Draw Food
            if (food) {
                drawFood(food);
            }

            // 5. Draw Special Diamond
            if (diamond) {
                drawDiamond(diamond);
            }

            // 6. Draw 3D Snake
            drawSnake();

            // 7. Render Sparkle Particles
            updateAndDrawParticles();
        }

        // --- DRAW FOOD WITH PSEUDO-3D SHADOW & SHINE ---
        function drawFood(f) {
            const cx = (f.x + 0.5) * cellWidth;
            const cy = (f.y + 0.5) * cellHeight;
            const radius = (Math.min(cellWidth, cellHeight) / 2) * (f.isBig ? 0.75 : 0.55);

            f.pulse += 0.08;
            const pulseRadius = radius + Math.sin(f.pulse) * 2;

            ctx.save();

            // Shadow
            ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
            ctx.beginPath();
            ctx.ellipse(cx + 3, cy + radius * 0.8, pulseRadius * 0.9, pulseRadius * 0.4, 0, 0, Math.PI * 2);
            ctx.fill();

            // 3D Gradient Sphere for Food
            const grad = ctx.createRadialGradient(
                cx - pulseRadius * 0.3, cy - pulseRadius * 0.3, pulseRadius * 0.1,
                cx, cy, pulseRadius
            );

            if (f.isBig) {
                grad.addColorStop(0, '#fef08a');
                grad.addColorStop(0.5, '#f59e0b');
                grad.addColorStop(1, '#b45309');
            } else {
                grad.addColorStop(0, '#fca5a5');
                grad.addColorStop(0.5, '#ef4444');
                grad.addColorStop(1, '#991b1b');
            }

            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(cx, cy, pulseRadius, 0, Math.PI * 2);
            ctx.fill();

            // Leaf or Stem accent
            ctx.fillStyle = '#22c55e';
            ctx.beginPath();
            ctx.arc(cx, cy - pulseRadius * 0.9, pulseRadius * 0.25, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }

        // --- DRAW REALISTIC DIAMOND WITH GLOW & AURA ---
        function drawDiamond(d) {
            const cx = (d.x + 0.5) * cellWidth;
            const cy = (d.y + 0.5) * cellHeight;
            const size = Math.min(cellWidth, cellHeight) * 0.45;

            d.sparkleAngle += 0.05;

            ctx.save();

            // Glowing Outer Aura Stars/Rays
            ctx.strokeStyle = 'rgba(6, 182, 212, 0.6)';
            ctx.lineWidth = 2;
            for (let i = 0; i < 4; i++) {
                const angle = d.sparkleAngle + (i * Math.PI / 2);
                ctx.beginPath();
                ctx.moveTo(cx + Math.cos(angle) * (size * 0.6), cy + Math.sin(angle) * (size * 0.6));
                ctx.lineTo(cx + Math.cos(angle) * (size * 1.3), cy + Math.sin(angle) * (size * 1.3));
                ctx.stroke();
            }

            // Drop Shadow
            ctx.fillStyle = 'rgba(0,0,0,0.4)';
            ctx.beginPath();
            ctx.ellipse(cx, cy + size * 0.8, size * 0.8, size * 0.3, 0, 0, Math.PI * 2);
            ctx.fill();

            // Diamond Geometric Shape Gradient
            const grad = ctx.createLinearGradient(cx - size, cy - size, cx + size, cy + size);
            grad.addColorStop(0, '#e0f2fe');
            grad.addColorStop(0.3, '#38bdf8');
            grad.addColorStop(0.7, '#0284c7');
            grad.addColorStop(1, '#0369a1');

            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.moveTo(cx, cy - size); // Top
            ctx.lineTo(cx + size, cy - size * 0.3); // Right top
            ctx.lineTo(cx, cy + size); // Bottom tip
            ctx.lineTo(cx - size, cy - size * 0.3); // Left top
            ctx.closePath();
            ctx.fill();

            // Diamond Inner Facet Highlights
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(cx - size, cy - size * 0.3);
            ctx.lineTo(cx + size, cy - size * 0.3);
            ctx.moveTo(cx, cy - size);
            ctx.lineTo(cx, cy + size);
            ctx.stroke();

            ctx.restore();
        }

        // --- DRAW GREEN SNAKE WITH DETAILED STRIPES & STRETCHING HEAD ---
        function drawSnake() {
            if (snake.length === 0) return;

            // Draw Body and Tail First (Tail to Head for proper layering)
            for (let i = snake.length - 1; i >= 1; i--) {
                const seg = snake[i];
                const cx = (seg.x + 0.5) * cellWidth;
                const cy = (seg.y + 0.5) * cellHeight;

                // Tapering Snake Tail Radius Ratio
                const progress = i / (snake.length - 1); // 0 at head next, 1 at tail
                const baseRadius = (Math.min(cellWidth, cellHeight) / 2) * 0.85;
                // Tail gently tapers down
                const radius = baseRadius * (1 - progress * 0.55);

                ctx.save();

                // 3D Shadow under body
                ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';
                ctx.beginPath();
                ctx.ellipse(cx + 2, cy + radius * 0.4, radius, radius * 0.5, 0, 0, Math.PI * 2);
                ctx.fill();

                // Green Snake Body 3D Radial Gradient
                const bodyGrad = ctx.createRadialGradient(
                    cx - radius * 0.3, cy - radius * 0.3, radius * 0.1,
                    cx, cy, radius
                );
                bodyGrad.addColorStop(0, '#86efac'); // Light green top specular
                bodyGrad.addColorStop(0.4, '#22c55e'); // Vibrant green
                bodyGrad.addColorStop(1, '#14532d'); // Dark green shadow base

                ctx.fillStyle = bodyGrad;
                ctx.beginPath();
                ctx.arc(cx, cy, radius, 0, Math.PI * 2);
                ctx.fill();

                // Detailed Stripes / Scales / Ziczac Lines on Body
                ctx.strokeStyle = 'rgba(5, 46, 22, 0.4)';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(cx, cy, radius * 0.65, 0, Math.PI * 1.2);
                ctx.stroke();

                ctx.restore();
            }

            // Draw Head with Dynamic Angle Rotation & Stretching
            const head = snake[0];
            const headCx = (head.x + 0.5) * cellWidth;
            const headCy = (head.y + 0.5) * cellHeight;
            const headRadius = (Math.min(cellWidth, cellHeight) / 2) * 0.9;

            // Calculate Angle based on current Direction
            let angle = 0;
            if (dir.x === 1) angle = 0;
            else if (dir.x === -1) angle = Math.PI;
            else if (dir.y === 1) angle = Math.PI / 2;
            else if (dir.y === -1) angle = -Math.PI / 2;

            ctx.save();
            ctx.translate(headCx, headCy);
            ctx.rotate(angle);

            // Apply Stretch Scale Dynamics
            ctx.scale(snakeHeadScale.x, snakeHeadScale.y);

            // Head Drop Shadow
            ctx.fillStyle = 'rgba(0,0,0,0.4)';
            ctx.beginPath();
            ctx.ellipse(2, headRadius * 0.4, headRadius, headRadius * 0.5, 0, 0, Math.PI * 2);
            ctx.fill();

            // Head Main Gradient
            const headGrad = ctx.createRadialGradient(
                -headRadius * 0.2, -headRadius * 0.2, headRadius * 0.1,
                0, 0, headRadius
            );
            headGrad.addColorStop(0, '#bbf7d0');
            headGrad.addColorStop(0.5, '#22c55e');
            headGrad.addColorStop(1, '#15803d');

            ctx.fillStyle = headGrad;
            ctx.beginPath();
            ctx.ellipse(0, 0, headRadius * 1.1, headRadius * 0.85, 0, 0, Math.PI * 2);
            ctx.fill();

            // Detailed Stripes on Head
            ctx.strokeStyle = '#052e16';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(-headRadius * 0.3, -headRadius * 0.5);
            ctx.lineTo(headRadius * 0.2, 0);
            ctx.lineTo(-headRadius * 0.3, headRadius * 0.5);
            ctx.stroke();

            // 3D Eyes (Left & Right)
            const eyeOffset = headRadius * 0.45;
            const eyeRadius = headRadius * 0.28;

            // White Spheres
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(headRadius * 0.3, -eyeOffset, eyeRadius, 0, Math.PI * 2);
            ctx.arc(headRadius * 0.3, eyeOffset, eyeRadius, 0, Math.PI * 2);
            ctx.fill();

            // Black Pupils
            ctx.fillStyle = '#000000';
            ctx.beginPath();
            ctx.arc(headRadius * 0.4, -eyeOffset, eyeRadius * 0.5, 0, Math.PI * 2);
            ctx.arc(headRadius * 0.4, eyeOffset, eyeRadius * 0.5, 0, Math.PI * 2);
            ctx.fill();

            // Pupil Light Reflections
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(headRadius * 0.45, -eyeOffset - 1, eyeRadius * 0.2, 0, Math.PI * 2);
            ctx.arc(headRadius * 0.45, eyeOffset - 1, eyeRadius * 0.2, 0, Math.PI * 2);
            ctx.fill();

            // Forked Red Tongue
            ctx.strokeStyle = '#ef4444';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.moveTo(headRadius * 1.0, 0);
            ctx.lineTo(headRadius * 1.4, 0);
            ctx.lineTo(headRadius * 1.65, -headRadius * 0.25);
            ctx.moveTo(headRadius * 1.4, 0);
            ctx.lineTo(headRadius * 1.65, headRadius * 0.25);
            ctx.stroke();

            ctx.restore();
        }

        // --- SCORE & UI UPDATES ---
        function updateScoreUI() {
            document.getElementById('score-text').textContent = score;
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('snake_3d_highscore', highScore);
                document.getElementById('highscore-text').textContent = highScore;
            }
        }

        function gameOver() {
            gameRunning = false;
            sound.playGameOver();

            // Display Game Over Modal
            document.getElementById('overlay-title').textContent = "TRÒ CHƠI KẾT THÚC";
            document.getElementById('overlay-subtitle').textContent = "Rắn đã va chạm! Hãy thử lại để phá kỷ lục.";
            document.getElementById('final-score').textContent = score;
            document.getElementById('final-highscore').textContent = highScore;
            document.getElementById('score-summary').classList.remove('hidden');
            document.getElementById('overlay-menu').classList.remove('hidden');
        }

        // --- MAIN ANIMATION LOOP (60 FPS) ---
        function mainLoop(timestamp) {
            update(timestamp);
            render();
            requestAnimationFrame(mainLoop);
        }

        // --- USER CONTROLS & EVENT LISTENERS ---
        function handleDirectionKey(key) {
            if (isPaused || !gameRunning) return;

            switch (key) {
                case 'ArrowUp':
                case 'w':
                case 'W':
                    if (dir.y !== 1) nextDir = { x: 0, y: -1 };
                    break;
                case 'ArrowDown':
                case 's':
                case 'S':
                    if (dir.y !== -1) nextDir = { x: 0, y: 1 };
                    break;
                case 'ArrowLeft':
                case 'a':
                case 'A':
                    if (dir.x !== 1) nextDir = { x: -1, y: 0 };
                    break;
                case 'ArrowRight':
                case 'd':
                case 'D':
                    if (dir.x !== -1) nextDir = { x: 1, y: 0 };
                    break;
            }
        }

        window.addEventListener('keydown', (e) => {
            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) {
                e.preventDefault(); // Prevent browser scrolling
            }

            if (e.key === ' ') {
                togglePause();
            } else {
                handleDirectionKey(e.key);
            }
        });

        // Touch Control Buttons for Mobile
        document.getElementById('btn-touch-up').addEventListener('click', () => handleDirectionKey('ArrowUp'));
        document.getElementById('btn-touch-down').addEventListener('click', () => handleDirectionKey('ArrowDown'));
        document.getElementById('btn-touch-left').addEventListener('click', () => handleDirectionKey('ArrowLeft'));
        document.getElementById('btn-touch-right').addEventListener('click', () => handleDirectionKey('ArrowRight'));

        // Pause Toggle Button
        function togglePause() {
            if (!gameRunning) return;
            isPaused = !isPaused;
            document.getElementById('pause-banner').classList.toggle('hidden', !isPaused);
            document.getElementById('pause-icon').className = isPaused ? 'fa-solid fa-play' : 'fa-solid fa-pause';
        }

        document.getElementById('btn-pause').addEventListener('click', togglePause);

        // Difficulty Selector Buttons inside Overlay
        document.querySelectorAll('.btn-diff').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.btn-diff').forEach(b => {
                    b.classList.remove('btn-green');
                    b.classList.add('btn-wood');
                });
                e.target.classList.remove('btn-wood');
                e.target.classList.add('btn-green');
                gameSpeed = parseInt(e.target.getAttribute('data-speed'));
            });
        });

        // Start Game Event
        document.getElementById('btn-play-start').addEventListener('click', () => {
            freeMode = false;
            document.getElementById('overlay-menu').classList.add('hidden');
            initGame();
        });

        // Free Mode Event
        document.getElementById('btn-free-mode').addEventListener('click', () => {
            freeMode = true;
            document.getElementById('overlay-menu').classList.add('hidden');
            initGame();
        });

        // Close Overlay via 'X' Button
        document.getElementById('btn-close-overlay').addEventListener('click', () => {
            document.getElementById('overlay-menu').classList.add('hidden');
        });

        // Settings Modal Controls
        document.getElementById('btn-settings').addEventListener('click', () => {
            document.getElementById('modal-settings').classList.remove('hidden');
            if (gameRunning && !isPaused) togglePause();
        });

        document.getElementById('btn-close-settings').addEventListener('click', () => {
            document.getElementById('modal-settings').classList.add('hidden');
        });

        document.getElementById('toggle-sound').addEventListener('change', (e) => {
            sound.enabled = e.target.checked;
        });

        document.getElementById('toggle-wall').addEventListener('change', (e) => {
            wallCollision = e.target.checked;
        });

        document.getElementById('btn-change-theme').addEventListener('click', () => {
            switchTheme();
        });

        document.getElementById('btn-restart-game').addEventListener('click', () => {
            document.getElementById('modal-settings').classList.add('hidden');
            initGame();
        });

        document.getElementById('btn-exit-game').addEventListener('click', () => {
            document.getElementById('modal-settings').classList.add('hidden');
            gameRunning = false;
            document.getElementById('overlay-menu').classList.remove('hidden');
        });

        // --- STARTUP INITIALIZATION ---
        window.onload = () => {
            resizeCanvas();
            requestAnimationFrame(mainLoop);
        };
    </script>
</body>
</html>
