    .game-card:hover { transform: translateY(-8px) scale(1.03); box-shadow: 0 0 35px rgba(255, 183, 3, 0.6); }
    .card-md5 { background: linear-gradient(180deg, #5c0f1b 0%, #1a0206 100%); border-color: #ff4d6d; }
    .card-thuong { background: linear-gradient(180deg, #0a4b6d 0%, #021622 100%); border-color: #00b4d8; }
    .card-title { font-size: 18px; font-weight: 900; text-align: center; color: #fff; text-shadow: 0 2px 6px #000; }
    .card-sub { font-size: 12px; text-align: center; color: #ffb703; font-weight: bold; }

