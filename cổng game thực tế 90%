<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cổng Game Thực Tế - Tài Xỉu Online Ultimate Pro</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #030206;
      color: #e0e0e0;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Screen Transition Animation Core */
    .app-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex;
      opacity: 1;
      z-index: 10;
    }

    /* ==========================================
       1. MAN HINH LOADING TAI GAME (1% -> 100%)
    ========================================== */
    #loading-screen {
      background: radial-gradient(circle at center, #1b0a2a 0%, #030108 100%);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 32px;
      font-weight: 900;
      background: linear-gradient(180deg, #fff2a3 0%, #d4af37 50%, #aa7c11 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 20px rgba(212, 175, 55, 0.5);
      letter-spacing: 3px;
      margin-bottom: 25px;
      text-transform: uppercase;
    }

    .loader-box {
      width: 320px;
      height: 18px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(212, 175, 55, 0.5);
      border-radius: 20px;
      padding: 2px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);
      position: relative;
    }

    .loader-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #ff0055, #ffd700);
      border-radius: 20px;
      transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffd700;
    }

    .loader-text {
      margin-top: 12px;
      font-size: 13px;
      color: #aaa;
      font-weight: bold;
    }

    /* ==========================================
       2. CONG GAME LOBBY
    ========================================== */
    .game-lobby {
      position: relative;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at center, #180d28 0%, #050308 100%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    /* Top Bar Header */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 24px;
      background: rgba(12, 8, 20, 0.95);
      border-bottom: 1px solid rgba(212, 175, 55, 0.3);
      box-shadow: 0 4px 20px rgba(0,0,0,0.8);
      z-index: 20;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }

    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid #ffd700;
      background-size: cover;
      background-position: center;
      box-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
      transition: transform 0.2s;
    }
    .avatar:active { transform: scale(0.92); }

    .balance-box {
      background: #0b0514;
      border: 1px solid #ffd700;
      border-radius: 20px;
      padding: 4px 16px;
      color: #ffd700;
      font-weight: 800;
      font-size: 15px;
      box-shadow: inset 0 0 6px rgba(212, 175, 55, 0.3);
      letter-spacing: 0.5px;
    }

    .top-nav {
      display: flex;
      gap: 20px;
      font-weight: 700;
      color: #8f82a7;
      text-transform: uppercase;
      font-size: 12px;
    }

    .top-nav span {
      cursor: pointer;
      transition: all 0.2s;
      padding: 6px 12px;
      border-radius: 12px;
    }

    .top-nav span:hover, .top-nav span.active {
      color: #fff;
      background: rgba(255, 215, 0, 0.15);
      border: 1px solid rgba(255, 215, 0, 0.3);
    }

    /* Header Action Buttons */
    .header-actions {
      display: flex;
      gap: 10px;
    }

    .btn-action {
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 800;
      font-size: 12px;
      cursor: pointer;
      border: none;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      transition: transform 0.1s, filter 0.2s;
    }
    .btn-action:active { transform: scale(0.95); }
    .btn-nap { background: linear-gradient(180deg, #00e676, #00897b); color: #fff; }
    .btn-rut { background: linear-gradient(180deg, #ff5252, #c62828); color: #fff; }

    /* Main Lobby Content */
    .lobby-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 40px;
      flex: 1;
      gap: 20px;
      overflow-x: auto;
    }

    .sidebar-left {
      width: 220px;
      background: rgba(14, 9, 22, 0.85);
      border: 1px solid rgba(212, 175, 55, 0.25);
      border-radius: 16px;
      padding: 14px;
      backdrop-filter: blur(8px);
    }

    .sidebar-title {
      color: #ffd700;
      font-size: 12px;
      font-weight: 800;
      text-align: center;
      margin-bottom: 12px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      padding-bottom: 6px;
    }

    .rank-item {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      margin-bottom: 10px;
      color: #bbb;
    }
    .rank-item .win-amount { color: #00e676; font-weight: 700; }

    /* GAME CARDS GRID (Sảnh ngoài) */
    .game-grid {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .game-card {
      width: 190px;
      height: 250px;
      border-radius: 22px;
      border: 2px solid rgba(255, 215, 0, 0.5);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 12px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.7);
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      position: relative;
      overflow: hidden;
      background-size: cover;
      background-position: center;
    }

    .game-card:hover {
      transform: translateY(-6px) scale(1.02);
      border-color: #ffd700;
      box-shadow: 0 12px 30px rgba(255, 215, 0, 0.4);
    }

    .game-card:active { transform: scale(0.96); }

    .card-hot-taixiu {
      background: linear-gradient(135deg, #800d1e 0%, #3a0007 100%);
      border-color: #ff4d6d;
    }

    .card-md5-taixiu {
      background: linear-gradient(135deg, #023e8a 0%, #001233 100%);
      border-color: #00b4d8;
    }

    .card-quayhu {
      background: linear-gradient(135deg, #6a040f 0%, #1a0003 100%);
    }

    .card-tag {
      align-self: flex-start;
      background: #ff0055;
      color: #fff;
      font-size: 9px;
      font-weight: 900;
      padding: 2px 8px;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.5);
      text-transform: uppercase;
    }

    .card-title-box { text-align: center; }
    .card-title {
      font-weight: 900;
      font-size: 15px;
      color: #fff;
      text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      letter-spacing: 0.5px;
    }
    .card-sub {
      font-size: 10px;
      color: #ffd700;
      font-weight: bold;
      margin-top: 2px;
    }

    /* THÔNG TIN Ô CƯỢC THỜI GIAN THỰC NGOÀI SẢNH LOBBY */
    .lobby-bet-preview {
      background: rgba(0, 0, 0, 0.65);
      border-radius: 12px;
      padding: 6px;
      border: 1px solid rgba(255, 215, 0, 0.3);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .lobby-bet-row {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      font-weight: bold;
    }
    .lobby-bet-tai { color: #ff5252; }
    .lobby-bet-xiu { color: #00e676; }
    .lobby-timer {
      font-size: 11px;
      color: #ffd700;
      text-align: center;
      font-weight: 900;
      border-top: 1px dashed rgba(255,255,255,0.2);
      padding-top: 2px;
    }

    /* Bottom Bar Nav */
    .bottom-bar {
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: rgba(8, 5, 14, 0.95);
      padding: 10px 0;
      border-top: 1px solid rgba(255, 215, 0, 0.2);
    }

    .bottom-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 11px;
      color: #888;
      cursor: pointer;
      transition: 0.2s;
      font-weight: bold;
    }
    .bottom-item:hover { color: #ffd700; }
    .bottom-icon { font-size: 18px; margin-bottom: 2px; }

    /* ==========================================
       3. SANH GAME TRONG SANH REALISTIC 3D
    ========================================== */
    .arena-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle, #0e1e2b 0%, #03080d 100%);
      z-index: 100;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      perspective: 1000px;
    }

    .arena-screen.hot-theme {
      background: radial-gradient(circle, #2b0e14 0%, #0d0305 100%);
    }

    .arena-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 24px;
      background: rgba(0, 0, 0, 0.85);
      border-bottom: 1px solid rgba(255, 215, 0, 0.3);
    }

    .arena-title {
      font-size: 18px;
      font-weight: 900;
      color: #ffd700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .btn-back-lobby {
      background: #c62828;
      color: #fff;
      border: 1px solid #ff5252;
      padding: 6px 16px;
      border-radius: 20px;
      font-weight: bold;
      font-size: 12px;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-back-lobby:active { transform: scale(0.92); }

    /* Bàn Chơi 3D Camera Panning */
    .arena-stage {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .arena-stage.pan-angle {
      transform: rotateX(22deg) rotateY(-8deg) scale(0.95);
    }

    /* Board Bàn Cược Oval */
    .real-taixiu-board {
      position: relative;
      width: 760px;
      height: 400px;
      background: radial-gradient(circle, #102d3f 0%, #040e14 100%);
      border: 4px solid #00b4d8;
      border-radius: 200px;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9), inset 0 0 30px rgba(0,180,216,0.4);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 45px;
    }

    .hot-theme .real-taixiu-board {
      background: radial-gradient(circle, #3f1019 0%, #140407 100%);
      border-color: #ff4d6d;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9), inset 0 0 30px rgba(255,77,109,0.4);
    }

    /* Nút Tròn Chức Năng Bàn Chơi */
    .circle-btn {
      position: absolute;
      width: 40px;
      height: 40px;
      background: radial-gradient(circle, #183845, #08151c);
      border: 1px solid #3a7893;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #83c5be;
      font-size: 15px;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      z-index: 10;
    }
    .circle-btn:active { transform: scale(0.9); }
    .circle-btn:hover { color: #fff; border-color: #00b4d8; }

    .btn-chart { top: 60px; left: 40px; }
    .btn-help { top: 135px; left: 20px; }
    .btn-history { top: 210px; left: 40px; }
    .btn-rank { top: 60px; right: 40px; }
    .btn-cam { top: 135px; right: 20px; }
    .btn-sound { top: 210px; right: 40px; }

    /* Cửa Cược Oval Nằm Ngang */
    .bet-side {
      width: 190px;
      height: 140px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      border-radius: 70px;
      background: rgba(5, 12, 18, 0.7);
      border: 2px solid rgba(255, 255, 255, 0.2);
      position: relative;
      transition: all 0.3s;
    }

    .bet-side.active-win {
      border: 3px solid #00e676;
      background: rgba(0, 230, 118, 0.25);
      box-shadow: 0 0 35px rgba(0, 230, 118, 0.8);
      animation: winGlow 0.6s infinite alternate;
    }

    @keyframes winGlow {
      0% { transform: scale(1); }
      100% { transform: scale(1.05); }
    }

    .bet-title {
      font-size: 36px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #fff;
    }

    .player-count { font-size: 11px; color: #64ffda; margin-bottom: 2px; }
    .bet-amount { font-size: 15px; font-weight: 800; color: #ffd700; }

    .my-bet-tag {
      font-size: 10px;
      color: #ff5252;
      background: rgba(0,0,0,0.85);
      padding: 2px 10px;
      border-radius: 10px;
      border: 1px solid #ff5252;
      margin-top: 3px;
      display: none;
    }

    .btn-bet {
      margin-top: 6px;
      background: linear-gradient(180deg, #d4af37, #8a6d0b);
      border: 1px solid #fff;
      border-radius: 14px;
      padding: 4px 18px;
      color: #000;
      font-size: 11px;
      font-weight: 900;
      cursor: pointer;
      transition: 0.1s;
    }
    .btn-bet:active { transform: scale(0.92); }

    /* Đĩa Trung Tâm Thực Tế */
    .center-plate {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, #222 0%, #080808 100%);
      border: 6px solid #1a2936;
      border-radius: 50%;
      box-shadow: 0 0 30px rgba(0,0,0,0.9), inset 0 0 15px rgba(0,0,0,0.8);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 5;
    }

    .timer-display {
      position: absolute;
      top: 15px;
      font-size: 24px;
      font-weight: 900;
      color: #ffd700;
      text-shadow: 0 0 10px rgba(255, 215, 0, 0.8);
    }

    /* ==========================================
       XÚC XẮC 3D MÀU ĐỎ CUBE CHUẨN XÁC 100%
    ========================================== */
    .dice-3d-arena {
      display: flex;
      gap: 15px;
      perspective: 800px;
      transform-style: preserve-3d;
      margin-top: 20px;
    }

    .cube {
      width: 44px;
      height: 44px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.1s linear;
    }

    /* Animation Lăn Đảo Cuộn Nhanh 3D */
    .cube.rolling {
      animation: rollFast3D 0.15s infinite linear;
    }

    @keyframes rollFast3D {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg) translateY(-20px); }
      50% { transform: rotateX(180deg) rotateY(360deg) rotateZ(90deg) translateY(15px); }
      100% { transform: rotateX(360deg) rotateY(720deg) rotateZ(180deg) translateY(-20px); }
    }

    /* Các mặt xúc xắc 3D */
    .face {
      position: absolute;
      width: 44px;
      height: 44px;
      background: radial-gradient(circle at 30% 30%, #e60000, #800000);
      border: 1px solid #b30000;
      border-radius: 8px;
      box-shadow: inset 0 0 5px rgba(0,0,0,0.6), 0 2px 5px rgba(0,0,0,0.5);
      display: grid;
      grid-template: repeat(3, 1fr) / repeat(3, 1fr);
      padding: 4px;
      align-items: center;
      justify-items: center;
    }

    /* Tọa độ 6 mặt Cube */
    .face-1 { transform: rotateY(0deg) translateZ(22px); }
    .face-6 { transform: rotateY(180deg) translateZ(22px); }
    .face-2 { transform: rotateY(-90deg) translateZ(22px); }
    .face-5 { transform: rotateY(90deg) translateZ(22px); }
    .face-3 { transform: rotateX(90deg) translateZ(22px); }
    .face-4 { transform: rotateX(-90deg) translateZ(22px); }

    /* Dấu chấm xúc xắc */
    .dot-pip {
      width: 8px;
      height: 8px;
      background: #fff;
      border-radius: 50%;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.8);
      display: none;
    }
    .dot-pip.red { background: #ffea00; } /* Mặt 1 nút vàng chói */

    /* Định nghĩa bố cục các mặt */
    .face-1 .p5 { display: block; width: 14px; height: 14px; } /* Nút 1 to */
    .face-2 .p1, .face-2 .p9 { display: block; }
    .face-3 .p1, .face-3 .p5, .face-3 .p9 { display: block; }
    .face-4 .p1, .face-4 .p3, .face-4 .p7, .face-4 .p9 { display: block; }
    .face-5 .p1, .face-5 .p3, .face-5 .p5, .face-5 .p7, .face-5 .p9 { display: block; }
    .face-6 .p1, .face-6 .p3, .face-6 .p4, .face-6 .p6, .face-6 .p7, .face-6 .p9 { display: block; }

    /* Lịch Sử Cầu */
    .history-dots {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      background: rgba(0, 0, 0, 0.7);
      padding: 4px 14px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .dot { width: 11px; height: 11px; border-radius: 50%; }
    .dot.tai { background: #fff; box-shadow: 0 0 5px #fff; }
    .dot.xiu { background: #222; border: 1px solid #666; }

    /* ==========================================
       4. BANNER THẮNG & THÔNG BÁO VÀI GIÂY REAL
    ========================================== */
    .win-banner-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      background: radial-gradient(circle, #ffd700 0%, #b8860b 100%);
      border: 3px solid #fff;
      padding: 15px 40px;
      border-radius: 30px;
      box-shadow: 0 0 50px #ffd700, 0 10px 25px rgba(0,0,0,0.9);
      text-align: center;
      z-index: 500;
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
    }

    .win-banner-overlay.show {
      transform: translate(-50%, -50%) scale(1.1);
    }

    .win-banner-title {
      font-size: 28px;
      font-weight: 900;
      color: #000;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .win-banner-money {
      font-size: 22px;
      font-weight: 900;
      color: #8b0000;
      margin-top: 4px;
    }

    /* TOAST THÔNG BÁO */
    .toast-msg {
      position: fixed;
      top: 25px;
      left: 50%;
      transform: translateX(-50%) translateY(-60px);
      background: rgba(10, 10, 10, 0.95);
      border: 1px solid #ffd700;
      color: #ffd700;
      padding: 10px 24px;
      border-radius: 24px;
      font-weight: bold;
      font-size: 13px;
      z-index: 9999;
      opacity: 0;
      transition: all 0.3s ease;
      pointer-events: none;
      box-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .toast-msg.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* MODAL DIALOGS */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(6px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 2000;
    }

    .general-card {
      width: 420px;
      background: #0d081a;
      border: 1.5px solid #ffd700;
      border-radius: 28px;
      padding: 24px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.95);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255,215,0,0.2);
      padding-bottom: 10px;
    }

    .card-title-text { color: #ffd700; font-weight: 900; font-size: 16px; }
    .btn-close-modal {
      width: 30px; height: 30px; background: #c62828; border-radius: 50%;
      color: #fff; display: flex; justify-content: center; align-items: center;
      cursor: pointer; font-weight: bold; border: none;
    }

    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: 11px; color: #aaa; font-weight: bold; }
    .form-input {
      background: #000; border: 1px solid #ffd700; padding: 10px 14px;
      border-radius: 16px; color: #fff; font-weight: bold; outline: none;
    }

    .btn-submit-action {
      background: linear-gradient(180deg, #00e676, #00897b);
      border: none; padding: 12px; border-radius: 20px; color: #fff;
      font-weight: bold; cursor: pointer; font-size: 13px;
    }

    .bet-quick-btns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .btn-quick {
