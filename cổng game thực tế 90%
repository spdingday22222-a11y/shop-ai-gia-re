  <!-- MODAL CƯỢC -->
  <div class="modal-overlay" id="bet-modal">
    <div class="general-card" style="width: 320px;">
      <div class="card-header">
        <span class="card-title-text" id="bet-modal-title">CƯỢC TÀI</span>
