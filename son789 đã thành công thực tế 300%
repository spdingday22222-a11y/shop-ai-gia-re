  <script>
    /* GAME LOGIC & STATE MANAGEMENT */
    let balance = 57300755;
    let selectedSide = null;
    let currentChipVal = 0;
    let pendingBetVal = 0;
    let userBets = { TAI: 0, XIU: 0 };
    let timer = 26;
    let timerInterval = null;
    let isSqueezeMode = false;
    let currentMode = 'MD5';
    let isBoardDragging = false;
    let boardPos = { x: 0, y: 0, startX: 0, startY: 0 };
    let isBowlDragging = false;
    let bowlPos = { x: 0, y: 0, startX: 0, startY: 0 };

    /* HELPER FUNCTIONS */
    function formatMoney(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function showToast(msg, duration = 2500) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), duration);
    }

    function updateBalanceDisplay() {
      document.getElementById('user-balance').innerText = '$ ' + formatMoney(balance);
      document.getElementById('arena-balance').innerText = '$ ' + formatMoney(balance);
    }

    /* INITIALIZATION & LOADING */
    window.addEventListener('load', () => {
      let progress = 0;
      const fill = document.getElementById('loader-fill');
      const loader = setInterval(() => {
        progress += 4;
        fill.style.width = progress + '%';
        if (progress >= 100) {
          clearInterval(loader);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
        }
      }, 30);

      initDragging();
      initBowlDragging();
    });

    /* ENTER & EXIT ARENA */
    function enterArena(mode) {
      currentMode = mode;
      document.getElementById('lobby-screen').classList.remove('active');
      const arena = document.getElementById('arena-screen');
      const board = document.getElementById('main-board');
      const title = document.getElementById('arena-title');

      arena.style.display = 'flex';
      setTimeout(() => arena.classList.add('active'), 10);

      if (mode === 'MD5') {
        title.innerText = 'TÀI XỈU MD5';
        board.className = 'real-taixiu-board theme-md5';
      } else {
        title.innerText = 'TÀI XỈU THƯỜNG';
        board.className = 'real-taixiu-board theme-thuong';
      }

      /* Reset vị trí kéo sảnh */
      boardPos = { x: 0, y: 0, startX: 0, startY: 0 };
      board.style.transform = `translate3d(0px, 0px, 0px)`;

      startNewRound();
    }

    function exitArena() {
      const arena = document.getElementById('arena-screen');
      arena.classList.remove('active');
      setTimeout(() => {
        arena.style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
    }

    /* DRAG SẢNH TỰ DO MƯỢT MÀ (POINTER EVENTS) */
    function initDragging() {
      const board = document.getElementById('main-board');

      board.addEventListener('pointerdown', (e) => {
        // Tránh kích hoạt drag khi click vào nút hoặc cửa cược
        if (e.target.closest('.circle-btn') || e.target.closest('.bet-side') || e.target.closest('.center-plate')) {
          return;
        }
        isBoardDragging = true;
        boardPos.startX = e.clientX - boardPos.x;
        boardPos.startY = e.clientY - boardPos.y;
        board.setPointerCapture(e.pointerId);
      });

      board.addEventListener('pointermove', (e) => {
        if (!isBoardDragging) return;
        boardPos.x = e.clientX - boardPos.startX;
        boardPos.y = e.clientY - boardPos.startY;
        board.style.transform = `translate3d(${boardPos.x}px, ${boardPos.y}px, 0px)`;
      });

      const endDrag = (e) => {
        if (isBoardDragging) {
          isBoardDragging = false;
          try { board.releasePointerCapture(e.pointerId); } catch(err){}
        }
      };

      board.addEventListener('pointerup', endDrag);
      board.addEventListener('pointercancel', endDrag);
    }

    /* DRAG BÁT NẶN TỰ DO */
    function initBowlDragging() {
      const bowl = document.getElementById('bowl-cover');

      bowl.addEventListener('pointerdown', (e) => {
        isBowlDragging = true;
        bowlPos.startX = e.clientX - bowlPos.x;
        bowlPos.startY = e.clientY - bowlPos.y;
        bowl.setPointerCapture(e.pointerId);
      });

      bowl.addEventListener('pointermove', (e) => {
        if (!isBowlDragging) return;
        bowlPos.x = e.clientX - bowlPos.startX;
        bowlPos.y = e.clientY - bowlPos.startY;
        bowl.style.transform = `translate3d(${bowlPos.x}px, ${bowlPos.y}px, 0px)`;
      });

      const endBowlDrag = (e) => {
        if (isBowlDragging) {
          isBowlDragging = false;
          try { bowl.releasePointerCapture(e.pointerId); } catch(err){}
        }
      };

      bowl.addEventListener('pointerup', endBowlDrag);
      bowl.addEventListener('pointercancel', endBowlDrag);
    }

    /* GAME LOOP & TIMER */
    function startNewRound() {
      clearInterval(timerInterval);
      timer = 26;
      userBets = { TAI: 0, XIU: 0 };
      updateBetValsDisplay();
      
      document.getElementById('title-TAI').classList.remove('blink-winner');
      document.getElementById('title-XIU').classList.remove('blink-winner');
      document.getElementById('win-popup').classList.remove('show');
      document.getElementById('lose-popup').classList.remove('show');
      
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('timer-text').style.display = 'block';

      const bowl = document.getElementById('bowl-cover');
      bowl.style.display = 'none';
      bowl.style.transform = `translate3d(0px, 0px, 0px)`;
      bowlPos = { x: 0, y: 0, startX: 0, startY: 0 };

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer < 10 ? '0' + timer : timer;
        
        // Cập nhật ngẫu nhiên số lượng người chơi/tiền bàn cược cho sinh động
        if (timer > 5) {
          document.getElementById('tai-players').innerText = Math.floor(300 + Math.random() * 80);
          document.getElementById('xiu-players').innerText = Math.floor(300 + Math.random() * 80);
          document.getElementById('tai-amount').innerText = formatMoney(Math.floor(250000000 + Math.random() * 20000000));
          document.getElementById('xiu-amount').innerText = formatMoney(Math.floor(230000000 + Math.random() * 20000000));
        }

        if (timer <= 0) {
          clearInterval(timerInterval);
          finishRound();
        }
      }, 1000);
    }

    function finishRound() {
      document.getElementById('chip-bar').classList.add('hidden-bet');
      document.getElementById('timer-text').style.display = 'none';

      // Tạo kết quả ngẫu nhiên
      const d1 = Math.floor(Math.random() * 6) + 1;
      const d2 = Math.floor(Math.random() * 6) + 1;
      const d3 = Math.floor(Math.random() * 6) + 1;
      const total = d1 + d2 + d3;
      const resultSide = total >= 11 ? 'TAI' : 'XIU';

      setCubeRotation('cube1', d1);
      setCubeRotation('cube2', d2);
      setCubeRotation('cube3', d3);

      const diceBox = document.getElementById('dice-container');
      diceBox.style.display = 'block';

      const cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];
      cubes.forEach(c => c.classList.add('rolling'));

      setTimeout(() => {
        cubes.forEach(c => c.classList.remove('rolling'));

        if (isSqueezeMode) {
          document.getElementById('bowl-cover').style.display = 'flex';
          showToast('Mời bạn nặn bài!', 2000);
          setTimeout(() => processWinLose(resultSide, total), 6000);
        } else {
          processWinLose(resultSide, total);
        }
      }, 1000);
    }

    function processWinLose(resultSide, total) {
      document.getElementById('bowl-cover').style.display = 'none';
      document.getElementById('title-' + resultSide).classList.add('blink-winner');

      const userWinAmt = userBets[resultSide] * 2;
      const userTotalBet = userBets.TAI + userBets.XIU;

      if (userBets[resultSide] > 0) {
        balance += userWinAmt;
        updateBalanceDisplay();
        document.getElementById('win-amount-text').innerText = '+' + formatMoney(userWinAmt);
        document.getElementById('win-popup').classList.add('show');
      } else if (userTotalBet > 0) {
        document.getElementById('lose-desc-text').innerText = `Kết quả: ${total} điểm (${resultSide})`;
        document.getElementById('lose-popup').classList.add('show');
      }

      // Thêm nút cầu mới
      const history = document.getElementById('history-dots');
      const dot = document.createElement('div');
      dot.className = `dot ${resultSide.toLowerCase()}`;
      history.appendChild(dot);
      if (history.children.length > 10) history.removeChild(history.children[0]);

      setTimeout(startNewRound, 5000);
    }

    function setCubeRotation(cubeId, value) {
      const cube = document.getElementById(cubeId);
      const rotations = {
        1: 'rotateY(0deg)',
        6: 'rotateY(180deg)',
        2: 'rotateY(90deg)',
        5: 'rotateY(-90deg)',
        3: 'rotateX(-90deg)',
        4: 'rotateX(90deg)'
      };
      cube.style.transform = rotations[value] || 'rotateY(0deg)';
    }

    /* BETTING LOGIC */
    function handleBetClick(side) {
      if (timer <= 3) {
        showToast('Hết thời gian đặt cược!');
        return;
      }
      selectedSide = side;
      document.getElementById('chip-bar').classList.remove('hidden-bet');
      document.getElementById('btn-bet-TAI').classList.toggle('active-bet', side === 'TAI');
      document.getElementById('btn-bet-XIU').classList.toggle('active-bet', side === 'XIU');
    }

    function selectChip(val, el) {
      currentChipVal = val;
      document.querySelectorAll('.chip-item-sq').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      pendingBetVal += val;
      if (selectedSide) {
        document.getElementById(`val-${selectedSide}`).innerText = formatMoney(userBets[selectedSide] + pendingBetVal);
      }
    }

    function confirmBet() {
      if (!selectedSide || pendingBetVal === 0) {
        showToast('Vui lòng chọn chip cược!');
        return;
      }
      if (pendingBetVal > balance) {
        showToast('Số dư không đủ!');
        cancelBet();
        return;
      }

      balance -= pendingBetVal;
      userBets[selectedSide] += pendingBetVal;
      pendingBetVal = 0;
      updateBalanceDisplay();
      updateBetValsDisplay();
      showToast('Đặt cược thành công!');
      document.getElementById('chip-bar').classList.add('hidden-bet');
    }

    function cancelBet() {
      pendingBetVal = 0;
      updateBetValsDisplay();
      document.getElementById('chip-bar').classList.add('hidden-bet');
    }

    function doAllIn(side) {
      if (timer <= 3) {
        showToast('Hết thời gian cược!');
        return;
      }
      if (balance <= 0) {
        showToast('Số dư đã hết!');
        return;
      }
      userBets[side] += balance;
      balance = 0;
      updateBalanceDisplay();
      updateBetValsDisplay();
      showToast('Đã All-In toàn bộ số dư!');
    }

    function updateBetValsDisplay() {
      document.getElementById('val-TAI').innerText = formatMoney(userBets.TAI);
      document.getElementById('val-XIU').innerText = formatMoney(userBets.XIU);
    }

    /* OTHER UTILITIES */
    function toggleSqueezeMode() {
      isSqueezeMode = !isSqueezeMode;
      const btn = document.getElementById('btn-squeeze-toggle');
      btn.classList.toggle('active-squeeze', isSqueezeMode);
      showToast(isSqueezeMode ? 'Đã BẬT chế độ Nặn' : 'Đã TẮT chế độ Nặn');
    }

    function toggleChat() {
      const chat = document.getElementById('chat-box');
      chat.style.display = chat.style.display === 'flex' ? 'none' : 'flex';
    }

    function sendChatMessage() {
      const input = document.getElementById('chat-input-field');
      const txt = input.value.trim();
      if (!txt) return;
      
      const list = document.getElementById('chat-msg-list');
      const item = document.createElement('div');
      item.className = 'chat-item';
      item.innerHTML = `<span class="chat-user">hilohi123:</span> <span class="chat-text">${txt}</span>`;
      list.appendChild(item);
      list.scrollTop = list.scrollHeight;
      input.value = '';
    }
  </script>
</body>
</html>
