        <!-- GAME BOARD POPUP -->
        <div class="game-modal" id="game-board">
            <button class="btn-close" onclick="closeGame()">X</button>
            <div class="session-id" id="session-label">#177407</div>

            <div class="board-content">
                <!-- BÊN TÀI -->
                <div class="side-box">
                    <div class="side-title">TÀI</div>
                    <div class="user-count">👤 <span id="users-tai">568</span></div>
                    <div class="bet-amount" id="bet-tai">246,533,760</div>
                    <button class="btn-cuoc" onclick="placeBet('tai')">CƯỢC</button>
                    <!-- LOGO LOGIC VÀ SỐ TIỀN CƯỢC -->
                    <div class="my-bet-tag" id="my-bet-tai">
                        <span class="logic-icon"></span> LOGIC: <span id="my-amount-tai">0</span> đ
