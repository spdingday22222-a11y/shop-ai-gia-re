                        <!-- 3 VIÊN XÚC XẮC DẤU CHẤM THỰC TẾ -->
                        <div class="dice-container" id="dice-group">
                            <!-- DIE 1 -->
                            <div class="real-dice" id="d1">
                                <div class="dot-pip" style="grid-area: 1/1;"></div>
