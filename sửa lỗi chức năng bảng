    ];

    let isNanMode = false;

    // Tiến trình Loading
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
        renderHistoryTable();
        renderRankTable();
        startGlobalGameLoop();
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function openPopup(id) {
      document.getElementById(id).classList.add('active');
      if (id === 'chart-modal') renderSoiCau();
    }

    function closePopup(id) {
      document.getElementById(id).classList.remove('active');
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      initBoardDrag();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn tay');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    function openBetPanel(side) {
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Đã chọn cửa ' + side + '. Chọn chip cược!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược!');
        return;
      }

      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
      
      showToast('Đặt cược thành công ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      const el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      document.getElementById('chip-panel').classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    // TẠO LẠI VẼ CÁC MẶT XÚC XẮC SẮC NÉT
    function renderDiceFace(diceEl, value) {
      const faces = diceEl.querySelectorAll('.dice-face');
      const dotPositions = {
        1: [4],
        2: [0, 8],
        3: [0, 4, 8],
        4: [0, 2, 6, 8],
        5: [0, 2, 4, 6, 8],
        6: [0, 2, 3, 5, 6, 8]
      };

      faces.forEach(face => {
        face.innerHTML = '';
        for (let i = 0; i < 9; i++) {
          const dot = document.createElement('div');
          if (dotPositions[value].includes(i)) {
            dot.className = value === 1 ? 'dot red-dot' : 'dot';
          }
          face.appendChild(dot);
        }
      });
    }

    // RENDER BẢNG LỊCH SỬ CƯỢC CÁ NHÂN
    function renderHistoryTable() {
      const tbody = document.getElementById('history-table-body');
      tbody.innerHTML = '';
      userBetHistory.forEach(item => {
        const tr = document.createElement('tr');
        const winClass = item.win >= 0 ? 'col-win' : 'col-lose';
        const winStr = item.win >= 0 ? '+' + item.win.toLocaleString() : item.win.toLocaleString();
        tr.innerHTML = `
          <td class="col-phien">${item.phien}</td>
          <td class="col-time">${item.time}</td>
          <td class="col-tongcuoc">${item.cuoc.toLocaleString()}</td>
          <td class="${winClass}">${winStr}</td>
          <td class="col-detail">${item.detail}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // RENDER BẢNG VINH DANH CAO THỦ & RANDOM THAY ĐỔI THEO PHIÊN
    function renderRankTable() {
      const tbody = document.getElementById('rank-table-body');
      tbody.innerHTML = '';
      topPlayers.forEach(item => {
        const tr = document.createElement('tr');
        let badge = item.rank;
        if (item.rank === 1) badge = '🥇 1';
        if (item.rank === 2) badge = '🥈 2';
        if (item.rank === 3) badge = '🥉 3';

        tr.innerHTML = `
          <td style="color:#ffea00; font-weight:bold;">${badge}</td>
          <td style="color:#ffffff; font-weight:bold;">${item.name}</td>
          <td class="col-tongcuoc">${item.bet.toLocaleString()}</td>
          <td class="col-win">+${item.win.toLocaleString()}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function randomizeTopPlayers() {
      const names = ['ToanDuyThanh', 'Bebatxucxac', 'TrumTaiXiu88', 'PhongBaVIP', 'DaiGiaMienTay', 'KiemTienTy', 'VuaPhatTai', 'SieuSaoMD5', 'LinhDan88'];
      // Random sắp xếp lại giá trị cược và thắng thực tế
      topPlayers.forEach(p => {
        p.bet += Math.floor((Math.random() - 0.4) * 50000000);
        if (p.bet < 50000000) p.bet = 50000000;
        p.win = Math.floor(p.bet * 1.98);
      });
      topPlayers.sort((a, b) => b.win - a.win);
      topPlayers.forEach((p, idx) => p.rank = idx + 1);
      renderRankTable();
    }

    function renderSoiCau() {
      const grid = document.getElementById('grid-cau');
      grid.innerHTML = '';
      historyResults.slice(-25).forEach(res => {
        const cell = document.createElement('div');
        cell.className = 'grid-cell';
        const dot = document.createElement('div');
        dot.className = 'dot-result ' + (res.side === 'TAI' ? 'tai' : 'xiu');
        dot.innerText = res.total;
        cell.appendChild(dot);
        grid.appendChild(cell);
      });
    }

    // VÒNG LẶP THỜI GIAN GAME REAL
    function startGlobalGameLoop() {
      let seconds = 50;
      let phase = 'BETTING'; // BETTING -> RESULT

      setInterval(() => {
        seconds--;
        if (seconds > 10) {
          phase = 'BETTING';
          document.getElementById('timer-text').style.display = 'block';
          document.getElementById('timer-text').innerText = seconds - 10;
          document.getElementById('dice-container').style.display = 'none';
          document.getElementById('plate-cover').style.display = 'none';
          document.getElementById('win-overlay').style.display = 'none';

          // Giả lập nhảy tiền cược sinh động
          totalTaiAmount += Math.floor(Math.random() * 5000000);
          totalXiuAmount += Math.floor(Math.random() * 5000000);
          taiPlayersCount += Math.floor(Math.random() * 3);
          xiuPlayersCount += Math.floor(Math.random() * 3);

          document.getElementById('tai-amount').innerText = totalTaiAmount.toLocaleString();
          document.getElementById('xiu-amount').innerText = totalXiuAmount.toLocaleString();
          document.getElementById('tai-players').innerText = taiPlayersCount;
          document.getElementById('xiu-players').innerText = xiuPlayersCount;

        } else if (seconds <= 10 && seconds > 0) {
          if (phase !== 'RESULT') {
            phase = 'RESULT';
            // Tạo kết quả ngẫu nhiên thực tế
            currentDices = [
              Math.floor(Math.random() * 6) + 1,
              Math.floor(Math.random() * 6) + 1,
              Math.floor(Math.random() * 6) + 1
            ];
            const sum = currentDices[0] + currentDices[1] + currentDices[2];
            currentResultSide = sum >= 11 ? 'TAI' : 'XIU';

            renderDiceFace(document.getElementById('dice1'), currentDices[0]);
            renderDiceFace(document.getElementById('dice2'), currentDices[1]);
            renderDiceFace(document.getElementById('dice3'), currentDices[2]);

            document.getElementById('timer-text').style.display = 'none';
            document.getElementById('dice-container').style.display = 'block';

            if (!isNanMode) {
              document.getElementById('plate-cover').style.display = 'none';
              showResultOverlay(sum);
            } else {
              document.getElementById('plate-cover').style.display = 'flex';
              showToast('Mời bạn kéo nặn bát!');
            }
          }
        } else {
          // Xử lý khi sang phiên mới
          seconds = 60;
          currentSessionId++;
          totalTaiAmount = 0; totalXiuAmount = 0;
          taiPlayersCount = 0; xiuPlayersCount = 0;
          
          // Trả lại nút cược
          ['TAI', 'XIU'].forEach(s => {
            confirmedBets[s] = 0;
            const el = document.getElementById('val-' + s);
            el.innerText = 'CƯỢC';
            el.className = 'bet-text-val label-cuoc';
            document.getElementById('title-' + s).classList.remove('highlight-pulse');
          });

          randomizeTopPlayers(); // Cập nhật ngẫu nhiên bảng cao thủ khi sang phiên mới
        }
      }, 1000);
    }

    function showResultOverlay(sum) {
      document.getElementById('title-' + currentResultSide).classList.add('highlight-pulse');
      
      // Xử lý cộng/trừ lịch sử cá nhân
      const myBet = confirmedBets[currentResultSide];
      if (myBet > 0) {
        const winAmt = myBet * 1.98;
        balance += winAmt;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        document.getElementById('win-overlay').innerText = '+' + winAmt.toLocaleString();
        document.getElementById('win-overlay').style.display = 'block';

        // Lưu lịch sử thắng
        const now = new Date();
        const timeStr = `${now.getDate()}-${now.getMonth()+1}-${now.getFullYear()} ${now.getHours()}:${now.getMinutes()}`;
        userBetHistory.unshift({
          phien: currentSessionId,
          time: timeStr,
          cuoc: myBet,
          win: winAmt - myBet,
          detail: `Đặt ${currentResultSide} Kết quả ${currentDices.join('-')} ${currentResultSide}, Tổng đặt ${myBet.toLocaleString()} Hoàn trả 0, Nhận ${winAmt.toLocaleString()}`
        });
        renderHistoryTable();
      }

      historyResults.push({ side: currentResultSide, total: sum, dices: currentDices });
    }

    function initBoardDrag() {
      const board = document.getElementById('game-board-container');
      let isDragging = false, startX, startY, posX = 0, posY = 0;

      board.addEventListener('mousedown', (e) => {
        if (e.target.closest('.circle-btn') || e.target.closest('.btn-cuoc-oval') || e.target.closest('.chip-panel-real') || e.target.closest('.plate-cover')) return;
        isDragging = true;
        startX = e.clientX - posX;
        startY = e.clientY - posY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        posX = e.clientX - startX;
        posY = e.clientY - startY;
        board.style.transform = `translate(${posX}px, ${posY}px)`;
      });

      window.addEventListener('mouseup', () => isDragging = false);
    }
  </script>
</body>
</html>
