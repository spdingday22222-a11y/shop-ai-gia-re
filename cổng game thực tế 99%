  <script>
    // System State Variables
    let userBalance = 57300755;
    let selectedChipValue = 100000;
    let selectedSideType = null;
    let myBets = { 'TÀI': 0, 'XỈU': 0 };
    let tempBetAmount = 0;
    let countdown = 45;
    let gameTimer = null;
    let isRolling = false;

    // Mapping góc xoay 3D cho các mặt từ 1-6
    const diceRotations = {
      1: { x: 0, y: 0 },
      6: { x: 0, y: 180 },
      2: { x: 0, y: 90 },
      5: { x: 0, y: -90 },
      3: { x: -90, y: 0 },
      4: { x: 90, y: 0 }
    };

    // Khởi chạy Loading Bar
    window.addEventListener('load', () => {
      let progress = 0;
      const fill = document.getElementById('loader-fill');
      const text = document.getElementById('loader-text');
      const interval = setInterval(() => {
        progress += Math.floor(Math.random() * 15) + 5;
        if (progress > 100) progress = 100;
        fill.style.width = progress + '%';
        if (progress === 100) {
          clearInterval(interval);
          setTimeout(() => {
            document.getElementById('loading-screen').classList.remove('active');
            document.getElementById('lobby-screen').classList.add('active');
            startGlobalTimer();
          }, 400);
        }
      }, 80);
    });

    // Cập nhật số dư giao diện
    function updateBalanceDisplay() {
      const formatted = userBalance.toLocaleString('en-US');
      document.getElementById('user-balance').innerText = formatted;
      document.getElementById('arena-balance').innerText = formatted;
    }

    // Toast Notification
    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    // Chuyển sang Sảnh Game
    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      const arena = document.getElementById('arena-screen');
      arena.style.display = 'flex';
      setTimeout(() => arena.classList.add('active'), 10);

      const titleText = document.getElementById('arena-title-text');
      if (mode === 'HOT_TAIXIU') {
        arena.classList.add('hot-theme');
        titleText.innerText = 'SẢNH HOT TÀI XỈU 3D';
      } else {
        arena.classList.remove('hot-theme');
        titleText.innerText = 'SẢNH TÀI XỈU MD5 REAL 3D';
      }
    }

    // Thoát về Lobby
    function exitArena() {
      const arena = document.getElementById('arena-screen');
      arena.classList.remove('active');
      setTimeout(() => {
        arena.style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    // Timer Vòng Chơi
    function startGlobalTimer() {
      if (gameTimer) clearInterval(gameTimer);
      gameTimer = setInterval(() => {
        countdown--;
        if (countdown < 0) countdown = 45;

        // Cập nhật giao diện timer
        const timerStr = countdown < 10 ? '0' + countdown : '' + countdown;
        document.getElementById('timer').innerText = countdown;
        document.getElementById('lobby-time-1').innerText = '00:' + timerStr;
        document.getElementById('lobby-time-2').innerText = '00:' + timerStr;

        // Khi đếm ngược về 0 -> Thực hiện lắc xúc xắc
        if (countdown === 0 && !isRolling) {
          rollDiceSequence();
        }
      }, 1000);
    }

    // Đổi góc Camera 3D
    function toggleCamera3D() {
      const stage = document.getElementById('arena-stage');
      stage.classList.toggle('pan-angle');
      showToast(stage.classList.contains('pan-angle') ? 'Đã bật góc nhìn 3D nghiêng' : 'Đã về góc nhìn thẳng');
    }

    // Chọn Chip Cược
    function selectChip(val, element) {
      selectedChipValue = val;
      document.querySelectorAll('.chip-sq').forEach(el => el.classList.remove('selected'));
      element.classList.add('selected');
    }

    // Chọn Cửa Cược (Tài / Xỉu)
    function selectSide(side) {
      if (countdown <= 3) {
        showToast('Hết thời gian đặt cược!');
        return;
      }
      selectedSideType = side;
      document.getElementById('side-tai').classList.remove('selected-side');
      document.getElementById('side-xiu').classList.remove('selected-side');
      if (side === 'TÀI') {
        document.getElementById('side-tai').classList.add('selected-side');
      } else {
        document.getElementById('side-xiu').classList.add('selected-side');
      }
    }

    // Nút X2
    function actionX2() {
      if (!selectedSideType) { showToast('Vui lòng chọn cửa cược!'); return; }
      const current = myBets[selectedSideType];
      if (current === 0) { showToast('Bạn chưa cược cửa này!'); return; }
      if (userBalance < current) { showToast('Số dư không đủ!'); return; }
      userBalance -= current;
      myBets[selectedSideType] += current;
      updateBalanceDisplay();
      renderMyBetTags();
      showToast('Đã x2 cược cửa ' + selectedSideType);
    }

    // Nút Đặt Cược
    function actionConfirmBet() {
      if (!selectedSideType) { showToast('Vui lòng chọn TÀI hoặc XỈU!'); return; }
      if (countdown <= 3) { showToast('Đã đóng hòm cược!'); return; }
      if (userBalance < selectedChipValue) { showToast('Số dư không đủ!'); return; }

      userBalance -= selectedChipValue;
      myBets[selectedSideType] += selectedChipValue;
      updateBalanceDisplay();
      renderMyBetTags();
      showToast('Đặt cược ' + selectedChipValue.toLocaleString() + 'đ vào ' + selectedSideType);
    }

    // Nút Hủy Cược
    function actionCancelBet() {
      if (myBets['TÀI'] === 0 && myBets['XỈU'] === 0) {
        showToast('Chưa có cược nào để hủy!');
        return;
      }
      userBalance += myBets['TÀI'] + myBets['XỈU'];
      myBets = { 'TÀI': 0, 'XỈU': 0 };
      updateBalanceDisplay();
      renderMyBetTags();
      showToast('Đã hủy tất cả cược phiên này');
    }

    // Nút All In
    function actionAllIn() {
      if (!selectedSideType) { showToast('Vui lòng chọn cửa cược!'); return; }
      if (userBalance <= 0) { showToast('Số dư đã hết!'); return; }
      const all = userBalance;
      myBets[selectedSideType] += all;
      userBalance = 0;
      updateBalanceDisplay();
      renderMyBetTags();
      showToast('Đã ALL IN vào ' + selectedSideType);
    }

    // Hiển thị Tag cược cá nhân
    function renderMyBetTags() {
      const tagTai = document.getElementById('my-tai-bet');
      const tagXiu = document.getElementById('my-xiu-bet');

      if (myBets['TÀI'] > 0) {
        tagTai.innerText = 'Cược: ' + myBets['TÀI'].toLocaleString();
        tagTai.style.display = 'block';
      } else {
        tagTai.style.display = 'none';
      }

      if (myBets['XỈU'] > 0) {
        tagXiu.innerText = 'Cược: ' + myBets['XỈU'].toLocaleString();
        tagXiu.style.display = 'block';
      } else {
        tagXiu.style.display = 'none';
      }
    }

    // Chuỗi Hiệu Ứng Lắc Xúc Xắc 3D & Trả Thưởng
    function rollDiceSequence() {
      isRolling = true;
      const wrap1 = document.getElementById('wrap1');
      const wrap2 = document.getElementById('wrap2');
      const wrap3 = document.getElementById('wrap3');
      const cube1 = document.getElementById('cube1');
      const cube2 = document.getElementById('cube2');
      const cube3 = document.getElementById('cube3');

      // Bật Animation nảy + xoay liên tục
      wrap1.classList.add('rolling-1');
      wrap2.classList.add('rolling-2');
      wrap3.classList.add('rolling-3');
      cube1.classList.add('rolling');
      cube2.classList.add('rolling');
      cube3.classList.add('rolling');

      // Tắt hiệu ứng thắng cũ
      document.getElementById('side-tai').classList.remove('active-win');
      document.getElementById('side-xiu').classList.remove('active-win');

      setTimeout(() => {
        // Tắt Lắc
        wrap1.classList.remove('rolling-1');
        wrap2.classList.remove('rolling-2');
        wrap3.classList.remove('rolling-3');
        cube1.classList.remove('rolling');
        cube2.classList.remove('rolling');
        cube3.classList.remove('rolling');

        // Tạo kết quả ngẫu nhiên (1-6)
        const d1 = Math.floor(Math.random() * 6) + 1;
        const d2 = Math.floor(Math.random() * 6) + 1;
        const d3 = Math.floor(Math.random() * 6) + 1;
        const sum = d1 + d2 + d3;
        const resultType = sum >= 11 ? 'TÀI' : 'XỈU';

        // Xoay viên xúc xắc về mặt kết quả
        applyDiceRotation(cube1, d1);
        applyDiceRotation(cube2, d2);
        applyDiceRotation(cube3, d3);

        // Hiển thị thắng cửa
        setTimeout(() => {
          if (resultType === 'TÀI') {
            document.getElementById('side-tai').classList.add('active-win');
          } else {
            document.getElementById('side-xiu').classList.add('active-win');
          }

          // Tính tiền thưởng
          if (myBets[resultType] > 0) {
            const winMoney = myBets[resultType] * 2;
            userBalance += winMoney;
            updateBalanceDisplay();
            showWinBanner(winMoney);
          }

          // Cập nhật điểm chấm Lịch sử
          addHistoryDot(resultType);

          // Reset cược lượt mới
          myBets = { 'TÀI': 0, 'XỈU': 0 };
          renderMyBetTags();
          isRolling = false;
        }, 800);

      }, 2000);
    }

    // Áp dụng góc quay 3D chuẩn
    function applyDiceRotation(cubeEl, value) {
      const rot = diceRotations[value];
      cubeEl.style.transform = `rotateX(${rot.x + 720}deg) rotateY(${rot.y + 720}deg)`;
    }

    // Hiển thị Bảng Thắng
    function showWinBanner(amount) {
      const banner = document.getElementById('win-banner');
      document.getElementById('win-money-text').innerText = '+' + amount.toLocaleString() + ' VNĐ';
      banner.classList.add('show');
      setTimeout(() => banner.classList.remove('show'), 3000);
    }

    // Thêm Lịch Sử Cầu
    function addHistoryDot(type) {
      const container = document.getElementById('history-dots');
      const dot = document.createElement('div');
      dot.className = 'dot ' + (type === 'TÀI' ? 'tai' : 'xiu');
      container.appendChild(dot);
      if (container.children.length > 10) {
        container.removeChild(container.firstChild);
      }
    }
  </script>
</body>
