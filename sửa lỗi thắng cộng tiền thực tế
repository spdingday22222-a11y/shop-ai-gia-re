<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Go88 Real - Tài Xỉu MD5 VIP</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      font-family: 'Arial Black', 'Arial', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #020204;
      color: #ffffff;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.25s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #101018 0%, #020204 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 42px; font-weight: 900;
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 45%, #e65c00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 20px rgba(245, 166, 35, 0.7));
      letter-spacing: 2px; text-transform: uppercase;
    }

    .loader-box {
      width: 320px; height: 14px; background: rgba(0,0,0,0.9);
      border: 1.5px solid #ffb703; border-radius: 10px; padding: 2px; margin-top: 20px;
      box-shadow: 0 0 15px rgba(255, 183, 3, 0.3);
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff8000, #ffea00);
      border-radius: 10px; transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffea00;
    }

    /* 2. LOBBY */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #151522 0%, #08080e 50%, #000002 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(10, 10, 15, 0.95);
      border-bottom: 2px solid #ffb703; z-index: 20;
      box-shadow: 0 4px 20px rgba(0,0,0,0.8);
    }

    .user-info { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 42px; height: 42px; border-radius: 10px; border: 2px solid #ffb703; background-size: cover; box-shadow: 0 0 8px rgba(255,183,3,0.5); }
    .balance-box {
      background: #08080c; border: 1.5px solid #ffb703;
      border-radius: 18px; padding: 4px 16px; color: #ffea00;
      font-weight: bold; font-size: 15px; text-shadow: 0 0 8px rgba(255, 234, 0, 0.5);
      box-shadow: inset 0 0 6px rgba(0,0,0,0.8);
    }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 220px; height: 280px; border-radius: 18px; border: 2px solid #ffb703;
      display: flex; flex-direction: column; justify-content: space-between; padding: 20px;
      cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;
      background: linear-gradient(180deg, #1f1f2e 0%, #0a0a10 100%);
      box-shadow: 0 0 25px rgba(255, 183, 3, 0.25), inset 0 0 15px rgba(255, 255, 255, 0.05);
    }
    .game-card:hover { transform: translateY(-5px) scale(1.03); box-shadow: 0 0 35px rgba(255, 183, 3, 0.5); }

    .card-title {
      font-size: 21px; font-weight: 900; text-align: center;
      background: linear-gradient(180deg, #ffffff 0%, #ffea00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }
    .card-sub { font-size: 11px; text-align: center; color: #00ffcc; font-weight: bold; letter-spacing: 1px; }

    /* 3. ARENA GAME PLAY */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(2, 2, 5, 0.98); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
      overflow: hidden;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(10, 10, 15, 0.98); border-bottom: 1.5px solid #ffb703;
      z-index: 20; box-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .btn-back-lobby {
      background: linear-gradient(180deg, #80000a, #4a0005);
      color: #fff; border: 1.5px solid #ffea00; padding: 6px 16px; border-radius: 16px;
      font-weight: bold; cursor: pointer; box-shadow: 0 3px 6px #000;
    }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; }

    .dim-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.82);
      z-index: 11; opacity: 0; pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .dim-overlay.active { opacity: 1; pointer-events: auto; }

    /* BÀN TÀI XỈU - KÉO THẢ TỰ DO (DRAG BOARD) */
    .real-taixiu-board {
      position: absolute; width: 740px; height: 360px;
      border-radius: 180px; display: flex; justify-content: space-between; align-items: center;
      padding: 20px 40px;
      background: radial-gradient(circle at center, #181820 0%, #0a0a0f 60%, #020204 100%);
      border: 4px solid #f5a623;
      box-shadow: 0 0 60px rgba(245, 166, 35, 0.35), inset 0 0 30px rgba(0, 0, 0, 0.95), inset 0 0 10px rgba(255, 234, 0, 0.3);
      cursor: grab;
      touch-action: none;
      will-change: transform, left, top;
      z-index: 15;
    }
    .real-taixiu-board:active { cursor: grabbing; }

    .board-logo {
      position: absolute; top: 18px; left: 50%; transform: translateX(-50%);
      font-size: 16px; font-weight: 900; letter-spacing: 2px;
      background: linear-gradient(180deg, #ffffff 0%, #ffb703 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 8px rgba(255, 183, 3, 0.6));
      z-index: 5; pointer-events: none;
    }

    /* NÚT TRÒN VIỀN BÀN CƯỢC */
    .circle-btn {
      position: absolute; width: 36px; height: 36px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 14px; font-weight: bold; cursor: pointer;
      background: linear-gradient(180deg, #2a2a38, #12121a);
      border: 1.5px solid #ffea00; z-index: 25; box-shadow: 0 4px 8px #000, 0 0 8px rgba(255,234,0,0.3);
      transition: transform 0.15s;
    }
    .circle-btn:active { transform: scale(0.9); }

    .btn-info { top: 22px; left: 145px; }
    .btn-chart { top: 88px; left: 60px; background: linear-gradient(180deg, #0077b6, #023e8a); }
    .btn-help { top: 158px; left: 25px; }
    .btn-history { top: 228px; left: 60px; }

    .btn-close { top: 22px; right: 145px; background: linear-gradient(180deg, #9e1a22, #500000); }
    .btn-rank { top: 88px; right: 60px; }
    .btn-chat-toggle { top: 158px; right: 25px; }

    /* NÚT NẶN BÀN TAY */
    .btn-nan-hand {
      position: absolute; right: 105px; bottom: 25px; width: 48px; height: 48px;
      border-radius: 50%; background: radial-gradient(circle, #ff9d00, #804000);
      border: 2px solid #fff3a1; box-shadow: 0 0 12px #ff9d00, 0 4px 8px #000;
      display: flex; justify-content: center; align-items: center; font-size: 22px;
      cursor: pointer; z-index: 26; transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-nan-hand:hover { transform: scale(1.1); }
    .btn-nan-hand:active { transform: scale(0.92); }

    .btn-nan-hand.active {
      background: radial-gradient(circle, #00ffcc, #005544);
      border-color: #00ffff;
      box-shadow: 0 0 20px #00ffff, 0 0 40px rgba(0, 255, 255, 0.6);
      animation: nanPulse 1.2s infinite alternate;
    }
    @keyframes nanPulse {
      0% { transform: scale(1); }
      100% { transform: scale(1.12); }
    }

    /* CỬA CƯỢC TÀI / XỈU */
    .bet-side {
      width: 200px; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 20;
    }

    .player-count { font-size: 13px; color: #ffea00; font-weight: bold; margin-bottom: 2px; text-shadow: 0 0 5px #ffea00; transition: transform 0.1s; }
    .player-count.bounce { transform: scale(1.25); color: #ffffff; }

    .bet-title {
      font-size: 56px; font-weight: 900; color: #ffffff;
      text-shadow: 0 4px 10px rgba(0,0,0,0.9), 0 0 15px rgba(255,255,255,0.3);
      letter-spacing: 3px; transition: all 0.3s ease;
    }
    .bet-title.highlight-pulse {
      color: #ffea00; text-shadow: 0 0 25px #ffea00, 0 0 50px #ffea00;
      animation: pulseGlow 0.6s infinite alternate;
    }
    @keyframes pulseGlow {
      from { transform: scale(1); }
      to { transform: scale(1.12); }
    }

    .bet-amount {
      font-size: 18px; font-weight: 900; color: #00ffcc;
      text-shadow: 0 0 8px rgba(0, 255, 204, 0.6), 0 2px 4px #000; margin-bottom: 8px;
      transition: transform 0.1s ease, color 0.1s ease;
    }
    .bet-amount.jump-glow {
      transform: scale(1.2); color: #ffea00; text-shadow: 0 0 15px #ffea00;
    }

    .btn-cuoc-oval {
      width: 145px; height: 40px;
      background: radial-gradient(circle, #252533 0%, #101018 100%);
      border: 2px solid #ffb703; border-radius: 20px;
      display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: inset 0 0 8px rgba(0,0,0,0.9), 0 4px 10px rgba(0,0,0,0.8), 0 0 10px rgba(255, 183, 3, 0.2);
      transition: transform 0.1s, border-color 0.2s;
    }
    .btn-cuoc-oval:active { transform: scale(0.95); }

    .bet-text-val { font-size: 16px; font-weight: 900; color: #8888a0; text-shadow: 0 1px 2px #000; }
    .bet-text-val.label-cuoc {
      color: #ff9d00;
      background: linear-gradient(180deg, #fff3a1 0%, #ff9d00 60%, #b35900 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 3px rgba(0, 0, 0, 0.9));
      font-size: 18px; letter-spacing: 1px;
    }
    .bet-text-val.active-bet { color: #ffea00; text-shadow: 0 0 8px rgba(255, 234, 0, 0.9); }

    /* BÁT / ĐĨA TRUNG TÂM */
    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 215px; height: 215px; border-radius: 50%;
      background: radial-gradient(circle, #0d0d12 0%, #181824 70%, #000000 100%);
      border: 4px solid #ffb703; display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 40px rgba(0,0,0,0.9), inset 0 0 20px rgba(255,183,3,0.3); z-index: 21;
    }

    .plate-cover {
      position: fixed; width: 210px; height: 210px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #4a4a5a 0%, #1a1a24 60%, #050508 100%);
      border: 3px solid #ffea00; box-shadow: 0 10px 30px rgba(0,0,0,0.95), inset 0 2px 10px rgba(255,255,255,0.4);
      z-index: 99; display: none; cursor: grab; justify-content: center; align-items: center;
      touch-action: none; transition: filter 0.2s ease, transform 0.1s ease;
      will-change: transform, left, top;
    }
    .plate-cover:active { cursor: grabbing; filter: drop-shadow(0px 0px 22px rgba(255, 234, 0, 0.95)); }
    .plate-cover-knob { width: 48px; height: 48px; border-radius: 50%; background: radial-gradient(circle, #ffd700, #b8860b); border: 2px solid #fff; box-shadow: 0 4px 8px #000; pointer-events: none; }

    .timer-display { font-size: 64px; font-weight: 900; color: #ffea00; text-shadow: 0 0 20px rgba(255, 234, 0, 0.9); z-index: 6; }

    .dice-triangle-container { position: absolute; width: 140px; height: 120px; display: none; z-index: 8; }
    .dice-real {
      position: absolute; width: 44px; height: 44px;
      background: linear-gradient(145deg, #e60000, #800000);
      border: 2px solid #ffffff; border-radius: 9px;
      box-shadow: inset 0 0 6px rgba(255,255,255,0.8), 0 5px 10px rgba(0,0,0,0.8);
      display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 4px; align-items: center; justify-items: center;
    }

    #dice1 { top: 5px; left: 48px; }
    #dice2 { bottom: 8px; left: 16px; }
    #dice3 { bottom: 8px; right: 16px; }

    .pip { width: 7px; height: 7px; background: #ffffff; border-radius: 50%; display: none; box-shadow: inset 0 1px 1px rgba(0,0,0,0.5); }
    .pip.center-red { background: #ff0000; border: 1px solid #fff; width: 14px; height: 14px; grid-column: 2; grid-row: 2; display: block; }
    .p-1 { grid-column: 1; grid-row: 1; } .p-3 { grid-column: 3; grid-row: 1; }
    .p-4 { grid-column: 1; grid-row: 2; } .p-5 { grid-column: 2; grid-row: 2; } .p-6 { grid-column: 3; grid-row: 2; }
    .p-7 { grid-column: 1; grid-row: 3; } .p-9 { grid-column: 3; grid-row: 3; }

    .win-text-overlay {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-size: 32px; font-weight: 900; color: #ffea00;
      text-shadow: 0 0 15px #ffea00, 0 4px 10px #000; z-index: 10; display: none; white-space: nowrap;
      animation: popWin 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popWin {
      0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    /* CHIP CƯỢC */
    .chip-panel-real {
      position: absolute; 
      bottom: -60px; 
      left: 50%; 
      transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      background: rgba(0, 0, 0, 0) !important;
      border: none !important;
      box-shadow: none !important;
      padding: 8px 20px 10px 20px; border-radius: 16px; z-index: 100;
      transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 1;
    }

    .chip-panel-real.hidden {
      opacity: 0; pointer-events: none; 
      transform: translate(-50%, 40px);
    }

    .chip-list { display: flex; gap: 8px; }

    .chip-btn {
      width: 60px; height: 38px; border-radius: 8px;
      background: linear-gradient(180deg, #ffb300 0%, #ff8000 60%, #cc5200 100%);
      border: 1.5px solid #ffe066; color: #ffffff; font-size: 13px; font-weight: 900;
      display: flex; justify-content: center; align-items: center; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(255,255,255,0.8), 0 4px 8px #000;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); transition: transform 0.1s, box-shadow 0.1s;
    }
    .chip-btn:active { transform: translateY(-2px); box-shadow: 0 0 12px #ffea00; }

    .chip-actions { display: flex; gap: 12px; width: 100%; justify-content: center; margin-top: 2px; }

    .btn-action-x2 {
      background: linear-gradient(180deg, #3a7bd5, #3a6073); border: 1px solid #fff;
      color: #fff; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.6);
    }

    .btn-action-bet {
      background: linear-gradient(180deg, #fff3b0 0%, #f5a623 50%, #d47a00 100%);
      border: 1.5px solid #ffffff;
      color: #3d1e00; padding: 6px 32px; border-radius: 18px; font-weight: 900; font-size: 14px; cursor: pointer;
      box-shadow: 0 0 15px rgba(245, 166, 35, 0.9), 0 3px 6px rgba(0,0,0,0.6);
      text-shadow: 0 1px 0 rgba(255,255,255,0.6);
    }

    .btn-action-cancel {
      background: linear-gradient(180deg, #b8121f 0%, #80000a 60%, #4a0005 100%);
      border: 1.5px solid #ff9999;
      color: #fff; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(255,255,255,0.4), 0 3px 6px rgba(0,0,0,0.8);
      text-shadow: 0 1px 2px #000;
    }

    /* 4. BẢNG LỊCH SỬ PHIÊN / SOI CẦU CHUẨN GO88 VIP (MODAL) TĂNG CAO HIỂN THỊ ĐỦ 7 HÀNG DỌC */
    .chart-modal-overlay {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0, 0, 0, 0.75); z-index: 95; display: none;
      justify-content: center; align-items: center; pointer-events: none;
    }
    .chart-modal-overlay.active { display: flex; pointer-events: auto; }

    .chart-modal-box {
      position: absolute;
      width: 860px; height: 640px;
      background: linear-gradient(180deg, #2b231f 0%, #120e0c 100%);
      border: 3px solid #ffb703; border-radius: 16px;
      box-shadow: 0 0 60px rgba(0,0,0,0.95), 0 0 25px rgba(245, 166, 35, 0.4);
      display: flex; flex-direction: column; overflow: hidden;
      pointer-events: auto;
      will-change: transform;
    }

    .chart-header {
      height: 50px; background: linear-gradient(180deg, #423631, #241e1b);
      border-bottom: 2px solid #ffb703; display: flex; justify-content: center;
      align-items: center; position: relative; padding: 0 20px;
      cursor: grab;
      touch-action: none;
    }
    .chart-header:active { cursor: grabbing; }

    .chart-title-main {
      font-size: 18px; font-weight: 900; color: #ffea00;
      text-shadow: 0 2px 4px #000; letter-spacing: 2px; text-transform: uppercase;
      background: linear-gradient(180deg, #ffe066 0%, #ff9d00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .btn-close-chart {
      position: absolute; right: 15px; width: 32px; height: 32px; border-radius: 50%; 
      background: linear-gradient(180deg, #d9534f, #a94442); border: 2px solid #fff;
      color: #fff; font-weight: bold; display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: 0 2px 6px #000; z-index: 10;
      transition: transform 0.15s;
    }
    .btn-close-chart:active { transform: scale(0.9); }

    .chart-body-wrapper {
      flex: 1; padding: 12px 18px; overflow-y: auto; overflow-x: hidden;
      display: flex; flex-direction: column; gap: 10px;
    }

    .session-info-bar {
      text-align: center; font-size: 13px; color: #ffea00; font-weight: bold;
      text-shadow: 0 1px 2px #000; margin-bottom: 2px;
    }

    /* THANH THỐNG KÊ TÀI / XỈU TRỰC QUAN */
    .stats-pill-container {
      display: flex; justify-content: center; align-items: center; gap: 15px; margin-bottom: 2px;
    }
    .stat-pill {
      display: flex; align-items: center; background: rgba(0,0,0,0.6);
      border: 1.5px solid #ffb703; border-radius: 16px; padding: 2px 12px;
      font-size: 12px; font-weight: 900; box-shadow: inset 0 1px 3px #000;
    }
    .stat-pill.tai-pill { color: #ffea00; border-color: #ffb703; }
    .stat-pill.xiu-pill { color: #ffffff; border-color: #cccccc; }

    /* HỆ THỐNG BẢNG CẦU 7 HÀNG DỌC HIỂN THỊ ĐỦ TRỌN VẸN 100% */
    .chart-section-box {
      background: #0e0a08; border: 2px solid #4a3f38; border-radius: 8px; padding: 6px;
      overflow-x: auto; overflow-y: hidden; touch-action: pan-x;
    }

    .grid-cau-container {
      display: grid;
      grid-template-rows: repeat(7, 36px);
      grid-auto-columns: 36px;
      grid-auto-flow: column;
      gap: 1.5px;
      width: max-content;
      min-width: 100%;
    }

    .grid-cell {
      width: 36px; height: 36px;
      background: #181412;
      border: 1px solid #362c26;
      display: flex; justify-content: center; align-items: center;
      border-radius: 3px;
    }

    /* CHẤM TRÒN TÀI & XỈU CHUẨN VIP THỰC TẾ */
    .dot-result {
      width: 28px; height: 28px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      font-size: 10px; font-weight: 900;
      box-shadow: 0 2px 5px rgba(0,0,0,0.8), inset 0 1px 1px rgba(255,255,255,0.6);
    }
    .dot-result.tai {
      background: radial-gradient(circle at 35% 35%, #333333, #050505);
      border: 1.5px solid #ffffff; color: #ffea00; text-shadow: 0 0 3px rgba(255,234,0,0.8);
    }
    .dot-result.xiu {
      background: radial-gradient(circle at 35% 35%, #ffffff, #999999);
      border: 1.5px solid #ffffff; color: #000; text-shadow: none;
    }

    /* TOAST */
    .toast-msg {
      position: fixed; top: 25px; left: 50%; transform: translateX(-50%) translateY(-60px);
      background: linear-gradient(180deg, #1f1b18 0%, #0d0a08 100%);
      border: 2px solid #ffb703; color: #ffea00;
      padding: 12px 28px; border-radius: 25px; font-weight: 900; font-size: 14px;
      z-index: 99999; opacity: 0; transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
      box-shadow: 0 0 25px rgba(255, 183, 3, 0.7), inset 0 0 10px rgba(255, 234, 0, 0.3);
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
      letter-spacing: 0.5px;
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

  <div id="toast" class="toast-msg">Thông báo hệ thống</div>

  <!-- 1. LOADING SCREEN -->
  <div id="loading-screen" class="app-screen active">
    <div class="loader-brand">GO88 MD5 VIP</div>
    <div class="loader-box"><div class="loader-fill" id="loader-fill"></div></div>
  </div>

  <!-- 2. GAME LOBBY -->
  <div id="lobby-screen" class="app-screen game-lobby">
    <div class="top-bar">
      <div class="user-info">
        <div class="avatar" style="background-image: url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100');"></div>
        <div>
          <div style="font-size: 11px; color: #aaa;">Go88TrumBai</div>
          <div class="balance-box" id="user-balance">$ 1,096,000</div>
        </div>
      </div>
      <div>
        <button class="btn-action-bet" style="padding: 5px 18px; font-size: 12px;" onclick="showToast('💳 Cổng Nạp Tự Động 24/7 Sẵn Sàng!')">NẠP TIỀN</button>
      </div>
    </div>

    <div class="lobby-content">
      <div class="game-card" onclick="enterArena('MD5')">
        <div class="card-title">TÀI XỈU MD5</div>
        <div class="card-sub">MINH BẠCH 100%</div>
        <div style="text-align: center; color:#ffea00; font-size:12px; font-weight:bold;">#13217</div>
      </div>
    </div>
  </div>

  <!-- 3. ARENA GAME PLAY -->
  <div id="arena-screen" class="arena-screen">
    <div class="arena-header">
      <button class="btn-back-lobby" onclick="exitArena()">◄ RỜI SẢNH</button>
      <div style="font-weight:900; color:#ffea00; font-size: 18px;" id="arena-title">TÀI XỈU MD5 VIP</div>
      <div class="balance-box" id="arena-balance">$ 1,096,000</div>
    </div>

    <div class="arena-stage" id="arena-stage">
      <div class="dim-overlay" id="dim-overlay"></div>

      <!-- BÀN CƯỢC -->
      <div class="real-taixiu-board" id="draggable-board">
        <div class="board-logo">GO88 VIP MD5</div>

        <div class="circle-btn btn-info" onclick="showToast('ℹ️ Phiên cược mã hóa MD5 Minh Bạch 100%')">i</div>
        <div class="circle-btn btn-chart" onclick="openChartModal()">📊</div>
        <div class="circle-btn btn-help" onclick="showToast('❓ Luật chơi: Tài (11-17), Xỉu (3-10)')">?</div>
        <div class="circle-btn btn-history" onclick="showToast('📜 Xem Lịch Sử Cược Cá Nhân')">📜</div>

        <div class="circle-btn btn-close" onclick="exitArena()">X</div>
        <div class="circle-btn btn-rank" onclick="showToast('🏆 Bảng Vinh Danh Top Đại Gia')">🏆</div>
        <div class="circle-btn btn-chat-toggle" onclick="showToast('💬 Khung Chat Cộng Đồng VIP')">💬</div>

        <div class="btn-nan-hand active" id="btn-nan" onclick="toggleNanMode()" title="Bật/Tắt chế độ Nặn">✋</div>

        <!-- CỬA TÀI -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="tai-players">142</span></div>
          <div class="bet-title" id="title-TAI">TÀI</div>
          <div class="bet-amount" id="tai-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('TAI')">
            <span class="bet-text-val label-cuoc" id="val-TAI">CƯỢC</span>
          </div>
        </div>

        <!-- BÁT / ĐĨA TRUNG TÂM -->
        <div class="center-plate" id="center-plate">
          <div class="timer-display" id="timer-text">40</div>

          <div class="dice-triangle-container" id="dice-container">
            <div class="dice-real" id="dice1"></div>
            <div class="dice-real" id="dice2"></div>
            <div class="dice-real" id="dice3"></div>
          </div>

          <div class="win-text-overlay" id="win-overlay">+0</div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="xiu-players">128</span></div>
          <div class="bet-title" id="title-XIU">XỈU</div>
          <div class="bet-amount" id="xiu-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('XIU')">
            <span class="bet-text-val label-cuoc" id="val-XIU">CƯỢC</span>
          </div>
        </div>

        <!-- BANNER PHÍM CHIP CƯỢC -->
        <div class="chip-panel-real hidden" id="chip-panel">
          <div class="chip-list">
            <div class="chip-btn" onclick="addChip(1000)">1K</div>
            <div class="chip-btn" onclick="addChip(10000)">10K</div>
            <div class="chip-btn" onclick="addChip(50000)">50K</div>
            <div class="chip-btn" onclick="addChip(100000)">100K</div>
            <div class="chip-btn" onclick="addChip(500000)">500K</div>
            <div class="chip-btn" onclick="addChip(1000000)">1M</div>
            <div class="chip-btn" onclick="addChip(10000000)">10M</div>
            <div class="chip-btn" onclick="addChip(50000000)">50M</div>
          </div>
          <div class="chip-actions">
            <button class="btn-action-x2" onclick="allInBet()">ALL IN</button>
            <button class="btn-action-bet" onclick="confirmBet()">ĐẶT CƯỢC</button>
            <button class="btn-action-cancel" onclick="cancelBet()">HỦY</button>
          </div>
        </div>
      </div>

      <!-- NẮP KÉO TỰ DO -->
      <div class="plate-cover" id="plate-cover">
        <div class="plate-cover-knob"></div>
      </div>

      <!-- BẢNG LỊCH SỬ PHIÊN / SOI CẦU -->
      <div class="chart-modal-overlay" id="chart-modal">
        <div class="chart-modal-box" id="draggable-chart">
          <div class="chart-header" id="chart-drag-handle">
            <div class="chart-title-main">Lịch Sử Phiên</div>
            <div class="btn-close-chart" onclick="closeChartModal()">✕</div>
          </div>
          <div class="chart-body-wrapper" id="chart-scroll-area">
            <div class="session-info-bar">Phiên gần đây nhất (#122) - Tài 12 (4-5-3)</div>
            
            <div class="stats-pill-container">
              <div class="stat-pill tai-pill">Tài: 51</div>
              <div class="stat-pill xiu-pill">Xỉu: 49</div>
            </div>
            <div class="chart-section-box">
              <div class="grid-cau-container" id="grid-cau-top"></div>
            </div>

            <div class="stats-pill-container" style="margin-top: 6px;">
              <div class="stat-pill tai-pill">Tài: 28</div>
              <div class="stat-pill xiu-pill">Xỉu: 22</div>
            </div>
            <div class="chart-section-box">
              <div class="grid-cau-container" id="grid-cau-bottom"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let balance = 1096000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    let timer = 40;
    let timerInterval = null;
    let botBetInterval = null;
    let gameState = 'BETTING';

    let currentTaiBet = 0, currentXiuBet = 0;
    let currentTaiUsers = 142, currentXiuUsers = 128;
    let currentDiceResults = [1, 2, 3];

    let historyResults = [
      { side: 'TAI', total: 13 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 10 }, { side: 'XIU', total: 9 }, { side: 'TAI', total: 11 }, { side: 'XIU', total: 8 }, { side: 'TAI', total: 16 }, { side: 'TAI', total: 17 }, { side: 'TAI', total: 10 }, { side: 'TAI', total: 11 }, { side: 'XIU', total: 9 }, { side: 'TAI', total: 14 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 15 }, { side: 'XIU', total: 12 },
      { side: 'XIU', total: 10 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 12 }, { side: 'TAI', total: 9 }, { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 }, { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 12 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 11 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 10 }, { side: 'TAI', total: 10 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 },
      { side: 'TAI', total: 12 }, { side: 'TAI', total: 14 }, { side: 'TAI', total: 15 }, { side: 'TAI', total: 13 }, { side: 'TAI', total: 16 }, 
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 5 }, { side: 'XIU', total: 4 }, { side: 'XIU', total: 7 }, { side: 'XIU', total: 8 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 6 },
      { side: 'TAI', total: 13 }, { side: 'TAI', total: 14 }, { side: 'XIU', total: 8 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 }
    ];

    let isNanMode = true;
    let isDraggingCover = false;
    let coverX = 0, coverY = 0;
    let coverStartX = 0, coverStartY = 0;

    const plateCover = document.getElementById('plate-cover');
    const dragBoard = document.getElementById('draggable-board');
    const dragChart = document.getElementById('draggable-chart');
    const chartHandle = document.getElementById('chart-drag-handle');
    const dimOverlay = document.getElementById('dim-overlay');
    const chipPanel = document.getElementById('chip-panel');

    window.addEventListener('DOMContentLoaded', () => {
      let fill = document.getElementById('loader-fill');
      let w = 0;
      let loadInterval = setInterval(() => {
        w += Math.floor(Math.random() * 20) + 10;
        if (w >= 100) {
          w = 100;
          clearInterval(loadInterval);
          setTimeout(() => {
            document.getElementById('loading-screen').classList.remove('active');
            document.getElementById('lobby-screen').classList.add('active');
          }, 300);
        }
        fill.style.width = w + '%';
      }, 80);
    });

    function showToast(msg) {
      let t = document.getElementById('toast');
      t.innerText = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2500);
    }

    function enterArena(gameType) {
      document.getElementById('lobby-screen').classList.remove('active');
      let arena = document.getElementById('arena-screen');
      arena.style.display = 'flex';
      setTimeout(() => arena.classList.add('active'), 10);

      requestAnimationFrame(() => {
        initBoardPosition();
        initChartPosition();
        resetCoverPosition();
        renderChartGrids();
      });

      startCountdown();
      startBotSimulation();
    }

    function exitArena() {
      clearInterval(timerInterval);
      clearInterval(botBetInterval);
      let arena = document.getElementById('arena-screen');
      arena.classList.remove('active');
      setTimeout(() => {
        arena.style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 250);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      let btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('✋ Đã bật chế độ Nặn tay VIP');
      } else {
        btn.classList.remove('active');
        showToast('⚡ Đã tắt chế độ Nặn (Mở tự động)');
      }
    }

    function initBoardPosition() {
      let stage = document.getElementById('arena-stage');
      let sw = stage.clientWidth;
      let sh = stage.clientHeight;
      dragBoard.style.left = (sw - dragBoard.offsetWidth) / 2 + 'px';
      dragBoard.style.top = (sh - dragBoard.offsetHeight) / 2 + 'px';
    }

    let isDraggingBoard = false;
    let boardStartX = 0, boardStartY = 0, boardPosX = 0, boardPosY = 0;

    dragBoard.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.circle-btn') || e.target.closest('.btn-cuoc-oval') || e.target.closest('.chip-panel-real') || e.target.closest('.center-plate') || e.target.closest('.btn-nan-hand')) return;
      isDraggingBoard = true;
      boardStartX = e.clientX;
      boardStartY = e.clientY;
      let rect = dragBoard.getBoundingClientRect();
      let parentRect = dragBoard.parentElement.getBoundingClientRect();
      boardPosX = rect.left - parentRect.left;
      boardPosY = rect.top - parentRect.top;
      dragBoard.setPointerCapture(e.pointerId);
    });

    dragBoard.addEventListener('pointermove', (e) => {
      if (!isDraggingBoard) return;
      let dx = e.clientX - boardStartX;
      let dy = e.clientY - boardStartY;
      dragBoard.style.left = (boardPosX + dx) + 'px';
      dragBoard.style.top = (boardPosY + dy) + 'px';
    });

    dragBoard.addEventListener('pointerup', (e) => {
      isDraggingBoard = false;
      try { dragBoard.releasePointerCapture(e.pointerId); } catch(err){}
    });

    function initChartPosition() {
      let sw = window.innerWidth;
      let sh = window.innerHeight;
      dragChart.style.left = (sw - dragChart.offsetWidth) / 2 + 'px';
      dragChart.style.top = (sh - dragChart.offsetHeight) / 2 + 'px';
    }

    let isDraggingChart = false;
    let chartStartX = 0, chartStartY = 0, chartPosX = 0, chartPosY = 0;

    chartHandle.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.btn-close-chart')) return;
      isDraggingChart = true;
      chartStartX = e.clientX;
      chartStartY = e.clientY;
      let rect = dragChart.getBoundingClientRect();
      chartPosX = rect.left;
      chartPosY = rect.top;
      chartHandle.setPointerCapture(e.pointerId);
    });

    chartHandle.addEventListener('pointermove', (e) => {
      if (!isDraggingChart) return;
      let dx = e.clientX - chartStartX;
      let dy = e.clientY - chartStartY;
      dragChart.style.left = (chartPosX + dx) + 'px';
      dragChart.style.top = (chartPosY + dy) + 'px';
    });

    chartHandle.addEventListener('pointerup', (e) => {
      isDraggingChart = false;
      try { chartHandle.releasePointerCapture(e.pointerId); } catch(err){}
    });

    function openChartModal() {
      document.getElementById('chart-modal').classList.add('active');
      renderChartGrids();
    }
    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function startCountdown() {
      clearInterval(timerInterval);
      timer = 40;
      gameState = 'BETTING';
      currentTaiBet = 0;
      currentXiuBet = 0;
      confirmedBets = { TAI: 0, XIU: 0 };

      document.getElementById('tai-amount').innerText = '0';
      document.getElementById('xiu-amount').innerText = '0';
      document.getElementById('val-TAI').innerText = 'CƯỢC';
      document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
      document.getElementById('val-XIU').innerText = 'CƯỢC';
      document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';

      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('win-overlay').style.display = 'none';
      plateCover.style.display = 'none';
      dimOverlay.classList.remove('active');
      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer < 10 ? '0' + timer : timer;

        if (timer <= 6 && gameState === 'BETTING') {
          gameState = 'LOCKED';
          if (currentBetSide) cancelBet();
          chipPanel.classList.add('hidden');
        }

        if (timer <= 0) {
          clearInterval(timerInterval);
          clearInterval(botBetInterval);
          rollDiceAndResolve();
        }
      }, 1000);
    }

    function startBotSimulation() {
      clearInterval(botBetInterval);
      botBetInterval = setInterval(() => {
        if (gameState !== 'BETTING') return;

        let addTai = Math.floor(Math.random() * 2500000) + 500000;
        let addXiu = Math.floor(Math.random() * 2500000) + 500000;
        currentTaiBet += addTai;
        currentXiuBet += addXiu;

        let tElem = document.getElementById('tai-amount');
        let xElem = document.getElementById('xiu-amount');
        tElem.innerText = currentTaiBet.toLocaleString();
        xElem.innerText = currentXiuBet.toLocaleString();

        tElem.classList.add('jump-glow');
        xElem.classList.add('jump-glow');
        setTimeout(() => {
          tElem.classList.remove('jump-glow');
          xElem.classList.remove('jump-glow');
        }, 150);

        currentTaiUsers += Math.floor(Math.random() * 5) - 2;
        currentXiuUsers += Math.floor(Math.random() * 5) - 2;
        document.getElementById('tai-players').innerText = Math.max(80, currentTaiUsers);
        document.getElementById('xiu-players').innerText = Math.max(70, currentXiuUsers);
      }, 700);
    }

    function openBetPanel(side) {
      if (gameState !== 'BETTING') {
        showToast('⚠️ Đã hết thời gian đặt cược cho phiên này!');
        return;
      }
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      chipPanel.classList.remove('hidden');
      showToast('🎯 Đã chọn cửa ' + side + '. Chọn mệnh giá chip!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('❌ Số dư tài khoản không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('❌ Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('🔥 Đã All-In toàn bộ số dư!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        let el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      if (currentBetSide) {
        let el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      chipPanel.classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('⚠️ Vui lòng chọn số tiền cần cược!');
        return;
      }
      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;

      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
      showToast('✅ Cược thành công ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      let el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      chipPanel.classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    function rollDiceAndResolve() {
      gameState = 'RESULT';
      document.getElementById('timer-text').style.display = 'none';
      let diceContainer = document.getElementById('dice-container');
      diceContainer.style.display = 'block';

      let d1 = Math.floor(Math.random() * 6) + 1;
      let d2 = Math.floor(Math.random() * 6) + 1;
      let d3 = Math.floor(Math.random() * 6) + 1;
      currentDiceResults = [d1, d2, d3];
      let total = d1 + d2 + d3;
      let resultSide = total >= 11 ? 'TAI' : 'XIU';

      setDiceFace('dice1', d1);
      setDiceFace('dice2', d2);
      setDiceFace('dice3', d3);

      if (isNanMode) {
        dimOverlay.classList.add('active');
        plateCover.style.display = 'flex';
        resetCoverPosition();
        setupCoverDrag(resultSide, total);
      } else {
        finishRound(resultSide, total);
      }
    }

    function setDiceFace(diceId, val) {
      let dice = document.getElementById(diceId);
      dice.innerHTML = '';
      for (let i = 1; i <= 9; i++) {
        let pip = document.createElement('div');
        pip.className = 'pip p-' + i;
        if (val === 1 && i === 5) pip.className = 'pip center-red';
        if (val === 2 && (i === 1 || i === 9)) pip.style.display = 'block';
        if (val === 3 && (i === 1 || i === 5 || i === 9)) {
          if (i === 5) pip.className = 'pip center-red';
          pip.style.display = 'block';
        }
        if (val === 4 && (i === 1 || i === 3 || i === 7 || i === 9)) pip.style.display = 'block';
        if (val === 5 && (i === 1 || i === 3 || i === 5 || i === 7 || i === 9)) {
          if (i === 5) pip.className = 'pip center-red';
          pip.style.display = 'block';
        }
        if (val === 6 && (i === 1 || i === 3 || i === 4 || i === 6 || i === 7 || i === 9)) pip.style.display = 'block';
        dice.appendChild(pip);
      }
    }

    function resetCoverPosition() {
      let plate = document.getElementById('center-plate');
      let rect = plate.getBoundingClientRect();
      coverX = rect.left + (rect.width - 210) / 2;
      coverY = rect.top + (rect.height - 210) / 2;
      plateCover.style.left = coverX + 'px';
      plateCover.style.top = coverY + 'px';
      plateCover.style.transform = 'translate(0px, 0px)';
    }

    function setupCoverDrag(resultSide, total) {
      isDraggingCover = false;
      plateCover.onpointerdown = (e) => {
        isDraggingCover = true;
        coverStartX = e.clientX;
        coverStartY = e.clientY;
        plateCover.setPointerCapture(e.pointerId);
      };
      plateCover.onpointermove = (e) => {
        if (!isDraggingCover) return;
        let dx = e.clientX - coverStartX;
        let dy = e.clientY - coverStartY;
        plateCover.style.transform = `translate(${dx}px, ${dy}px)`;
        if (Math.hypot(dx, dy) > 95) {
          plateCover.onpointerdown = null;
          plateCover.onpointermove = null;
          finishRound(resultSide, total);
        }
      };
      plateCover.onpointerup = () => { isDraggingCover = false; };
    }

    function finishRound(resultSide, total) {
      plateCover.style.display = 'none';
      dimOverlay.classList.remove('active');

      document.getElementById('title-' + resultSide).classList.add('highlight-pulse');

      let userWinMoney = 0;
      if (confirmedBets[resultSide] > 0) {
        userWinMoney = confirmedBets[resultSide] * 2;
        balance += userWinMoney;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        let winOverlay = document.getElementById('win-overlay');
        winOverlay.innerText = '+' + userWinMoney.toLocaleString();
        winOverlay.style.display = 'block';
      }

      historyResults.push({ side: resultSide, total: total });
      renderChartGrids();

      setTimeout(() => {
        startCountdown();
      }, 4500);
    }

    function renderChartGrids() {
      renderGridToContainer('grid-cau-top');
      renderGridToContainer('grid-cau-bottom');
    }

    function renderGridToContainer(containerId) {
      let container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = '';

      let maxCols = 55;
      let totalRows = 7;
      let gridData = Array(totalRows).fill().map(() => Array(maxCols).fill(null));

      let currentCol = 0;
      let currentRow = 0;
      let lastSide = null;
      let streakCount = 0;

      historyResults.forEach((item) => {
        if (lastSide === null) {
          currentCol = 0;
          currentRow = 0;
          streakCount = 1;
        } else if (item.side === lastSide) {
          streakCount++;
          if (streakCount > totalRows) {
            currentCol++;
            currentRow = 0;
            streakCount = 1;
          } else {
            currentRow++;
            if (currentRow >= totalRows) {
              currentRow = totalRows - 1;
              currentCol++;
            }
          }
        } else {
          currentCol++;
          currentRow = 0;
          streakCount = 1;
        }

        if (currentCol < maxCols) {
          while (gridData[currentRow][currentCol] !== null && currentCol < maxCols) {
            currentCol++;
          }
          if (currentCol < maxCols) {
            gridData[currentRow][currentCol] = item;
          }
        }
        lastSide = item.side;
      });

      for (let c = 0; c < maxCols; c++) {
        for (let r = 0; r < totalRows; r++) {
          let cell = document.createElement('div');
          cell.className = 'grid-cell';
          let data = gridData[r][c];
          if (data) {
            let dot = document.createElement('div');
            dot.className = 'dot-result ' + (data.side === 'TAI' ? 'tai' : 'xiu');
            dot.innerText = data.total;
            cell.appendChild(dot);
          }
          container.appendChild(cell);
        }
      }
    }
  </script>
</body>
