<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Tài Xỉu 3D Việt Nam Premium</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Three.js & OrbitControls & TWEEN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

    <style>
        * {
            box-sizing: border-box;
            touch-action: manipulation;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            color: #ffffff;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            height: 100vh;
            width: 100vw;
        }

        /* Layout 3 cột dựa theo phác thảo sketch */
        .sketch-layout {
            display: grid;
            grid-template-columns: minmax(180px, 280px) 1fr minmax(180px, 280px);
            align-items: center;
            height: calc(100vh - 150px);
            width: 100vw;
            max-width: 1400px;
            margin: 0 auto;
            padding: 10px 15px;
        }

        @media (max-width: 768px) {
            .sketch-layout {
                grid-template-columns: 1fr 1fr;
                grid-template-rows: 1fr auto;
                height: calc(100vh - 190px);
                padding: 5px;
            }
            .canvas-container {
                grid-column: 1 / -1;
                grid-row: 1;
            }
            .tai-btn-container {
                grid-column: 1;
                grid-row: 2;
            }
            .xiu-btn-container {
                grid-column: 2;
                grid-row: 2;
            }
        }

        /* Glassmorphism không che vướng tầm nhìn đĩa */
        .glass-panel {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        }

        .bet-card {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            background: rgba(15, 23, 42, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.1);
        }

        .bet-card:hover {
            transform: translateY(-2px);
        }

        .bet-card.selected-side {
            border-color: #f59e0b !important;
            box-shadow: 0 0 25px rgba(245, 158, 11, 0.4);
            background: rgba(245, 158, 11, 0.08);
        }

        /* Scrollbar cho chip selector */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        @keyframes pulse-red {
            0%, 100% { transform: scale(1); color: #ef4444; }
            50% { transform: scale(1.08); color: #f87171; }
        }

        .timer-warning {
            animation: pulse-red 0.8s infinite;
        }

        /* Toast animation */
        @keyframes toastIn {
            from { opacity: 0; transform: translate(-50%, -20px); }
            to { opacity: 1; transform: translate(-50%, 0); }
        }
        .toast-animate {
            animation: toastIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Con trỏ nặn nắp */
        .nan-hand-cursor {
            cursor: grab;
        }
        .nan-hand-cursor:active {
            cursor: grabbing;
        }

        /* Glowing text effect */
        .glow-gold {
            text-shadow: 0 0 12px rgba(245, 158, 11, 0.6);
        }
        .glow-red {
            text-shadow: 0 0 15px rgba(239, 68, 68, 0.7);
        }
        .glow-blue {
            text-shadow: 0 0 15px rgba(59, 130, 246, 0.7);
        }
    </style>
</head>
<body class="flex flex-col justify-between h-screen w-screen overflow-hidden">

