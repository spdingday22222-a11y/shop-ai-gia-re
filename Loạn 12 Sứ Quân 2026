<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Loạn 12 Sứ Quân - Full Upgrade Edition</title>
    <style>
        * { box-sizing: border-box; user-select: none; -webkit-user-select: none; margin: 0; padding: 0; }
        body { background-color: #05030a; color: #fff; font-family: 'Courier New', Courier, monospace; display: flex; justify-content: center; align-items: center; min-height: 100vh; overflow: hidden; position: relative; }

        /* Canvas Vũ trụ Sinh động */
        #space-canvas { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 0; background: radial-gradient(ellipse at bottom, #101426 0%, #030408 100%); }

        .screen {
            position: relative; z-index: 10; width: 100%; max-width: 440px; height: 720px;
            background: rgba(17, 13, 10, 0.95); border: 4px solid #8b5a2b; border-radius: 12px;
            box-shadow: 0 0 35px rgba(0,0,0,0.9), 0 0 15px rgba(241, 196, 15, 0.2);
            padding: 10px; display: none; flex-direction: column; gap: 8px; overflow: hidden;
        }
        .screen.active { display: flex; }

        /* Title Bar & Ancient Logo Styling */
        .title-bar {
            background: linear-gradient(180deg, #3a1e08 0%, #1a0f0a 100%);
            border: 2px solid #d4af37; box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 3px 6px rgba(0,0,0,0.8);
            text-align: center; padding: 6px 10px; color: #f1c40f; font-weight: bold; font-size: 13px;
            display: flex; justify-content: space-between; align-items: center; border-radius: 6px;
        }
        .logo-container {
            display: flex; align-items: center; gap: 6px;
            background: rgba(0,0,0,0.5); padding: 2px 8px; border-radius: 4px; border: 1px solid #8b5a2b;
        }
        .logo-badge {
            background: #8b0000; color: #f1c40f; border: 1px solid #d4af37; font-size: 10px;
            padding: 1px 4px; border-radius: 3px; font-weight: 900; text-shadow: 1px 1px 2px #000;
        }
        .logo-text {
            background: linear-gradient(180deg, #fff275 0%, #f1c40f 50%, #e67e22 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            font-weight: 900; font-size: 13px; letter-spacing: 1px;
            filter: drop-shadow(0px 2px 2px rgba(0,0,0,0.9));
            text-transform: uppercase;
        }
        .player-name-tag { color: #00d2d3; font-size: 11px; background: rgba(0,0,0,0.8); padding: 3px 8px; border-radius: 4px; border: 1px solid #00aea4; }

        /* Select Screen */
        .char-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 5px; }
        .char-card { background: #1a0f0a; border: 2px solid #5c3a1e; border-radius: 6px; padding: 6px; text-align: center; cursor: pointer; }
        .char-card.selected { border-color: #2ecc71; box-shadow: 0 0 12px #2ecc71, inset 0 0 8px rgba(46, 204, 113, 0.4); background: #2c1e11; }
        .char-avatar-img { width: 48px; height: 48px; margin: 0 auto 5px auto; border-radius: 4px; border: 2px solid #d4af37; display: flex; justify-content: center; align-items: center; font-size: 24px; background: #000; }
        .char-desc-box { background: #110803; border: 2px solid #5c3a1e; border-radius: 6px; padding: 10px; flex: 1; color: #eccc68; font-size: 11px; line-height: 1.4; display: flex; flex-direction: column; justify-content: space-between; }

        .btn {
            background: linear-gradient(180deg, #e67e22 0%, #d35400 50%, #a04000 100%);
            border: 2px solid #f39c12; box-shadow: inset 0 1px 0 rgba(255,255,255,0.4), 0 3px 5px rgba(0,0,0,0.8);
            color: #fff; padding: 8px; font-weight: bold; font-size: 12px; border-radius: 4px; cursor: pointer; text-align: center; text-shadow: 1px 1px 2px #000;
        }
        .btn:active { transform: translateY(1px); }
        .btn-secondary { background: linear-gradient(180deg, #7f8c8d, #34495e); border: 1px solid #95a5a6; color: #fff; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 11px; }

        /* Map Screen */
        .map-container { position: relative; flex: 1; background: #1a252f; border: 2px solid #6e4727; border-radius: 6px; overflow-y: auto; overflow-x: hidden; }
        .map-grid { position: relative; width: 100%; height: 850px; background: linear-gradient(180deg, #273c75, #192a56); }
        .map-node {
            position: absolute; width: 34px; height: 34px; border-radius: 50%; background: #e74c3c; border: 2px solid #fff;
            display: flex; justify-content: center; align-items: center; font-weight: bold; font-size: 11px; cursor: pointer;
            transform: translate(-50%, -50%); box-shadow: 0 0 10px rgba(0,0,0,0.8); z-index: 2;
        }
        .map-node.active-node { background: #f1c40f; color: #000; box-shadow: 0 0 12px #f1c40f; }
        .map-node.locked { background: #7f8c8d; opacity: 0.6; cursor: not-allowed; }
        .map-node-label { position: absolute; top: 36px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 9px; background: rgba(0,0,0,0.85); padding: 2px 5px; border-radius: 3px; color: #fff; border: 1px solid #555; }

        /* Battle Screen */
        .game-frame { background: linear-gradient(180deg, #2c1a0e 0%, #150a04 100%); border: 3px solid #6e4727; border-radius: 6px; padding: 6px; display: flex; flex-direction: column; gap: 6px; }
        .board-container { background: #0d0805; border: 3px solid #b8860b; border-radius: 6px; padding: 4px; position: relative; }
        #board { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; background-color: #050302; aspect-ratio: 1; }
        .cell { background: #18100a; border-radius: 3px; display: flex; justify-content: center; align-items: center; cursor: pointer; position: relative; box-shadow: inset 0 0 4px rgba(0,0,0,0.9); }
        .cell.selected { outline: 2px solid #00ffff; outline-offset: -1px; z-index: 5; box-shadow: 0 0 8px #00ffff; }

        /* Gems Design */
        .gem { width: 100%; height: 100%; border-radius: 4px; display: flex; justify-content: center; align-items: center; position: relative; box-shadow: inset 0 2px 2px rgba(255,255,255,0.4), inset 0 -2px 4px rgba(0,0,0,0.7); transition: transform 0.15s ease-in-out; }
        .gem-sword { background: linear-gradient(135deg, #7f8c8d, #2c3e50); border: 1px solid #bdc3c7; }
        .gem-sword::after { content: '⚔️'; font-size: 16px; filter: drop-shadow(0 2px 2px #000); }
        .gem-heart { background: radial-gradient(circle, #ff6b81, #b22222); border: 1px solid #ff7675; }
        .gem-heart::after { content: '♥'; color: #fff; font-size: 20px; }
        .gem-gold { background: radial-gradient(circle, #ffeaa7, #d35400); border: 1px solid #f1c40f; }
        .gem-gold::after { content: '🪙'; font-size: 16px; }
        .gem-taichi { background: radial-gradient(circle, #74b9ff, #130f40); border: 1px solid #00d2d3; }
        .gem-taichi::after { content: '☯'; color: #ff7675; font-size: 18px; }
        .gem-shield { background: repeating-linear-gradient(0deg, #20bf6b, #20bf6b 4px, #26de81 4px, #26de81 8px); border: 1px solid #2ed573; }
        .gem-shield::after { content: '🛡️'; font-size: 15px; }

        /* Dynamic Animation Canvas Layer */
        #effect-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 100; }

        /* HUD & Avatars */
        .battle-hud { background: #110803; border: 2px solid #5c3a1e; padding: 6px; display: flex; justify-content: space-between; align-items: center; border-radius: 4px; }
        .fighter-box { display: flex; align-items: center; gap: 6px; width: 48%; }
        .fighter-box.enemy { flex-direction: row-reverse; }
        .pixel-avatar { width: 48px; height: 48px; background: #000; border: 2px solid #8b5a2b; border-radius: 4px; overflow: hidden; position: relative; flex-shrink: 0; }
        .pixel-avatar canvas { width: 100%; height: 100%; image-rendering: pixelated; }

        .frozen-overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: rgba(0, 210, 211, 0.5); border: 2px solid #00ffff; box-shadow: inset 0 0 10px #ffffff; display:none; pointer-events:none; }

        .bars-container { flex: 1; display: flex; flex-direction: column; gap: 2px; }
        .classic-bar-wrap { height: 10px; background: #000; border: 1px solid #444; position: relative; border-radius: 2px; overflow: hidden; }
        .classic-bar-fill { height: 100%; width: 100%; transition: width 0.3s; }
        .hp-red { background: linear-gradient(180deg, #ff6b6b, #ee5253); }
        .exp-purple { background: linear-gradient(180deg, #a55eea, #8854d0); }
        .level-badge { font-size: 9px; color: #f1c40f; font-weight: bold; }

        /* Modals */
        .modal-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 200; display: none; flex-direction: column; justify-content: center; align-items: center; padding: 20px; }
        .modal-overlay.active { display: flex; }
        .modal-box { background: #1a0f0a; border: 3px solid #8b5a2b; border-radius: 8px; padding: 15px; width: 100%; max-width: 320px; text-align: center; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 0 20px #000; }
    </style>
</head>
<body>

<canvas id="space-canvas"></canvas>

<!-- SCREEN 1: SELECT CHARACTER -->
<div id="screen-char" class="screen active">
    <div class="title-bar">
        <div class="logo-container">
            <span class="logo-badge">⚔️</span>
            <span class="logo-text">LOẠN 12 SỨ QUÂN</span>
        </div>
        <span class="player-name-tag" id="tag-screen-1">Tướng Quân</span>
    </div>

    <div style="display:flex; flex-direction:column; gap:4px; font-size:11px; margin-top:5px;">
        <label style="color:#f1c40f;">TÊN TƯỚNG QUÂN:</label>
        <input type="text" id="player-name-input" value="Đinh Bộ Lĩnh" oninput="updatePlayerName(this.value)" style="padding:6px; background:#000; border:1px solid #8b5a2b; color:#f1c40f; font-family:inherit; outline:none; border-radius:4px;">
    </div>

    <div class="char-grid" id="char-grid"></div>

    <div class="char-desc-box">
        <div id="char-desc-text">Hãy chọn vị tướng đồng hành để bắt đầu cuộc chiến chinh phục 12 Sứ Quân.</div>
        <button class="btn" style="margin-top: 10px;" onclick="goToMapScreen()">BẮT ĐẦU CHINH PHẠT</button>
    </div>
</div>

<!-- SCREEN 2: MAP WORLD -->
<div id="screen-map" class="screen">
    <div class="title-bar">
        <div class="logo-container">
            <span class="logo-badge">🗺️</span>
            <span class="logo-text">CHIẾN TRƯỜNG</span>
        </div>
        <span class="player-name-tag" id="tag-screen-2">Tướng Quân</span>
    </div>

    <div class="map-container" id="map-container">
        <div class="map-grid" id="map-grid">
            <svg style="position: absolute; width:100%; height:100%; pointer-events:none;" id="map-svg"></svg>
        </div>
    </div>

    <div style="display:flex; gap:8px;">
        <button class="btn-secondary" style="flex:1" onclick="switchScreen('screen-char')">Trở Về</button>
        <button class="btn" style="flex:2" onclick="openModal('modal-settings')">Cài Đặt</button>
    </div>
</div>

<!-- SCREEN 3: BATTLE SCREEN -->
<div id="screen-battle" class="screen">
    <div class="title-bar">
        <span id="battle-location-name" class="logo-text">CHIẾN TRƯỜNG</span>
        <span class="player-name-tag" id="tag-screen-3">Tướng Quân</span>
    </div>

    <div class="game-frame">
        <div class="board-container">
            <canvas id="effect-canvas"></canvas>
            <div id="board"></div>
        </div>

        <div class="battle-hud">
            <!-- Player -->
            <div class="fighter-box">
                <div class="pixel-avatar">
                    <canvas id="canvas-player" width="48" height="48"></canvas>
                    <div id="player-frozen" class="frozen-overlay"></div>
                </div>
                <div class="bars-container">
                    <div style="display:flex; justify-content:space-between;" class="level-badge">
                        <span id="player-name-hud">Tướng Quân</span>
                        <span id="player-lvl-display">Lv.1</span>
                    </div>
                    <div class="classic-bar-wrap">
                        <div id="player-hp-bar" class="classic-bar-fill hp-red"></div>
                    </div>
                    <div class="classic-bar-wrap" title="Tinh Tuý Kinh Nghiệm">
                        <div id="player-exp-bar" class="classic-bar-fill exp-purple"></div>
                    </div>
                </div>
            </div>

            <!-- Enemy -->
            <div class="fighter-box enemy">
                <div class="pixel-avatar">
                    <canvas id="canvas-enemy" width="48" height="48"></canvas>
                    <div id="enemy-frozen" class="frozen-overlay"></div>
                </div>
                <div class="bars-container">
                    <div style="display:flex; justify-content:space-between;" class="level-badge">
                        <span id="enemy-lvl-display">Lv.1</span>
                        <span id="enemy-name-hud">Địch</span>
                    </div>
                    <div class="classic-bar-wrap">
                        <div id="enemy-hp-bar" class="classic-bar-fill hp-red"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; background:#110803; padding:6px 10px; border:1px solid #5c3a1e; font-size:11px; color:#eccc68; border-radius:4px;">
        <span id="turn-display">Lượt: Người Chơi</span>
        <span id="combo-display" style="color: #2ed573; font-weight:bold;"></span>
        <span onclick="openModal('modal-quit')" style="cursor:pointer; text-decoration:underline; font-weight:bold; color:#ff7675;">THOÁT TRẬN</span>
    </div>
</div>

<!-- MODALS -->
<div id="modal-result" class="modal-overlay">
    <div class="modal-box">
        <div style="color:#f39c12; font-size:16px; font-weight:bold;" id="result-title">KẾT QUẢ</div>
        <div id="result-desc" style="color:#dcdde1; font-size:12px;">Bạn đã thua cuộc!</div>
        <div id="exp-gained-text" style="color:#a55eea; font-size:11px; font-weight:bold;"></div>
        <div style="display:flex; gap:8px; justify-content:center;">
            <button class="btn" onclick="retryBattle()">Chơi Lại</button>
            <button class="btn-secondary" onclick="quitBattleToMap()">Bản Đồ</button>
        </div>
    </div>
</div>

<div id="modal-quit" class="modal-overlay">
    <div class="modal-box">
        <div style="color:#f39c12; font-size:14px; font-weight:bold;">THOÁT TRẬN ĐẤU?</div>
        <div style="display:flex; gap:8px; justify-content:center;">
            <button class="btn" onclick="quitBattleToMap()">Xác Nhận</button>
            <button class="btn-secondary" onclick="closeModal('modal-quit')">Hủy</button>
        </div>
    </div>
</div>

<div id="modal-settings" class="modal-overlay">
    <div class="modal-box">
        <div style="color:#f39c12; font-size:14px; font-weight:bold;">CÀI ĐẶT HỆ THỐNG</div>
        <div style="text-align:left; font-size:11px; display:flex; flex-direction:column; gap:8px;">
            <label><input type="checkbox" id="chk-shadow" checked> Hiệu ứng Phi Kiếm Đổ Bóng</label>
            <label><input type="checkbox" id="chk-freeze" checked> Băng Huyền Kịch Đóng Băng</label>
            <label><input type="checkbox" id="chk-skeleton" checked> Biến Thần Người Xương Múa Kiếm</label>
        </div>
        <button class="btn" onclick="closeModal('modal-settings')">Đóng</button>
    </div>
</div>

<script>
/* 1. VŨ TRỤ SINH ĐỘNG NỀN HẠT KHÔNG GIAN */
const spaceCanvas = document.getElementById('space-canvas');
const spaceCtx = spaceCanvas.getContext('2d');
let stars = [];

function initSpaceBg() {
    spaceCanvas.width = window.innerWidth;
    spaceCanvas.height = window.innerHeight;
    stars = [];
    for(let i=0; i<120; i++) {
        stars.push({
            x: Math.random() * spaceCanvas.width,
            y: Math.random() * spaceCanvas.height,
            size: Math.random() * 2 + 0.5,
            color: ['#00d2d3', '#ff7675', '#f1c40f', '#ffffff', '#a55eea'][Math.floor(Math.random()*5)],
            speed: Math.random() * 0.5 + 0.1
        });
    }
}

function drawSpaceBg() {
    spaceCtx.clearRect(0, 0, spaceCanvas.width, spaceCanvas.height);
    stars.forEach(s => {
        spaceCtx.fillStyle = s.color;
        spaceCtx.beginPath();
        spaceCtx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        spaceCtx.fill();
        s.y += s.speed;
        if (s.y > spaceCanvas.height) s.y = 0;
    });
    requestAnimationFrame(drawSpaceBg);
}
window.addEventListener('resize', initSpaceBg);
initSpaceBg(); drawSpaceBg();

/* 2. CẤU HÌNH NHÂN VẬT & 16 BẢN ĐỒ LỊCH SỬ */
const CHARACTERS = [
    { id: 1, name: 'Bắc Hải Long', hp: 120, atk: 15, desc: 'Đao pháp dũng mãnh, cân bằng giữa tấn công và phòng thủ.' },
    { id: 2, name: 'Tây Sơn Tướng', hp: 140, atk: 18, desc: 'Thân hình cường tráng, sinh lực dồi dào, sức đánh chí mạng.' },
    { id: 3, name: 'Đông Hải Tiên', hp: 100, atk: 22, desc: 'Bậc thầy thuật pháp, sát thương vô cùng lớn.' }
];

const MAP_NODES = [
    { id: 1, name: 'Hoa Lư', x: 25, y: 780, enemyName: 'Đinh Bộ Lĩnh' },
    { id: 2, name: 'Ái Châu', x: 20, y: 720, enemyName: 'Lê Hoàn' },
    { id: 3, name: 'Bình Lục', x: 50, y: 650, enemyName: 'Nguyễn Chuẩn' },
    { id: 4, name: 'Bảo Đà', x: 40, y: 590, enemyName: 'Phạm Bạch Hổ' },
    { id: 5, name: 'Ô Mạn', x: 25, y: 530, enemyName: 'Đỗ Cảnh Thạc' },
    { id: 6, name: 'Đỗ Động', x: 35, y: 470, enemyName: 'Ngô Nhật Khánh' },
    { id: 7, name: 'Tế Giang', x: 55, y: 410, enemyName: 'Lã Đường' },
    { id: 8, name: 'Siêu Loại', x: 65, y: 350, enemyName: 'Nguyễn Siêu' },
    { id: 9, name: 'Cổ Loa', x: 45, y: 290, enemyName: 'Kiều Công Hãn' },
    { id: 10, name: 'Tây Phù Liệt', x: 30, y: 230, enemyName: 'Nguyễn Kế Minh' },
    { id: 11, name: 'Tam Đái', x: 20, y: 170, enemyName: 'Trần Lãm' },
    { id: 12, name: 'Chùa Non Nước', x: 50, y: 110, enemyName: 'Sư Không Lộ' },
    { id: 13, name: 'Tiên Du', x: 80, y: 130, enemyName: 'Lý Khuê' },
    { id: 14, name: 'Đường', x: 85, y: 230, enemyName: 'Ngoại Phụ' },
    { id: 15, name: 'Đằng', x: 82, y: 350, enemyName: 'Phạm Phòng Ngạc' },
    { id: 16, name: 'Kỳ Bố', x: 80, y: 500, enemyName: 'Trần Minh Công' }
];

let selectedChar = CHARACTERS[0];
let playerName = "Đinh Bộ Lĩnh";
let playerLevel = 1;
let playerExp = 0;
let maxLevel = 200;
let unlockedLevel = 0;
let currentLevel = 0;

/* 3. CANVAS HOẠT HỌA NHÂN VẬT */
let isSkeletonForm = false;
let animFrame = 0;

function drawPixelCharacter(canvasId, isEnemy, isSkeleton = false) {
    const canvas = document.getElementById(canvasId);
    if(!canvas) return;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, 48, 48);
    
    let bounce = Math.sin(animFrame * 0.15) * 2;

    if (isSkeleton) {
        ctx.fillStyle = '#f5f6fa';
        ctx.fillRect(18, 8 + bounce, 12, 10);
        ctx.fillStyle = '#000';
        ctx.fillRect(20, 11 + bounce, 3, 3); ctx.fillRect(25, 11 + bounce, 3, 3);
        ctx.fillStyle = '#dcdde1';
        ctx.fillRect(23, 18 + bounce, 2, 14);
        ctx.fillRect(19, 20 + bounce, 10, 2); ctx.fillRect(20, 24 + bounce, 8, 2);
        let swordAngle = Math.cos(animFrame * 0.2) * 8;
        ctx.fillStyle = '#bdc3c7';
        ctx.fillRect(12, 22 + bounce + swordAngle, 6, 2);
        ctx.fillStyle = '#00d2d3';
        ctx.fillRect(6, 12 + bounce + swordAngle, 6, 18);
        ctx.fillStyle = '#f5f6fa';
        ctx.fillRect(19, 32, 3, 10); ctx.fillRect(26, 32, 3, 10);
    } else {
        let mainColor = isEnemy ? '#e74c3c' : '#2ecc71';
        let skinColor = '#ffdd99';

        ctx.fillStyle = isEnemy ? '#f1c40f' : '#2e86de';
        ctx.fillRect(14, 6 + bounce, 20, 8);
        ctx.fillStyle = skinColor;
        ctx.fillRect(16, 14 + bounce, 16, 12);
        ctx.fillStyle = '#000';
        ctx.fillRect(18, 17 + bounce, 3, 3); ctx.fillRect(27, 17 + bounce, 3, 3);
        ctx.fillStyle = mainColor;
        ctx.fillRect(14, 26 + bounce, 20, 12);
        ctx.fillStyle = '#f1c40f';
        ctx.fillRect(isEnemy ? 8 : 34, 20 + bounce, 4, 16);
    }
}

function startAvatarAnimation() {
    setInterval(() => {
        animFrame++;
        drawPixelCharacter('canvas-player', false, isSkeletonForm);
        drawPixelCharacter('canvas-enemy', true, false);
    }, 100);
}
startAvatarAnimation();

/* UI UPDATES */
function updatePlayerName(val) {
    playerName = val || "Tướng Quân";
    document.getElementById('tag-screen-1').innerText = playerName;
    document.getElementById('tag-screen-2').innerText = playerName;
    document.getElementById('tag-screen-3').innerText = playerName;
    document.getElementById('player-name-hud').innerText = playerName;
}

function switchScreen(screenId) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(screenId).classList.add('active');
}

function openModal(id) { document.getElementById(id).classList.add('active'); }
function closeModal(id) { document.getElementById(id).classList.remove('active'); }

function renderCharSelect() {
    const grid = document.getElementById('char-grid');
    grid.innerHTML = '';
    CHARACTERS.forEach((c) => {
        const card = document.createElement('div');
        card.className = `char-card ${selectedChar.id === c.id ? 'selected' : ''}`;
        card.onclick = () => { 
            selectedChar = c; 
            document.getElementById('char-desc-text').innerText = c.desc;
            renderCharSelect(); 
        };
        card.innerHTML = `<div class="char-avatar-img">⚔️</div><div style="font-size:10px; color:#f1c40f; font-weight:bold;">${c.name}</div>`;
        grid.appendChild(card);
    });
}
renderCharSelect();

function goToMapScreen() {
    switchScreen('screen-map');
    renderMap();
}

function renderMap() {
    const container = document.getElementById('map-grid');
    const svg = document.getElementById('map-svg');
    container.querySelectorAll('.map-node').forEach(n => n.remove());
    svg.innerHTML = '';

    MAP_NODES.forEach((node, idx) => {
        const el = document.createElement('div');
        let isUnlocked = idx <= unlockedLevel;
        el.className = `map-node ${idx === unlockedLevel ? 'active-node' : (isUnlocked ? '' : 'locked')}`;
        el.style.left = `${node.x}%`;
        el.style.top = `${node.y}px`;
        el.innerText = idx + 1;

        const label = document.createElement('div');
        label.className = 'map-node-label';
        label.innerText = node.name;
        el.appendChild(label);

        el.onclick = () => { if (isUnlocked) startBattle(idx); };
        container.appendChild(el);
    });
}

/* 4. LOGIC BÀN CỜ VÀ MATCH-3 ĐÃ SỬA LỖI ĐỔI ĐỒ */
const BOARD_SIZE = 7;
const GEM_TYPES = [
    { type: 'sword', class: 'gem-sword' },
    { type: 'heart', class: 'gem-heart' },
    { type: 'gold', class: 'gem-gold' },
    { type: 'taichi', class: 'gem-taichi' },
    { type: 'shield', class: 'gem-shield' }
];

let board = [];
let selectedCell = null;
let isAnimating = false;
let isPlayerTurn = true;

let player = { hp: 100, maxHp: 100, atk: 15, lvl: 1 };
let enemy = { hp: 100, maxHp: 100, atk: 12, lvl: 1, name: '' };

const delay = ms => new Promise(res => setTimeout(res, ms));

function startBattle(nodeIndex) {
    currentLevel = nodeIndex;
    const node = MAP_NODES[nodeIndex];

    let randomLvlOffset = Math.floor(Math.random() * 5) - 2;
    enemy.lvl = Math.max(1, Math.min(maxLevel, playerLevel + randomLvlOffset));
    
    player.maxHp = selectedChar.hp + (playerLevel * 15);
    player.hp = player.maxHp;
    player.atk = selectedChar.atk + (playerLevel * 3);

    enemy.name = node.enemyName;
    enemy.maxHp = 100 + (enemy.lvl * 14);
    enemy.hp = enemy.maxHp;
    enemy.atk = 10 + (enemy.lvl * 3);

    document.getElementById('battle-location-name').innerText = node.name.toUpperCase();
    document.getElementById('player-lvl-display').innerText = `Lv.${playerLevel}`;
    document.getElementById('enemy-lvl-display').innerText = `Lv.${enemy.lvl}`;
    document.getElementById('enemy-name-hud').innerText = enemy.name;

    switchScreen('screen-battle');
    isPlayerTurn = true;
    document.getElementById('turn-display').innerText = "Lượt: Người Chơi";
    initBoard();
    updateUI();
}

function initBoard() {
    const boardEl = document.getElementById('board');
    boardEl.innerHTML = '';
    board = [];

    for (let r = 0; r < BOARD_SIZE; r++) {
        board[r] = [];
        for (let c = 0; c < BOARD_SIZE; c++) {
            let gem;
            do {
                gem = GEM_TYPES[Math.floor(Math.random() * GEM_TYPES.length)];
            } while (
                (r >= 2 && board[r-1][c]?.type === gem.type && board[r-2][c]?.type === gem.type) ||
                (c >= 2 && board[r][c-1]?.type === gem.type && board[r][c-2]?.type === gem.type)
            );

            board[r][c] = { ...gem };
            const cell = document.createElement('div');
            cell.className = 'cell';
            cell.dataset.row = r;
            cell.dataset.col = c;
            cell.addEventListener('click', () => handleCellClick(r, c));
            boardEl.appendChild(cell);
        }
    }
    renderBoard();
}

function renderBoard() {
    const cells = document.querySelectorAll('.cell');
    cells.forEach(cell => {
        const r = parseInt(cell.dataset.row);
        const c = parseInt(cell.dataset.col);
        const gem = board[r][c];
        cell.innerHTML = '';
        if (gem) {
            const gemEl = document.createElement('div');
            gemEl.className = `gem ${gem.class}`;
            cell.appendChild(gemEl);
        }
    });
}

function handleCellClick(r, c) {
    if (isAnimating || !isPlayerTurn) return;

    if (!selectedCell) {
        selectedCell = { r, c };
        highlightCell(r, c, true);
    } else {
        const prevR = selectedCell.r;
        const prevC = selectedCell.c;
        highlightCell(prevR, prevC, false);

        if (Math.abs(prevR - r) + Math.abs(prevC - c) === 1) {
            swapAndProcess(prevR, prevC, r, c);
            selectedCell = null;
        } else {
            selectedCell = { r, c };
            highlightCell(r, c, true);
        }
    }
}

function highlightCell(r, c, flag) {
    const cells = document.querySelectorAll('.cell');
    const index = r * BOARD_SIZE + c;
    if(cells[index]) {
        if (flag) cells[index].classList.add('selected');
        else cells[index].classList.remove('selected');
    }
}

async function swapAndProcess(r1, c1, r2, c2) {
    isAnimating = true;
    swapGems(r1, c1, r2, c2);
    renderBoard();

    let matches = checkMatches();
    if (matches.length === 0) {
        await delay(200);
        swapGems(r1, c1, r2, c2);
        renderBoard();
        isAnimating = false;
        return;
    }

    await processMatches(true);

    if (enemy.hp > 0 && player.hp > 0) {
        isPlayerTurn = false;
        document.getElementById('turn-display').innerText = "Lượt: Kẻ Địch";
        await delay(500);
        await enemyAI();
    }
}

function swapGems(r1, c1, r2, c2) {
    const temp = board[r1][c1];
    board[r1][c1] = board[r2][c2];
    board[r2][c2] = temp;
}

function checkMatches() {
    let matchedSet = new Set();
    
    // Check hàng ngang
    for (let r = 0; r < BOARD_SIZE; r++) {
        for (let c = 0; c < BOARD_SIZE - 2; c++) {
            let type = board[r][c]?.type;
            if (type && type === board[r][c+1]?.type && type === board[r][c+2]?.type) {
                matchedSet.add(`${r},${c}`);
                matchedSet.add(`${r},${c+1}`);
                matchedSet.add(`${r},${c+2}`);
            }
        }
    }

    // Check hàng dọc
    for (let c = 0; c < BOARD_SIZE; c++) {
        for (let r = 0; r < BOARD_SIZE - 2; r++) {
            let type = board[r][c]?.type;
            if (type && type === board[r+1][c]?.type && type === board[r+2][c]?.type) {
                matchedSet.add(`${r},${c}`);
                matchedSet.add(`${r+1},${c}`);
                matchedSet.add(`${r+2},${c}`);
            }
        }
    }

    return Array.from(matchedSet).map(pos => {
        const [r, c] = pos.split(',').map(Number);
        return { r, c, gem: board[r][c] };
    });
}

async function processMatches(isPlayer) {
    let matches = checkMatches();
    while (matches.length > 0) {
        let swordCount = 0;

        matches.forEach(({ gem }) => {
            if (!gem) return;
            if (gem.type === 'sword') swordCount++;
            if (gem.type === 'heart') {
                if (isPlayer) player.hp = Math.min(player.maxHp, player.hp + 15);
                else enemy.hp = Math.min(enemy.maxHp, enemy.hp + 12);
            }
        });

        if (swordCount > 0) {
            let dmg = swordCount * (isPlayer ? player.atk : enemy.atk);
            if (isPlayer) enemy.hp = Math.max(0, enemy.hp - dmg);
            else player.hp = Math.max(0, player.hp - dmg);
        }

        matches.forEach(({ r, c }) => { board[r][c] = null; });
        renderBoard();
        updateUI();
        await delay(200);

        dropGems();
        renderBoard();
        await delay(200);

        if (enemy.hp <= 0 || player.hp <= 0) break;
        matches = checkMatches();
    }
    isAnimating = false;
}

function dropGems() {
    for (let c = 0; c < BOARD_SIZE; c++) {
        for (let r = BOARD_SIZE - 1; r >= 0; r--) {
            if (board[r][c] === null) {
                for (let lookup = r - 1; lookup >= 0; lookup--) {
                    if (board[lookup][c] !== null) {
                        board[r][c] = board[lookup][c];
                        board[lookup][c] = null;
                        break;
                    }
                }
            }
            if (board[r][c] === null) {
                board[r][c] = { ...GEM_TYPES[Math.floor(Math.random() * GEM_TYPES.length)] };
            }
        }
    }
}

async function enemyAI() {
    let possibleSwaps = [];
    for(let r=0; r<BOARD_SIZE; r++) {
        for(let c=0; c<BOARD_SIZE; c++) {
            if(c < BOARD_SIZE-1) possibleSwaps.push({r1:r, c1:c, r2:r, c2:c+1});
            if(r < BOARD_SIZE-1) possibleSwaps.push({r1:r, c1:c, r2:r+1, c2:c});
        }
    }

    let foundMatch = false;
    for(let swap of possibleSwaps) {
        swapGems(swap.r1, swap.c1, swap.r2, swap.c2);
        let matches = checkMatches();
        if(matches.length > 0) {
            renderBoard();
            await delay(300);
            await processMatches(false);
            foundMatch = true;
            break;
        } else {
            swapGems(swap.r1, swap.c1, swap.r2, swap.c2);
        }
    }

    if (!foundMatch) {
        document.getElementById('combo-display').innerText = "Địch không đổi được!";
        await delay(400);
        document.getElementById('combo-display').innerText = "";
    }

    if (player.hp > 0 && enemy.hp > 0) {
        isPlayerTurn = true;
        document.getElementById('turn-display').innerText = "Lượt: Người Chơi";
    }
}

function updateUI() {
    document.getElementById('player-hp-bar').style.width = `${Math.max(0, (player.hp / player.maxHp) * 100)}%`;
    document.getElementById('enemy-hp-bar').style.width = `${Math.max(0, (enemy.hp / enemy.maxHp) * 100)}%`;

    if (enemy.hp <= 0) {
        showResult(true);
    } else if (player.hp <= 0) {
        showResult(false);
    }
}

function showResult(isWin) {
    const modal = document.getElementById('modal-result');
    const title = document.getElementById('result-title');
    const desc = document.getElementById('result-desc');
    const expText = document.getElementById('exp-gained-text');

    if (isWin) {
        title.innerText = "CHIẾN THẮNG!";
        title.style.color = "#2ecc71";
        desc.innerText = `Bạn đã đánh bại ${enemy.name}!`;
        let expGained = 50 + currentLevel * 10;
        expText.innerText = `+${expGained} EXP`;
        if (currentLevel === unlockedLevel && unlockedLevel < MAP_NODES.length - 1) {
            unlockedLevel++;
        }
    } else {
        title.innerText = "THẤT BẠI!";
        title.style.color = "#e74c3c";
        desc.innerText = "Bạn đã hy sinh trên chiến trường!";
        expText.innerText = "+0 EXP";
    }
    openModal('modal-result');
}

function retryBattle() {
    closeModal('modal-result');
    startBattle(currentLevel);
}

function quitBattleToMap() {
    closeModal('modal-result');
    closeModal('modal-quit');
    switchScreen('screen-map');
    renderMap();
}
