    .dim-overlay.active { opacity: 1; }

    /* BÀN TÀI XỈU MÀU ĐEN ĐẬM SẮC NẾT & KÉO THẢ TỰ DO */
    .real-taixiu-board {
      position: absolute; width: 760px; height: 370px;
      border-radius: 185px; display: flex; justify-content: space-between; align-items: center;
      padding: 20px 42px;
      background: radial-gradient(circle at center, #15151f 0%, #0a0a0f 65%, #020203 100%);
      border: 4px solid #f5a623;
      box-shadow: 0 0 65px rgba(245, 166, 35, 0.4), inset 0 0 35px rgba(0, 0, 0, 0.95), inset 0 0 12px rgba(255, 234, 0, 0.35);
      cursor: move;
      touch-action: none;
      z-index: 12;
      transition: transform 0.05s ease-out;
    }

    .board-logo {
      position: absolute; top: 16px; left: 50%; transform: translateX(-50%);
      font-size: 16px; font-weight: 900; letter-spacing: 2px;
      background: linear-gradient(180deg, #ffffff 0%, #ffb703 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 8px rgba(255, 183, 3, 0.7));
      z-index: 5; pointer-events: none;
    }

    /* NÚT TRÒN VIỀN BÀN CƯỢC */
    .circle-btn {
      position: absolute; width: 36px; height: 36px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 14px; font-weight: bold; cursor: pointer;
      background: linear-gradient(180deg, #2a2a38, #12121a);
      border: 1.5px solid #ffea00; z-index: 25; box-shadow: 0 4px 8px #000, 0 0 8px rgba(255,234,0,0.3);
      transition: transform 0.15s;
    }
    .circle-btn:active { transform: scale(0.9); }

    .btn-info { top: 22px; left: 145px; }
    .btn-chart { top: 88px; left: 60px; background: linear-gradient(180deg, #0077b6, #023e8a); }
    .btn-help { top: 158px; left: 25px; }
    .btn-history { top: 228px; left: 60px; }

    .btn-close { top: 22px; right: 145px; background: linear-gradient(180deg, #9e1a22, #500000); }
    .btn-rank { top: 88px; right: 60px; }
    .btn-chat-toggle { top: 158px; right: 25px; }

    .btn-nan-hand {
      position: absolute; right: 105px; bottom: 25px; width: 46px; height: 46px;
      border-radius: 50%; background: radial-gradient(circle, #ff9d00, #804000);
      border: 2px solid #fff3a1; box-shadow: 0 0 12px #ff9d00, 0 4px 8px #000;
      display: flex; justify-content: center; align-items: center; font-size: 22px;
      cursor: pointer; z-index: 26; transition: transform 0.2s, background 0.3s;
    }
    .btn-nan-hand.active { background: radial-gradient(circle, #00ffcc, #005544); border-color: #00ffff; box-shadow: 0 0 15px #00ffff; }

    /* CỬA CƯỢC TÀI / XỈU */
    .bet-side {
      width: 210px; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 10;
    }

    .player-count {
      font-size: 13px; color: #ffea00; font-weight: bold; margin-bottom: 2px; text-shadow: 0 0 5px #ffea00;
      display: flex; align-items: center; gap: 4px; transition: transform 0.15s ease;
    }
    .player-count.bounce { transform: scale(1.18); }

    .bet-title {
      font-size: 58px; font-weight: 900; color: #ffffff;
      text-shadow: 0 4px 12px rgba(0,0,0,0.9), 0 0 18px rgba(255,255,255,0.3);
      letter-spacing: 3px; transition: all 0.3s ease;
    }
    .bet-title.highlight-pulse {
      color: #ffea00; text-shadow: 0 0 25px #ffea00, 0 0 50px #ffea00;
      animation: pulseGlow 0.6s infinite alternate;
    }
    @keyframes pulseGlow {
      from { transform: scale(1); }
      to { transform: scale(1.12); }
    }

    .bet-amount {
      font-size: 19px; font-weight: 900; color: #00ffcc;
      text-shadow: 0 0 8px rgba(0, 255, 204, 0.7), 0 2px 4px #000; margin-bottom: 8px;
      transition: transform 0.15s ease;
    }
    .bet-amount.bounce { transform: scale(1.12); color: #00ffff; }

    .btn-cuoc-oval {
      width: 150px; height: 42px;
      background: radial-gradient(circle, #252533 0%, #101018 100%);
      border: 2px solid #ffb703; border-radius: 21px;
      display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: inset 0 0 8px rgba(0,0,0,0.9), 0 4px 10px rgba(0,0,0,0.8);
      transition: transform 0.1s, border-color 0.2s;
    }
    .btn-cuoc-oval:active { transform: scale(0.95); }

    .bet-text-val { font-size: 16px; font-weight: 900; color: #8888a0; text-shadow: 0 1px 2px #000; }
    .bet-text-val.label-cuoc {
      color: #ff9d00;
      background: linear-gradient(180deg, #fff3a1 0%, #ff9d00 60%, #b35900 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 3px rgba(0, 0, 0, 0.9));
      font-size: 18px; letter-spacing: 1px;
    }
    .bet-text-val.active-bet { color: #ffea00; text-shadow: 0 0 8px rgba(255, 234, 0, 0.9); }

    /* BÁT / ĐĨA TRUNG TÂM */
    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 220px; height: 220px; border-radius: 50%;
      background: radial-gradient(circle, #0a0a0f 0%, #151522 70%, #000000 100%);
      border: 4px solid #ffb703; display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 45px rgba(0,0,0,0.95), inset 0 0 25px rgba(255,183,3,0.35); z-index: 15;
    }

    .plate-cover {
      position: absolute; width: 214px; height: 214px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #4a4a5e 0%, #181824 60%, #040406 100%);
      border: 3px solid #ffea00; box-shadow: 0 10px 30px rgba(0,0,0,0.95), inset 0 2px 10px rgba(255,255,255,0.4);
      z-index: 20; display: none; cursor: grab; justify-content: center; align-items: center;
      touch-action: none; transition: filter 0.2s ease;
    }
    .plate-cover:active { cursor: grabbing; filter: drop-shadow(0px 0px 18px rgba(255, 234, 0, 0.9)); }
    .plate-cover-knob { width: 50px; height: 50px; border-radius: 50%; background: radial-gradient(circle, #ffd700, #b8860b); border: 2px solid #fff; box-shadow: 0 4px 8px #000; }

    .timer-display { font-size: 68px; font-weight: 900; color: #ffea00; text-shadow: 0 0 20px rgba(255, 234, 0, 0.9); z-index: 6; }

    /* KHUNG 3 VIÊN XÚC SẮC 3D THỰC TẾ (ĐỨNG THẲNG KHỐI HỘP - KHÔNG NGHIÊNG LECH) */
    .dice-triangle-container {
      position: absolute; width: 140px; height: 130px; display: none; z-index: 18;
    }

    /* THIẾT LẬP KHỐI HỘP 3D DẠNG DỰNG THẲNG VUÔNG VẮN */
    .dice-real-box {
      position: absolute; width: 44px; height: 44px;
      background: linear-gradient(135deg, #ff2a2a 0%, #b30000 70%, #660000 100%);
      border: 2px solid #ffffff; border-radius: 8px;
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.9), inset 0 1px 3px rgba(255, 255, 255, 0.8), inset 0 -3px 6px rgba(0, 0, 0, 0.6);
      display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 3px; align-items: center; justify-items: center;
    }

    /* VỊ TRÍ 3 VIÊN TAM GIÁC: 1 ĐỈNH TRÊN, 2 VIÊN DƯỚI DỰNG CÂN */
    #dice1 { top: 6px; left: 48px; }
    #dice2 { bottom: 8px; left: 16px; }
    #dice3 { bottom: 8px; right: 16px; }

    /* CHẤM XÚC SẮC CHUẨN TÂM TUYỆT ĐỐI */
    .pip {
      width: 8px; height: 8px; background: #ffffff; border-radius: 50%; display: none;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.6), 0 0 2px rgba(255,255,255,0.8);
    }
    .pip.center-red {
      background: #ff0000; border: 1.5px solid #ffffff; width: 14px; height: 14px;
      grid-column: 2; grid-row: 2; display: block;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.5), 0 0 4px #ff0000;
    }

    .p-1 { grid-column: 1; grid-row: 1; } .p-3 { grid-column: 3; grid-row: 1; }
    .p-4 { grid-column: 1; grid-row: 2; } .p-5 { grid-column: 2; grid-row: 2; } .p-6 { grid-column: 3; grid-row: 2; }
    .p-7 { grid-column: 1; grid-row: 3; } .p-9 { grid-column: 3; grid-row: 3; }

    .win-text-overlay {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-size: 38px; font-weight: 900; color: #ffea00;
      text-shadow: 0 0 20px #ffea00, 0 4px 12px #000; z-index: 25; display: none; white-space: nowrap;
      animation: popWin 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popWin {
      0% { transform: translate(-50%, -50%) scale(0.4); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    /* BANNER BAN CƯỢC TÀNG HÌNH BANNER NGOÀI & DỊCH SÁT VIỀN */
    .chip-panel-real {
      position: absolute;
      bottom: -60px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      background: transparent !important; border: none !important; box-shadow: none !important;
      padding: 8px 20px; z-index: 100;
      transition: opacity 0.3s ease, transform 0.3s ease;
      opacity: 1;
    }

    .chip-panel-real.hidden {
      opacity: 0; pointer-events: none; transform: translate(-50%, 40px);
    }

    .chip-list { display: flex; gap: 8px; }

    .chip-btn {
      width: 62px; height: 38px; border-radius: 8px;
      background: linear-gradient(180deg, #ffb300 0%, #ff8000 60%, #cc5200 100%);
      border: 1.5px solid #ffe066; color: #ffffff; font-size: 13px; font-weight: 900;
