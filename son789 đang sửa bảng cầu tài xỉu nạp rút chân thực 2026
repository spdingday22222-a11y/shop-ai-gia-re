    .btn-rank { top: 90px; right: 60px; }
    .btn-chat-toggle { top: 165px; right: 25px; }
    .btn-squeeze { top: 240px; right: 60px; font-size: 16px; }

    /* CỬA CƯỢC 3D */
    .bet-side {
