<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cổng Game Thực Tế - Tài Xỉu Online Ultimate Pro 3D</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #030206;
      color: #e0e0e0;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Screen Transition Core */
    .app-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex;
      opacity: 1;
      z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle at center, #1b0a2a 0%, #030108 100%);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 32px;
      font-weight: 900;
      background: linear-gradient(180deg, #fff2a3 0%, #d4af37 50%, #aa7c11 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 20px rgba(212, 175, 55, 0.5);
      letter-spacing: 3px;
      margin-bottom: 25px;
      text-transform: uppercase;
    }

    .loader-box {
      width: 320px;
      height: 18px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(212, 175, 55, 0.5);
      border-radius: 20px;
      padding: 2px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);
      position: relative;
    }

    .loader-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #ff0055, #ffd700);
      border-radius: 20px;
      transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffd700;
    }

    .loader-text {
      margin-top: 12px;
      font-size: 13px;
      color: #aaa;
      font-weight: bold;
    }

    /* 2. GAME LOBBY */
    .game-lobby {
      position: relative;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at center, #180d28 0%, #050308 100%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 24px;
      background: rgba(12, 8, 20, 0.95);
      border-bottom: 1px solid rgba(212, 175, 55, 0.3);
      box-shadow: 0 4px 20px rgba(0,0,0,0.8);
      z-index: 20;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }

    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid #ffd700;
      background-size: cover;
      background-position: center;
      box-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
      transition: transform 0.2s;
    }
    .avatar:active { transform: scale(0.92); }

    .balance-box {
      background: #0b0514;
      border: 1px solid #ffd700;
      border-radius: 20px;
      padding: 4px 16px;
      color: #ffd700;
      font-weight: 800;
      font-size: 15px;
      box-shadow: inset 0 0 6px rgba(212, 175, 55, 0.3);
      letter-spacing: 0.5px;
    }

    .top-nav {
      display: flex;
      gap: 20px;
      font-weight: 700;
      color: #8f82a7;
      text-transform: uppercase;
      font-size: 12px;
    }

    .top-nav span {
      cursor: pointer;
      transition: all 0.2s;
      padding: 6px 12px;
      border-radius: 12px;
    }

    .top-nav span:hover, .top-nav span.active {
      color: #fff;
      background: rgba(255, 215, 0, 0.15);
      border: 1px solid rgba(255, 215, 0, 0.3);
    }

    .header-actions {
      display: flex;
      gap: 10px;
    }

    .btn-action {
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 800;
      font-size: 12px;
      cursor: pointer;
      border: none;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      transition: transform 0.1s, filter 0.2s;
    }
    .btn-action:active { transform: scale(0.95); }
    .btn-nap { background: linear-gradient(180deg, #00e676, #00897b); color: #fff; }
    .btn-rut { background: linear-gradient(180deg, #ff5252, #c62828); color: #fff; }

    .lobby-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 40px;
      flex: 1;
      gap: 20px;
      overflow-x: auto;
    }

    .sidebar-left {
      width: 220px;
      background: rgba(14, 9, 22, 0.85);
      border: 1px solid rgba(212, 175, 55, 0.25);
      border-radius: 16px;
      padding: 14px;
      backdrop-filter: blur(8px);
    }

    .sidebar-title {
      color: #ffd700;
      font-size: 12px;
      font-weight: 800;
      text-align: center;
      margin-bottom: 12px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      padding-bottom: 6px;
    }

    .rank-item {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      margin-bottom: 10px;
      color: #bbb;
    }
    .rank-item .win-amount { color: #00e676; font-weight: 700; }

    .game-grid {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .game-card {
      width: 190px;
      height: 250px;
      border-radius: 22px;
      border: 2px solid rgba(255, 215, 0, 0.5);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 12px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.7);
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      position: relative;
      overflow: hidden;
      background-size: cover;
      background-position: center;
    }

    .game-card:hover {
      transform: translateY(-6px) scale(1.02);
      border-color: #ffd700;
      box-shadow: 0 12px 30px rgba(255, 215, 0, 0.4);
    }

    .game-card:active { transform: scale(0.96); }

    .card-hot-taixiu {
      background: linear-gradient(135deg, #800d1e 0%, #3a0007 100%);
      border-color: #ff4d6d;
    }

    .card-md5-taixiu {
      background: linear-gradient(135deg, #023e8a 0%, #001233 100%);
      border-color: #00b4d8;
    }

    .card-quayhu {
      background: linear-gradient(135deg, #6a040f 0%, #1a0003 100%);
    }

    .card-tag {
      align-self: flex-start;
      background: #ff0055;
      color: #fff;
      font-size: 9px;
      font-weight: 900;
      padding: 2px 8px;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.5);
      text-transform: uppercase;
    }

    .card-title-box { text-align: center; }
    .card-title {
      font-weight: 900;
      font-size: 15px;
      color: #fff;
      text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      letter-spacing: 0.5px;
    }
    .card-sub {
      font-size: 10px;
      color: #ffd700;
      font-weight: bold;
      margin-top: 2px;
    }

    .lobby-bet-preview {
      background: rgba(0, 0, 0, 0.65);
      border-radius: 12px;
      padding: 6px;
      border: 1px solid rgba(255, 215, 0, 0.3);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .lobby-bet-row {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      font-weight: bold;
    }
    .lobby-bet-tai { color: #ff5252; }
    .lobby-bet-xiu { color: #00e676; }
    .lobby-timer {
      font-size: 11px;
      color: #ffd700;
      text-align: center;
      font-weight: 900;
      border-top: 1px dashed rgba(255,255,255,0.2);
      padding-top: 2px;
    }

    .bottom-bar {
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: rgba(8, 5, 14, 0.95);
      padding: 10px 0;
      border-top: 1px solid rgba(255, 215, 0, 0.2);
    }

    .bottom-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 11px;
      color: #888;
      cursor: pointer;
      transition: 0.2s;
      font-weight: bold;
    }
    .bottom-item:hover { color: #ffd700; }
    .bottom-icon { font-size: 18px; margin-bottom: 2px; }

    /* 3. ARENA REALISTIC 3D & DICE ENGINE */
    .arena-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle, #0e1e2b 0%, #03080d 100%);
      z-index: 100;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      perspective: 1200px;
    }

    .arena-screen.hot-theme {
      background: radial-gradient(circle, #2b0e14 0%, #0d0305 100%);
    }

    .arena-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 24px;
      background: rgba(0, 0, 0, 0.85);
      border-bottom: 1px solid rgba(255, 215, 0, 0.3);
      z-index: 20;
    }

    .arena-title {
      font-size: 18px;
      font-weight: 900;
      color: #ffd700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .btn-back-lobby {
      background: #c62828;
      color: #fff;
      border: 1px solid #ff5252;
      padding: 6px 16px;
      border-radius: 20px;
      font-weight: bold;
      font-size: 12px;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-back-lobby:active { transform: scale(0.92); }

    .arena-stage {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .arena-stage.pan-angle {
      transform: rotateX(28deg) rotateY(-10deg) scale(0.95);
    }

    .real-taixiu-board {
      position: relative;
      width: 820px;
      height: 380px;
      background: radial-gradient(circle, #102d3f 0%, #040e14 100%);
      border: 4px solid #00b4d8;
      border-radius: 200px;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9), inset 0 0 30px rgba(0,180,216,0.4);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 45px;
      transform-style: preserve-3d;
    }

    .hot-theme .real-taixiu-board {
      background: radial-gradient(circle, #3f1019 0%, #140407 100%);
      border-color: #ff4d6d;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9), inset 0 0 30px rgba(255,77,109,0.4);
    }

    .circle-btn {
      position: absolute;
      width: 40px;
      height: 40px;
      background: radial-gradient(circle, #183845, #08151c);
      border: 1px solid #3a7893;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #83c5be;
      font-size: 15px;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      z-index: 10;
    }
    .circle-btn:active { transform: scale(0.9); }
    .circle-btn:hover { color: #fff; border-color: #00b4d8; }

    .btn-chart { top: 50px; left: 40px; }
    .btn-help { top: 125px; left: 20px; }
    .btn-history { top: 200px; left: 40px; }
    .btn-rank { top: 50px; right: 40px; }
    .btn-cam { top: 125px; right: 20px; }
    .btn-sound { top: 200px; right: 40px; }

    /* CỬA CƯỢC TÀI / XỈU - ĐÃ XOÁ LOGO/NÚT CƯỢC */
    .bet-side {
      width: 210px;
      height: 160px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      border-radius: 80px;
      background: rgba(5, 12, 18, 0.75);
      border: 2px solid rgba(255, 255, 255, 0.2);
      position: relative;
      transition: all 0.3s;
      cursor: pointer;
    }

    .bet-side:hover {
      border-color: #ffd700;
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
    }

    .bet-side.active-win {
      border: 3px solid #00e676;
      background: rgba(0, 230, 118, 0.25);
      box-shadow: 0 0 35px rgba(0, 230, 118, 0.8);
      animation: winGlow 0.6s infinite alternate;
    }

    @keyframes winGlow {
      0% { transform: scale(1); }
      100% { transform: scale(1.05); }
    }

    .bet-title {
      font-size: 40px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #fff;
      text-shadow: 0 3px 10px rgba(0,0,0,0.8);
    }

    .player-count { font-size: 11px; color: #64ffda; margin-bottom: 2px; }
    .bet-amount { font-size: 16px; font-weight: 800; color: #ffd700; }

    .my-bet-tag {
      font-size: 11px;
      color: #00e676;
      background: rgba(0,0,0,0.9);
      padding: 3px 12px;
      border-radius: 12px;
      border: 1px solid #00e676;
      margin-top: 6px;
      display: none;
      font-weight: 800;
    }

    /* HÌNH TRÒN ĐỎ VỚI MÀU ĐEN TRONG BÊN TRONG CỰC THỰC TẾ */
    .center-plate {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 250px;
      height: 250px;
      background: radial-gradient(circle, #100608 0%, #080304 60%, #9e0c1b 92%, #e6a119 100%);
      border: 6px solid #d4af37;
      border-radius: 50%;
      box-shadow: 0 0 35px rgba(255, 0, 0, 0.3), inset 0 0 25px rgba(0,0,0,0.95), 0 10px 25px rgba(0,0,0,0.9);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 5;
      transform-style: preserve-3d;
    }

    .timer-display {
      position: absolute;
      top: 10px;
      font-size: 26px;
      font-weight: 900;
      color: #ffd700;
      text-shadow: 0 0 10px rgba(255, 215, 0, 0.8), 0 2px 4px rgba(0,0,0,0.9);
      z-index: 20;
    }

    /* KHU VỰC VẬT LÝ XÚC XẮC 3D - TĂNG KÍCH THƯỚC GẤP ĐÔI & TÁCH NHAU RA 1/2 THỰC TẾ */
    .dice-3d-arena {
      position: relative;
      width: 135px;
      height: 135px;
      margin-top: 25px;
      transform-style: preserve-3d;
    }

    .cube-wrapper {
      position: absolute;
      width: 57px;
      height: 57px;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.1, 0.8, 0.2, 1);
    }

    /* Tách khoảng cách rộng ra nửa độ dài thực tế */
    #wrap1 { top: 2px; left: 2px; }
    #wrap2 { top: 2px; right: 2px; }
    #wrap3 { bottom: 2px; left: 39px; }

    /* BÓNG ĐỔ VẬT LÝ DƯỚI ĐĨA */
    .dice-shadow {
      position: absolute;
      width: 57px;
      height: 57px;
      background: radial-gradient(ellipse at center, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 75%);
      border-radius: 50%;
      transform: rotateX(90deg) translateZ(-28px);
      transition: transform 0.1s linear, opacity 0.1s linear;
      pointer-events: none;
    }

    .cube {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    /* HIỆU ỨNG LẮN ĐẢO NẨY CAO THỰC TẾ 100% GIỮ NGUYÊN VẸN */
    .cube-wrapper.rolling-1 {
      animation: physicsThrow1 1.1s cubic-bezier(0.2, 0.8, 0.25, 1.1) infinite;
    }
    .cube-wrapper.rolling-2 {
      animation: physicsThrow2 1.1s cubic-bezier(0.2, 0.8, 0.25, 1.1) infinite;
    }
    .cube-wrapper.rolling-3 {
      animation: physicsThrow3 1.1s cubic-bezier(0.2, 0.8, 0.25, 1.1) infinite;
    }

    .cube-wrapper.rolling-1 .dice-shadow,
    .cube-wrapper.rolling-2 .dice-shadow,
    .cube-wrapper.rolling-3 .dice-shadow {
      animation: shadowPulse 1.1s ease-in-out infinite;
    }

    @keyframes physicsThrow1 {
      0%   { transform: translate3d(0, 0, 0); }
      35%  { transform: translate3d(-24px, -120px, 180px); }
      65%  { transform: translate3d(20px, 15px, 25px); }
      85%  { transform: translate3d(-8px, -12px, 45px); }
      100% { transform: translate3d(0, 0, 0); }
    }

    @keyframes physicsThrow2 {
      0%   { transform: translate3d(0, 0, 0); }
      35%  { transform: translate3d(28px, -130px, 200px); }
      65%  { transform: translate3d(-15px, 18px, 30px); }
      85%  { transform: translate3d(10px, -10px, 40px); }
      100% { transform: translate3d(0, 0, 0); }
    }

    @keyframes physicsThrow3 {
      0%   { transform: translate3d(0, 0, 0); }
      35%  { transform: translate3d(-6px, -140px, 210px); }
      65%  { transform: translate3d(14px, -18px, 25px); }
      85%  { transform: translate3d(-15px, -6px, 50px); }
      100% { transform: translate3d(0, 0, 0); }
    }

    @keyframes shadowPulse {
      0%, 100% { transform: rotateX(90deg) translateZ(-28px) scale(1); opacity: 0.9; }
      35%      { transform: rotateX(90deg) translateZ(-28px) scale(3.2); opacity: 0.1; }
      65%      { transform: rotateX(90deg) translateZ(-28px) scale(1.1); opacity: 0.8; }
    }

    .cube.rolling {
      animation: rollSpin 0.16s linear infinite;
    }

    @keyframes rollSpin {
      0%   { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      100% { transform: rotateX(720deg) rotateY(1080deg) rotateZ(360deg); }
    }

    /* 3 VIÊN XÚC XẮC ĐỎ ĐẬM NHẠT CAO CẤP - DẤU CHẤM GIỮ NGUYÊN VẸN 100% */
    .face {
      position: absolute;
      width: 57px;
      height: 57px;
      background: radial-gradient(circle at 30% 30%, #e60026 0%, #aa0015 65%, #59000a 100%);
      border: 1px solid rgba(255, 180, 180, 0.4);
      border-radius: 12px;
      box-shadow: inset 0 0 6px rgba(255, 200, 200, 0.8), inset -3px -3px 6px rgba(0,0,0,0.6), 0 4px 8px rgba(0,0,0,0.6);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
      padding: 4px;
      align-items: center;
      justify-items: center;
      backface-visibility: hidden;
    }

    /* Định vị 6 mặt không gian 3D tương ứng size 57px (bán kính 28.5px) */
    .face-1 { transform: rotateY(0deg) translateZ(28.5px); }
    .face-6 { transform: rotateY(180deg) translateZ(28.5px); }
    .face-2 { transform: rotateY(-90deg) translateZ(28.5px); }
    .face-5 { transform: rotateY(90deg) translateZ(28.5px); }
    .face-3 { transform: rotateX(90deg) translateZ(28.5px); }
    .face-4 { transform: rotateX(-90deg) translateZ(28.5px); }

    /* Dấu chấm khoét chìm màu đen giữ nguyên vẹn 100% */
    .dot-pip {
      width: 10px;
      height: 10px;
      background: radial-gradient(circle at 35% 35%, #3a3a3a 0%, #111111 75%, #000000 100%);
      border-radius: 50%;
      box-shadow: inset 0 1px 2px rgba(0,0,0,1), 0 1px 1px rgba(255,255,255,0.7);
      display: none;
    }

    /* Mặt 1 Nút Đỏ Siêu Lớn Khoét Chìm Giữ Nguyên */
    .face-1 .dot-pip.red-giant {
      display: block;
      width: 22px;
      height: 22px;
      background: radial-gradient(circle at 35% 35%, #ffffff 0%, #ffd700 60%, #cc9900 100%);
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.9), 0 1px 1px rgba(255,255,255,0.9);
      grid-column: 2;
      grid-row: 2;
    }

    /* Vị trí các chấm chuẩn xác */
    .p1 { grid-column: 1; grid-row: 1; }
    .p3 { grid-column: 3; grid-row: 1; }
    .p4 { grid-column: 1; grid-row: 2; }
    .p5 { grid-column: 2; grid-row: 2; }
    .p6 { grid-column: 3; grid-row: 2; }
    .p7 { grid-column: 1; grid-row: 3; }
    .p9 { grid-column: 3; grid-row: 3; }

    .face-1 .p5 { display: block; }
    .face-2 .p1, .face-2 .p9 { display: block; }
    .face-3 .p1, .face-3 .p5, .face-3 .p9 { display: block; }
    .face-4 .p1, .face-4 .p3, .face-4 .p7, .face-4 .p9 { display: block; }
    .face-5 .p1, .face-5 .p3, .face-5 .p5, .face-5 .p7, .face-5 .p9 { display: block; }
    .face-6 .p1, .face-6 .p3, .face-6 .p4, .face-6 .p6, .face-6 .p7, .face-6 .p9 { display: block; }

    /* LOGO & CHIP TIỀN VUÔNG GÓC THỰC TẾ XUẤT HIỆN BÊN NGOÀI SẢNH BÊN DƯỚI */
