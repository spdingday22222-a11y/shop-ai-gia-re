    /* ĐỊNH DẠNG SỐ */
    function formatMoney(num) {
      return num.toLocaleString('vi-VN');
    }

    /* NHẢY SỐ ĐỘNG SINH ĐỘNG THỰC TẾ HAI BÊN CƯỢC */
    function startDynamicLobbyAndArena() {
      // Đếm ngược phiên cược
      gameInterval = setInterval(() => {
        timerVal--;
        if (timerVal < 0) {
          timerVal = 45;
          resetNewRound();
        }
        document.getElementById('timer').innerText = timerVal < 10 ? '0' + timerVal : timerVal;
        document.getElementById('lobby-time-1').innerText = '00:' + (timerVal < 10 ? '0' + timerVal : timerVal);
        document.getElementById('lobby-time-2').innerText = '00:' + (timerVal < 10 ? '0' + timerVal : timerVal);

        if (timerVal === 5 && !isRolling) {
          triggerDiceRoll();
        }
      }, 1000);

      // Cập nhật nhảy số người chơi và tổng tiền linh hoạt
      dynamicNumberInterval = setInterval(() => {
        if (timerVal > 5) {
          // Thêm cược ngẫu nhiên Tài
          let addTai = Math.floor(Math.random() * 50) * 10000;
          totalTaiAmount += addTai;
          if (Math.random() > 0.6) totalTaiPlayers += Math.floor(Math.random() * 3) + 1;

          // Thêm cược ngẫu nhiên Xỉu
          let addXiu = Math.floor(Math.random() * 50) * 10000;
          totalXiuAmount += addXiu;
          if (Math.random() > 0.6) totalXiuPlayers += Math.floor(Math.random() * 3) + 1;

          // Cập nhật giao diện Arena
          let taiAmtEl = document.getElementById('tai-amount');
          let xiuAmtEl = document.getElementById('xiu-amount');
          let taiPlrEl = document.getElementById('tai-players');
          let xiuPlrEl = document.getElementById('xiu-players');

          taiAmtEl.innerText = formatMoney(totalTaiAmount);
          xiuAmtEl.innerText = formatMoney(totalXiuAmount);
          taiPlrEl.innerText = totalTaiPlayers;
          xiuPlrEl.innerText = totalXiuPlayers;

          // Nhấp nháy nhẹ nhàng khi nhảy số
          if (addTai > 0) {
            taiAmtEl.classList.add('pulse-text');
            document.getElementById('side-tai').classList.add('bounce-effect');
            setTimeout(() => {
              taiAmtEl.classList.remove('pulse-text');
              document.getElementById('side-tai').classList.remove('bounce-effect');
            }, 300);
          }
          if (addXiu > 0) {
            xiuAmtEl.classList.add('pulse-text');
            document.getElementById('side-xiu').classList.add('bounce-effect');
            setTimeout(() => {
              xiuAmtEl.classList.remove('pulse-text');
              document.getElementById('side-xiu').classList.remove('bounce-effect');
            }, 300);
          }
        }
      }, 1200);
    }

    /* VÀO & RỜI SẢNH ARENA */
    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 50);
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    /* CHỌN CỬA CƯỢC (TÀI HOẶC XỈU) */
    function selectBetSide(side) {
      if (timerVal <= 5) {
        showToast('Hết thời gian cược phiên này!');
        return;
      }
      currentSide = side;
      pendingBetAmount = 0;

      document.getElementById('btn-bet-tai').classList.remove('selected-active');
      document.getElementById('btn-bet-xiu').classList.remove('selected-active');

      if (side === 'TÀI') {
        document.getElementById('btn-bet-tai').classList.add('selected-active');
      } else {
        document.getElementById('btn-bet-xiu').classList.add('selected-active');
      }

      document.getElementById('chip-bar').classList.add('active');
      showToast('Đã chọn cửa ' + side + '. Vui lòng chọn số tiền!');
    }

    /* TỰ ĐỘNG CẬP NHẬT TIỀN KHI BẤM CHIP */
    function addChipValue(val) {
      if (!currentSide) {
        showToast('Vui lòng chọn cửa TÀI hoặc XỈU trước!');
        return;
      }

      if (balance < pendingBetAmount + val) {
        showToast('Số dư tài khoản không đủ!');
        return;
      }

      pendingBetAmount += val;

      // Cập nhật số tiền hiển thị xem trước trực tiếp ở ô đã chọn
      if (currentSide === 'TÀI') {
        let tag = document.getElementById('my-tai-bet');
        tag.style.display = 'block';
        tag.innerText = 'Đang chọn: ' + formatMoney(pendingBetAmount);
      } else {
        let tag = document.getElementById('my-xiu-bet');
        tag.style.display = 'block';
        tag.innerText = 'Đang chọn: ' + formatMoney(pendingBetAmount);
      }
    }

    /* HỦY CHỌN CƯỢC */
    function cancelBetSelection() {
      pendingBetAmount = 0;
      currentSide = null;
      document.getElementById('btn-bet-tai').classList.remove('selected-active');
      document.getElementById('btn-bet-xiu').classList.remove('selected-active');
      document.getElementById('chip-bar').classList.remove('active');

      // Khôi phục thẻ tag cược
      let tagTai = document.getElementById('my-tai-bet');
      tagTai.innerText = 'Đã cược: ' + formatMoney(myTaiBet);
      if (myTaiBet === 0) tagTai.style.display = 'none';

      let tagXiu = document.getElementById('my-xiu-bet');
      tagXiu.innerText = 'Đã cược: ' + formatMoney(myXiuBet);
      if (myXiuBet === 0) tagXiu.style.display = 'none';

      showToast('Đã hủy chọn cược');
    }

    /* XÁC NHẬN CƯỢC & HIỆU ỨNG VỠ ÒA TÓE MÀU VÀNG CAM */
    function confirmBet() {
      if (!currentSide || pendingBetAmount === 0) {
        showToast('Vui lòng chọn chip tiền cược!');
        return;
      }

      balance -= pendingBetAmount;
      document.getElementById('user-balance').innerText = formatMoney(balance);
      document.getElementById('arena-balance').innerText = formatMoney(balance);

      if (currentSide === 'TÀI') {
        myTaiBet += pendingBetAmount;
        let tag = document.getElementById('my-tai-bet');
        tag.innerText = 'Đã cược: ' + formatMoney(myTaiBet);
        tag.style.display = 'block';
      } else {
        myXiuBet += pendingBetAmount;
        let tag = document.getElementById('my-xiu-bet');
        tag.innerText = 'Đã cược: ' + formatMoney(myXiuBet);
        tag.style.display = 'block';
      }

      // KÍCH HOẠT HIỆU ỨNG TÓE MÀU VÀNG CAM VỠ ÒA THỰC TẾ
      let rect = currentSide === 'TÀI' 
        ? document.getElementById('side-tai').getBoundingClientRect() 
        : document.getElementById('side-xiu').getBoundingClientRect();

      createExplosion(rect.left + rect.width / 2, rect.top + rect.height / 2);

      showToast('Đặt cược thành công ' + formatMoney(pendingBetAmount) + 'đ vào ' + currentSide);

      // Reset thanh chọn chip
      pendingBetAmount = 0;
      currentSide = null;
      document.getElementById('btn-bet-tai').classList.remove('selected-active');
      document.getElementById('btn-bet-xiu').classList.remove('selected-active');
      document.getElementById('chip-bar').classList.remove('active');
    }

    /* LẮN XÚC XẮC THỰC TẾ 3D */
    function triggerDiceRoll() {
      isRolling = true;
      let w1 = document.getElementById('wrap1');
      let w2 = document.getElementById('wrap2');
      let w3 = document.getElementById('wrap3');
      let c1 = document.getElementById('cube1');
      let c2 = document.getElementById('cube2');
      let c3 = document.getElementById('cube3');

      w1.classList.add('rolling-1');
      w2.classList.add('rolling-2');
      w3.classList.add('rolling-3');
      c1.classList.add('rolling');
      c2.classList.add('rolling');
      c3.classList.add('rolling');

      setTimeout(() => {
        w1.classList.remove('rolling-1');
        w2.classList.remove('rolling-2');
        w3.classList.remove('rolling-3');
        c1.classList.remove('rolling');
        c2.classList.remove('rolling');
        c3.classList.remove('rolling');

        // Tạo kết quả xúc xắc ngẫu nhiên
        let d1 = Math.floor(Math.random() * 6) + 1;
        let d2 = Math.floor(Math.random() * 6) + 1;
        let d3 = Math.floor(Math.random() * 6) + 1;
        let total = d1 + d2 + d3;
        let result = total >= 11 ? 'TÀI' : 'XỈU';

        setCubeRotation(c1, d1);
        setCubeRotation(c2, d2);
        setCubeRotation(c3, d3);

        setTimeout(() => {
          showRoundResult(result, total);
        }, 800);
      }, 2500);
    }

    function setCubeRotation(cube, value) {
      let rotations = {
        1: 'rotateY(0deg)',
        6: 'rotateY(180deg)',
        2: 'rotateY(90deg)',
        5: 'rotateY(-90deg)',
        3: 'rotateX(-90deg)',
        4: 'rotateX(90deg)'
      };
      cube.style.transform = rotations[value];
    }

    /* HIỂN THỊ KẾT QUẢ PHIÊN & TRẢ THƯỞNG */
    function showRoundResult(result, total) {
      let winSide = result === 'TÀI' ? document.getElementById('side-tai') : document.getElementById('side-xiu');
      winSide.classList.add('active-win');

      let myWin = 0;
      if (result === 'TÀI' && myTaiBet > 0) myWin = myTaiBet * 1.98;
      if (result === 'XỈU' && myXiuBet > 0) myWin = myXiuBet * 1.98;

      if (myWin > 0) {
        balance += myWin;
        document.getElementById('user-balance').innerText = formatMoney(balance);
        document.getElementById('arena-balance').innerText = formatMoney(balance);

        document.getElementById('win-money-text').innerText = '+' + formatMoney(myWin) + 'đ';
        document.getElementById('win-banner').classList.add('show');

        // Nổ pháo hoa ăn mừng lớn ở giữa màn hình
        createExplosion(window.innerWidth / 2, window.innerHeight / 2);

        setTimeout(() => {
          document.getElementById('win-banner').classList.remove('show');
        }, 3000);
      }

      // Thêm nút lịch sử cầu
      let dots = document.getElementById('history-dots');
      let newDot = document.createElement('div');
      newDot.className = 'dot ' + (result === 'TÀI' ? 'tai' : 'xiu');
      dots.appendChild(newDot);
      if (dots.children.length > 10) dots.removeChild(dots.children[0]);
    }

    /* RESET PHIÊN MỚI */
    function resetNewRound() {
      isRolling = false;
      myTaiBet = 0;
      myXiuBet = 0;

      document.getElementById('side-tai').classList.remove('active-win');
      document.getElementById('side-xiu').classList.remove('active-win');

      document.getElementById('my-tai-bet').style.display = 'none';
      document.getElementById('my-xiu-bet').style.display = 'none';

      // Reset lượng cược ngẫu nhiên mới
      totalTaiAmount = Math.floor(Math.random() * 200 + 400) * 1000000;
      totalXiuAmount = Math.floor(Math.random() * 200 + 500) * 1000000;
      totalTaiPlayers = Math.floor(Math.random() * 100 + 350);
      totalXiuPlayers = Math.floor(Math.random() * 100 + 450);
    }

    /* XOAY CAMERA 3D */
    let cam3d = false;
    function toggleCamera3D() {
      cam3d = !cam3d;
      let stage = document.getElementById('arena-stage');
      stage.style.transform = cam3d ? 'rotateX(25deg) rotateY(-10deg)' : 'rotateX(0deg) rotateY(0deg)';
      showToast(cam3d ? 'Bật chế độ góc nhìn 3D Nghiêng' : 'Bật chế độ góc nhìn 3D Thẳng');
    }
  </script>
