      <div>
        <button class="btn-action-bet" style="padding: 5px 18px; font-size: 12px;" onclick="showToast('💳 Cổng Nạp Tự Động 24/7 Sẵn Sàng!')">NẠP TIỀN</button>
      </div>
    </div>

    <div class="lobby-content">
      <div class="game-card" onclick="enterArena('MD5')">
        <div class="card-title">TÀI XỈU MD5</div>
        <div class="card-sub">MINH BẠCH 100%</div>
        <div style="text-align: center; color:#ffea00; font-size:12px; font-weight:bold;">#13217</div>
      </div>
    </div>
  </div>

  <!-- 3. ARENA GAME PLAY -->
  <div id="arena-screen" class="arena-screen">
    <div class="arena-header">
      <button class="btn-back-lobby" onclick="exitArena()">◄ RỜI SẢNH</button>
      <div style="font-weight:900; color:#ffea00; font-size: 18px;" id="arena-title">TÀI XỈU MD5</div>
      <div class="balance-box" id="arena-balance">$ 1,096,000</div>
    </div>

    <div class="arena-stage" id="arena-stage">
      <!-- Lớp Dim Nắp Tối Nền -->
      <div class="dim-overlay" id="dim-overlay"></div>

      <!-- BÀN CƯỢC KÉO THẢ TỰ DO (DRAG LOBBY BOARD) -->
      <div class="real-taixiu-board" id="draggable-board">
        <div class="board-logo">GO88 MD5</div>

        <!-- Các nút tiện ích xung quanh viền -->
        <div class="circle-btn btn-info" onclick="showToast('ℹ️ Phiên cược mã hóa MD5 Minh Bạch 100%')">i</div>
        <div class="circle-btn btn-chart" onclick="openChartModal()">📊</div>
        <div class="circle-btn btn-help" onclick="showToast('❓ Luật chơi: Tài (11-17), Xỉu (3-10)')">?</div>
        <div class="circle-btn btn-history" onclick="showToast('📜 Xem Lịch Sử Cược Cá Nhân')">📜</div>

        <div class="circle-btn btn-close" onclick="exitArena()">X</div>
        <div class="circle-btn btn-rank" onclick="showToast('🏆 Bảng Vinh Danh Top Đại Đại Gia')">🏆</div>
        <div class="circle-btn btn-chat-toggle" onclick="showToast('💬 Khung Chat Cộng Đồng MD5 VIP')">💬</div>

        <!-- NÚT NẶN BÀN TAY BẮT MẮT -->
        <div class="btn-nan-hand active" id="btn-nan" onclick="toggleNanMode()" title="Bật/Tắt chế độ Nặn">✋</div>

        <!-- CỬA TÀI -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="tai-players">0</span></div>
          <div class="bet-title" id="title-TAI">TÀI</div>
          <div class="bet-amount" id="tai-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('TAI')">
            <span class="bet-text-val label-cuoc" id="val-TAI">CƯỢC</span>
          </div>
        </div>

        <!-- BÁT / ĐĨA TRUNG TÂM -->
        <div class="center-plate" id="center-plate">
          <div class="timer-display" id="timer-text">40</div>

          <div class="dice-triangle-container" id="dice-container">
            <div class="dice-real" id="dice1"></div>
            <div class="dice-real" id="dice2"></div>
            <div class="dice-real" id="dice3"></div>
          </div>

          <div class="win-text-overlay" id="win-overlay">+198,000</div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="xiu-players">0</span></div>
          <div class="bet-title" id="title-XIU">XỈU</div>
          <div class="bet-amount" id="xiu-amount">0</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('XIU')">
            <span class="bet-text-val label-cuoc" id="val-XIU">CƯỢC</span>
          </div>
        </div>

        <!-- BANNER PHÍM CHIP CƯỢC -->
        <div class="chip-panel-real hidden" id="chip-panel">
          <div class="chip-list">
            <div class="chip-btn" onclick="addChip(1000)">1K</div>
            <div class="chip-btn" onclick="addChip(10000)">10K</div>
            <div class="chip-btn" onclick="addChip(50000)">50K</div>
            <div class="chip-btn" onclick="addChip(100000)">100K</div>
            <div class="chip-btn" onclick="addChip(500000)">500K</div>
            <div class="chip-btn" onclick="addChip(1000000)">1M</div>
            <div class="chip-btn" onclick="addChip(10000000)">10M</div>
            <div class="chip-btn" onclick="addChip(50000000)">50M</div>
          </div>
          <div class="chip-actions">
            <button class="btn-action-x2" onclick="allInBet()">ALL IN</button>
            <button class="btn-action-bet" onclick="confirmBet()">ĐẶT CƯỢC</button>
            <button class="btn-action-cancel" onclick="cancelBet()">HỦY</button>
          </div>
        </div>
      </div>

      <!-- NẮP KÉO TỰ DO RA NGOÀI SẢNH MƯỢT MÀ -->
      <div class="plate-cover" id="plate-cover">
        <div class="plate-cover-knob"></div>
      </div>
    </div>
  </div>

  <!-- BẢNG SOI CẦU MỞ RỘNG - KÉO THẢ TỰ DO BÊN TRONG BẢNG -->
  <div class="chart-modal-overlay" id="chart-modal">
    <div class="chart-modal-box" id="draggable-chart">
      <div class="chart-header" id="chart-drag-handle">
        <div class="chart-title">📊 BẢNG SOI CẦU TÀI XỈU MD5 - GO88 VIP</div>
        <div class="btn-close-chart" onclick="closeChartModal()">X</div>
      </div>
      <div class="chart-body-wrapper" id="chart-scroll-area">
        <div class="grid-cau-container" id="grid-cau"></div>
      </div>
    </div>
  </div>

  <script>
    // State Game
    let balance = 1096000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    let timer = 40;
    let timerInterval = null;
    let nanInterval = null;
    let botBetInterval = null;
    let gameState = 'BETTING'; // 'BETTING', 'NAN', 'REWARD'

    // Bot Bet Simulation Variables
    let currentTaiBet = 0, currentXiuBet = 0;
    let currentTaiUsers = 0, currentXiuUsers = 0;
    let currentDiceResults = [1, 2, 3];

    // Lịch sử kết quả cầu 5 hàng
    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 },
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 },
      { side: 'XIU', total: 4 }, { side: 'TAI', total: 16 }
    ];

    // Chế độ nặn & Kéo nắp
    let isNanMode = true;
    let isDraggingCover = false;
    let coverX = 0, coverY = 0;
    let coverStartX = 0, coverStartY = 0;

    const plateCover = document.getElementById('plate-cover');
    const dragBoard = document.getElementById('draggable-board');
    const dragChart = document.getElementById('draggable-chart');
    const chartHandle = document.getElementById('chart-drag-handle');
    const dimOverlay = document.getElementById('dim-overlay');

    // ========================================================
    // 1. ENGINE KÉO THẢ TỰ DO BÀN CƯỢC SẢNH GAME (DRAG BOARD)
    // ========================================================
    let isDraggingBoard = false;
    let boardX = 0, boardY = 0;
    let boardStartX = 0, boardStartY = 0;

    function initBoardPosition() {
      boardX = (window.innerWidth - dragBoard.offsetWidth) / 2;
      boardY = (window.innerHeight - dragBoard.offsetHeight) / 2;
      dragBoard.style.left = boardX + 'px';
      dragBoard.style.top = boardY + 'px';
    }

    dragBoard.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.circle-btn') || e.target.closest('.btn-cuoc-oval') || 
          e.target.closest('.btn-nan-hand') || e.target.closest('.chip-panel-real') ||
          e.target.closest('.center-plate') || e.target.closest('#plate-cover')) {
        return;
      }
      isDraggingBoard = true;
      boardStartX = e.clientX - boardX;
      boardStartY = e.clientY - boardY;
      dragBoard.setPointerCapture(e.pointerId);
    });

    dragBoard.addEventListener('pointermove', (e) => {
      if (!isDraggingBoard) return;
      
      const prevBoardX = boardX;
      const prevBoardY = boardY;

      boardX = e.clientX - boardStartX;
      boardY = e.clientY - boardStartY;
      dragBoard.style.left = boardX + 'px';
      dragBoard.style.top = boardY + 'px';
      
      // Khi kéo bàn cược đi, nắp di chuyển tịnh tiến theo bàn cược mà KHÔNG bị nhảy đậy lại đĩa
      if (gameState === 'NAN' && isNanMode && !isDraggingCover) {
        coverX += (boardX - prevBoardX);
        coverY += (boardY - prevBoardY);
        plateCover.style.left = coverX + 'px';
        plateCover.style.top = coverY + 'px';
      }
    });

    dragBoard.addEventListener('pointerup', (e) => {
      if (!isDraggingBoard) return;
      isDraggingBoard = false;
      try { dragBoard.releasePointerCapture(e.pointerId); } catch(err){}
    });

    // ========================================================
    // 2. ENGINE KÉO THẢ TỰ DO BẢNG SOI CẦU (DRAG CHART MODAL)
    // ========================================================
    let isDraggingChart = false;
    let chartX = 0, chartY = 0;
    let chartStartX = 0, chartStartY = 0;

    function initChartPosition() {
      chartX = (window.innerWidth - dragChart.offsetWidth) / 2;
      chartY = (window.innerHeight - dragChart.offsetHeight) / 2;
      dragChart.style.left = chartX + 'px';
      dragChart.style.top = chartY + 'px';
    }

    chartHandle.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.btn-close-chart')) return;
      isDraggingChart = true;
      chartStartX = e.clientX - chartX;
      chartStartY = e.clientY - chartY;
      chartHandle.setPointerCapture(e.pointerId);
    });

    chartHandle.addEventListener('pointermove', (e) => {
      if (!isDraggingChart) return;
      chartX = e.clientX - chartStartX;
      chartY = e.clientY - chartStartY;
      dragChart.style.left = chartX + 'px';
      dragChart.style.top = chartY + 'px';
    });

    chartHandle.addEventListener('pointerup', (e) => {
      if (!isDraggingChart) return;
      isDraggingChart = false;
      try { chartHandle.releasePointerCapture(e.pointerId); } catch(err){}
    });

    // ========================================================
    // 3. ENGINE KÉO THẢ NẮP NẶN TỰ DO & CHỐNG LỖI (DRAG PLATE COVER)
    // ========================================================
    function resetCoverPosition() {
      const centerPlate = document.getElementById('center-plate');
      const rect = centerPlate.getBoundingClientRect();
      coverX = rect.left + (rect.width - 210) / 2;
      coverY = rect.top + (rect.height - 210) / 2;

      plateCover.style.left = coverX + 'px';
      plateCover.style.top = coverY + 'px';
    }

    plateCover.addEventListener('pointerdown', (e) => {
      if (gameState === 'BETTING' || !isNanMode) return;
      e.stopPropagation(); // Ngăn sự kiện lan tới bàn sảnh
      isDraggingCover = true;
      coverStartX = e.clientX - coverX;
      coverStartY = e.clientY - coverY;
      plateCover.setPointerCapture(e.pointerId);
    });

    plateCover.addEventListener('pointermove', (e) => {
      if (!isDraggingCover || !isNanMode) return;
      coverX = e.clientX - coverStartX;
      coverY = e.clientY - coverStartY;
      plateCover.style.left = coverX + 'px';
      plateCover.style.top = coverY + 'px';
    });

    plateCover.addEventListener('pointerup', (e) => {
      if (!isDraggingCover) return;
      isDraggingCover = false;
      try { plateCover.releasePointerCapture(e.pointerId); } catch(err){}
    });

    // ========================================================
    // 4. MAIN GAME LOGIC
    // ========================================================
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      const arena = document.getElementById('arena-screen');
      arena.style.display = 'flex';
      setTimeout(() => {
        arena.classList.add('active');
        initBoardPosition();
        resetCoverPosition();
      }, 10);
      startNewGameRound();
    }

    function exitArena() {
      const arena = document.getElementById('arena-screen');
      arena.classList.remove('active');
      setTimeout(() => {
        arena.style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
      clearInterval(nanInterval);
      clearInterval(botBetInterval);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('✋ ĐÃ BẬT CHẾ ĐỘ NẶN 20s');
        if (gameState === 'NAN') {
          resetCoverPosition();
          plateCover.style.display = 'flex';
          dimOverlay.classList.add('active');
        }
      } else {
        btn.classList.remove('active');
        showToast('⚡ ĐÃ TẮT NẶN - MỞ KẾT QUẢ TỰ ĐỘNG');
        plateCover.style.display = 'none';
        dimOverlay.classList.remove('active');
      }
    }

    function startBotBetting() {
      clearInterval(botBetInterval);
      botBetInterval = setInterval(() => {
        if (gameState !== 'BETTING') return;

        const deltaTai = Math.floor(Math.random() * 45000000) + 3000000;
        const deltaXiu = Math.floor(Math.random() * 45000000) + 3000000;

        if (currentTaiBet + deltaTai < 2480000000) currentTaiBet += deltaTai;
        if (currentXiuBet + deltaXiu < 2480000000) currentXiuBet += deltaXiu;

        currentTaiUsers += Math.floor(Math.random() * 12) + 1;
        currentXiuUsers += Math.floor(Math.random() * 12) + 1;

        const taiEl = document.getElementById('tai-amount');
        const xiuEl = document.getElementById('xiu-amount');
        const taiU = document.getElementById('tai-players');
        const xiuU = document.getElementById('xiu-players');

        taiEl.innerText = currentTaiBet.toLocaleString();
        xiuEl.innerText = currentXiuBet.toLocaleString();
        taiU.innerText = currentTaiUsers.toLocaleString();
        xiuU.innerText = currentXiuUsers.toLocaleString();

        taiEl.classList.add('jump-glow');
        xiuEl.classList.add('jump-glow');
        taiU.classList.add('bounce');
        xiuU.classList.add('bounce');

        setTimeout(() => {
          taiEl.classList.remove('jump-glow');
          xiuEl.classList.remove('jump-glow');
          taiU.classList.remove('bounce');
          xiuU.classList.remove('bounce');
        }, 150);
      }, 700);
    }

    function startNewGameRound() {
      clearInterval(timerInterval);
      clearInterval(nanInterval);
      gameState = 'BETTING';

      currentTaiBet = 0;
      currentXiuBet = 0;
      currentTaiUsers = 0;
      currentXiuUsers = 0;

      document.getElementById('tai-amount').innerText = "0";
      document.getElementById('xiu-amount').innerText = "0";
      document.getElementById('tai-players').innerText = "0";
      document.getElementById('xiu-players').innerText = "0";

      confirmedBets = { TAI: 0, XIU: 0 };
      tempBetAmount = 0;
      currentBetSide = null;

      document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
      document.getElementById('val-TAI').innerText = 'CƯỢC';
      document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';
      document.getElementById('val-XIU').innerText = 'CƯỢC';

      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');
      document.getElementById('win-overlay').style.display = 'none';

      document.getElementById('chip-panel').classList.add('hidden');
      document.getElementById('dice-container').style.display = 'none';
      plateCover.style.display = 'none';
      dimOverlay.classList.remove('active');

      const timerEl = document.getElementById('timer-text');
      timerEl.style.display = 'block';
      timer = 40;
      timerEl.innerText = timer;

      startBotBetting();

      timerInterval = setInterval(() => {
        timer--;
        if (timer >= 0) {
          timerEl.innerText = timer;
        } else {
          clearInterval(timerInterval);
          processBettingEnd();
        }
      }, 1000);
    }

    function openBetPanel(side) {
      if (gameState !== 'BETTING') return;
      currentBetSide = side;
      tempBetAmount = 0;
      document.getElementById('chip-panel').classList.remove('hidden');
      updateBetDisplay();
    }

    function addChip(amount) {
      if (!currentBetSide || gameState !== 'BETTING') return;
      if (balance >= tempBetAmount + amount) {
        tempBetAmount += amount;
        updateBetDisplay();
      } else {
        showToast('⚠️ Số dư không đủ!');
      }
    }

    function allInBet() {
      if (!currentBetSide || gameState !== 'BETTING') return;
      tempBetAmount = balance;
      updateBetDisplay();
    }

    function updateBetDisplay() {
      const valEl = document.getElementById('val-' + currentBetSide);
      valEl.className = 'bet-text-val active-bet';
      valEl.innerText = tempBetAmount > 0 ? tempBetAmount.toLocaleString() : '0';
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('⚠️ Vui lòng chọn phím chip cược!');
        return;
      }
      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

      showToast(`✅ Cược thành công $ ${tempBetAmount.toLocaleString()} vào cửa ${currentBetSide}`);
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function cancelBet() {
      if (currentBetSide && confirmedBets[currentBetSide] === 0) {
        const valEl = document.getElementById('val-' + currentBetSide);
        valEl.className = 'bet-text-val label-cuoc';
        valEl.innerText = 'CƯỢC';
      }
      tempBetAmount = 0;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function processBettingEnd() {
      clearInterval(botBetInterval);
      document.getElementById('chip-panel').classList.add('hidden');
      document.getElementById('timer-text').style.display = 'none';

      currentDiceResults = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];

      renderDice(currentDiceResults);
      document.getElementById('dice-container').style.display = 'block';

      if (isNanMode) {
        gameState = 'NAN';
        resetCoverPosition();
        plateCover.style.display = 'flex';
        dimOverlay.classList.add('active');

        let nanTimer = 20;
        showToast('✋ BẮT ĐẦU NẶN! Kéo nắp tự do (20s)');

        nanInterval = setInterval(() => {
          nanTimer--;
          if (nanTimer <= 0) {
            clearInterval(nanInterval);
            finishRound();
          }
        }, 1000);
      } else {
        finishRound();
      }
    }

    function renderDice(results) {
      results.forEach((val, idx) => {
        const diceEl = document.getElementById('dice' + (idx + 1));
        diceEl.innerHTML = '';

        if (val === 1) {
          diceEl.innerHTML = '<div class="pip center-red"></div>';
        } else {
          let pips = [];
          if (val === 2) pips = [1, 9];
          else if (val === 3) pips = [1, 5, 9];
          else if (val === 4) pips = [1, 3, 7, 9];
          else if (val === 5) pips = [1, 3, 5, 7, 9];
          else if (val === 6) pips = [1, 3, 4, 6, 7, 9];

          pips.forEach(p => {
            const pip = document.createElement('div');
            pip.className = `pip p-${p}`;
            pip.style.display = 'block';
            diceEl.appendChild(pip);
          });
        }
      });
    }

    function finishRound() {
      gameState = 'REWARD';
      plateCover.style.display = 'none';
      dimOverlay.classList.remove('active');

      const sum = currentDiceResults.reduce((a, b) => a + b, 0);
      const winSide = sum >= 11 ? 'TAI' : 'XIU';

      document.getElementById('title-' + winSide).classList.add('highlight-pulse');

      historyResults.push({ side: winSide, total: sum });
      renderChartGrid();

      const userWinBet = confirmedBets[winSide];
      if (userWinBet > 0) {
        const reward = Math.floor(userWinBet * 1.98);
        balance += reward;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        const winOverlay = document.getElementById('win-overlay');
        winOverlay.innerText = `+${reward.toLocaleString()}`;
        winOverlay.style.display = 'block';
        showToast(`🎉 CHÚC MỪNG! BẠN THẮNG $ ${reward.toLocaleString()}`);
      } else {
        showToast(`🎲 KẾT QUẢ: ${winSide} (${sum} ĐIỂM)`);
      }

      setTimeout(() => {
        startNewGameRound();
      }, 5000);
    }

    // ========================================================
    // 5. BẢNG SOI CẦU LOGIC (CHART GRID)
    // ========================================================
    function openChartModal() {
      const modal = document.getElementById('chart-modal');
      modal.classList.add('active');
      initChartPosition();
      renderChartGrid();
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function renderChartGrid() {
      const gridContainer = document.getElementById('grid-cau');
      gridContainer.innerHTML = '';

      let columns = [];
      let currentCol = [];
      let currentSide = null;

      historyResults.forEach(res => {
        if (!currentSide) {
          currentSide = res.side;
          currentCol.push(res);
        } else if (res.side === currentSide && currentCol.length < 5) {
          currentCol.push(res);
        } else {
          columns.push(currentCol);
          currentCol = [res];
          currentSide = res.side;
        }
      });
      if (currentCol.length > 0) columns.push(currentCol);

      columns.forEach(col => {
        for (let i = 0; i < 5; i++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';
          if (col[i]) {
            const dot = document.createElement('div');
            dot.className = `dot-result ${col[i].side.toLowerCase()}`;
            dot.innerText = col[i].total;
            cell.appendChild(dot);
          }
          gridContainer.appendChild(cell);
        }
      });

      const scrollArea = document.getElementById('chart-scroll-area');
      setTimeout(() => scrollArea.scrollLeft = scrollArea.scrollWidth, 50);
    }

    window.addEventListener('resize', () => {
      if (document.getElementById('arena-screen').classList.contains('active')) {
        initBoardPosition();
        resetCoverPosition();
      }
      if (document.getElementById('chart-modal').classList.contains('active')) {
        initChartPosition();
      }
    });
  </script>
</body>
</html>
