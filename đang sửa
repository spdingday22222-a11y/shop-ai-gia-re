<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Tài Xỉu 3D Chân Thực</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800;900&display=swap');

        body {
            font-family: 'Montserrat', sans-serif;
            background: radial-gradient(circle at center, #1a1c29 0%, #0d0e15 100%);
            color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Gold Gradient Borders & Text */
        .gold-border {
            border: 2px solid #dfb76c;
            box-shadow: 0 0 15px rgba(223, 183, 108, 0.3), inset 0 0 15px rgba(223, 183, 108, 0.2);
        }

        .gold-text {
            background: linear-gradient(135deg, #ffe8b3 0%, #f9d479 50%, #c39637 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Plate Container Shadow */
        .plate-shadow {
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), inset 0 0 40px rgba(0, 0, 0, 0.8);
        }

        /* --- 3D DICE STYLING --- */
        .dice-scene {
            width: 70px;
            height: 70px;
            perspective: 600px;
            margin: 10px;
        }

        .dice {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 1.2s cubic-bezier(0.2, 0.85, 0.4, 1.2);
        }

        /* Dice Faces */
        .dice-face {
            position: absolute;
            width: 70px;
            height: 70px;
            background: linear-gradient(145deg, #ffffff, #e6e6e6);
            border: 1px solid #ccc;
            border-radius: 14px;
            box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.2);
            display: grid;
            grid-template: repeat(3, 1fr) / repeat(3, 1fr);
            padding: 7px;
            box-sizing: border-box;
        }

        /* 3D Positions for Faces */
        .face-1 { transform: rotateY(0deg) translateZ(35px); }
        .face-6 { transform: rotateY(180deg) translateZ(35px); }
        .face-2 { transform: rotateY(-90deg) translateZ(35px); }
        .face-5 { transform: rotateY(90deg) translateZ(35px); }
        .face-3 { transform: rotateX(90deg) translateZ(35px); }
        .face-4 { transform: rotateX(-90deg) translateZ(35px); }

        /* Dots Styling */
        .dot {
            width: 13px;
            height: 13px;
            background-color: #222;
            border-radius: 50%;
            justify-self: center;
            align-self: center;
            box-shadow: inset 1px 1px 2px rgba(0,0,0,0.6);
        }

        /* Face 1 Big Red Dot */
        .face-1 .dot {
            width: 24px;
            height: 24px;
            background-color: #d90429;
            grid-area: 2 / 2;
            box-shadow: inset 1px 1px 3px rgba(0,0,0,0.5);
        }

        /* Red dots for Face 4 (Traditional Asian Dice Option) */
        .face-4 .dot {
            background-color: #d90429;
        }

        /* Specific Dot Layouts */
        /* Face 2 */
        .face-2 .dot:nth-child(1) { grid-area: 1 / 1; }
        .face-2 .dot:nth-child(2) { grid-area: 3 / 3; }

        /* Face 3 */
        .face-3 .dot:nth-child(1) { grid-area: 1 / 1; }
        .face-3 .dot:nth-child(2) { grid-area: 2 / 2; }
        .face-3 .dot:nth-child(3) { grid-area: 3 / 3; }

        /* Face 4 */
        .face-4 .dot:nth-child(1) { grid-area: 1 / 1; }
        .face-4 .dot:nth-child(2) { grid-area: 1 / 3; }
        .face-4 .dot:nth-child(3) { grid-area: 3 / 1; }
        .face-4 .dot:nth-child(4) { grid-area: 3 / 3; }

        /* Face 5 */
        .face-5 .dot:nth-child(1) { grid-area: 1 / 1; }
        .face-5 .dot:nth-child(2) { grid-area: 1 / 3; }
        .face-5 .dot:nth-child(3) { grid-area: 2 / 2; }
        .face-5 .dot:nth-child(4) { grid-area: 3 / 1; }
        .face-5 .dot:nth-child(5) { grid-area: 3 / 3; }

        /* Face 6 */
        .face-6 .dot:nth-child(1) { grid-area: 1 / 1; }
        .face-6 .dot:nth-child(2) { grid-area: 2 / 1; }
        .face-6 .dot:nth-child(3) { grid-area: 3 / 1; }
        .face-6 .dot:nth-child(4) { grid-area: 1 / 3; }
        .face-6 .dot:nth-child(5) { grid-area: 2 / 3; }
        .face-6 .dot:nth-child(6) { grid-area: 3 / 3; }

        /* Bowl Lid (Nắp đậy) Animation */
        .bowl-lid {
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s ease;
        }

        .bowl-lid.open {
            transform: translateY(-160px) rotate(-15deg);
            opacity: 0;
            pointer-events: none;
        }

        /* Shaking Animation for Plate */
        @keyframes shake {
            0% { transform: translate(0, 0) rotate(0deg); }
            10% { transform: translate(-10px, -10px) rotate(-3deg); }
            20% { transform: translate(10px, 8px) rotate(3deg); }
            30% { transform: translate(-12px, 5px) rotate(-4deg); }
            40% { transform: translate(12px, -8px) rotate(4deg); }
            50% { transform: translate(-8px, 10px) rotate(-2deg); }
            60% { transform: translate(10px, -5px) rotate(3deg); }
            70% { transform: translate(-10px, 8px) rotate(-3deg); }
            80% { transform: translate(8px, -10px) rotate(2deg); }
            90% { transform: translate(-5px, 5px) rotate(-1deg); }
            100% { transform: translate(0, 0) rotate(0deg); }
        }

        .shaking {
            animation: shake 1.2s ease-in-out infinite;
        }

        /* Pulse Highlight for Winner */
        @keyframes winnerGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(234, 179, 8, 0.4); transform: scale(1); }
            50% { box-shadow: 0 0 35px rgba(234, 179, 8, 0.9); transform: scale(1.03); }
        }

        .winner-active {
            animation: winnerGlow 1.5s infinite ease-in-out;
            border-color: #facc15 !important;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        ::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.2); }
        ::-webkit-scrollbar-thumb { background: #dfb76c; border-radius: 4px; }
    </style>
</head>
<body class="flex flex-col items-center justify-between min-h-screen p-3 md:p-6">

