<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Go88 Real - Tài Xỉu MD5 & Thường</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Arial', 'Segoe UI', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #05020a;
      color: #ffffffea;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #fx-canvas {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 9999;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
      will-change: opacity;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #1a092b 0%, #05010a 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 36px; font-weight: 900;
      background: linear-gradient(180deg, #e0c3fc 0%, #8ec5fc 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; text-shadow: 0 0 15px rgba(142, 197, 252, 0.4);
    }

    .loader-box {
      width: 300px; height: 14px;
      background: rgba(0,0,0,0.8);
      border: 1px solid #7b2cbf; border-radius: 10px;
      padding: 2px; margin-top: 15px;
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #7b2cbf, #9d4edd);
      border-radius: 10px; transition: width 0.05s linear;
    }

    /* 2. GAME LOBBY GO88 REAL */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #240046 0%, #10002b 50%, #03001e 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 6px 20px; background: rgba(12, 5, 24, 0.92);
      border-bottom: 2px solid #5a189a; z-index: 20;
    }

    .user-info { display: flex; align-items: center; gap: 10px; }
    .avatar { width: 40px; height: 40px; border-radius: 8px; border: 2px solid #9d4edd; background-size: cover; }
    .balance-box {
      background: #0d0417; border: 1px solid #7b2cbf;
      border-radius: 15px; padding: 3px 12px; color: #e0aaff;
      font-weight: bold; font-size: 14px; text-shadow: 0 0 5px rgba(224, 170, 255, 0.3);
    }

    .top-nav { display: flex; gap: 8px; font-weight: bold; font-size: 11px; text-transform: uppercase; }
    .top-nav span { padding: 5px 10px; border-radius: 4px; cursor: pointer; color: #b8c0e0; }
    .top-nav span.active, .top-nav span:hover { color: #fff; background: rgba(123, 44, 191, 0.4); border: 1px solid #9d4edd; }

    .btn-nap { background: linear-gradient(180deg, #9d4edd, #5a189a); color: #fff; border: none; padding: 6px 15px; border-radius: 6px; font-weight: 900; cursor: pointer; }
    .btn-rut { background: linear-gradient(180deg, #480ca8, #10002b); color: #fff; border: 1px solid #7b2cbf; padding: 6px 15px; border-radius: 6px; font-weight: 900; cursor: pointer; }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 200px; height: 260px; border-radius: 15px; border: 2px solid #7b2cbf;
      display: flex; flex-direction: column; justify-content: space-between; padding: 10px;
      cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; position: relative;
      box-shadow: 0 0 20px rgba(60, 9, 108, 0.5);
      will-change: transform;
    }
    .game-card:hover { transform: scale(1.05); box-shadow: 0 0 25px rgba(157, 78, 221, 0.7); }

    .card-md5 { background: linear-gradient(180deg, #4a0e17 0%, #1a0307 100%); border-color: #ff4d6d; }
    .card-thuong { background: linear-gradient(180deg, #093a52 0%, #02131d 100%); border-color: #00b4d8; }

    .card-title { font-size: 16px; font-weight: 900; text-align: center; color: #fff; text-shadow: 0 2px 4px #000; }
    .card-sub { font-size: 11px; text-align: center; color: #e0aaff; font-weight: bold; }

    /* 3. ARENA GAME PLAY (MD5 & THƯỜNG) */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(3, 1, 8, 0.92); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 20px; background: rgba(10, 4, 20, 0.95); border-bottom: 1px solid #5a189a;
      z-index: 20;
    }

    .btn-back-lobby { background: #7209b7; color: #fff; border: 1px solid #b5179e; padding: 5px 12px; border-radius: 15px; font-weight: bold; cursor: pointer; }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; overflow: hidden; }

    /* BÀN TÀI XỈU GO88 THỰC TẾ */
    .real-taixiu-board {
      position: absolute; width: 720px; height: 350px;
      border-radius: 180px; display: flex; justify-content: space-between; align-items: center;
      padding: 20px 35px; box-shadow: 0 0 50px rgba(6, 108, 126, 0.95), inset 0 0 15px rgba(255, 255, 255, 0.164);
      cursor: grab; user-select: none;
      left: calc(50% - 360px);
      top: calc(50% - 175px);
      touch-action: none;
      will-change: transform;
      transform: translate3d(0, 0, 0);
    }
    .real-taixiu-board:active { cursor: grabbing; }

    .real-taixiu-board.theme-md5 {
      background: radial-gradient(circle, #7a121c 0%, #3d070b 60%, #1f0204 100%);
      border: 4px solid #25b313;
    }

    .real-taixiu-board.theme-thuong {
      background: radial-gradient(circle, #0c526e 0%, #052c3d 60%, #01141c 100%);
      border: 4px solid #0096c7;
    }

    /* NÚT TRÒN VIỀN SẢNH */
    .circle-btn {
      position: absolute; width: 36px; height: 36px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 13px; font-weight: bold; cursor: pointer; box-shadow: 0 3px 6px rgba(165, 13, 71, 0.6);
      border: 1px solid #ffb703; z-index: 15; transition: transform 0.15s, background 0.2s;
      will-change: transform;
    }
    .theme-md5 .circle-btn { background: linear-gradient(180deg, #9e1a22, #400407); }
    .theme-thuong .circle-btn { background: linear-gradient(180deg, #0a6380, #022530); }
    .circle-btn:active { transform: scale(0.9); }

    .btn-info { top: 22px; left: 145px; }
    .btn-chart { top: 88px; left: 55px; }
    .btn-help { top: 162px; left: 22px; }
    .btn-history { top: 236px; left: 55px; }

    .btn-close { top: 22px; right: 145px; background: #9e1a22 !important; }
    .btn-rank { top: 88px; right: 55px; }
    .btn-chat-toggle { top: 162px; right: 22px; }
    .btn-squeeze { top: 236px; right: 55px; font-size: 16px; }

    .btn-squeeze.active-squeeze {
      border-color: #00ff66 !important;
      box-shadow: 0 0 12px #00ff66 !important;
      background: linear-gradient(180deg, #00b33c, #004d1a) !important;
    }

    /* CỬA CƯỢC TÀI / XỈU */
    .bet-side {
      width: 190px; height: 160px; display: flex; flex-direction: column;
      justify-content: center; align-items: center; position: relative;
      pointer-events: auto;
    }

    .bet-title { 
      font-size: 44px; font-weight: 900; letter-spacing: 2px; color: #d1820a; 
      text-shadow: 0 3px 6px rgba(0,0,0,0.8); transition: transform 0.2s, color 0.2s;
      will-change: transform;
    }

    .bet-title.blink-winner {
      animation: blinkWinGlow 0.4s infinite alternate;
    }

    @keyframes blinkWinGlow {
      0% { color: #f3efec; text-shadow: 0 0 5px #fff; transform: scale(1); }
      100% { color: #f0eceaf8; text-shadow: 0 0 20px #f5f5f3f3, 0 0 35px #ff9000; transform: scale(1.12); }
    }

    .player-count { font-size: 11px; color: #ffeb3b; font-weight: bold; margin-bottom: 2px; display: flex; align-items: center; gap: 3px; }

    .bet-amount {
      font-size: 16px; font-weight: 900; color: #fff;
      text-shadow: 0 2px 4px rgba(0,0,0,0.8); transition: transform 0.1s;
    }

    .bet-action-group { display: flex; gap: 5px; margin-top: 6px; align-items: center; }

    /* NÚT LOGO CƯỢC */
    .btn-real-bet-logo {
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 45%, #b86b00 100%);
      border: 2px solid #fff; border-radius: 12px; padding: 4px 10px;
      color: #000; font-size: 11px; font-weight: 900; cursor: pointer;
      box-shadow: 0 4px 10px rgba(0,0,0,0.7), inset 0 1px 2px rgba(255,255,255,0.8);
      display: flex; flex-direction: column; align-items: center; min-width: 105px;
      transition: transform 0.1s, box-shadow 0.2s;
      will-change: transform; transform: translateZ(0);
      position: relative; overflow: hidden;
    }
    .btn-real-bet-logo:active { transform: scale(0.92); }
    .btn-real-bet-logo.active-bet { 
      border-color: #64605c; 
      box-shadow: 0 0 12px #717379, inset 0 0 5px #515455; 
    }

    .btn-alin {
      background: linear-gradient(180deg, #ff416c, #ff4b2b);
      border: 1px solid #fff; border-radius: 12px; padding: 6px 10px;
      color: #fff; font-size: 11px; font-weight: 900; cursor: pointer;
      box-shadow: 0 3px 8px rgba(0,0,0,0.6); text-shadow: 0 1px 2px #000;
      transition: transform 0.1s;
    }
    .btn-alin:active { transform: scale(0.92); }

    /* Ô SỐ CƯỢC NẢY NỔI */
    .user-bet-val {
      font-size: 13px; color: #ff9d00; font-weight: 900; margin-top: 3px;
      background: #110803; border: 1px solid #ff8000; padding: 2px 8px; border-radius: 6px;
      width: 100%; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      text-shadow: 0 0 6px rgba(255, 157, 0, 0.9); box-shadow: inset 0 0 5px rgba(255, 128, 0, 0.5);
      animation: pulseOrangeReal 1.8s infinite ease-in-out;
      letter-spacing: 0.5px;
    }

    @keyframes pulseOrangeReal {
      0% { transform: scale(1); color: #ff9d00; border-color: #ff8000; box-shadow: inset 0 0 5px rgba(255, 128, 0, 0.5); }
      50% { transform: scale(1.08); color: #ffea00; border-color: #ffaa00; box-shadow: inset 0 0 8px rgba(255, 170, 0, 0.8), 0 0 10px rgba(255, 150, 0, 0.8); }
      100% { transform: scale(1); color: #ff9d00; border-color: #ff8000; box-shadow: inset 0 0 5px rgba(255, 128, 0, 0.5); }
    }

    /* BÁT / ĐĨA TRUNG TÂM */
    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 210px; height: 210px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 30px rgba(110, 105, 105, 0.829); z-index: 5;
      perspective: 800px; pointer-events: auto;
    }

    .theme-md5 .center-plate {
      background: radial-gradient(circle, #080304 0%, #222122a4 70%, #c7434c 100%);
      border: 4px solid #d93843;
    }

    .theme-thuong .center-plate {
      background: radial-gradient(circle, #05131a 0%, #31303194 70%, #1ea1be 100%);
      border: 4px solid #00d2ff;
    }

    /* ĐỒNG HỒ ĐẾM NGƯỢC */
    .timer-display {
      font-size: 62px; font-weight: 900; letter-spacing: -2px; z-index: 6;
      position: absolute; pointer-events: none; opacity: 0.9;
    }
    .theme-md5 .timer-display { color: #f4a261; text-shadow: 0 0 6px rgba(244,162,97,0.4); }
    .theme-thuong .timer-display { color: #e0aaff; text-shadow: 0 0 6px rgba(224,170,255,0.4); }

    /* NẮP / BÁT KÉO TỰ DO (NẶN) */
    .bowl-cover {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #3a3a3a 0%, #111111 70%, #000000 100%);
      border: 6px solid #b5838d;
      box-shadow: inset 0 0 15px rgba(255,255,255,0.2), 0 8px 25px rgba(0,0,0,0.9);
      z-index: 20; cursor: grab; display: none; justify-content: center; align-items: center;
      transition: opacity 0.3s ease;
      touch-action: none;
      will-change: transform;
    }

    .bowl-handle {
      width: 45px; height: 45px; border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #e0aaff, #5a189a);
      border: 2px solid #fff; box-shadow: 0 4px 8px rgba(0,0,0,0.8);
    }

    .bowl-cover:active { cursor: grabbing; }

    /* XÚC XẮC 3D LĂN ĐẢO NHANH THỰC TẾ */
    .dice-3d-arena { 
      position: absolute; width: 84px; height: 84px; z-index: 8; 
      transform-style: preserve-3d; display: none; 
    }

    .cube-wrapper { position: absolute; width: 36px; height: 36px; transform-style: preserve-3d; }
    #wrap1 { top: 6px; left: 24px; } 
    #wrap2 { bottom: 8px; left: 4px; } 
    #wrap3 { bottom: 8px; right: 4px; }

    .cube { 
      width: 100%; height: 100%; position: relative; 
      transform-style: preserve-3d; 
      transition: transform 0.6s cubic-bezier(0.2, 0.85, 0.32, 1.2); 
    }
    
    #cube1.rolling { animation: roll3DFast1 4s cubic-bezier(0.25, 1, 0.3, 1) forwards; }
    #cube2.rolling { animation: roll3DFast2 4s cubic-bezier(0.2, 0.9, 0.25, 1) forwards; }
    #cube3.rolling { animation: roll3DFast3 4s cubic-bezier(0.3, 1, 0.35, 1) forwards; }

    @keyframes roll3DFast1 {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      50% { transform: rotateX(2160deg) rotateY(1440deg) rotateZ(1080deg); }
      100% { transform: rotateX(4320deg) rotateY(2880deg) rotateZ(2160deg); }
    }

    @keyframes roll3DFast2 {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      50% { transform: rotateX(-1440deg) rotateY(2520deg) rotateZ(-1800deg); }
      100% { transform: rotateX(-2880deg) rotateY(5040deg) rotateZ(-3600deg); }
    }

    @keyframes roll3DFast3 {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      50% { transform: rotateX(1800deg) rotateY(-2160deg) rotateZ(2520deg); }
      100% { transform: rotateX(3600deg) rotateY(-4320deg) rotateZ(5040deg); }
    }

    .face {
      position: absolute; width: 36px; height: 36px; background: #d30505e0;
      border: 1px solid #f8f5f6e3; border-radius: 8px; display: grid;
      grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 2px; align-items: center; justify-items: center;
      box-shadow: inset 0 0 5px rgba(248, 248, 246, 0.89);
      backface-visibility: hidden;
    }

    .face-1 { transform: rotateY(0deg) translateZ(18px); }
    .face-6 { transform: rotateY(180deg) translateZ(18px); }
    .face-2 { transform: rotateY(-90deg) translateZ(18px); }
    .face-5 { transform: rotateY(90deg) translateZ(18px); }
    .face-3 { transform: rotateX(90deg) translateZ(18px); }
    .face-4 { transform: rotateX(-90deg) translateZ(18px); }

    .dot-pip { width: 6px; height: 6px; background: #f1eeeee5; border-radius: 50%; display: none; }
    .face-1 .dot-pip.red-giant { display: block; width: 14px; height: 14px; background: #f0efefe5; grid-column: 2; grid-row: 2; }
    .p1 { grid-column: 1; grid-row: 1; } .p3 { grid-column: 3; grid-row: 1; }
    .p4 { grid-column: 1; grid-row: 2; } .p5 { grid-column: 2; grid-row: 2; } .p6 { grid-column: 3; grid-row: 2; }
    .p7 { grid-column: 1; grid-row: 3; } .p9 { grid-column: 3; grid-row: 3; }

    .face-2 .p1, .face-2 .p9 { display: block; }
    .face-3 .p1, .face-3 .p5, .face-3 .p9 { display: block; }
    .face-4 .p1, .face-4 .p3, .face-4 .p7, .face-4 .p9 { display: block; }
    .face-5 .p1, .face-5 .p3, .face-5 .p5, .face-5 .p7, .face-5 .p9 { display: block; }
    .face-6 .p1, .face-6 .p3, .face-6 .p4, .face-6 .p6, .face-6 .p7, .face-6 .p9 { display: block; }

    /* NÂNG CẤP: BẢNG SOI CẦU THỰC TẾ LỒNG TRONG HÌNH TRÒN NHỎ - KÉO THẢ MƯỢT MÀ KHÔNG VƯỚNG */
    .roadmap-modal {
      position: fixed; width: 620px; height: 260px; background: rgba(15, 7, 28, 0.98);
      border: 3px solid #ffb703; border-radius: 16px; z-index: 500;
      display: none; flex-direction: column; padding: 10px;
      box-shadow: 0 0 35px rgba(255, 183, 3, 0.5); opacity: 0; transition: opacity 0.2s ease;
      touch-action: none; cursor: grab; user-select: none;
    }
    .roadmap-modal:active { cursor: grabbing; }
    .roadmap-modal.show { display: flex; opacity: 1; }

    .roadmap-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #7b2cbf; padding-bottom: 5px; }
    .roadmap-title { font-weight: 900; color: #ffb703; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }
    .roadmap-close { background: #ff2a2a; color: #fff; border: none; width: 24px; height: 24px; border-radius: 50%; font-weight: bold; cursor: pointer; }

    /* 5 Ô CỘT DỌC VUÔNG NÂU THỰC TẾ */
    .roadmap-grid-container {
      flex: 1; margin-top: 8px; background: #120904; border: 2px solid #5c2c0e; border-radius: 8px;
      display: grid; grid-template-columns: repeat(20, 1fr); grid-template-rows: repeat(5, 1fr);
      gap: 3px; padding: 5px; overflow-x: auto;
    }

    .roadmap-cell {
      background: #2a150a; border: 1px solid #3d1f0f; border-radius: 4px;
      display: flex; justify-content: center; align-items: center; width: 100%; height: 100%;
    }

    /* CHẤM TRÒN HIỆN SỐ TỔNG ĐIỂM THỰC TẾ */
    .dot-result {
      width: 24px; height: 24px; border-radius: 50%; display: flex; justify-content: center; align-items: center;
      font-size: 11px; font-weight: 900; color: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.8);
      animation: popInDot 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popInDot { 0% { transform: scale(0); } 100% { transform: scale(1); } }

    .dot-result.tai { background: radial-gradient(circle, #ff4d6d 0%, #800f2f 100%); border: 1px solid #ffea00; color: #fff; }
    .dot-result.xiu { background: radial-gradient(circle, #00b4d8 0%, #004080 100%); border: 1px solid #ffffff; color: #fff; }

    /* CHIP CƯỢC NEON XANH LÁ */
    .chip-bar-container {
      position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 5px; background: rgba(5, 20, 10, 0.95);
      border: 2px solid #ec6408; box-shadow: 0 0 15px rgba(88, 87, 86, 0.76);
      padding: 6px 12px; border-radius: 10px; z-index: 100;
      transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .chip-bar-container.hidden-bet {
      opacity: 0; pointer-events: none; transform: translateX(-50%) translateY(40px);
    }

    .chip-item-sq {
      width: 42px; height: 34px; border-radius: 6px;
      border: 1px solid #494745;
      background: linear-gradient(180deg, #0d381e 0%, #041f0f 100%);
      display: flex; justify-content: center; align-items: center; font-size: 11px;
      font-weight: 900; color: #52504f; cursor: pointer; text-shadow: 0 0 4px #5a5857;
      box-shadow: inset 0 0 5px rgba(128, 28, 123, 0.3); transition: transform 0.1s, background 0.2s;
    }
    .chip-item-sq:active { transform: scale(0.9); }
    .chip-item-sq.selected {
      background: linear-gradient(180deg, #00ff66 0%, #008033 100%);
      color: #000; text-shadow: none; border: 1px solid #fff;
      transform: translateY(-3px); box-shadow: 0 0 10px #00ff66;
    }

    .btn-chip-action { padding: 6px 12px; border-radius: 6px; border: none; font-weight: 900; font-size: 11px; cursor: pointer; }
    .btn-chip-confirm { background: linear-gradient(180deg, #ff9800, #b86b00); color: #fff; border: 1px solid #ffe066; }
    .btn-chip-cancel { background: linear-gradient(180deg, #d32f2f, #7b0000); color: #fff; border: 1px solid #ff8a8a; }

    /* CHAT BOX */
    .chat-box-real {
      position: absolute; right: 10px; top: 60px; width: 230px; height: 360px;
      background: rgba(10, 5, 20, 0.94); border: 1px solid #7b2cbf; border-radius: 8px;
      display: none; flex-direction: column; justify-content: space-between; padding: 8px; z-index: 101;
    }

    .chat-messages { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; font-size: 11px; }
    .chat-item { line-height: 1.3; }
    .chat-user { color: #e0aaff; font-weight: bold; }
    .chat-text { color: #fff; }

    .chat-input-row { display: flex; gap: 4px; margin-top: 5px; }
    .chat-input { flex: 1; background: #000; border: 1px solid #5a189a; border-radius: 4px; padding: 4px 8px; color: #fff; font-size: 11px; }
    .btn-send-chat { background: #7b2cbf; color: #fff; border: none; border-radius: 4px; padding: 4px 8px; font-weight: bold; cursor: pointer; }

    /* TOAST NOTIFICATION */
    .toast-msg {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-50px);
      background: rgba(10,4,20,0.95); border: 2px solid #9d4edd; color: #e0aaff;
      padding: 10px 24px; border-radius: 20px; font-weight: bold; font-size: 13px;
      z-index: 9999; opacity: 0; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none; box-shadow: 0 0 15px rgba(157, 78, 221, 0.5); text-align: center;
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* POPUP THẮNG CỘNG TIỀN */
    .win-popup {
      position: absolute; top: 20%; left: 50%; transform: translateX(-50%) scale(0);
      background: radial-gradient(circle, #e67309e8 0%, #e97f06e0 100%);
      border: 3px solid #fff; border-radius: 20px; padding: 15px 30px;
      color: #f1850a; font-weight: 900; text-align: center; z-index: 200;
      box-shadow: 0 0 40px #ffea00; opacity: 0; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
    }
    .win-popup.show { transform: translateX(-50%) scale(1); opacity: 1; }
    .win-popup-title { font-size: 18px; color: #fff; text-shadow: 0 1px 2px #000; }
    .win-popup-amount { font-size: 28px; color: #ffea00; text-shadow: 0 2px 5px #000; margin-top: 5px; }

    /* POPUP THUA CƯỢC */
    .lose-popup {
      position: absolute; top: 20%; left: 50%; transform: translateX(-50%) scale(0);
      background: radial-gradient(circle, #3a0007 0%, #1a0003 100%);
      border: 3px solid #ff2a2a; border-radius: 20px; padding: 15px 30px;
      color: #ff4d4d; font-weight: 900; text-align: center; z-index: 200;
      box-shadow: 0 0 40px #ff0000; opacity: 0; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
    }
    .lose-popup.show {
      transform: translateX(-50%) scale(1); opacity: 1;
      animation: loseShake 0.4s ease-in-out;
    }
    @keyframes loseShake {
      0%, 100% { transform: translateX(-50%) scale(1); }
      20%, 60% { transform: translateX(-53%) scale(1); }
      40%, 80% { transform: translateX(-47%) scale(1); }
    }
    .lose-popup-title { font-size: 18px; color: #ff3333; text-shadow: 0 1px 2px #000; }
    .lose-popup-desc { font-size: 14px; color: #ffb3b3; margin-top: 5px; }
  </style>
</head>
<body>

