    /* 3 VIÊN XÚC XẮC 3D */
    .dice-3d-arena { position: absolute; width: 90px; height: 90px; z-index: 8; transform-style: preserve-3d; display: none; }
    .cube-wrapper { position: absolute; width: 38px; height: 38px; transform-style: preserve-3d; }
    #wrap1 { top: 4px; left: 26px; }
    #wrap2 { bottom: 6px; left: 4px; }
    #wrap3 { bottom: 6px; right: 4px; }

    .cube { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.2, 0.85, 0.32, 1.2); }
    
    #cube1.rolling { animation: roll3DFast1 3.5s cubic-bezier(0.25, 1, 0.3, 1) forwards; }
    #cube2.rolling { animation: roll3DFast2 3.5s cubic-bezier(0.2, 0.9, 0.25, 1) forwards; }
    #cube3.rolling { animation: roll3DFast3 3.5s cubic-bezier(0.3, 1, 0.35, 1) forwards; }

    @keyframes roll3DFast1 {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      100% { transform: rotateX(4320deg) rotateY(2880deg) rotateZ(2160deg); }
    }
    @keyframes roll3DFast2 {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      100% { transform: rotateX(-2880deg) rotateY(5040deg) rotateZ(-3600deg); }
    }
    @keyframes roll3DFast3 {
      0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      100% { transform: rotateX(3600deg) rotateY(-4320deg) rotateZ(5040deg); }
    }

    .face {
      position: absolute; width: 38px; height: 38px; background: #d30505;
      border: 1.5px solid #ffffff; border-radius: 8px; display: grid;
      grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 3px; align-items: center; justify-items: center; backface-visibility: hidden;
      box-shadow: inset 0 0 6px rgba(255, 255, 255, 0.8);
    }
    .face-1 { transform: rotateY(0deg) translateZ(19px); }
    .face-6 { transform: rotateY(180deg) translateZ(19px); }
    .face-2 { transform: rotateY(-90deg) translateZ(19px); }
    .face-5 { transform: rotateY(90deg) translateZ(19px); }
    .face-3 { transform: rotateX(90deg) translateZ(19px); }
    .face-4 { transform: rotateX(-90deg) translateZ(19px); }

    .dot-pip { width: 6px; height: 6px; background: #ffffff; border-radius: 50%; display: none; }
    .face-1 .dot-pip.red-giant { display: block; width: 14px; height: 14px; background: #ffffff; grid-column: 2; grid-row: 2; }
    .p1 { grid-column: 1; grid-row: 1; } .p3 { grid-column: 3; grid-row: 1; }
    .p4 { grid-column: 1; grid-row: 2; } .p5 { grid-column: 2; grid-row: 2; } .p6 { grid-column: 3; grid-row: 2; }
    .p7 { grid-column: 1; grid-row: 3; } .p9 { grid-column: 3; grid-row: 3; }

    .face-2 .p1, .face-2 .p9 { display: block; }
    .face-3 .p1, .face-3 .p5, .face-3 .p9 { display: block; }
    .face-4 .p1, .face-4 .p3, .face-4 .p7, .face-4 .p9 { display: block; }
    .face-5 .p1, .face-5 .p3, .face-5 .p5, .face-5 .p7, .face-5 .p9 { display: block; }
    .face-6 .p1, .face-6 .p3, .face-6 .p4, .face-6 .p6, .face-6 .p7, .face-6 .p9 { display: block; }

    /* THANH CHIP CƯỢC */
    .chip-bar-container {
