      </div>

      <div class="form-group">
        <label class="form-label">Nhập số tiền cược</label>
        <input type="number" class="form-input" id="bet-input-amount" placeholder="0">
      </div>

      <div class="bet-quick-btns">
        <div class="btn-quick" onclick="addBetAmount(10000)">10K</div>
        <div class="btn-quick" onclick="addBetAmount(50000)">50K</div>
        <div class="btn-quick" onclick="addBetAmount(100000)">100K</div>
        <div class="btn-quick" onclick="addBetAmount(500000)">500K</div>
        <div class="btn-quick" onclick="addBetAmount(1000000)">1M</div>
        <div class="btn-quick" onclick="addBetAmount(5000000)">5M</div>
      </div>

      <button class="btn-submit-action" onclick="submitBet()">XÁC NHẬN CƯỢC</button>
    </div>
  </div>

  <!-- MODAL NẠP TIỀN -->
  <div class="modal-overlay" id="nap-modal">
    <div class="general-card">
      <div class="card-header">
        <span class="card-title-text">CỔNG NẠP TIỀN TỰ ĐỘNG</span>
        <button class="btn-close-modal" onclick="closeModal('nap-modal')">✕</button>
      </div>
      <div style="text-align:center; padding: 20px;">
        <p style="color:#ffd700; font-weight:bold;">Nạp tiền qua Ngân Hàng / Momo tự động 100%</p>
      </div>
      <button class="btn-submit-action" onclick="closeModal('nap-modal'); showToast('Nạp thành công +10,000,000đ!'); userBalance += 10000000; updateBalanceUI();">NẠP NHANH 10M</button>
    </div>
  </div>

  <script>
    // System State
    let userBalance = 57300755;
    let currentSideChoice = '';
    let myBets = { TAI: 0, XIU: 0 };
    let timerValue = 45;
    let isRolling = false;
    let currentDiceResult = [1, 2, 3];

    // Toạ độ góc quay chính xác 100% cho từng mặt nút xúc xắc vuông vức
    const rotationMap = {
      1: { x: 0, y: 0 },
      6: { x: 0, y: 180 },
      2: { x: 0, y: 90 },
      5: { x: 0, y: -90 },
      3: { x: -90, y: 0 },
      4: { x: 90, y: 0 }
    };

    // Fast Game Loading Screen Sequence
    window.addEventListener('DOMContentLoaded', () => {
      let progress = 1;
      const fill = document.getElementById('loader-fill');
      const text = document.getElementById('loader-text');
      const timer = setInterval(() => {
        progress += Math.floor(Math.random() * 8) + 3;
        if (progress >= 100) {
          progress = 100;
          clearInterval(timer);
          setTimeout(() => {
            document.getElementById('loading-screen').classList.remove('active');
            document.getElementById('lobby-screen').classList.add('active');
          }, 300);
        }
        fill.style.width = progress + '%';
        text.innerText = `Đang tải tài nguyên ${progress}%...`;
      }, 40);

      startGlobalGameLoop();
    });

    // Helper Toast Msg
    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }

    // Modal Handlers
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    function openNapModal() { document.getElementById('nap-modal').style.display = 'flex'; }
    function openRutModal() { showToast('Tính năng Rút Tiền đang hoạt động tốt!'); }
    function openUserModal() { showToast('Thông tin người chơi VIP 6'); }

    function updateBalanceUI() {
      const formatted = userBalance.toLocaleString('en-US');
      document.getElementById('user-balance').innerText = formatted;
      document.getElementById('arena-balance').innerText = formatted;
    }

    // Cổng Game Arena Transition
    function enterArena(gameType) {
      document.getElementById('lobby-screen').classList.remove('active');
      const arena = document.getElementById('arena-screen');
      arena.style.display = 'flex';
      setTimeout(() => arena.classList.add('active'), 10);

      if (gameType === 'HOT_TAIXIU') {
        arena.classList.add('hot-theme');
        document.getElementById('arena-title-text').innerText = 'SẢNH HOT TÀI XỈU 3D';
      } else {
        arena.classList.remove('hot-theme');
        document.getElementById('arena-title-text').innerText = 'SẢNH TÀI XỈU MD5 REAL 3D';
      }
    }

    function exitArena() {
      const arena = document.getElementById('arena-screen');
      arena.classList.remove('active');
      setTimeout(() => {
        arena.style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    function toggleCamera3D() {
      document.getElementById('arena-stage').classList.toggle('pan-angle');
    }

    // Bet Processing
    function openBetModal(side) {
      if (timerValue <= 5) {
        showToast('Hết thời gian cược phiên này!');
        return;
      }
      currentSideChoice = side;
      document.getElementById('bet-modal-title').innerText = 'CƯỢC ' + side;
      document.getElementById('bet-input-amount').value = '';
      document.getElementById('bet-modal').style.display = 'flex';
    }

    function addBetAmount(val) {
      const inp = document.getElementById('bet-input-amount');
      inp.value = (parseInt(inp.value || 0) + val);
    }

    function submitBet() {
      const amount = parseInt(document.getElementById('bet-input-amount').value || 0);
      if (amount <= 0) return showToast('Vui lòng nhập số tiền hợp lệ!');
      if (amount > userBalance) return showToast('Số dư không đủ!');

      userBalance -= amount;
      myBets[currentSideChoice === 'TÀI' ? 'TAI' : 'XIU'] += amount;
      updateBalanceUI();

      if (currentSideChoice === 'TÀI') {
        document.getElementById('my-tai-bet').style.display = 'block';
        document.getElementById('my-tai-bet').innerText = 'Đã cược: ' + myBets.TAI.toLocaleString('en-US');
      } else {
        document.getElementById('my-xiu-bet').style.display = 'block';
        document.getElementById('my-xiu-bet').innerText = 'Đã cược: ' + myBets.XIU.toLocaleString('en-US');
      }

      closeModal('bet-modal');
      showToast(`Cược thành công ${amount.toLocaleString('en-US')}đ vào cửa ${currentSideChoice}`);
    }

    // Thiết lập góc quay 3D chính xác 100% cho Cube
    function setCubeFace(cubeId, value) {
      const cube = document.getElementById(cubeId);
      const rot = rotationMap[value];
      // Cộng thêm các vòng quay 360 độ ngẫu nhiên trước đó để tạo độ tự nhiên
      cube.style.transform = `rotateX(${rot.x + 1440}deg) rotateY(${rot.y + 1440}deg) rotateZ(0deg)`;
    }

    // Game Loop - Đồng Bộ Phiên Thực Tế
    function startGlobalGameLoop() {
      setInterval(() => {
        timerValue--;

        // Cập nhật đếm ngược hiển thị ở trong Bàn và cả Ô cược Ngoài Sảnh
        const formattedTime = (timerValue < 10 ? '0' : '') + timerValue;
        document.getElementById('timer').innerText = formattedTime;
        document.getElementById('lobby-time-1').innerText = '00:' + formattedTime;
        document.getElementById('lobby-time-2').innerText = '00:' + formattedTime;

        // Bắt đầu hiệu ứng lăn đảo cuộn nhanh 3D trước khi kết thúc
        if (timerValue === 5 && !isRolling) {
          isRolling = true;
          showToast('Hệ thống đang lắc xúc xắc 3D...');
          document.getElementById('cube1').classList.add('rolling');
          document.getElementById('cube2').classList.add('rolling');
          document.getElementById('cube3').classList.add('rolling');
        }

        // Kết thúc phiên cược -> Trả kết quả chuẩn xác
        if (timerValue <= 0) {
          timerValue = 45;
          isRolling = false;

          // Tạo kết quả ngẫu nhiên 3D
          const d1 = Math.floor(Math.random() * 6) + 1;
          const d2 = Math.floor(Math.random() * 6) + 1;
          const d3 = Math.floor(Math.random() * 6) + 1;
          currentDiceResult = [d1, d2, d3];
          const total = d1 + d2 + d3;
          const resultSide = total >= 11 ? 'TAI' : 'XIU';

          // Dừng Animation Lăn Đảo
          const c1 = document.getElementById('cube1');
          const c2 = document.getElementById('cube2');
          const c3 = document.getElementById('cube3');

          c1.classList.remove('rolling');
          c2.classList.remove('rolling');
          c3.classList.remove('rolling');

          // Xoay 3D chính xác vuông vức 100%
          setCubeFace('cube1', d1);
          setCubeFace('cube2', d2);
          setCubeFace('cube3', d3);

          // Phát hiệu ứng Thắng cược & Thông báo thực tế vài giây
          setTimeout(() => {
            const resultText = `${d1} - ${d2} - ${d3} (${total} Nút) ► ${resultSide === 'TAI' ? 'TÀI' : 'XỈU'}`;
            showToast('KẾT QUẢ: ' + resultText);

            // Bật hiệu ứng phát sáng ô thắng cược
            const winSideElem = document.getElementById(resultSide === 'TAI' ? 'side-tai' : 'side-xiu');
            winSideElem.classList.add('active-win');

            // Tính tiền thưởng nếu thắng
            const wonMoney = myBets[resultSide] * 1.98;
            if (wonMoney > 0) {
              userBalance += wonMoney;
              updateBalanceUI();

              // Hiện Banner Thắng Lớn
              const winBanner = document.getElementById('win-banner');
              document.getElementById('win-money-text').innerText = '+' + wonMoney.toLocaleString('en-US') + 'đ';
              winBanner.classList.add('show');
              setTimeout(() => winBanner.classList.remove('show'), 3500);
            }

            // Reset trạng thái sau 4 giây
            setTimeout(() => {
              winSideElem.classList.remove('active-win');
              myBets = { TAI: 0, XIU: 0 };
              document.getElementById('my-tai-bet').style.display = 'none';
              document.getElementById('my-xiu-bet').style.display = 'none';
            }, 4000);

          }, 300);
        }

        // Tạo biến động số tiền đặt cược ngẫu nhiên cho chân thực
        if (timerValue > 5) {
          const addTai = Math.floor(Math.random() * 3000000);
          const addXiu = Math.floor(Math.random() * 3000000);
          
          const tElem = document.getElementById('tai-amount');
          const xElem = document.getElementById('xiu-amount');
          
          const currT = parseInt(tElem.innerText.replace(/,/g, '')) + addTai;
          const currX = parseInt(xElem.innerText.replace(/,/g, '')) + addXiu;
          
          tElem.innerText = currT.toLocaleString('en-US');
          xElem.innerText = currX.toLocaleString('en-US');

          document.getElementById('lobby-tai-1').innerText = (currT / 1000000).toFixed(0) + 'M';
          document.getElementById('lobby-xiu-1').innerText = (currX / 1000000).toFixed(0) + 'M';
        }

      }, 1000);
    }
  </script>
</body>
