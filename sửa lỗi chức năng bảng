      { phien: 5119, time: '28-04-2026 00:26', cuoc: 100000000, win: -100000000, detail: 'Đặt Xỉu Kết quả 3-4-4 Tài, Tổng đặt 100,000,000 Hoàn trả 0, Nhận 0' },
      { phien: 5117, time: '28-04-2026 00:24', cuoc: 69600000, win: -69600000, detail: 'Đặt Tài Kết quả 2-4-4 Xỉu, Tổng đặt 69,600,000 Hoàn trả 0, Nhận 0' },
      { phien: 5116, time: '28-04-2026 00:23', cuoc: 10000000, win: 19800000, detail: 'Đặt Xỉu Kết quả 2-1-4 Xỉu, Tổng đặt 10,000,000 Hoàn trả 0, Nhận 19,800,000' }
