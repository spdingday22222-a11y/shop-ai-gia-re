          clearInterval(interval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
        }
      }, 30);

      initBoardDragLogic();
      initBowlDragLogic();
      startFakeBotChat();
    };

    /* THÔNG BÁO TOAST THỰC TẾ */
    function showToast(msg, duration = 2500) {
      let t = document.getElementById('toast');
      t.innerText = msg;
      t.classList.add('show');
      
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        t.classList.remove('show');
      }, duration);
    }

    function formatNumber(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function formatShortMoney(num) {
      if (num >= 1000000) return (num / 1000000) + 'M';
      if (num >= 1000) return (num / 1000) + 'K';
      return num;
    }

    function updateDisplays() {
      document.getElementById('user-balance').innerText = '$ ' + formatNumber(userBalance);
      document.getElementById('arena-balance').innerText = '$ ' + formatNumber(userBalance);
      document.getElementById('tai-amount').innerText = formatNumber(taiMoney);
      document.getElementById('xiu-amount').innerText = formatNumber(xiuMoney);
      document.getElementById('tai-players').innerText = taiUsers;
      document.getElementById('xiu-players').innerText = xiuUsers;

      document.getElementById('val-TAI').innerText = currentBetTAI > 0 ? formatShortMoney(currentBetTAI) : '0';
      document.getElementById('val-XIU').innerText = currentBetXIU > 0 ? formatShortMoney(currentBetXIU) : '0';
    }

    /* VÀO / RỜI SẢNH GAME */
    function enterArena(mode) {
      currentMode = mode;
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);

      let board = document.getElementById('main-board');
      let title = document.getElementById('arena-title');

      if (mode === 'MD5') {
        board.className = "real-taixiu-board theme-md5";
        title.innerText = "TÀI XỈU MD5";
        title.style.color = "#ffd700";
      } else {
        board.className = "real-taixiu-board theme-thuong";
        title.innerText = "TÀI XỈU THƯỜNG";
        title.style.color = "#00d2ff";
      }

      resetArenaBoardPosition();
      startGameTimer();
      updateDisplays();
    }

    function exitArena() {
      if (timerInterval) clearInterval(timerInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    /* ĐẾM NGƯỢC THỜI GIAN & CHÍNH SÁCH LẮC CƯỢC THỰC TẾ */
    function startGameTimer() {
      if (timerInterval) clearInterval(timerInterval);
      countdown = 26;
      isBowlOpened = false;

      // Ẩn/Hiện thành phần
      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('bowl-cover').style.display = 'none';
      document.getElementById('title-TAI').classList.remove('blink-winner');
      document.getElementById('title-XIU').classList.remove('blink-winner');

      timerInterval = setInterval(() => {
        countdown--;
        if (countdown >= 0) {
          document.getElementById('timer-text').innerText = countdown;

          // Giả lập nhảy tổng tiền & số người cược sống động
          if (countdown > 5) {
            let addT = Math.floor(Math.random() * 500000) + 50000;
            let addX = Math.floor(Math.random() * 500000) + 50000;
            taiMoney += addT;
            xiuMoney += addX;
            if (Math.random() > 0.6) taiUsers += Math.floor(Math.random() * 2) + 1;
            if (Math.random() > 0.6) xiuUsers += Math.floor(Math.random() * 2) + 1;

            let elemT = document.getElementById('tai-amount');
            let elemX = document.getElementById('xiu-amount');
            elemT.classList.add('bump-orange');
            elemX.classList.add('bump-orange');
            setTimeout(() => {
              elemT.classList.remove('bump-orange');
              elemX.classList.remove('bump-orange');
            }, 400);

            updateDisplays();
          }
        }

        if (countdown === 5) {
          // Hết giờ cược - Ẩn thanh chip
          cancelBet();
          showToast('Hết thời gian đặt cược!', 2000);
        }

        if (countdown === 0) {
          // Thực hiện Lắc Xí Ngầu
          rollDice3D();
        }

        if (countdown < -10) {
          // Khởi tạo phiên mới
          startGameTimer();
        }
      }, 1000);
    }

    /* QUAY XÚC XẮC 3D VÀ XỬ LÝ KẾT QUẢ */
    function rollDice3D() {
      document.getElementById('timer-text').style.display = 'none';
      let diceBox = document.getElementById('dice-container');
      diceBox.style.display = 'block';

      let cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];
      cubes.forEach(c => c.classList.add('rolling'));

      // Tạo ngẫu nhiên 3 mặt xúc xắc (1-6)
      diceResults = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];

      setTimeout(() => {
        cubes.forEach(c => c.classList.remove('rolling'));
        setCubeFaces(cubes[0], diceResults[0]);
        setCubeFaces(cubes[1], diceResults[1]);
        setCubeFaces(cubes[2], diceResults[2]);

        if (isSqueezeMode) {
          // Đậy bát lại để người chơi nặn
          let bowl = document.getElementById('bowl-cover');
          bowl.style.display = 'flex';
          bowl.style.top = '0px';
          bowl.style.left = '0px';
          bowl.style.opacity = '1';
          showToast('Mời bạn kéo bát để NẶN!', 2500);
        } else {
          // Mở thưởng trực tiếp
          finishRoundAndShowWinner();
        }
      }, 1200);
    }

    function setCubeFaces(cube, val) {
      let rotations = {
        1: 'rotateY(0deg)',
        6: 'rotateY(-180deg)',
        2: 'rotateY(90deg)',
        5: 'rotateY(-90deg)',
        3: 'rotateX(-90deg)',
        4: 'rotateX(90deg)'
      };
      cube.style.transform = rotations[val];
    }

    function finishRoundAndShowWinner() {
      if (isBowlOpened) return;
      isBowlOpened = true;

      let sum = diceResults.reduce((a, b) => a + b, 0);
      let isTai = sum >= 11 && sum <= 17;

      // Nhấp nháy bên thắng
      if (isTai) {
        document.getElementById('title-TAI').classList.add('blink-winner');
      } else {
        document.getElementById('title-XIU').classList.add('blink-winner');
      }

      // Xử lý cộng tiền cho User
      let winAmount = 0;
      if (isTai && currentBetTAI > 0) winAmount = currentBetTAI * 2;
      if (!isTai && currentBetXIU > 0) winAmount = currentBetXIU * 2;

      if (winAmount > 0) {
        userBalance += winAmount;
        updateDisplays();
        showWinPopup(winAmount);
      }

      // Thêm điểm vào lịch sử
      addHistoryDot(isTai ? 'tai' : 'xiu');

      // Reset tiền cược cá nhân cho phiên tới
      currentBetTAI = 0;
      currentBetXIU = 0;
      updateDisplays();
    }

    function showWinPopup(amt) {
      let pop = document.getElementById('win-popup');
      document.getElementById('win-amount-text').innerText = '+ ' + formatNumber(amt);
      pop.classList.add('show');

      if (winPopupTimeout) clearTimeout(winPopupTimeout);
      winPopupTimeout = setTimeout(() => {
        pop.classList.remove('show');
      }, 7000); // Tự động ẩn sau 7 giây
    }

    function addHistoryDot(type) {
      let box = document.getElementById('history-dots');
      let d = document.createElement('div');
      d.className = 'dot ' + type;
      box.appendChild(d);
      if (box.children.length > 12) box.removeChild(box.children[0]);
    }

    /* NÚT TÁC VỤ ĐẶT CƯỢC & TÍNH NĂNG CHIP */
    function activateBetSide(side) {
      if (countdown <= 5) {
        showToast('Đã hết thời gian đặt cược phiên này!');
        return;
      }

      selectedSide = side;
      pendingBetAmount = 0;
      document.getElementById('btn-bet-TAI').classList.remove('active-bet');
      document.getElementById('btn-bet-XIU').classList.remove('active-bet');
      document.getElementById('btn-bet-' + side).classList.add('active-bet');

      document.getElementById('chip-bar').classList.remove('hidden-bet');
    }

    function addChipValue(val, elem) {
      if (!selectedSide) return;
      if (elem) {
        document.querySelectorAll('.chip-item-sq').forEach(el => el.classList.remove('selected'));
        elem.classList.add('selected');
      }
      currentChipVal = val;
      pendingBetAmount += val;

      if (selectedSide === 'TAI') {
        document.getElementById('val-TAI').innerText = formatShortMoney(currentBetTAI + pendingBetAmount);
      } else {
        document.getElementById('val-XIU').innerText = formatShortMoney(currentBetXIU + pendingBetAmount);
      }
    }

    function confirmBet() {
      if (!selectedSide || pendingBetAmount <= 0) return;

      if (pendingBetAmount > userBalance) {
        showToast('Số dư tài khoản không đủ!');
        return;
      }

      userBalance -= pendingBetAmount;
      if (selectedSide === 'TAI') {
        currentBetTAI += pendingBetAmount;
        taiMoney += pendingBetAmount;
      } else {
        currentBetXIU += pendingBetAmount;
        xiuMoney += pendingBetAmount;
      }

      showToast('Đặt cược thành công ' + formatNumber(pendingBetAmount) + 'đ');
      pendingBetAmount = 0;
      document.getElementById('chip-bar').classList.add('hidden-bet');
      document.getElementById('btn-bet-TAI').classList.remove('active-bet');
      document.getElementById('btn-bet-XIU').classList.remove('active-bet');
      updateDisplays();
    }

    function cancelBet() {
      pendingBetAmount = 0;
      selectedSide = null;
      document.getElementById('chip-bar').classList.add('hidden-bet');
      document.getElementById('btn-bet-TAI').classList.remove('active-bet');
      document.getElementById('btn-bet-XIU').classList.remove('active-bet');
      updateDisplays();
    }

    function doAllIn(side) {
      if (countdown <= 5) {
        showToast('Đã hết thời gian đặt cược!');
        return;
      }
      if (userBalance <= 0) {
        showToast('Số dư không đủ để All-in!');
        return;
      }

      selectedSide = side;
      pendingBetAmount = userBalance;
      confirmBet();
    }

    /* BẬT / TẮT CHẾ ĐỘ NẶN BÁT */
    function toggleSqueezeMode() {
      isSqueezeMode = !isSqueezeMode;
      let btn = document.getElementById('btn-squeeze-toggle');
      if (isSqueezeMode) {
        btn.classList.add('active-squeeze');
        showToast('Đã BẬT chế độ Nặn bát 🖐️');
      } else {
        btn.classList.remove('active-squeeze');
        showToast('Đã TẮT chế độ Nặn bát');
      }
    }

    /* KÉO THẢ TỰ DO BÀN CHƠI TÀI XỈU */
    function initBoardDragLogic() {
      let board = document.getElementById('main-board');
      let isDragging = false;
      let startX, startY, initialLeft, initialTop;

      board.addEventListener('mousedown', startDrag);
      board.addEventListener('touchstart', startDrag, { passive: false });

      function startDrag(e) {
        // Tránh kéo bàn khi ấn vào nút bấm hoặc vùng cược
        if (e.target.closest('.circle-btn') || e.target.closest('.bet-side') || e.target.closest('.center-plate')) return;
        
        isDragging = true;
        let p = e.touches ? e.touches[0] : e;
        startX = p.clientX;
        startY = p.clientY;
        initialLeft = board.offsetLeft;
        initialTop = board.offsetTop;

        document.addEventListener('mousemove', onDrag);
        document.addEventListener('touchmove', onDrag, { passive: false });
        document.addEventListener('mouseup', stopDrag);
        document.addEventListener('touchend', stopDrag);
      }

      function onDrag(e) {
        if (!isDragging) return;
        if (e.cancelable) e.preventDefault();
        let p = e.touches ? e.touches[0] : e;
        let dx = p.clientX - startX;
        let dy = p.clientY - startY;

        board.style.left = (initialLeft + dx) + 'px';
        board.style.top = (initialTop + dy) + 'px';
      }

      function stopDrag() {
        isDragging = false;
        document.removeEventListener('mousemove', onDrag);
        document.removeEventListener('touchmove', onDrag);
        document.removeEventListener('mouseup', stopDrag);
        document.removeEventListener('touchend', stopDrag);
      }
    }

    function resetArenaBoardPosition() {
      let board = document.getElementById('main-board');
      board.style.left = 'calc(50% - 360px)';
      board.style.top = 'calc(50% - 175px)';
    }

    /* KÉO NẶN BÁT TỰ DO KHẮP MÀN HÌNH */
    function initBowlDragLogic() {
      let bowl = document.getElementById('bowl-cover');
      let isDragging = false;
      let startX, startY, initialLeft, initialTop;

      bowl.addEventListener('mousedown', startBowlDrag);
      bowl.addEventListener('touchstart', startBowlDrag, { passive: false });

      function startBowlDrag(e) {
        isDragging = true;
        let p = e.touches ? e.touches[0] : e;
        startX = p.clientX;
        startY = p.clientY;
        initialLeft = bowl.offsetLeft;
        initialTop = bowl.offsetTop;

        document.addEventListener('mousemove', onBowlDrag);
        document.addEventListener('touchmove', onBowlDrag, { passive: false });
        document.addEventListener('mouseup', stopBowlDrag);
        document.addEventListener('touchend', stopBowlDrag);
      }

      function onBowlDrag(e) {
        if (!isDragging) return;
        if (e.cancelable) e.preventDefault();
        let p = e.touches ? e.touches[0] : e;
        let dx = p.clientX - startX;
        let dy = p.clientY - startY;

        let curL = initialLeft + dx;
        let curT = initialTop + dy;
        bowl.style.left = curL + 'px';
        bowl.style.top = curT + 'px';

        // Tính khoảng cách đã kéo mở nắp
        let distance = Math.sqrt(curL * curL + curT * curT);
        if (distance > 110) {
          bowl.style.opacity = '0';
          setTimeout(() => {
            bowl.style.display = 'none';
            finishRoundAndShowWinner();
          }, 200);
          stopBowlDrag();
        }
      }

      function stopBowlDrag() {
        isDragging = false;
        document.removeEventListener('mousemove', onBowlDrag);
        document.removeEventListener('touchmove', onBowlDrag);
        document.removeEventListener('mouseup', stopBowlDrag);
        document.removeEventListener('touchend', stopBowlDrag);
      }
    }

    /* ẨN/HIỆN CHAT BÊN PHẢI */
    function toggleChat() {
      let box = document.getElementById('chat-box');
      box.style.display = (box.style.display === 'none') ? 'flex' : 'none';
    }

    function sendChat() {
      let input = document.getElementById('chat-input-field');
      let msg = input.value.trim();
      if (!msg) return;

      appendChatMessage('hilohi123', msg);
      input.value = '';
    }

    function appendChatMessage(user, text) {
      let list = document.getElementById('chat-msg-list');
      let item = document.createElement('div');
      item.className = 'chat-item';
      item.innerHTML = `<span class="chat-user">${user}:</span> <span class="chat-text">${text}</span>`;
      list.appendChild(item);
      list.scrollTop = list.scrollHeight;
    }

