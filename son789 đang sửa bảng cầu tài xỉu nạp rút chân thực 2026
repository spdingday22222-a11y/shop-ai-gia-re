              <div class="form-group"><label>Số Tài Khoản Nhận:</label><input class="form-control" placeholder="Nhập số tài khoản..."></div>
              <div class="form-group"><label>Tên Tên Chủ TKNH:</label><input class="form-control" placeholder="TÊN VIẾT HOA KHÔNG DẤU"></div>
            </div>
            <div>
              <div class="form-group"><label>Số Tiền Rút (VNĐ):</label><input type="number" class="form-control" id="rut-amount-input" placeholder="Số tiền rút tối thiểu 200,000"></div>
              <div style="margin-top: 15px; color:#aaa; font-size:11px;">Số dư hiện tại: <strong style="color:#ffea00;">${fmtNum(userBalance)} đ</strong></div>
              <button class="btn-submit-nap btn-submit-rut" onclick="processRutMoney()">GỬI YÊU CẦU RÚT TIỀN</button>
            </div>
          </div>
        `;
      } else if (tabName === 'ĐỔI THẺ CÀO') {
        body.innerHTML = `
          <div class="nap-notice" style="color:#00f0ff">* ĐỔI THƯỞNG MÃ THẺ CÀO TỰ ĐỘNG *</div>
          <div class="nap-grid">
            <div>
              <div class="form-group"><label>Chọn Nhà Mạng:</label><select class="form-control"><option>VIETTEL</option><option>VINAPHONE</option><option>MOBIFONE</option></select></div>
              <div class="form-group"><label>Chọn Mệnh Giá Thẻ:</label><select class="form-control" id="rut-card-val"><option value="100000">100,000 đ</option><option value="200000">200,000 đ</option><option value="500000">500,000 đ</option></select></div>
            </div>
            <div style="display:flex; flex-direction:column; justify-content:flex-end;">
              <button class="btn-submit-nap btn-submit-rut" onclick="processRutCard()">ĐỔI THẺ NGAY</button>
            </div>
          </div>
        `;
      } else {
        let rows = withdrawHistory.map(w => `
          <tr>
            <td>${w.id}</td>
            <td>${w.time}</td>
            <td class="txt-red">-${fmtNum(w.amount)} đ</td>
            <td>${w.bank}</td>
            <td class="txt-green">${w.status}</td>
          </tr>
        `).join('');
        body.innerHTML = `
          <div style="max-height: 250px; overflow-y: auto;">
            <table class="bet-history-table">
              <thead><tr><th>Mã GD</th><th>Thời Gian</th><th>Số Tiền</th><th>Cổng Nhận</th><th>Trạng Thái</th></tr></thead>
              <tbody>${rows}</tbody>
            </table>
          </div>
        `;
      }
    }

    // Logic Nạp & Rút
    function processNapMoney() {
      let val = parseInt(document.getElementById('nap-amount-input').value) || 0;
      if (val < 50000) return showToast('Số tiền nạp tối thiểu là 50,000 đ!');
      showToast('Đang kết nối cổng ngân hàng...');
      setTimeout(() => {
        userBalance += val;
        updateBalanceDisplay();
        closeModal('modal-nap-rut');
        showToast(`Nạp thành công +${fmtNum(val)} đ vào tài khoản!`, 3000);
      }, 2000);
    }

    function processNapCard() {
      let val = parseInt(document.getElementById('card-val-sel').value) || 0;
      showToast('Đang gạch thẻ tự động...');
      setTimeout(() => {
        userBalance += val;
        updateBalanceDisplay();
        closeModal('modal-nap-rut');
        showToast(`Nạp thẻ thành công +${fmtNum(val)} đ!`, 3000);
      }, 2000);
    }

    function processRutMoney() {
      let val = parseInt(document.getElementById('rut-amount-input').value) || 0;
      if (val < 200000) return showToast('Rút tối thiểu 200,000 đ!');
      if (val > userBalance) return showToast('Số dư tài khoản không đủ!');
      showToast('Đang khởi tạo lệnh rút tiền...');
      setTimeout(() => {
        userBalance -= val;
        updateBalanceDisplay();
        withdrawHistory.unshift({ id: 'WD' + Math.floor(1000 + Math.random()*9000), time: 'Mới xong', amount: val, bank: 'Chuyển Khoản Ngân Hàng', status: 'Thành công' });
        closeModal('modal-nap-rut');
        showToast(`Rút tiền thành công -${fmtNum(val)} đ! Tiền sẽ về trong vài giây.`, 3000);
      }, 2500);
    }

    function processRutCard() {
      let val = parseInt(document.getElementById('rut-card-val').value) || 0;
      if (val > userBalance) return showToast('Số dư tài khoản không đủ!');
      showToast('Đang quy đổi thẻ cào...');
      setTimeout(() => {
        userBalance -= val;
        updateBalanceDisplay();
        closeModal('modal-nap-rut');
        showToast(`Đã đổi thẻ cào thành công mệnh giá ${fmtNum(val)} đ!`, 3000);
      }, 2000);
    }

    // GAME ARENA LOGIC
    function enterArena(mode) {
      currentMode = mode;
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);

      let board = document.getElementById('main-board');
      let title = document.getElementById('arena-title');

      if(mode === 'MD5') {
        title.innerText = 'TÀI XỈU MD5 - SỐ ' + sessionMD5;
        board.className = 'real-taixiu-board theme-md5';
      } else {
        title.innerText = 'TÀI XỈU CÂN CỬA - SỐ ' + sessionThuong;
        board.className = 'real-taixiu-board theme-thuong';
      }

      startNewRound();
    }

    function exitArena() {
      if(gameInterval) clearInterval(gameInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => document.getElementById('arena-screen').style.display = 'none', 300);
      document.getElementById('lobby-screen').classList.add('active');
    }

    function startNewRound() {
      if(gameInterval) clearInterval(gameInterval);
      timerValue = 30;
      document.getElementById('timer-text').innerText = timerValue;
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('bowl-cover').style.display = 'none';
      
      // Reset Bet Highlights
      document.getElementById('title-TAI').classList.remove('blink-winner');
      document.getElementById('title-XIU').classList.remove('blink-winner');
      confirmedBets = { TAI: 0, XIU: 0 };
      document.getElementById('val-TAI').innerText = '0';
      document.getElementById('val-XIU').innerText = '0';

      gameInterval = setInterval(() => {
        timerValue--;
        document.getElementById('timer-text').innerText = timerValue;

        // Randomly simulate other players betting
        if(timerValue > 5) {
          let tAmt = parseInt(document.getElementById('tai-amount').innerText.replace(/\./g,'')) + Math.floor(Math.random()*5000000);
          let xAmt = parseInt(document.getElementById('xiu-amount').innerText.replace(/\./g,'')) + Math.floor(Math.random()*5000000);
          document.getElementById('tai-amount').innerText = fmtNum(tAmt);
          document.getElementById('xiu-amount').innerText = fmtNum(xAmt);
        }

        if(timerValue === 5) {
          showToast('Khóa cổng cược! Đang lắc xúc xắc...', 1500);
          document.getElementById('chip-bar').classList.add('hidden-bet');
        }

        if(timerValue <= 0) {
          clearInterval(gameInterval);
          finishRoundAndShowResult();
        }
      }, 1000);
    }

    function handleBetClick(side) {
      if (timerValue <= 5) return showToast('Đã hết thời gian đặt cược!');
      activeBetSide = side;
      document.getElementById('chip-bar').classList.remove('hidden-bet');
      showToast('Chọn mệnh giá chip cược bên dưới', 1000);
    }

    function selectChip(val, el) {
      document.querySelectorAll('.chip-item-sq').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      selectedChipVal = val;
    }

    function confirmBet() {
      if(!activeBetSide || selectedChipVal <= 0) return showToast('Vui lòng chọn chip cược!');
      if(userBalance < selectedChipVal) return showToast('Số dư tài khoản không đủ!');

      userBalance -= selectedChipVal;
      confirmedBets[activeBetSide] += selectedChipVal;
      document.getElementById('val-' + activeBetSide).innerText = fmtNum(confirmedBets[activeBetSide]);
      updateBalanceDisplay();
      showToast(`Đã cược ${fmtNum(selectedChipVal)} đ vào cửa ${activeBetSide}`);
    }

    function cancelBet() {
      document.getElementById('chip-bar').classList.add('hidden-bet');
      activeBetSide = null;
    }

    function doAllIn(side) {
      if (timerValue <= 5) return showToast('Đã hết thời gian đặt cược!');
      if (userBalance <= 0) return showToast('Tài khoản đã hết tiền!');
      
      let amt = userBalance;
      userBalance = 0;
      confirmedBets[side] += amt;
      document.getElementById('val-' + side).innerText = fmtNum(confirmedBets[side]);
      updateBalanceDisplay();
      showToast(`TẤT TAY All-in ${fmtNum(amt)} đ vào cửa ${side}!`, 2500);
    }

    function toggleSqueezeMode() {
      isSqueezeMode = !isSqueezeMode;
      let btn = document.getElementById('btn-squeeze-toggle');
      if(isSqueezeMode) {
        btn.style.background = '#00ff66';
        btn.style.color = '#000';
        showToast('Bật chế độ Nặn 3D');
      } else {
        btn.style.background = '';
        btn.style.color = '#fff';
        showToast('Tắt chế độ Nặn');
      }
    }

    // XỬ LÝ KẾT QUẢ & TỰ ĐỘNG CẬP NHẬT BẢNG CẦU + CỘNG TIỀN
    function finishRoundAndShowResult() {
      let d1 = Math.floor(Math.random()*6) + 1;
      let d2 = Math.floor(Math.random()*6) + 1;
      let d3 = Math.floor(Math.random()*6) + 1;
      let sum = d1 + d2 + d3;
      let winSide = (sum >= 11) ? 'TAI' : 'XIU';

      // 1. Cập nhật dữ liệu Lịch sử phiên
      let currSession = (currentMode === 'MD5') ? sessionMD5 : sessionThuong;
      sessionHistory.push({ id: currSession, d1: d1, d2: d2, d3: d3, sum: sum, type: winSide });
      if(sessionHistory.length > 30) sessionHistory.shift();

      if(currentMode === 'MD5') sessionMD5++; else sessionThuong++;

      // 2. Lắc xí ngầu 3D
      document.getElementById('dice-container').style.display = 'block';
      let c1 = document.getElementById('cube1');
      let c2 = document.getElementById('cube2');
      let c3 = document.getElementById('cube3');
      
      c1.className = 'cube rolling'; c2.className = 'cube rolling'; c3.className = 'cube rolling';

      setTimeout(() => {
        c1.className = 'cube'; c2.className = 'cube'; c3.className = 'cube';

        // Highlight cửa thắng
        document.getElementById('title-' + winSide).classList.add('blink-winner');

        // 3. Tính tiền Thắng/Thua thực tế
        let userBetWinSide = confirmedBets[winSide];
        let userBetLoseSide = confirmedBets[winSide === 'TAI' ? 'XIU' : 'TAI'];
        
        let winAmt = 0;
        if (userBetWinSide > 0) {
          winAmt = Math.floor(userBetWinSide * 1.98); // Thắng ăn 1.98
          userBalance += winAmt;
          updateBalanceDisplay();

          // Show Popup Thắng
          document.getElementById('win-amount-text').innerText = '+' + fmtNum(winAmt) + ' đ';
          let winPop = document.getElementById('win-popup');
          winPop.classList.add('show');
          setTimeout(() => winPop.classList.remove('show'), 3500);

          userBetHistory.unshift({
            session: currSession,
            time: 'Vừa xong',
            bet: userBetWinSide,
            win: winAmt,
            desc: `Đặt ${winSide} Kết quả ${d1}-${d2}-${d3} ${winSide}, Tổng cược ${fmtNum(userBetWinSide)} Nhận ${fmtNum(winAmt)}`
          });
        } else if (userBetLoseSide > 0) {
          let losePop = document.getElementById('lose-popup');
          losePop.classList.add('show');
          setTimeout(() => losePop.classList.remove('show'), 3000);

          userBetHistory.unshift({
            session: currSession,
            time: 'Vừa xong',
            bet: userBetLoseSide,
            win: -userBetLoseSide,
            desc: `Đặt ${winSide === 'TAI'?'XIU':'TAI'} Kết quả ${d1}-${d2}-${d3} ${winSide}, Tổng cược ${fmtNum(userBetLoseSide)}`
          });
        }

        // Chờ 6 giây sau sang phiên mới
        setTimeout(() => startNewRound(), 6000);

      }, 3500);
    }

    // MODAL BẢNG CẦU NÂNG CẤP CHÂN THỰC THEO MẪU
    function openBangCauModal() {
      let modal = document.getElementById('modal-bang-cau');
      modal.classList.add('active');

      let last = sessionHistory[sessionHistory.length - 1];
      document.getElementById('bc-last-session').innerText = '#' + last.id;

      let taiCount = sessionHistory.filter(s => s.type === 'TAI').length;
      let xiuCount = sessionHistory.filter(s => s.type === 'XIU').length;
      document.getElementById('bc-count-tai').innerText = taiCount;
      document.getElementById('bc-count-xiu').innerText = xiuCount;

      renderCauTopGraph();
      renderCauMatrix5Row();
    }

    // VẼ NỬA TRÊN: ĐIỂM SỐ BÓNG TRÒN NỐI DÂY (Hình 2)
    function renderCauTopGraph() {
      let cv = document.getElementById('cau-canvas');
      let ctx = cv.getContext('2d');
      let container = document.getElementById('cau-nodes-container');
      
      ctx.clearRect(0, 0, cv.width, cv.height);
      container.innerHTML = '';

      let pts = sessionHistory.slice(-20); // 20 phiên gần đây
      let stepX = cv.width / 21;

      let pointsCoords = [];

      pts.forEach((s, i) => {
        let x = stepX * (i + 1);
        // Điểm từ 3 đến 18: 3 ở dưới cùng (height-15), 18 ở trên cùng (15)
        let y = cv.height - ((s.sum - 3) / 15) * (cv.height - 30) - 15;
        pointsCoords.push({ x: x, y: y, sum: s.sum, type: s.type });
      });

      // Vẽ đường nối các điểm
      ctx.beginPath();
      ctx.strokeStyle = '#ffe066';
      ctx.lineWidth = 2;
      pointsCoords.forEach((p, idx) => {
        if(idx === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.stroke();

      // Tạo các quả bóng số tròn
      pointsCoords.forEach(p => {
        let node = document.createElement('div');
        node.className = `node-ball ${p.type.toLowerCase()}`;
        node.innerText = p.sum;
        node.style.left = p.x + 'px';
        node.style.top = p.y + 'px';
        container.appendChild(node);
      });
    }

    // VẼ NỬA DƯỚI: CỘT DỌC 5 Ô MATRIX
    function renderCauMatrix5Row() {
      let container = document.getElementById('matrix-5row-container');
      container.innerHTML = '';

      let columns = [];
      let currentCol = [];
      let lastType = null;

      sessionHistory.forEach(s => {
        if (!lastType || s.type === lastType) {
          if (currentCol.length < 5) {
            currentCol.push(s);
          } else {
            columns.push({ type: lastType, items: currentCol });
            currentCol = [s];
          }
        } else {
          columns.push({ type: lastType, items: currentCol });
          currentCol = [s];
        }
        lastType = s.type;
      });
      if(currentCol.length > 0) columns.push({ type: lastType, items: currentCol });

      columns.forEach(col => {
        for(let r=0; r<5; r++) {
          let cell = document.createElement('div');
          cell.className = 'cau-cell-5row';
          if(col.items[r]) {
            cell.classList.add(col.items[r].type.toLowerCase());
            cell.innerText = col.items[r].sum;
          }
          container.appendChild(cell);
        }
      });
    }

    // MODAL LỊCH SỬ CƯỢC MẪU
    function openLichSuCuocModal() {
      let tbody = document.getElementById('history-table-body');
      tbody.innerHTML = userBetHistory.map(h => `
        <tr>
          <td>${h.session}</td>
          <td>${h.time}</td>
          <td>${fmtNum(h.bet)}</td>
          <td class="${h.win > 0 ? 'txt-green' : 'txt-red'}">${h.win > 0 ? '+' : ''}${fmtNum(h.win)}</td>
          <td style="text-align:left; padding-left:10px;">${h.desc}</td>
        </tr>
      `).join('');
      document.getElementById('modal-lich-su').classList.add('active');
    }
  </script>
