<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tool Tài Xỉu Cân Hết Cổng Game</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .tool-card {
            background: rgba(15, 23, 42, 0.85);
            border: 2px solid #ffd700;
            border-radius: 16px;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.3);
            width: 100%;
            max-width: 480px;
            padding: 24px;
            backdrop-filter: blur(10px);
        }

        .tool-header {
            text-align: center;
            margin-bottom: 24px;
            border-bottom: 1px solid rgba(255, 215, 0, 0.2);
            padding-bottom: 15px;
        }

        .tool-title {
            color: #ffd700;
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
            line-height: 1.4;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #e2e8f0;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border-radius: 8px;
            border: 1px solid #334155;
            background-color: #1e293b;
            color: #fff;
            font-size: 15px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #ffd700;
            box-shadow: 0 0 8px rgba(255, 215, 0, 0.4);
        }

        .btn-predict {
            width: 100%;
            padding: 14px;
            background: linear-gradient(90deg, #ff9900, #ff5500);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 85, 0, 0.4);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-predict:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 85, 0, 0.6);
        }

        .btn-predict:active {
            transform: translateY(0);
        }

        .result-box {
            margin-top: 25px;
            padding: 20px;
            border-radius: 12px;
            background: rgba(30, 41, 59, 0.9);
            border: 1px dashed #ffd700;
            text-align: center;
        }

        .result-title {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .result-value {
            font-size: 28px;
            font-weight: 900;
            letter-spacing: 2px;
            min-height: 40px;
        }

        .tai {
            color: #ef4444;
            text-shadow: 0 0 12px rgba(239, 68, 68, 0.6);
        }

        .xiu {
            color: #3b82f6;
            text-shadow: 0 0 12px rgba(59, 130, 246, 0.6);
        }

        .detail-info {
            margin-top: 10px;
            font-size: 13px;
            color: #cbd5e1;
        }
    </style>
</head>
<body>

    <div class="tool-card">
        <!-- TIÊU ĐỀ TOOL -->
        <div class="tool-header">
            <h1 class="tool-title">TOOL TÀI XỈU CÂN HẾT CỔNG GAME THỰC TẾ</h1>
        </div>

        <!-- MÃ PHIÊN TÀI XỈU -->
        <div class="form-group">
            <label for="sessionCode">Mã Phiên Tài Xỉu (Thực tế):</label>
            <input type="number" id="sessionCode" class="form-control" placeholder="Nhập mã phiên (VD: 1234567)" autocomplete="off">
        </div>

        <!-- KẾT QUẢ PHIÊN TRƯỚC -->
        <div class="form-group">
            <label for="previousResult">Kết Quả Phiên Trước (Thực tế):</label>
            <select id="previousResult" class="form-control">
                <option value="">-- Chọn hoặc nhập kết quả phiên trước --</option>
                <option value="TAI">Tài (11 - 17 điểm)</option>
                <option value="XIU">Xỉu (3 - 10 điểm)</option>
            </select>
        </div>

        <div class="form-group">
            <label for="previousPoints">Tổng Điểm Nút Phiên Trước (Nếu có):</label>
            <input type="number" id="previousPoints" class="form-control" placeholder="Nhập tổng điểm (3 đến 18)" min="3" max="18">
        </div>

        <!-- NÚT DỰ ĐOÁN -->
        <button class="btn-predict" onclick="predictResult()">Dự Đoán Kết Quả Thực TẾ</button>

        <!-- DỰ ĐOÁN KẾT QUẢ THỰC TẾ -->
        <div class="result-box">
            <div class="result-title">Dự Đoán Kết Quả Phiên Tiếp Theo</div>
            <div id="predictionDisplay" class="result-value">---</div>
            <div id="detailDisplay" class="detail-info">Vui lòng nhập đầy đủ thông tin để tính toán.</div>
        </div>
    </div>

    <script>
        function predictResult() {
            const sessionCode = document.getElementById('sessionCode').value;
            const previousResult = document.getElementById('previousResult').value;
            const previousPoints = document.getElementById('previousPoints').value;

            const predictionDisplay = document.getElementById('predictionDisplay');
            const detailDisplay = document.getElementById('detailDisplay');

            if (!sessionCode) {
                alert("Vui lòng nhập Mã Phiên Tài Xỉu thực tế!");
                return;
            }

            if (!previousResult && !previousPoints) {
                alert("Vui lòng chọn hoặc nhập Kết Quả Phiên Trước!");
                return;
            }

            // Thuật toán tính toán mẫu dựa trên Mã Phiên và Điểm phiên trước
            let sessionNum = parseInt(sessionCode);
            let pointNum = previousPoints ? parseInt(previousPoints) : (previousResult === 'TAI' ? 12 : 8);
            
            // Công thức tính toán chỉ số hạt nhân (Ví dụ)
            let calculation = (sessionNum + pointNum) % 2;

            predictionDisplay.innerHTML = "Đang phân tích...";
            predictionDisplay.className = "result-value";
            detailDisplay.innerText = "Hệ thống đang kết nối thuật toán cổng game...";

            setTimeout(() => {
                if (calculation === 0) {
                    predictionDisplay.innerText = "TÀI (11-17)";
                    predictionDisplay.className = "result-value tai";
                    detailDisplay.innerText = `Phiên #${parseInt(sessionCode) + 1} | Độ tin cậy: ${(85 + (sessionNum % 10)).toFixed(1)}%`;
                } else {
                    predictionDisplay.innerText = "XỈU (3-10)";
                    predictionDisplay.className = "result-value xiu";
                    detailDisplay.innerText = `Phiên #${parseInt(sessionCode) + 1} | Độ tin cậy: ${(84 + (sessionNum % 11)).toFixed(1)}%`;
                }
            }, 800);
        }
    </script>
</body>
</html>
