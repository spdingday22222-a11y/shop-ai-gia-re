    let userBetHistory = [
      { phien: 5122, time: '28-04-2026 00:29', cuoc: 200000160, win: -200000160, detail: 'Đặt Xỉu Kết quả 6-3-4 Tài, Tổng đặt 200,000,160 Hoàn trả 0, Nhận 0' },
