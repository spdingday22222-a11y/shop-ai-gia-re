    let myTaiBet = 0;
    let myXiuBet = 0;

    let totalTaiAmount = 658469416;
    let totalXiuAmount = 790120500;
    let totalTaiPlayers = 425;
    let totalXiuPlayers = 580;

    let timerVal = 45;
    let gameInterval = null;
    let dynamicNumberInterval = null;
    let isRolling = false;

    // Canvas FX - Nổ pháo hoa vàng cam
    const canvas = document.getElementById('fx-canvas');
    const ctx = canvas.getContext('2d');
    let particles = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function createExplosion(x, y) {
      const colors = ['#ff9800', '#ffb74d', '#ff5722', '#ffeb3b', '#ffffff'];
      for (let i = 0; i < 90; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 12 + 2;
        particles.push({
          x: x,
          y: y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          radius: Math.random() * 4 + 2,
          color: colors[Math.floor(Math.random() * colors.length)],
          alpha: 1,
          decay: Math.random() * 0.02 + 0.015
        });
      }
    }

    function renderFX() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.15; // Trọng lực nhẹ
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          particles.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.globalAlpha = p.alpha;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.shadowBlur = 10;
        ctx.shadowColor = p.color;
        ctx.fill();
        ctx.restore();
      }
      requestAnimationFrame(renderFX);
    }
    renderFX();

    /* INIT & LOADING */
    window.addEventListener('load', () => {
      let fill = document.getElementById('loader-fill');
      let text = document.getElementById('loader-text');
