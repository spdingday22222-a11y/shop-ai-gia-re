<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Go88 Real - Tài Xỉu MD5 VIP</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Arial Black', 'Arial', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #020204;
      color: #ffffff;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #101018 0%, #020204 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 40px; font-weight: 900;
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 45%, #e65c00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 20px rgba(245, 166, 35, 0.7));
      letter-spacing: 2px; text-transform: uppercase;
    }

    .loader-box {
      width: 320px; height: 14px; background: rgba(0,0,0,0.9);
      border: 1.5px solid #ffb703; border-radius: 10px; padding: 2px; margin-top: 20px;
      box-shadow: 0 0 15px rgba(255, 183, 3, 0.3);
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff8000, #ffea00);
      border-radius: 10px; transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffea00;
    }

    /* 2. LOBBY */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #151522 0%, #08080e 50%, #000002 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 24px; background: rgba(10, 10, 15, 0.95);
      border-bottom: 2px solid #ffb703; z-index: 20;
      box-shadow: 0 4px 20px rgba(0,0,0,0.8);
    }

    .user-info { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 42px; height: 42px; border-radius: 10px; border: 2px solid #ffb703; background-size: cover; box-shadow: 0 0 8px rgba(255,183,3,0.5); }
    .balance-box {
      background: #08080c; border: 1.5px solid #ffb703;
      border-radius: 18px; padding: 4px 16px; color: #ffea00;
      font-weight: bold; font-size: 15px; text-shadow: 0 0 8px rgba(255, 234, 0, 0.5);
      box-shadow: inset 0 0 6px rgba(0,0,0,0.8);
    }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 210px; height: 270px; border-radius: 18px; border: 2px solid #ffb703;
      display: flex; flex-direction: column; justify-content: space-between; padding: 18px;
      cursor: pointer; transition: transform 0.25s, box-shadow 0.25s;
      background: linear-gradient(180deg, #1f1f2e 0%, #0a0a10 100%);
      box-shadow: 0 0 25px rgba(255, 183, 3, 0.25), inset 0 0 15px rgba(255, 255, 255, 0.05);
    }
    .game-card:hover { transform: translateY(-5px) scale(1.03); box-shadow: 0 0 35px rgba(255, 183, 3, 0.5); }

    .card-title {
      font-size: 20px; font-weight: 900; text-align: center;
      background: linear-gradient(180deg, #ffffff 0%, #ffea00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }
    .card-sub { font-size: 11px; text-align: center; color: #00ffcc; font-weight: bold; letter-spacing: 1px; }

    /* 3. ARENA GAME PLAY */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(2, 2, 5, 0.98); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(10, 10, 15, 0.98); border-bottom: 1.5px solid #ffb703;
      z-index: 20; box-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .btn-back-lobby {
      background: linear-gradient(180deg, #80000a, #4a0005);
      color: #fff; border: 1.5px solid #ffea00; padding: 6px 16px; border-radius: 16px;
      font-weight: bold; cursor: pointer; box-shadow: 0 3px 6px #000;
    }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; }

    /* LỚP DIM KHU VỰC KHI ĐANG NẶN THỰC TẾ */
    .dim-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.8);
      z-index: 11; opacity: 0; pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .dim-overlay.active { opacity: 1; }

    /* BÀN TÀI XỈU MÀU ĐEN SẮC NÉT & SANG TRỌNG */
    .real-taixiu-board {
      position: absolute; width: 740px; height: 360px;
      border-radius: 180px; display: flex; justify-content: space-between; align-items: center;
      padding: 20px 40px;
      background: radial-gradient(circle at center, #1b1b24 0%, #0d0d14 60%, #040407 100%);
      border: 4px solid #f5a623;
      box-shadow: 0 0 60px rgba(245, 166, 35, 0.35), inset 0 0 30px rgba(0, 0, 0, 0.9), inset 0 0 10px rgba(255, 234, 0, 0.3);
    }

    .board-logo {
      position: absolute; top: 18px; left: 50%; transform: translateX(-50%);
      font-size: 16px; font-weight: 900; letter-spacing: 2px;
      background: linear-gradient(180deg, #ffffff 0%, #ffb703 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 8px rgba(255, 183, 3, 0.6));
      z-index: 5; pointer-events: none;
    }

    /* NÚT TRÒN VIỀN BÀN CƯỢC */
    .circle-btn {
      position: absolute; width: 36px; height: 36px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 14px; font-weight: bold; cursor: pointer;
      background: linear-gradient(180deg, #2a2a38, #12121a);
      border: 1.5px solid #ffea00; z-index: 15; box-shadow: 0 4px 8px #000, 0 0 8px rgba(255,234,0,0.3);
      transition: transform 0.15s;
    }
    .circle-btn:active { transform: scale(0.9); }

    .btn-info { top: 22px; left: 145px; }
    .btn-chart { top: 88px; left: 60px; background: linear-gradient(180deg, #0077b6, #023e8a); }
    .btn-help { top: 158px; left: 25px; }
    .btn-history { top: 228px; left: 60px; }

    .btn-close { top: 22px; right: 145px; background: linear-gradient(180deg, #9e1a22, #500000); }
    .btn-rank { top: 88px; right: 60px; }
    .btn-chat-toggle { top: 158px; right: 25px; }

    .btn-nan-hand {
      position: absolute; right: 105px; bottom: 25px; width: 46px; height: 46px;
      border-radius: 50%; background: radial-gradient(circle, #ff9d00, #804000);
      border: 2px solid #fff3a1; box-shadow: 0 0 12px #ff9d00, 0 4px 8px #000;
      display: flex; justify-content: center; align-items: center; font-size: 22px;
      cursor: pointer; z-index: 16; transition: transform 0.2s, background 0.3s;
    }
    .btn-nan-hand.active { background: radial-gradient(circle, #00ffcc, #005544); border-color: #00ffff; box-shadow: 0 0 15px #00ffff; }

    /* CỬA CƯỢC TÀI / XỈU */
    .bet-side {
      width: 200px; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 10;
    }

    .player-count { font-size: 13px; color: #ffea00; font-weight: bold; margin-bottom: 2px; text-shadow: 0 0 5px #ffea00; }

    .bet-title {
      font-size: 56px; font-weight: 900; color: #ffffff;
      text-shadow: 0 4px 10px rgba(0,0,0,0.9), 0 0 15px rgba(255,255,255,0.3);
      letter-spacing: 3px; transition: all 0.3s ease;
    }
    .bet-title.highlight-pulse {
      color: #ffea00; text-shadow: 0 0 25px #ffea00, 0 0 50px #ffea00;
      animation: pulseGlow 0.6s infinite alternate;
    }
    @keyframes pulseGlow {
      from { transform: scale(1); }
      to { transform: scale(1.12); }
    }

    .bet-amount {
      font-size: 18px; font-weight: 900; color: #00ffcc;
      text-shadow: 0 0 8px rgba(0, 255, 204, 0.6), 0 2px 4px #000; margin-bottom: 8px;
    }

    .btn-cuoc-oval {
      width: 145px; height: 40px;
      background: radial-gradient(circle, #252533 0%, #101018 100%);
      border: 2px solid #ffb703; border-radius: 20px;
      display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: inset 0 0 8px rgba(0,0,0,0.9), 0 4px 10px rgba(0,0,0,0.8), 0 0 10px rgba(255, 183, 3, 0.2);
      transition: transform 0.1s, border-color 0.2s;
    }
    .btn-cuoc-oval:active { transform: scale(0.95); }

    .bet-text-val { font-size: 16px; font-weight: 900; color: #8888a0; text-shadow: 0 1px 2px #000; }
    .bet-text-val.label-cuoc {
      color: #ff9d00;
      background: linear-gradient(180deg, #fff3a1 0%, #ff9d00 60%, #b35900 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 3px rgba(0, 0, 0, 0.9));
      font-size: 18px; letter-spacing: 1px;
    }
    .bet-text-val.active-bet { color: #ffea00; text-shadow: 0 0 8px rgba(255, 234, 0, 0.9); }

    /* BÁT / ĐĨA TRUNG TÂM */
    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 215px; height: 215px; border-radius: 50%;
      background: radial-gradient(circle, #0d0d12 0%, #181824 70%, #000000 100%);
      border: 4px solid #ffb703; display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 40px rgba(0,0,0,0.9), inset 0 0 20px rgba(255,183,3,0.3); z-index: 12;
    }

    .plate-cover {
      position: absolute; width: 210px; height: 210px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #4a4a5a 0%, #1a1a24 60%, #050508 100%);
      border: 3px solid #ffea00; box-shadow: 0 10px 30px rgba(0,0,0,0.95), inset 0 2px 10px rgba(255,255,255,0.4);
      z-index: 15; display: none; cursor: grab; justify-content: center; align-items: center;
      touch-action: none; transition: filter 0.2s ease;
    }
    .plate-cover:active { cursor: grabbing; filter: drop-shadow(0px 0px 18px rgba(255, 234, 0, 0.9)); }
    .plate-cover-knob { width: 48px; height: 48px; border-radius: 50%; background: radial-gradient(circle, #ffd700, #b8860b); border: 2px solid #fff; box-shadow: 0 4px 8px #000; }

    .timer-display { font-size: 64px; font-weight: 900; color: #ffea00; text-shadow: 0 0 20px rgba(255, 234, 0, 0.9); z-index: 6; }

    .dice-triangle-container { position: absolute; width: 140px; height: 120px; display: none; z-index: 8; }
    .dice-real {
      position: absolute; width: 44px; height: 44px;
      background: linear-gradient(145deg, #e60000, #800000);
      border: 2px solid #ffffff; border-radius: 9px;
      box-shadow: inset 0 0 6px rgba(255,255,255,0.8), 0 5px 10px rgba(0,0,0,0.8);
      display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 4px; align-items: center; justify-items: center;
    }

    #dice1 { top: 5px; left: 48px; }
    #dice2 { bottom: 8px; left: 16px; }
    #dice3 { bottom: 8px; right: 16px; }

    .pip { width: 7px; height: 7px; background: #ffffff; border-radius: 50%; display: none; box-shadow: inset 0 1px 1px rgba(0,0,0,0.5); }
    .pip.center-red { background: #ff0000; border: 1px solid #fff; width: 14px; height: 14px; grid-column: 2; grid-row: 2; display: block; }
    .p-1 { grid-column: 1; grid-row: 1; } .p-3 { grid-column: 3; grid-row: 1; }
    .p-4 { grid-column: 1; grid-row: 2; } .p-5 { grid-column: 2; grid-row: 2; } .p-6 { grid-column: 3; grid-row: 2; }
    .p-7 { grid-column: 1; grid-row: 3; } .p-9 { grid-column: 3; grid-row: 3; }

    .win-text-overlay {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-size: 36px; font-weight: 900; color: #ffea00;
      text-shadow: 0 0 15px #ffea00, 0 4px 10px #000; z-index: 10; display: none; white-space: nowrap;
      animation: popWin 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popWin {
      0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    /* 1. CHIP CƯỢC DỊCH XUỐNG CẠNH VIỀN SẢNH + 2. LOGO VUÔNG TÀNG HÌNH VĨNH VIỄN */
    .chip-panel-real {
      position: absolute; 
      bottom: 0px; 
      left: 50%; 
      transform: translate(-50%, 80%); /* Dịch xuống sát cạnh viền sảnh */
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      
      /* TÀNG HÌNH VĨNH VIỄN TẠI KHUNG NGOÀI Ô CHIP */
      background: rgba(0, 0, 0, 0) !important;
      border: none !important;
      box-shadow: none !important;
      
      padding: 8px 20px 10px 20px; border-radius: 16px; z-index: 100;
      transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 1;
    }

    .chip-panel-real.hidden {
      opacity: 0; pointer-events: none; 
      transform: translate(-50%, 130%);
    }

    .chip-list { display: flex; gap: 8px; }

    .chip-btn {
      width: 60px; height: 38px; border-radius: 8px;
      background: linear-gradient(180deg, #ffb300 0%, #ff8000 60%, #cc5200 100%);
      border: 1.5px solid #ffe066; color: #ffffff; font-size: 13px; font-weight: 900;
      display: flex; justify-content: center; align-items: center; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(255,255,255,0.8), 0 4px 8px #000;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9); transition: transform 0.1s, box-shadow 0.1s;
    }
    .chip-btn:active { transform: translateY(-2px); box-shadow: 0 0 12px #ffea00; }

    .chip-actions { display: flex; gap: 12px; width: 100%; justify-content: center; margin-top: 2px; }

    .btn-action-x2 {
      background: linear-gradient(180deg, #3a7bd5, #3a6073); border: 1px solid #fff;
      color: #fff; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.6);
    }

    .btn-action-bet {
      background: linear-gradient(180deg, #fff3b0 0%, #f5a623 50%, #d47a00 100%);
      border: 1.5px solid #ffffff;
      color: #3d1e00; padding: 6px 32px; border-radius: 18px; font-weight: 900; font-size: 14px; cursor: pointer;
      box-shadow: 0 0 15px rgba(245, 166, 35, 0.9), 0 3px 6px rgba(0,0,0,0.6);
      text-shadow: 0 1px 0 rgba(255,255,255,0.6);
    }

    .btn-action-cancel {
      background: linear-gradient(180deg, #b8121f 0%, #80000a 60%, #4a0005 100%);
      border: 1.5px solid #ff9999;
      color: #fff; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(255,255,255,0.4), 0 3px 6px rgba(0,0,0,0.8);
      text-shadow: 0 1px 2px #000;
    }

    /* 3 & 4 & 5. BẢNG SOI CẦU MỞ RỘNG - NÂNG CẤP GIAO DIỆN NÂU XÁM KẺ VẠCH ĐẬM & 5 Ô CỘT DỌC SỐ CHẤM TRÒN */
    .chart-modal-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(0, 0, 0, 0.75); z-index: 1000; display: none;
      justify-content: center; align-items: center; backdrop-filter: blur(4px);
    }
    .chart-modal-overlay.active { display: flex; }

    .chart-modal-box {
      width: 820px; height: 480px;
      background: linear-gradient(180deg, #2d2623 0%, #1c1816 100%); /* Nâu xám VIP */
      border: 3px solid #ffb703; border-radius: 20px;
      box-shadow: 0 0 50px rgba(0,0,0,0.95), 0 0 20px rgba(245, 166, 35, 0.4);
      display: flex; flex-direction: column; overflow: hidden; position: relative;
    }

    .chart-header {
      height: 48px; background: linear-gradient(180deg, #423631, #241e1b);
      border-bottom: 2px solid #ffb703; display: flex; justify-content: space-between;
      align-items: center; padding: 0 20px;
    }

    .chart-title {
      font-size: 16px; font-weight: 900; color: #ffea00;
      text-shadow: 0 2px 4px #000; letter-spacing: 1px;
    }

    .btn-close-chart {
      width: 28px; height: 28px; border-radius: 50%; background: #a00; border: 1.5px solid #fff;
      color: #fff; font-weight: bold; display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: 0 2px 4px #000;
    }

    .chart-body-wrapper {
      flex: 1; padding: 15px; overflow-x: auto; overflow-y: hidden;
      display: flex; flex-direction: column; gap: 12px;
      cursor: grab; touch-action: none;
    }
    .chart-body-wrapper:active { cursor: grabbing; }

    /* LƯỚI BẢNG CẦU 5 HÀNG DỌC CÓ KẺ VẠCH ĐẬM SẮC NẾT */
    .grid-cau-container {
      display: grid;
      grid-template-rows: repeat(5, 42px); /* Đúng 5 ô cột dọc */
      grid-auto-columns: 42px;
      grid-auto-flow: column;
      gap: 2px;
      background: #0d0b0a;
      border: 2px solid #ffb703;
      padding: 4px;
      border-radius: 8px;
      width: max-content;
      min-width: 100%;
    }

    .grid-cell {
      width: 42px; height: 42px;
      background: #181412;
      border: 1px solid #443833; /* Kẻ vạch đậm sắc nét */
      display: flex; justify-content: center; align-items: center;
      border-radius: 4px;
    }

    /* CHẤM TRÒN HIỆN SỐ KẾT QUẢ & CÓ THỂ BỆT SANG BÊN CẠNH */
    .dot-result {
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      font-size: 13px; font-weight: 900; color: #fff;
      box-shadow: 0 2px 5px rgba(0,0,0,0.8), inset 0 1px 2px rgba(255,255,255,0.6);
    }
    .dot-result.tai {
      background: radial-gradient(circle at 35% 35%, #ffcc00, #b37700);
      border: 1.5px solid #ffffff; color: #000; text-shadow: 0 0 2px #fff;
    }
    .dot-result.xiu {
      background: radial-gradient(circle at 35% 35%, #e6e6e6, #555555);
      border: 1.5px solid #ffffff; color: #000;
    }

    .toast-msg {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-50px);
      background: rgba(10,10,18,0.98); border: 2px solid #ffb703; color: #ffea00;
      padding: 10px 24px; border-radius: 20px; font-weight: bold; font-size: 13px;
      z-index: 9999; opacity: 0; transition: all 0.3s ease; pointer-events: none;
      box-shadow: 0 0 20px rgba(255,183,3,0.5);
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

  <div id="toast" class="toast-msg">Thông báo hệ thống</div>

  <!-- 1. LOADING SCREEN -->
  <div id="loading-screen" class="app-screen active">
    <div class="loader-brand">GO88 MD5 REAL</div>
    <div class="loader-box"><div class="loader-fill" id="loader-fill"></div></div>
  </div>

  <!-- 2. GAME LOBBY -->
  <div id="lobby-screen" class="app-screen game-lobby">
    <div class="top-bar">
      <div class="user-info">
        <div class="avatar" style="background-image: url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100');"></div>
        <div>
          <div style="font-size: 11px; color: #aaa;">Go88TrumBai</div>
          <div class="balance-box" id="user-balance">$ 1,096,000</div>
        </div>
      </div>
      <div>
        <button class="btn-action-bet" style="padding: 5px 18px; font-size: 12px;" onclick="showToast('Cổng Nạp Tự Động 24/7')">NẠP TIỀN</button>
      </div>
    </div>

    <div class="lobby-content">
      <div class="game-card" onclick="enterArena('MD5')">
        <div class="card-title">TÀI XỈU MD5</div>
        <div class="card-sub">MINH BẠCH 100%</div>
        <div style="text-align: center; color:#ffea00; font-size:12px; font-weight:bold;">#13217</div>
      </div>
    </div>
  </div>

  <!-- 3. ARENA GAME PLAY -->
  <div id="arena-screen" class="arena-screen">
    <div class="arena-header">
      <button class="btn-back-lobby" onclick="exitArena()">◄ RỜI SẢNH</button>
      <div style="font-weight:900; color:#ffea00; font-size: 18px;" id="arena-title">TÀI XỈU MD5</div>
      <div class="balance-box" id="arena-balance">$ 1,096,000</div>
    </div>

    <div class="arena-stage">
      <div class="dim-overlay" id="dim-overlay"></div>

      <div class="real-taixiu-board">
        <div class="board-logo">GO88 MD5</div>

        <!-- Các nút tiện ích xung quanh viền -->
        <div class="circle-btn btn-info" onclick="showToast('Phiên cược mã hóa MD5')">i</div>
        <div class="circle-btn btn-chart" onclick="openChartModal()">📊</div>
        <div class="circle-btn btn-help" onclick="showToast('Luật chơi: Tài (11-17), Xỉu (3-10)')">?</div>
        <div class="circle-btn btn-history" onclick="showToast('Lịch sử cược cá nhân')">📜</div>

        <div class="circle-btn btn-close" onclick="exitArena()">X</div>
        <div class="circle-btn btn-rank" onclick="showToast('Bảng vinh danh Top')">🏆</div>
        <div class="circle-btn btn-chat-toggle" onclick="showToast('Mở khung Chat')">💬</div>

        <div class="btn-nan-hand" id="btn-nan" onclick="toggleNanMode()" title="Bật/Tắt chế độ Nặn">✋</div>

        <!-- CỬA TÀI -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="tai-players">398</span></div>
          <div class="bet-title" id="title-TAI">TÀI</div>
          <div class="bet-amount" id="tai-amount">161,516,213</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('TAI')">
            <span class="bet-text-val label-cuoc" id="val-TAI">CƯỢC</span>
          </div>
        </div>

        <!-- BÁT / ĐĨA TRUNG TÂM -->
        <div class="center-plate" id="center-plate">
          <div class="timer-display" id="timer-text">15</div>

          <div class="plate-cover" id="plate-cover">
            <div class="plate-cover-knob"></div>
          </div>

          <div class="dice-triangle-container" id="dice-container">
            <div class="dice-real" id="dice1"></div>
            <div class="dice-real" id="dice2"></div>
            <div class="dice-real" id="dice3"></div>
          </div>

          <div class="win-text-overlay" id="win-overlay">+198,000</div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="xiu-players">226</span></div>
          <div class="bet-title" id="title-XIU">XỈU</div>
          <div class="bet-amount" id="xiu-amount">51,223,396</div>
          <div class="btn-cuoc-oval" onclick="openBetPanel('XIU')">
            <span class="bet-text-val label-cuoc" id="val-XIU">CƯỢC</span>
          </div>
        </div>

        <!-- BANNER PHÍM CHIP CƯỢC THỰC TẾ: DỊCH XUỐNG DƯỚI CẠNH VIỀN SẢNH + KHUNG LOGO TÀNG HÌNH -->
        <div class="chip-panel-real hidden" id="chip-panel">
          <div class="chip-list">
            <div class="chip-btn" onclick="addChip(1000)">1K</div>
            <div class="chip-btn" onclick="addChip(10000)">10K</div>
            <div class="chip-btn" onclick="addChip(50000)">50K</div>
            <div class="chip-btn" onclick="addChip(100000)">100K</div>
            <div class="chip-btn" onclick="addChip(500000)">500K</div>
            <div class="chip-btn" onclick="addChip(1000000)">1M</div>
            <div class="chip-btn" onclick="addChip(10000000)">10M</div>
            <div class="chip-btn" onclick="addChip(50000000)">50M</div>
          </div>
          <div class="chip-actions">
            <button class="btn-action-x2" onclick="allInBet()">ALL IN</button>
            <button class="btn-action-bet" onclick="confirmBet()">ĐẶT CƯỢC</button>
            <button class="btn-action-cancel" onclick="cancelBet()">HỦY</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- POPUP BẢNG SOI CẦU MỞ RỘNG - NÂNG CẤP 5 Ô CỘT DỌC SỐ CHẤM TRÒN & CÓ THỂ KÉO BỆT MƯỢT MÀ -->
  <div class="chart-modal-overlay" id="chart-modal">
    <div class="chart-modal-box">
      <div class="chart-header">
        <div class="chart-title">📊 BẢNG SOI CẦU TÀI XỈU MD5 - GO88 VIP</div>
        <div class="btn-close-chart" onclick="closeChartModal()">X</div>
      </div>
      <div class="chart-body-wrapper" id="chart-scroll-area">
        <!-- LƯỚI BẢNG CẦU THỰC TẾ HÀNG NGANG CỘT DỌC -->
        <div class="grid-cau-container" id="grid-cau"></div>
      </div>
    </div>
  </div>

  <script>
    // State Game
    let balance = 1096000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    let timer = 15;
    let timerInterval = null;
    let currentResultSide = null;

    // Lịch sử kết quả cầu (Mẫu thực tế)
    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 }, /* Bệt Xỉu > 5 sẽ bệt sang cột bên */
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 }
    ];

    // Chế độ nặn
    let isNanMode = false;
    let isDraggingCover = false;
    let coverStartX = 0, coverStartY = 0;
    let coverCurX = 0, coverCurY = 0;

    // Loading Bar
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      startTimer();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn tay');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    function openBetPanel(side) {
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Đã chọn cửa ' + side + '. Chọn chip cược!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In toàn bộ số tiền!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      showToast('Đã hủy thao tác cược!');
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược!');
        return;
      }

      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
      
      showToast('Đặt cược thành công ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      const el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      document.getElementById('chip-panel').classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    /* ĐỒNG HỒ ĐẾM NGƯỢC & HIỂN THỊ KẾT QUẢ THỜI GIAN THỰC */
    function startTimer() {
      clearInterval(timerInterval);
      timer = 15;
      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('win-overlay').style.display = 'none';
      document.getElementById('plate-cover').style.display = 'none';
      document.getElementById('dim-overlay').classList.remove('active');
      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer < 10 ? '0' + timer : timer;

        if (timer <= 0) {
          clearInterval(timerInterval);
          renderDiceResult();
        }
      }, 1000);
    }

    function renderDiceResult() {
      document.getElementById('timer-text').style.display = 'none';
      const diceContainer = document.getElementById('dice-container');
      const plateCover = document.getElementById('plate-cover');

      const d1 = Math.floor(Math.random() * 6) + 1;
      const d2 = Math.floor(Math.random() * 6) + 1;
      const d3 = Math.floor(Math.random() * 6) + 1;

      renderSingleDice('dice1', d1);
      renderSingleDice('dice2', d2);
      renderSingleDice('dice3', d3);

      diceContainer.style.display = 'block';

      const total = d1 + d2 + d3;
      currentResultSide = total >= 11 ? 'TAI' : 'XIU';

      // Lưu kết quả vào lịch sử bảng cầu
      historyResults.push({ side: currentResultSide, total: total });

      if (isNanMode) {
        coverCurX = 0;
        coverCurY = 0;
        plateCover.style.transform = 'translate(0px, 0px)';
        plateCover.style.display = 'flex';
        
        showToast('Kéo nắp để mở kết quả!');
        setupCoverDrag();

        setTimeout(() => {
          document.getElementById('dim-overlay').classList.remove('active');
          plateCover.style.display = 'none';
          finishRound(currentResultSide);
        }, 10000);
      } else {
        finishRound(currentResultSide);
      }
    }

    function finishRound(resultSide) {
      document.getElementById('title-' + resultSide).classList.add('highlight-pulse');

      if (confirmedBets[resultSide] > 0) {
        const winAmount = confirmedBets[resultSide] * 1.98;
        balance += winAmount;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        const winOverlay = document.getElementById('win-overlay');
        winOverlay.innerText = '+' + Math.floor(winAmount).toLocaleString();
        winOverlay.style.display = 'block';
      }

      setTimeout(() => {
        confirmedBets = { TAI: 0, XIU: 0 };
        
        const valTai = document.getElementById('val-TAI');
        valTai.innerText = 'CƯỢC';
        valTai.className = 'bet-text-val label-cuoc';

        const valXiu = document.getElementById('val-XIU');
        valXiu.innerText = 'CƯỢC';
        valXiu.className = 'bet-text-val label-cuoc';

        startTimer();
      }, 3500);
    }

    /* KÉO NẮP NẶN BÀN TAY THỰC TẾ */
    function setupCoverDrag() {
      const cover = document.getElementById('plate-cover');
      const dimOverlay = document.getElementById('dim-overlay');

      const onStart = (e) => {
        isDraggingCover = true;
        dimOverlay.classList.add('active');
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        coverStartX = pageX - coverCurX;
        coverStartY = pageY - coverCurY;
      };

      const onMove = (e) => {
        if (!isDraggingCover) return;
        const pageX = e.touches ? e.touches[0].pageX : e.pageX;
        const pageY = e.touches ? e.touches[0].pageY : e.pageY;
        
        coverCurX = pageX - coverStartX;
        coverCurY = pageY - coverStartY;
        cover.style.transform = `translate(${coverCurX}px, ${coverCurY}px)`;
      };

      const onEnd = () => {
        if (isDraggingCover) {
          isDraggingCover = false;
          dimOverlay.classList.remove('active');
        }
      };

      cover.onmousedown = onStart;
      window.onmousemove = onMove;
      window.onmouseup = onEnd;

      cover.ontouchstart = onStart;
      window.ontouchmove = onMove;
      window.ontouchend = onEnd;
    }

    function renderSingleDice(id, val) {
      const el = document.getElementById(id);
      el.innerHTML = '';
      if (val === 1) {
        el.innerHTML = '<div class="pip center-red"></div>';
      } else {
        const positions = {
          2: [1, 9],
          3: [1, 5, 9],
          4: [1, 3, 7, 9],
          5: [1, 3, 5, 7, 9],
          6: [1, 3, 4, 6, 7, 9]
        };
        positions[val].forEach(p => {
          const pDiv = document.createElement('div');
          pDiv.className = `pip p-${p}`;
          pDiv.style.display = 'block';
          el.appendChild(pDiv);
        });
      }
    }

    /* BẢNG SOI CẦU MỞ RỘNG - LOGIC 5 Ô CỘT DỌC & THUẬT TOÁN BỆT SANG BÊN CẠNH THỰC TẾ */
    function openChartModal() {
      renderGridCau();
      document.getElementById('chart-modal').classList.add('active');
      setupChartScrollDrag();
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function renderGridCau() {
      const grid = document.getElementById('grid-cau');
      grid.innerHTML = '';

      // Ma trận cầu: Nằm trong 5 ô dọc x N cột ngang
      let columns = [];
      let curCol = [];
      let lastSide = null;

      historyResults.forEach(res => {
        if (!lastSide) {
          lastSide = res.side;
          curCol.push(res);
        } else if (res.side === lastSide) {
          if (curCol.length < 5) {
            curCol.push(res);
          } else {
            // Khi bị bệt quá 5 ô cột dọc -> Bệt nối tiếp sang cột bên cạnh!
            columns.push(curCol);
            curCol = [res];
          }
        } else {
          columns.push(curCol);
          curCol = [res];
          lastSide = res.side;
        }
      });
      if (curCol.length > 0) columns.push(curCol);

      // Đảm bảo tối thiểu 20 cột hiển thị cho rộng rãi
      const totalCols = Math.max(columns.length, 20);

      for (let c = 0; c < totalCols; c++) {
        const colData = columns[c] || [];
        for (let r = 0; r < 5; r++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';

          if (colData[r]) {
            const dot = document.createElement('div');
            dot.className = 'dot-result ' + (colData[r].side === 'TAI' ? 'tai' : 'xiu');
            dot.innerText = colData[r].total;
            cell.appendChild(dot);
          }
          grid.appendChild(cell);
        }
      }
    }

    /* KÉO BẢNG BÊN TRONG HÌNH TRÒN NHỎ MƯỢT MÀ TỰ DO */
    function setupChartScrollDrag() {
      const slider = document.getElementById('chart-scroll-area');
      let isDown = false;
      let startX, scrollLeft;

      slider.onmousedown = (e) => {
        isDown = true;
        startX = e.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      };
      slider.onmouseleave = () => { isDown = false; };
      slider.onmouseup = () => { isDown = false; };
      slider.onmousemove = (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - slider.offsetLeft;
        const walk = (x - startX) * 2;
        slider.scrollLeft = scrollLeft - walk;
      };

      slider.ontouchstart = (e) => {
        isDown = true;
        startX = e.touches[0].pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      };
      slider.ontouchend = () => { isDown = false; };
      slider.ontouchmove = (e) => {
        if (!isDown) return;
        const x = e.touches[0].pageX - slider.offsetLeft;
        const walk = (x - startX) * 2;
        slider.scrollLeft = scrollLeft - walk;
      };
    }
  </script>
</body>
</html>
