<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archer.io 2D - Bản Chuẩn VIP</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        body { 
            background: #0f172a; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            overflow: hidden; 
            color: #fff; 
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
        }

        canvas { display: block; }

        /* Giao diện UI overlays */
        #ui-layer {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
        }

        /* Bảng xếp hạng Leaderboard */
        .leaderboard {
            position: absolute;
            top: 15px; right: 15px;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(8px);
            padding: 12px 18px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            width: 200px;
        }
        .leaderboard h3 { font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: #f59e0b; margin-bottom: 8px; text-align: center; }
        .lb-item { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; font-weight: 600; }
        .lb-item.me { color: #38bdf8; }

        /* Bảng nâng cấp Stats */
        .stats-panel {
            position: absolute;
            bottom: 20px; left: 20px;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            padding: 15px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            pointer-events: all;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 220px;
        }
        .stat-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 6px 10px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 700;
            transition: all 0.2s;
        }
        .stat-btn:hover { background: #f59e0b; color: #000; }
        .stat-btn:disabled { opacity: 0.3; cursor: not-allowed; background: rgba(255, 255, 255, 0.05); }

        /* Thanh Cấp Độ EXP */
        .level-bar-container {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 350px;
            background: rgba(15, 23, 42, 0.8);
            padding: 6px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            text-align: center;
        }
        .level-bar {
            width: 0%; height: 12px;
            background: linear-gradient(90deg, #3b82f6, #f59e0b);
            border-radius: 10px;
            transition: width 0.2s;
        }
        .level-text { font-size: 11px; font-weight: 800; margin-top: 3px; letter-spacing: 1px; }

        /* Màn hình Start / Game Over */
        .screen-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(10px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            pointer-events: all;
            z-index: 100;
        }
        .screen-overlay h1 { font-size: 42px; color: #f59e0b; letter-spacing: 3px; margin-bottom: 10px; }
        .screen-overlay input {
            padding: 12px 20px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 16px;
            outline: none;
            text-align: center;
            margin-bottom: 15px;
            width: 220px;
        }
        .screen-overlay button {
            padding: 12px 30px;
            border-radius: 10px;
            border: none;
            background: #f59e0b;
            color: #0f172a;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 1px;
        }
        .screen-overlay button:hover { transform: scale(1.05); background: #fbbf24; }
    </style>
</head>
<body>

<div id="game-container">
    <canvas id="canvas"></canvas>

    <div id="ui-layer">
        <!-- Bảng xếp hạng -->
        <div class="leaderboard">
            <h3>TOP CAO THỦ</h3>
            <div id="lb-list"></div>
        </div>

        <!-- Bảng nâng cấp Stats -->
        <div class="stats-panel">
            <div style="font-size: 12px; font-weight: 800; color: #f59e0b; margin-bottom: 4px;">
                ĐIỂM KỸ NĂNG: <span id="skill-points">0</span>
            </div>
            <button class="stat-btn" id="btn-up-dmg" onclick="upgradeStat('dmg')">
                <span>SÁT THƯƠNG</span> <span id="val-dmg">Lv.1</span>
            </button>
            <button class="stat-btn" id="btn-up-spd" onclick="upgradeStat('spd')">
                <span>TỐC ĐỘ ĐI TRUYỂN</span> <span id="val-spd">Lv.1</span>
            </button>
            <button class="stat-btn" id="btn-up-hp" onclick="upgradeStat('hp')">
                <span>MÁU TỐI ĐA</span> <span id="val-hp">Lv.1</span>
            </button>
            <button class="stat-btn" id="btn-up-rate" onclick="upgradeStat('rate')">
                <span>TỐC ĐỘ BẮN</span> <span id="val-rate">Lv.1</span>
            </button>
        </div>

        <!-- Thanh EXP -->
        <div class="level-bar-container">
            <div class="level-bar" id="exp-bar"></div>
            <div class="level-text">CẤP <span id="player-lvl">1</span></div>
        </div>
    </div>

    <!-- Màn hình Menu Bắt đầu -->
    <div id="start-screen" class="screen-overlay">
        <h1>ARCHER.IO</h1>
        <p style="color: #94a3b8; margin-bottom: 20px; font-size: 14px;">WASD di chuyển | Giữ Chuột Trái để kéo cung & thả để bắn</p>
        <input type="text" id="username" placeholder="Nhập tên nhân vật..." maxlength="12" value="CungThulO">
        <button onclick="startGame()">VÀO TRẬN ĐẤU</button>
    </div>

    <!-- Màn hình Game Over -->
    <div id="game-over-screen" class="screen-overlay" style="display: none;">
        <h1 style="color: #ef4444;">BẠN ĐÃ BỊ BẮN HẠ!</h1>
        <p style="font-size: 18px; margin-bottom: 20px;">Tổng điểm đạt được: <span id="final-score" style="color: #f59e0b; font-weight: 800;">0</span></p>
        <button onclick="restartGame()">CHƠI LẠI</button>
    </div>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

window.addEventListener('resize', () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
});

// CẤU HÌNH THẾ GIỚI GAME
const WORLD_SIZE = 3000;
let isGameRunning = false;

// ĐẦU VÀO ĐIỀU KHIỂN
const keys = { w: false, a: false, s: false, d: false };
const mouse = { x: 0, y: 0, isDown: false, chargeTime: 0 };

window.addEventListener('keydown', e => {
    if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keys.w = true;
    if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keys.a = true;
    if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keys.s = true;
    if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keys.d = true;
});

window.addEventListener('keyup', e => {
    if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keys.w = false;
    if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keys.a = false;
    if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keys.s = false;
    if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keys.d = false;
});

window.addEventListener('mousemove', e => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
});

window.addEventListener('mousedown', e => {
    if (e.button === 0 && isGameRunning) mouse.isDown = true;
});

window.addEventListener('mouseup', e => {
    if (e.button === 0 && isGameRunning && mouse.isDown) {
        player.shoot();
        mouse.isDown = false;
        mouse.chargeTime = 0;
    }
});

// MẢNG QUẢN LÝ ĐỐI TƯỢNG
let gems = [];
let arrows = [];
let bots = [];
let particles = [];
let player;

const BOT_NAMES = ["Legolas", "RobinHood", "HawkEye", "SniperGod", "ShadowNinja", "ArcherPro", "Phantom", "DarkKnight"];
const COLORS = ["#ef4444", "#3b82f6", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899", "#06b6d4"];

class Character {
    constructor(x, y, name, color, isBot = false) {
        this.x = x;
        this.y = y;
        this.r = 20;
        this.name = name;
        this.color = color;
        this.isBot = isBot;

        this.level = 1;
        this.exp = 0;
        this.maxExp = 100;
        this.score = 0;
        this.skillPoints = 0;

        // Stats
        this.statDmg = 1;
        this.statSpd = 1;
        this.statHp = 1;
        this.statRate = 1;

        this.maxHp = 100;
        this.hp = 100;
        this.speed = 3.5;
        this.angle = 0;

        this.lastShootTime = 0;
        this.botTargetAngle = 0;
        this.botMoveTimer = 0;
    }

    getDmg() { return 20 + (this.statDmg - 1) * 8; }
    getSpeed() { return 3.5 + (this.statSpd - 1) * 0.4; }
    getMaxHp() { return 100 + (this.statHp - 1) * 25; }
    getCooldown() { return Math.max(200, 600 - (this.statRate - 1) * 70); }

    addExp(amount) {
        this.exp += amount;
        this.score += amount;
        if (this.exp >= this.maxExp) {
            this.exp -= this.maxExp;
            this.level++;
            this.maxExp = Math.floor(this.maxExp * 1.3);
            this.skillPoints++;
            
            // Hồi máu khi nâng cấp
            this.maxHp = this.getMaxHp();
            this.hp = Math.min(this.maxHp, this.hp + 30);

            if (this.isBot) {
                // Bot tự động nâng kỹ năng ngẫu nhiên
                const stats = ['dmg', 'spd', 'hp', 'rate'];
                this.upgradeStat(stats[Math.floor(Math.random() * stats.length)]);
            } else {
                updateUI();
            }
        }
        if (!this.isBot) updateUI();
    }

    upgradeStat(type) {
        if (this.skillPoints <= 0) return;
        if (type === 'dmg') this.statDmg++;
        if (type === 'spd') this.statSpd++;
        if (type === 'hp') { 
            this.statHp++; 
            this.maxHp = this.getMaxHp(); 
            this.hp += 25; 
        }
        if (type === 'rate') this.statRate++;
        this.skillPoints--;
        if (!this.isBot) updateUI();
    }

    shoot(chargeRatio = 1) {
        const now = Date.now();
        if (now - this.lastShootTime < this.getCooldown()) return;
        this.lastShootTime = now;

        const arrowSpeed = 10 + chargeRatio * 8;
        const arrowDmg = this.getDmg() * (0.6 + chargeRatio * 0.8);

        arrows.push(new Arrow(
            this.x + Math.cos(this.angle) * (this.r + 5),
            this.y + Math.sin(this.angle) * (this.r + 5),
            this.angle,
            arrowSpeed,
            arrowDmg,
            this
        ));
    }

    update() {
        // Tự động phục hồi máu chậm
        if (this.hp < this.getMaxHp()) {
            this.hp = Math.min(this.getMaxHp(), this.hp + 0.05);
        }

        if (this.isBot) {
            this.updateBotLogic();
        } else {
            // Cập nhật hướng xoay của Người chơi theo vị trí Con trỏ Chuột
            const screenCenterX = canvas.width / 2;
            const screenCenterY = canvas.height / 2;
            this.angle = Math.atan2(mouse.y - screenCenterY, mouse.x - screenCenterX);

            // Di chuyển người chơi
            let moveX = 0, moveY = 0;
            if (keys.w) moveY -= 1;
            if (keys.s) moveY += 1;
            if (keys.a) moveX -= 1;
            if (keys.d) moveX += 1;

            if (moveX !== 0 && moveY !== 0) {
                moveX *= 0.7071;
                moveY *= 0.7071;
            }

            const spd = this.getSpeed();
            this.x = Math.max(this.r, Math.min(WORLD_SIZE - this.r, this.x + moveX * spd));
            this.y = Math.max(this.r, Math.min(WORLD_SIZE - this.r, this.y + moveY * spd));

            // Tích lực bắn
            if (mouse.isDown) {
                mouse.chargeTime = Math.min(1000, mouse.chargeTime + 16.6);
            }
        }
    }

    updateBotLogic() {
        this.botMoveTimer--;
        if (this.botMoveTimer <= 0) {
            this.botMoveTimer = Math.floor(Math.random() * 60) + 30;
            this.botTargetAngle = Math.random() * Math.PI * 2;
        }

        // Tìm kiếm kẻ địch gần nhất để tấn công
        let nearestTarget = null;
        let minDist = 400;

        const targets = [player, ...bots.filter(b => b !== this)];
        for (let target of targets) {
            if (!target) continue;
            const dist = Math.hypot(target.x - this.x, target.y - this.y);
            if (dist < minDist) {
                minDist = dist;
                nearestTarget = target;
            }
        }

        if (nearestTarget) {
            this.angle = Math.atan2(nearestTarget.y - this.y, nearestTarget.x - this.x);
            if (Math.random() < 0.03) {
                this.shoot(Math.random() * 0.5 + 0.5);
            }
        } else {
            this.angle = this.botTargetAngle;
        }

        // Di chuyển BOT
        const spd = this.getSpeed() * 0.85;
        this.x = Math.max(this.r, Math.min(WORLD_SIZE - this.r, this.x + Math.cos(this.botTargetAngle) * spd));
        this.y = Math.max(this.r, Math.min(WORLD_SIZE - this.r, this.y + Math.sin(this.botTargetAngle) * spd));
    }

    draw(cameraX, cameraY) {
        const screenX = this.x - cameraX;
        const screenY = this.y - cameraY;

        // Vẽ Cánh Cung
        ctx.save();
        ctx.translate(screenX, screenY);
        ctx.rotate(this.angle);

        ctx.strokeStyle = "#78350f";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.arc(10, 0, 18, -Math.PI / 2, Math.PI / 2);
        ctx.stroke();

        // Dây Cung
        ctx.strokeStyle = "#e2e8f0";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(10, -18);
        
        let pullBack = 0;
        if (!this.isBot && mouse.isDown) {
            pullBack = (mouse.chargeTime / 1000) * 12;
        }
        ctx.lineTo(10 - pullBack, 0);
        ctx.lineTo(10, 18);
        ctx.stroke();

        ctx.restore();

        // Vẽ Thân Nhân Vật
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(screenX, screenY, this.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 2.5;
        ctx.stroke();

        // Thanh Máu & Tên Nhân Vật
        const hpPercent = Math.max(0, this.hp / this.getMaxHp());
        ctx.fillStyle = "rgba(0,0,0,0.5)";
        ctx.fillRect(screenX - 25, screenY - this.r - 18, 50, 6);
        ctx.fillStyle = hpPercent > 0.3 ? "#10b981" : "#ef4444";
        ctx.fillRect(screenX - 25, screenY - this.r - 18, 50 * hpPercent, 6);

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 11px Segoe UI";
        ctx.textAlign = "center";
        ctx.fillText(`${this.name} (Lv.${this.level})`, screenX, screenY - this.r - 22);
    }
}

class Arrow {
    constructor(x, y, angle, speed, dmg, owner) {
        this.x = x;
        this.y = y;
        this.angle = angle;
        this.speed = speed;
        this.dmg = dmg;
        this.owner = owner;
        this.life = 120; // Thời gian tồn tại
    }

    update() {
        this.x += Math.cos(this.angle) * this.speed;
        this.y += Math.sin(this.angle) * this.speed;
        this.life--;
    }

    draw(cameraX, cameraY) {
        const screenX = this.x - cameraX;
        const screenY = this.y - cameraY;

        ctx.save();
        ctx.translate(screenX, screenY);
        ctx.rotate(this.angle);

        // Mũi tên
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-12, 0);
        ctx.lineTo(8, 0);
        ctx.stroke();

        // Đầu mũi tên
        ctx.fillStyle = "#f59e0b";
        ctx.beginPath();
        ctx.moveTo(8, -4);
        ctx.lineTo(14, 0);
        ctx.lineTo(8, 4);
        ctx.closePath();
        ctx.fill();

        ctx.restore();
    }
}

class Gem {
    constructor() {
        this.x = Math.random() * (WORLD_SIZE - 100) + 50;
        this.y = Math.random() * (WORLD_SIZE - 100) + 50;
        this.r = 6;
        this.color = COLORS[Math.floor(Math.random() * COLORS.length)];
        this.expValue = Math.floor(Math.random() * 15) + 10;
    }

    draw(cameraX, cameraY) {
        const screenX = this.x - cameraX;
        const screenY = this.y - cameraY;

        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(screenX, screenY, this.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "rgba(255,255,255,0.6)";
        ctx.lineWidth = 1.5;
        ctx.stroke();
    }
}

class Particle {
    constructor(x, y, color) {
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 6;
        this.vy = (Math.random() - 0.5) * 6;
        this.r = Math.random() * 3 + 2;
        this.color = color;
        this.alpha = 1;
    }

    update() {
        this.x += this.vx;
        this.y += this.vy;
        this.alpha -= 0.04;
    }

    draw(cameraX, cameraY) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, this.alpha);
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(this.x - cameraX, this.y - cameraY, this.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
}

// TẠO HẠT HIỆU ỨNG NỔ NĂNG LƯỢNG
function createExplosion(x, y, color, count = 10) {
    for (let i = 0; i < count; i++) {
        particles.push(new Particle(x, y, color));
    }
}

// KHỞI TẠO VÀ BẮT ĐẦU GAME
function startGame() {
    const nameInput = document.getElementById('username').value.trim();
    const name = nameInput || "CungThulO";

    player = new Character(WORLD_SIZE / 2, WORLD_SIZE / 2, name, "#38bdf8", false);
    
    gems = [];
    for (let i = 0; i < 350; i++) gems.push(new Gem());

    bots = [];
    for (let i = 0; i < 12; i++) spawnBot();

    arrows = [];
    particles = [];

    document.getElementById('start-screen').style.display = 'none';
    document.getElementById('game-over-screen').style.display = 'none';
    isGameRunning = true;

    updateUI();
    requestAnimationFrame(gameLoop);
}

function spawnBot() {
    const name = BOT_NAMES[Math.floor(Math.random() * BOT_NAMES.length)] + "_" + Math.floor(Math.random() * 99);
    const color = COLORS[Math.floor(Math.random() * COLORS.length)];
    const x = Math.random() * (WORLD_SIZE - 200) + 100;
    const y = Math.random() * (WORLD_SIZE - 200) + 100;
    bots.push(new Character(x, y, name, color, true));
}

function restartGame() {
    startGame();
}

function upgradeStat(type) {
    if (player) player.upgradeStat(type);
}

function updateUI() {
    document.getElementById('skill-points').innerText = player.skillPoints;
    document.getElementById('player-lvl').innerText = player.level;
    document.getElementById('exp-bar').style.width = `${(player.exp / player.maxExp) * 100}%`;

    document.getElementById('val-dmg').innerText = `Lv.${player.statDmg}`;
    document.getElementById('val-spd').innerText = `Lv.${player.statSpd}`;
    document.getElementById('val-hp').innerText = `Lv.${player.statHp}`;
    document.getElementById('val-rate').innerText = `Lv.${player.statRate}`;

    const btns = document.querySelectorAll('.stat-btn');
    btns.forEach(btn => btn.disabled = player.skillPoints <= 0);
}

function updateLeaderboard() {
    const allPlayers = [player, ...bots].sort((a, b) => b.score - a.score);
    const lbList = document.getElementById('lb-list');
    lbList.innerHTML = '';

    allPlayers.slice(0, 5).forEach((p, index) => {
        const item = document.createElement('div');
        item.className = `lb-item ${p === player ? 'me' : ''}`;
        item.innerHTML = `<span>#${index + 1} ${p.name}</span><span>${p.score}</span>`;
        lbList.appendChild(item);
    });
}

// VÒNG LẶP CHÍNH (GAME LOOP)
function gameLoop() {
    if (!isGameRunning) return;

    // Cập nhật Camera theo Người chơi
    const cameraX = player.x - canvas.width / 2;
    const cameraY = player.y - canvas.height / 2;

    // Xóa màn hình
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Vẽ lưới Map (Grid)
    ctx.strokeStyle = "rgba(255, 255, 255, 0.04)";
    ctx.lineWidth = 1;
    const gridSize = 80;
    const startX = Math.floor(cameraX / gridSize) * gridSize;
    const startY = Math.floor(cameraY / gridSize) * gridSize;

    for (let x = startX; x < cameraX + canvas.width; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x - cameraX, 0);
        ctx.lineTo(x - cameraX, canvas.height);
        ctx.stroke();
    }
    for (let y = startY; y < cameraY + canvas.height; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y - cameraY);
        ctx.lineTo(canvas.width, y - cameraY);
        ctx.stroke();
    }

    // Vẽ Ranh giới bản đồ (Map Bounds)
    ctx.strokeStyle = "#ef4444";
    ctx.lineWidth = 5;
    ctx.strokeRect(-cameraX, -cameraY, WORLD_SIZE, WORLD_SIZE);

    // Cập nhật & Vẽ Gems
    gems.forEach((gem, index) => {
        gem.draw(cameraX, cameraY);

        // Ăn Gem
        const characters = [player, ...bots];
        for (let c of characters) {
            if (Math.hypot(c.x - gem.x, c.y - gem.y) < c.r + gem.r) {
                c.addExp(gem.expValue);
                createExplosion(gem.x, gem.y, gem.color, 4);
                gems.splice(index, 1);
                gems.push(new Gem());
                break;
            }
        }
    });

    // Cập nhật Cung thủ (Player & Bots)
    player.update();
    player.draw(cameraX, cameraY);

    bots.forEach((bot, bIndex) => {
        bot.update();
        bot.draw(cameraX, cameraY);
    });

    // Cập nhật & Vẽ Mũi tên
    arrows.forEach((arrow, aIndex) => {
        arrow.update();
        arrow.draw(cameraX, cameraY);

        // Va chạm Mũi tên với các Cung thủ
        const targets = [player, ...bots];
        for (let target of targets) {
            if (target === arrow.owner) continue;

            if (Math.hypot(target.x - arrow.x, target.y - arrow.y) < target.r) {
                target.hp -= arrow.dmg;
                createExplosion(arrow.x, arrow.y, "#ef4444", 8);

                // Khi bị tiêu diệt
                if (target.hp <= 0) {
                    arrow.owner.addExp(target.score * 0.5 + 100);
                    createExplosion(target.x, target.y, target.color, 25);

                    if (target === player) {
                        isGameRunning = false;
                        document.getElementById('final-score').innerText = player.score;
                        document.getElementById('game-over-screen').style.display = 'flex';
                    } else {
                        bots = bots.filter(b => b !== target);
                        setTimeout(spawnBot, 3000);
                    }
                }

                arrows.splice(aIndex, 1);
                break;
            }
        }

        if (arrow.life <= 0) arrows.splice(aIndex, 1);
    });

    // Cập nhật Hạt hiệu ứng
    particles.forEach((p, index) => {
        p.update();
        p.draw(cameraX, cameraY);
        if (p.alpha <= 0) particles.splice(index, 1);
    });

    // Vẽ Bán kính tích lực ngắm bắn của Người chơi
    if (mouse.isDown) {
        const chargeRatio = mouse.chargeTime / 1000;
        ctx.strokeStyle = "rgba(245, 158, 11, 0.6)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(canvas.width / 2, canvas.height / 2, player.r + 10 + chargeRatio * 10, 0, Math.PI * 2);
        ctx.stroke();
    }

    // Vẽ MINIMAP ở góc trái
    drawMinimap();

    // Cập nhật Bảng xếp hạng định kỳ
    updateLeaderboard();

    requestAnimationFrame(gameLoop);
}

// VẼ BẢN ĐỒ MÔ HÌNH THU NHỎ (MINIMAP)
function drawMinimap() {
    const size = 120;
    const margin = 15;
    const x = margin;
    const y = canvas.height - size - margin;

    ctx.fillStyle = "rgba(15, 23, 42, 0.85)";
    ctx.fillRect(x, y, size, size);
    ctx.strokeStyle = "rgba(255, 255, 255, 0.2)";
    ctx.lineWidth = 1.5;
    ctx.strokeRect(x, y, size, size);

    const scale = size / WORLD_SIZE;

    // Chấm người chơi
    ctx.fillStyle = "#38bdf8";
    ctx.beginPath();
    ctx.arc(x + player.x * scale, y + player.y * scale, 3, 0, Math.PI * 2);
    ctx.fill();

    // Chấm BOT
    ctx.fillStyle = "#ef4444";
    bots.forEach(bot => {
        ctx.beginPath();
        ctx.arc(x + bot.x * scale, y + bot.y * scale, 2, 0, Math.PI * 2);
        ctx.fill();
    });
}
</script>
