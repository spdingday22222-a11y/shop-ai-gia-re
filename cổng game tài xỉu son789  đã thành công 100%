  <script>
    /* CORE LOGIC & STATE MANAGEMENT */
    let userBalance = 57300755;
    let selectedSide = null; // 'TAI' hoặc 'XIU'
    let currentBetTAI = 0;
    let currentBetXIU = 0;
    let pendingBetAmount = 0;
    let currentChipVal = 1000;
    let currentMode = 'MD5';
    let countdown = 26;
    let timerInterval = null;
    let toastTimeout = null;
    let winPopupTimeout = null;
    
    let isSqueezeMode = false; // Bật / Tắt nặn
    let isBowlOpened = false;

    let taiMoney = 265337546;
    let xiuMoney = 237436422;
    let taiUsers = 344;
    let xiuUsers = 357;

    let diceResults = [1, 2, 3];

    // Giả lập Loading Screen
    window.onload = () => {
      let fill = document.getElementById('loader-fill');
      let w = 0;
      let interval = setInterval(() => {
        w += 5;
        fill.style.width = w + '%';
        if (w >= 100) {
          clearInterval(interval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
        }
      }, 30);

      initBoardDragLogic();
      initBowlDragLogic();
    };

    /* THÔNG BÁO TOAST THỰC TẾ */
    function showToast(msg, duration = 2500) {
      let t = document.getElementById('toast');
      t.innerText = msg;
      t.classList.add('show');
      
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        t.classList.remove('show');
      }, duration);
    }

    function formatNumber(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function formatShortMoney(num) {
      if (num >= 1000000) return (num / 1000000) + 'M';
      if (num >= 1000) return (num / 1000) + 'K';
      return num;
    }

    function updateDisplays() {
      document.getElementById('user-balance').innerText = '$ ' + formatNumber(userBalance);
      document.getElementById('arena-balance').innerText = '$ ' + formatNumber(userBalance);
      document.getElementById('tai-amount').innerText = formatNumber(taiMoney);
      document.getElementById('xiu-amount').innerText = formatNumber(xiuMoney);
      document.getElementById('tai-players').innerText = taiUsers;
      document.getElementById('xiu-players').innerText = xiuUsers;

      document.getElementById('val-TAI').innerText = currentBetTAI > 0 ? formatShortMoney(currentBetTAI) : '0';
      document.getElementById('val-XIU').innerText = currentBetXIU > 0 ? formatShortMoney(currentBetXIU) : '0';
    }

    /* KÉO SẢNH MƯỢT MÀ BẰNG CHUỘT TRÁI */
    function initBoardDragLogic() {
      const board = document.getElementById('main-board');
      let isDragging = false;
      let startX, startY, initialLeft, initialTop;

      board.addEventListener('mousedown', (e) => {
        // Tránh kéo sảnh khi nhấp vào nút chức năng hoặc khu cược
        if (e.target.closest('.circle-btn') || e.target.closest('.bet-side') || e.target.closest('.center-plate')) return;
        
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = board.offsetLeft;
        initialTop = board.offsetTop;
        board.style.cursor = 'grabbing';
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        board.style.left = (initialLeft + dx) + 'px';
        board.style.top = (initialTop + dy) + 'px';
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          board.style.cursor = 'grab';
        }
      });
    }

    function enterArena(mode) {
      currentMode = mode;
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);

      let board = document.getElementById('main-board');
      let title = document.getElementById('arena-title');

      if (mode === 'MD5') {
        board.className = 'real-taixiu-board theme-md5';
        title.innerText = 'TÀI XỈU MD5';
        taiMoney = 265337546; xiuMoney = 237436422;
      } else {
        board.className = 'real-taixiu-board theme-thuong';
        title.innerText = 'TÀI XỈU THƯỜNG';
        taiMoney = 443809158; xiuMoney = 216193290;
      }

      // Reset sảnh về vị trí trung tâm
      board.style.left = 'calc(50% - 360px)';
      board.style.top = 'calc(50% - 175px)';

      updateDisplays();
      startNewGameCycle();
    }

    function exitArena() {
      clearInterval(timerInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    /* BẬT / TẮT NẶN BẰNG BÀN TAY NẶN REAL */
    function toggleSqueezeMode() {
      isSqueezeMode = !isSqueezeMode;
      const btn = document.getElementById('btn-squeeze-toggle');
      if (isSqueezeMode) {
        btn.classList.add('active-squeeze');
        showToast('Đã BẬT Chế Độ Nặn Thực Tế 🖐️', 2000);
      } else {
        btn.classList.remove('active-squeeze');
        showToast('Đã TẮT Chế Độ Nặn Thực Tế 🖐️', 2000);
      }
    }

    /* HIỆU ỨNG NẨY SỐ VÀNG CAM THỰC TẾ */
    function bumpMoneyEffect(elementId) {
      let el = document.getElementById(elementId);
      el.classList.remove('bump-orange');
      void el.offsetWidth;
      el.classList.add('bump-orange');
    }

    /* BẮT ĐẦU PHIÊN ĐẾM NGƯỢC 26 GIÂY THỰC TẾ */
    function startNewGameCycle() {
      clearInterval(timerInterval);
      countdown = 26;
      isBowlOpened = false;

      // Reset UI & xúc xắc
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('bowl-cover').style.display = 'none';
      document.getElementById('bowl-cover').style.left = '0px';
      document.getElementById('bowl-cover').style.top = '0px';
      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('timer-text').innerText = countdown;

      document.getElementById('title-TAI').classList.remove('blink-winner');
      document.getElementById('title-XIU').classList.remove('blink-winner');

      timerInterval = setInterval(() => {
        countdown--;
        document.getElementById('timer-text').innerText = countdown;

        // Giả lập tiền cược tăng tự nhiên
        if (countdown > 5) {
          taiMoney += Math.floor(Math.random() * 800000 + 200000);
          xiuMoney += Math.floor(Math.random() * 800000 + 200000);
          if (Math.random() > 0.6) taiUsers++;
          if (Math.random() > 0.6) xiuUsers++;
          updateDisplays();
        }

        if (countdown <= 0) {
          clearInterval(timerInterval);
          finishCountdownAndShowResult();
        }
      }, 1000);
    }

    /* HẾT THỜI GIAN ĐẾM NGƯỢC -> HIỆN XÚC XẮC / BÁT NẶN */
    function finishCountdownAndShowResult() {
      document.getElementById('timer-text').style.display = 'none';

      // Sinh ngẫu nhiên 3 viên xúc xắc
      diceResults = [
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1,
        Math.floor(Math.random() * 6) + 1
      ];

      setCubeFace('cube1', diceResults[0]);
      setCubeFace('cube2', diceResults[1]);
      setCubeFace('cube3', diceResults[2]);

      document.getElementById('dice-container').style.display = 'block';

      if (isSqueezeMode) {
        // Nếu bật nặn -> Nắp xuất hiện đậy đĩa lại để người chơi tự kéo nặn
        document.getElementById('bowl-cover').style.display = 'flex';
        showToast('Hết thời gian! Hãy kéo bát để nặn kết quả 🖐️', 3000);
      } else {
        // Không nặn -> Mở kết quả ngay
        revealResult();
      }
    }

    /* HIỂN THỊ KẾT QUẢ VÀ TÍNH THẮNG THUA */
    function revealResult() {
      if (isBowlOpened) return;
      isBowlOpened = true;

      let sum = diceResults[0] + diceResults[1] + diceResults[2];
      let isTai = sum >= 11;
      let winningSide = isTai ? 'TAI' : 'XIU';

      // Nhấp nháy ảo cửa thắng
      document.getElementById(`title-${winningSide}`).classList.add('blink-winner');

      // Thắng cộng tiền thực tế
      let winMoney = 0;
      if (winningSide === 'TAI' && currentBetTAI > 0) {
        winMoney = currentBetTAI * 1.98;
      } else if (winningSide === 'XIU' && currentBetXIU > 0) {
        winMoney = currentBetXIU * 1.98;
      }

      if (winMoney > 0) {
        userBalance += winMoney;
        updateDisplays();
        showWinPopup(winMoney);
      } else {
        showToast(`Kết quả: ${sum} điểm (${winningSide})`, 3000);
      }

      // Thêm chấm lịch sử cầu
      addHistoryDot(isTai);

      // Chờ 6 giây sau đó sang phiên mới
      setTimeout(() => {
        currentBetTAI = 0;
        currentBetXIU = 0;
        updateDisplays();
        startNewGameCycle();
      }, 6000);
    }

    /* THÔNG BÁO THẮNG CỘNG TIỀN TỰ ĐỘNG BIẾN MẤT SAU 7 GIÂY THỰC TẾ */
    function showWinPopup(amount) {
      const popup = document.getElementById('win-popup');
      const text = document.getElementById('win-amount-text');
      text.innerText = `+$ ${formatNumber(Math.floor(amount))}`;
      popup.classList.add('show');

      if (winPopupTimeout) clearTimeout(winPopupTimeout);
      winPopupTimeout = setTimeout(() => {
        popup.classList.remove('show');
      }, 7000); // 7 Giây thực tế
    }

    function addHistoryDot(isTai) {
      const dotsBox = document.getElementById('history-dots');
      const dot = document.createElement('div');
      dot.className = `dot ${isTai ? 'tai' : 'xiu'}`;
      dotsBox.appendChild(dot);
      if (dotsBox.children.length > 12) {
        dotsBox.removeChild(dotsBox.children[0]);
      }
    }

    function setCubeFace(cubeId, val) {
      let cube = document.getElementById(cubeId);
      let rotations = {
        1: 'rotateY(0deg) rotateX(0deg)',
        6: 'rotateY(180deg) rotateX(0deg)',
        2: 'rotateY(90deg) rotateX(0deg)',
        5: 'rotateY(-90deg) rotateX(0deg)',
        3: 'rotateX(-90deg) rotateY(0deg)',
        4: 'rotateX(90deg) rotateY(0deg)'
      };
      cube.style.transform = rotations[val] || 'rotateY(0deg)';
    }

    /* LOGIC BÁT NẶN KÉO RỜI ĐĨA */
    function initBowlDragLogic() {
      const bowl = document.getElementById('bowl-cover');
      const plate = document.getElementById('center-plate');
      let isDragging = false;
      let startX, startY;

      bowl.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX - bowl.offsetLeft;
        startY = e.clientY - bowl.offsetTop;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        let left = e.clientX - startX;
        let top = e.clientY - startY;
        bowl.style.left = left + 'px';
        bowl.style.top = top + 'px';

        // Tính khoảng cách để xác định đã kéo rời đĩa nặn
        let dist = Math.sqrt(left * left + top * top);
        if (dist > 90 && !isBowlOpened) {
          revealResult();
        }
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });
    }

    /* TÁC VỤ ĐẶT CƯỢC THỰC TẾ */
    function activateBetSide(side) {
      if (countdown <= 3) {
        showToast('Đã hết thời gian đặt cược!', 2000);
        return;
      }
      selectedSide = side;
      pendingBetAmount = currentChipVal;
      document.getElementById('btn-bet-TAI').classList.toggle('active-bet', side === 'TAI');
      document.getElementById('btn-bet-XIU').classList.toggle('active-bet', side === 'XIU');
      document.getElementById('chip-bar').classList.remove('hidden-bet');
    }

    function addChipValue(val, el) {
      document.querySelectorAll('.chip-item-sq').forEach(c => c.classList.remove('selected'));
      if (el) el.classList.add('selected');
      currentChipVal = val;
      pendingBetAmount = val;
    }

    function confirmBet() {
      if (!selectedSide) return;

      if (userBalance < pendingBetAmount) {
        showToast(`Số dư không đủ! Cần $ ${formatNumber(pendingBetAmount)}`, 2500);
        return;
      }

      userBalance -= pendingBetAmount;
      if (selectedSide === 'TAI') {
        currentBetTAI += pendingBetAmount;
        taiMoney += pendingBetAmount;
        bumpMoneyEffect('tai-amount');
      } else {
        currentBetXIU += pendingBetAmount;
        xiuMoney += pendingBetAmount;
        bumpMoneyEffect('xiu-amount');
      }

      updateDisplays();
      showToast(`Cược thành công $ ${formatNumber(pendingBetAmount)} vào ${selectedSide}`, 2000);
      cancelBet();
    }

    function cancelBet() {
      selectedSide = null;
      document.getElementById('btn-bet-TAI').classList.remove('active-bet');
      document.getElementById('btn-bet-XIU').classList.remove('active-bet');
      document.getElementById('chip-bar').classList.add('hidden-bet');
    }

    function doAllIn(side) {
      if (countdown <= 3) {
        showToast('Đã hết thời gian cược!', 2000);
        return;
      }
      if (userBalance <= 0) {
        showToast('Số dư thực tế của bạn là 0, không thể Alin!', 2500);
        return;
      }

      let amount = userBalance;
      userBalance = 0;

      if (side === 'TAI') {
        currentBetTAI += amount;
        taiMoney += amount;
        bumpMoneyEffect('tai-amount');
      } else {
        currentBetXIU += amount;
        xiuMoney += amount;
        bumpMoneyEffect('xiu-amount');
      }

      updateDisplays();
      showToast(`TẤT TAY ALL-IN $ ${formatNumber(amount)} vào ${side}! 🔥`, 3000);
    }

    /* KHUNG CHAT BÊN PHẢI GO88 REAL */
    function toggleChat() {
      let chat = document.getElementById('chat-box');
      chat.style.display = chat.style.display === 'none' ? 'flex' : 'none';
    }

    function sendChat() {
      let input = document.getElementById('chat-input-field');
      let msg = input.value.trim();
      if (!msg) return;

      let list = document.getElementById('chat-msg-list');
      let item = document.createElement('div');
      item.className = 'chat-item';
      item.innerHTML = `<span class="chat-user">hilohi123:</span> <span class="chat-text">${msg}</span>`;
      list.appendChild(item);
      list.scrollTop = list.scrollHeight;
      input.value = '';
    }
  </script>
