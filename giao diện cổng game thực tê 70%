  <script>
    /* Global State Data */
    let userBalance = 57300755;
    let selectedAvatarUrl = 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100';
    let soundEnabled = true;
    let isCamera3D = false;
    
    let currentArena = null;
    let timeLeft = 45;
    let isRolling = false;
    let selectedBetType = null;
    let selectedBetAmount = 50000;

    let myBets = { TÀI: 0, XỈU: 0 };
    let myHistoryLogs = [];
    let currentSessionId = 984512;

    let taiAmount = 658469416;
    let xiuAmount = 790656149;
    let taiPlayers = 425;
    let xiuPlayers = 399;

    // Web Audio Sound Generator (Không phụ thuộc file ngoài)
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    
    function playDiceSound() {
      if (!soundEnabled) return;
      try {
        let osc = audioCtx.createOscillator();
        let gain = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(300 + Math.random() * 200, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.1);
      } catch(e){}
    }

    // SVG Xúc Xắc Sắc Nét 3D
    const diceSVGs = {
      1: `<svg width="26" height="26" viewBox="0 0 100 100"><circle cx="50" cy="50" r="14" fill="#d50000"/></svg>`,
      2: `<svg width="26" height="26" viewBox="0 0 100 100"><circle cx="28" cy="28" r="11" fill="#222"/><circle cx="72" cy="72" r="11" fill="#222"/></svg>`,
      3: `<svg width="26" height="26" viewBox="0 0 100 100"><circle cx="25" cy="25" r="10" fill="#222"/><circle cx="50" cy="50" r="10" fill="#d50000"/><circle cx="75" cy="75" r="10" fill="#222"/></svg>`,
      4: `<svg width="26" height="26" viewBox="0 0 100 100"><circle cx="28" cy="28" r="10" fill="#d50000"/><circle cx="72" cy="28" r="10" fill="#d50000"/><circle cx="28" cy="72" r="10" fill="#d50000"/><circle cx="72" cy="72" r="10" fill="#d50000"/></svg>`,
      5: `<svg width="26" height="26" viewBox="0 0 100 100"><circle cx="25" cy="25" r="9" fill="#222"/><circle cx="75" cy="25" r="9" fill="#222"/><circle cx="50" cy="50" r="9" fill="#d50000"/><circle cx="25" cy="75" r="9" fill="#222"/><circle cx="75" cy="75" r="9" fill="#222"/></svg>`,
      6: `<svg width="26" height="26" viewBox="0 0 100 100"><circle cx="28" cy="22" r="9" fill="#222"/><circle cx="72" cy="22" r="9" fill="#222"/><circle cx="28" cy="50" r="9" fill="#222"/><circle cx="72" cy="50" r="9" fill="#222"/><circle cx="28" cy="78" r="9" fill="#222"/><circle cx="72" cy="78" r="9" fill="#222"/></svg>`
    };

    function formatMoney(num) { return num.toLocaleString('en-US'); }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    /* 1. KHI MO WEBPAGE -> LOADING 1% DEN 100% HOAN TOAN KHONG KHUNG */
    window.addEventListener('load', () => {
      let percent = 1;
      const fill = document.getElementById('loader-fill');
      const text = document.getElementById('loader-text');

      let timer = setInterval(() => {
        percent += Math.floor(Math.random() * 8) + 2;
        if (percent >= 100) {
          percent = 100;
          clearInterval(timer);
          fill.style.width = '100%';
          text.innerText = 'Tải game hoàn tất 100%!';
          setTimeout(() => {
            document.getElementById('loading-screen').classList.remove('active');
            document.getElementById('lobby-screen').classList.add('active');
          }, 400);
        } else {
          fill.style.width = percent + '%';
          text.innerText = `Đang tải tài nguyên ${percent}%...`;
        }
      }, 40);
    });

    /* 2. CHUYỂN CẢNH SANH GAME INNER ARENA REAL 3D */
    function enterArena(type) {
      currentArena = type;
      const screen = document.getElementById('arena-screen');
      const title = document.getElementById('arena-title-text');
      
      if (type === 'HOT_TAIXIU') {
        title.innerText = 'HOT TÀI XỈU CÂN CỬA 3D';
        screen.classList.add('hot-theme');
      } else {
        title.innerText = 'SẢNH TÀI XỈU MD5 REAL 3D';
        screen.classList.remove('hot-theme');
      }

      screen.style.display = 'flex';
      setTimeout(() => screen.classList.add('active'), 10);
      updateBalanceUI();
    }

    function exitArena() {
      const screen = document.getElementById('arena-screen');
      screen.classList.remove('active');
      setTimeout(() => screen.style.display = 'none', 300);
    }

    /* 3. LOGIC DEM NGOAC & XÓC LĂN XÚC XẮC 2s TRƯỚC MÀN HÌNH */
    setInterval(() => {
      if (isRolling) return;

      if (timeLeft > 0) {
        timeLeft--;
        document.getElementById('timer').innerText = timeLeft < 10 ? '0' + timeLeft : timeLeft;

        if (timeLeft > 5) {
          if (Math.random() > 0.3) {
            taiAmount += Math.floor(Math.random() * 500000) + 100000;
            taiPlayers += Math.random() > 0.6 ? 1 : 0;
            document.getElementById('tai-amount').innerText = formatMoney(taiAmount);
            document.getElementById('tai-players').innerText = taiPlayers;
          }
          if (Math.random() > 0.3) {
            xiuAmount += Math.floor(Math.random() * 500000) + 100000;
            xiuPlayers += Math.random() > 0.6 ? 1 : 0;
            document.getElementById('xiu-amount').innerText = formatMoney(xiuAmount);
            document.getElementById('xiu-players').innerText = xiuPlayers;
          }
        }
      } else {
        startRollingSequence();
      }
    }, 1000);

    function startRollingSequence() {
      isRolling = true;
      document.getElementById('timer').style.display = 'none';
      document.getElementById('plate-lid').classList.remove('opened');
      document.getElementById('dice-container').style.display = 'flex';
      document.getElementById('center-plate').classList.add('shaking');

      const d1 = document.getElementById('dice1');
      const d2 = document.getElementById('dice2');
      const d3 = document.getElementById('dice3');

      d1.classList.add('rolling-front');
      d2.classList.add('rolling-front');
      d3.classList.add('rolling-front');

      // Cuộn nhanh phía trước màn hình trong 2 giây
      let soundTimer = setInterval(playDiceSound, 100);

      let rollInterval = setInterval(() => {
        d1.innerHTML = diceSVGs[Math.floor(Math.random() * 6) + 1];
        d2.innerHTML = diceSVGs[Math.floor(Math.random() * 6) + 1];
        d3.innerHTML = diceSVGs[Math.floor(Math.random() * 6) + 1];
      }, 60);

      setTimeout(() => {
        clearInterval(rollInterval);
        clearInterval(soundTimer);
        
        document.getElementById('center-plate').classList.remove('shaking');
        d1.classList.remove('rolling-front');
        d2.classList.remove('rolling-front');
        d3.classList.remove('rolling-front');

        let v1 = Math.floor(Math.random() * 6) + 1;
        let v2 = Math.floor(Math.random() * 6) + 1;
        let v3 = Math.floor(Math.random() * 6) + 1;
        let total = v1 + v2 + v3;
        let result = total >= 11 ? 'TÀI' : 'XỈU';

        d1.innerHTML = diceSVGs[v1];
        d2.innerHTML = diceSVGs[v2];
        d3.innerHTML = diceSVGs[v3];

        // Đóng nắp bát tự động che kết quả
        document.getElementById('plate-lid').style.display = 'flex';

        // Xử lý thắng thua thực tế
        let winAmount = 0;
        let betOnThis = myBets[result];
        if (betOnThis > 0) {
          winAmount = betOnThis * 1.98;
          userBalance += winAmount;
          updateBalanceUI();
          showToast(`🎉 CHÚC MỪNG! Thắng +${formatMoney(winAmount)} VNĐ (${result} ${total}d)`);
        } else if (myBets['TÀI'] > 0 || myBets['XỈU'] > 0) {
          showToast(`❌ Kết quả: ${result} (${total} điểm). Chúc bạn may mắn lần sau!`);
        }

        // Lưu Lịch Sử Đặt Cược Thực Tế
        if (myBets['TÀI'] > 0 || myBets['XỈU'] > 0) {
          myHistoryLogs.unshift({
            id: currentSessionId,
            side: myBets['TÀI'] > 0 ? 'TÀI' : 'XỈU',
            bet: myBets['TÀI'] > 0 ? myBets['TÀI'] : myBets['XỈU'],
            res: `${result} (${total}d)`,
            win: winAmount > 0 ? `+${formatMoney(winAmount)}` : '0'
          });
        }

        currentSessionId++;
        setTimeout(resetNewSession, 5000);

      }, 2000); // ĐÚNG 2 GIÂY
    }

    function resetNewSession() {
      document.getElementById('side-tai').classList.remove('active-win');
      document.getElementById('side-xiu').classList.remove('active-win');
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('timer').style.display = 'block';
      document.getElementById('plate-lid').classList.remove('opened');

      timeLeft = 45;
      isRolling = false;
      myBets = { TÀI: 0, XỈU: 0 };

      document.getElementById('my-tai-bet').style.display = 'none';
      document.getElementById('my-xiu-bet').style.display = 'none';

      taiAmount = 150000000;
      xiuAmount = 140000000;
      taiPlayers = 150;
      xiuPlayers = 130;

      document.getElementById('tai-amount').innerText = formatMoney(taiAmount);
      document.getElementById('xiu-amount').innerText = formatMoney(xiuAmount);
      document.getElementById('tai-players').innerText = taiPlayers;
      document.getElementById('xiu-players').innerText = xiuPlayers;
    }

    function openPlateLid() {
      document.getElementById('plate-lid').classList.add('opened');
    }

    /* 4. CHỨC NĂNG CƯỢC BO TRÒN HUYỆN THOẠI */
    function openBetModal(side) {
      if (isRolling) { showToast('Đang xóc đĩa, vui lòng chờ phiên sau!'); return; }
      selectedBetType = side;
      document.getElementById('bet-modal-title').innerText = `CƯỢC ${side}`;
      document.getElementById('bet-modal').style.display = 'flex';
    }

    function addBetVal(val) {
      selectedBetAmount += val;
      document.getElementById('bet-input').value = formatMoney(selectedBetAmount);
    }

    function setAllIn() {
      selectedBetAmount = userBalance;
      document.getElementById('bet-input').value = formatMoney(selectedBetAmount);
    }

    function confirmBet() {
      if (selectedBetAmount > userBalance) { showToast('Số dư không đủ!'); return; }
      if (selectedBetAmount <= 0) return;

      userBalance -= selectedBetAmount;
      myBets[selectedBetType] += selectedBetAmount;
      updateBalanceUI();

      if (selectedBetType === 'TÀI') {
        document.getElementById('my-tai-bet').innerText = `Đã cược: ${formatMoney(myBets['TÀI'])}`;
        document.getElementById('my-tai-bet').style.display = 'block';
      } else {
        document.getElementById('my-xiu-bet').innerText = `Đã cược: ${formatMoney(myBets['XỈU'])}`;
        document.getElementById('my-xiu-bet').style.display = 'block';
      }

      showToast(`Cược thành công ${formatMoney(selectedBetAmount)} VNĐ vào ${selectedBetType}`);
      closeModal('bet-modal');
      selectedBetAmount = 50000;
      document.getElementById('bet-input').value = '50,000';
    }

    /* 5. USER MODAL, CHỌN AVATAR HOT GIRL / SÁT THỦ */
    function openUserModal() { document.getElementById('user-modal').style.display = 'flex'; }

    function selectAvatar(el, url) {
      document.querySelectorAll('.avatar-item').forEach(item => item.classList.remove('selected'));
      el.classList.add('selected');
      selectedAvatarUrl = url;
    }

    function saveUserProfile() {
      const newName = document.getElementById('user-name-input').value;
      document.getElementById('user-name-display').innerText = newName;
      document.getElementById('main-avatar').style.backgroundImage = `url('${selectedAvatarUrl}')`;
      showToast('🎉 Cập nhật thông tin tài khoản thành công!');
      closeModal('user-modal');
    }

    /* 6. CHỨC NĂNG NẠP & RÚT TIỀN THỰC TẾ */
    function openNapModal() { document.getElementById('nap-modal').style.display = 'flex'; }
    function openRutModal() { 
      document.getElementById('rut-balance-display').innerText = formatMoney(userBalance);
      document.getElementById('rut-modal').style.display = 'flex'; 
    }

    function switchPayTab(el, type) {
      document.querySelectorAll('.pay-tab').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
      document.getElementById('pay-qr-body').style.display = type === 'qr' ? 'block' : 'none';
      document.getElementById('pay-card-body').style.display = type === 'card' ? 'block' : 'none';
    }

    function confirmNapMoney() {
      userBalance += 2000000;
      updateBalanceUI();
      showToast('🎉 Nạp thành công +2,000,000 VNĐ vào tài khoản!');
      closeModal('nap-modal');
    }

    function confirmRutMoney() {
      const amount = parseInt(document.getElementById('rut-amount-input').value) || 0;
      if (amount <= 0 || amount > userBalance) { showToast('Số tiền rút không hợp lệ!'); return; }
      
      userBalance -= amount;
      updateBalanceUI();
      showToast(`🚀 Lệnh rút ${formatMoney(amount)} VNĐ đã gửi thành công!`);
      closeModal('rut-modal');
    }

    /* 7. LỊCH SỬ ĐẶT CƯỢC MODAL */
    function openHistoryBetsModal() {
      const tbody = document.getElementById('history-bets-list');
      tbody.innerHTML = '';
      if (myHistoryLogs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="padding:15px; color:#888;">Chưa có lịch sử cược</td></tr>`;
      } else {
        myHistoryLogs.forEach(log => {
          tbody.innerHTML += `
            <tr style="border-bottom:1px solid #222;">
              <td style="padding:6px;">#${log.id}</td>
              <td style="color:${log.side==='TÀI'?'#ffd700':'#00b4d8'}; font-weight:bold;">${log.side}</td>
              <td>${formatMoney(log.bet)}</td>
              <td>${log.res}</td>
              <td style="color:${log.win!='0'?'#00e676':'#ff5252'}; font-weight:bold;">${log.win}</td>
            </tr>
          `;
        });
      }
      document.getElementById('history-bets-modal').style.display = 'flex';
    }

    /* 8. HELPER SYSTEM FUNCTIONS */
    function updateBalanceUI() {
      document.getElementById('user-balance').innerText = formatMoney(userBalance);
      document.getElementById('arena-balance').innerText = formatMoney(userBalance);
    }

    function openSettingModal() { document.getElementById('setting-modal').style.display = 'flex'; }
    
    function toggleSound() {
      soundEnabled = !soundEnabled;
      document.getElementById('sound-btn').innerText = soundEnabled ? '🔊' : '🔇';
      document.getElementById('sound-toggle').checked = soundEnabled;
      showToast(soundEnabled ? 'Đã bật âm thanh' : 'Đã tắt âm thanh');
    }

    function toggleCamera3D() {
      isCamera3D = !isCamera3D;
      const stage = document.getElementById('arena-stage');
      if (isCamera3D) {
        stage.classList.add('pan-angle');
        showToast('Bật chế độ Soi Góc Nhìn 3D (Camera Panning)');
      } else {
        stage.classList.remove('pan-angle');
        showToast('Về góc nhìn tiêu chuẩn');
      }
    }

    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
  </script>
</body>
</html>
