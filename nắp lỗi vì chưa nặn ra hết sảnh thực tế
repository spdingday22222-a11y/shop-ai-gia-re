  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Arial Black', 'Segoe UI', Tahoma, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #000000;
      color: #ffffff;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #0d0d12 0%, #000000 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 42px; font-weight: 900;
      background: linear-gradient(180deg, #ffe066 0%, #f5a623 45%, #e65c00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 25px rgba(245, 166, 35, 0.8));
      letter-spacing: 3px; text-transform: uppercase;
    }

    .loader-box {
      width: 320px; height: 14px; background: rgba(0,0,0,0.9);
      border: 1.5px solid #ffb703; border-radius: 10px; padding: 2px; margin-top: 25px;
      box-shadow: 0 0 15px rgba(255, 183, 3, 0.4);
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff8000, #ffea00);
      border-radius: 10px; transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffea00;
    }

    /* 2. LOBBY */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #12121c 0%, #050508 60%, #000000 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(8, 8, 12, 0.98);
      border-bottom: 2px solid #ffb703; z-index: 20;
      box-shadow: 0 4px 20px rgba(0,0,0,0.9);
    }

    .user-info { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 44px; height: 44px; border-radius: 10px; border: 2px solid #ffb703; background-size: cover; box-shadow: 0 0 10px rgba(255,183,3,0.5); }
    .balance-box {
      background: #050508; border: 1.5px solid #ffb703;
      border-radius: 18px; padding: 5px 18px; color: #ffea00;
      font-weight: bold; font-size: 16px; text-shadow: 0 0 8px rgba(255, 234, 0, 0.6);
      box-shadow: inset 0 0 8px rgba(0,0,0,0.9);
    }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 220px; height: 280px; border-radius: 20px; border: 2px solid #ffb703;
      display: flex; flex-direction: column; justify-content: space-between; padding: 20px;
      cursor: pointer; transition: transform 0.25s, box-shadow 0.25s;
      background: linear-gradient(180deg, #1a1a26 0%, #06060a 100%);
      box-shadow: 0 0 30px rgba(255, 183, 3, 0.25), inset 0 0 15px rgba(255, 255, 255, 0.05);
    }
    .game-card:hover { transform: translateY(-5px) scale(1.03); box-shadow: 0 0 40px rgba(255, 183, 3, 0.6); }

    .card-title {
      font-size: 22px; font-weight: 900; text-align: center;
      background: linear-gradient(180deg, #ffffff 0%, #ffea00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }
    .card-sub { font-size: 11px; text-align: center; color: #00ffcc; font-weight: bold; letter-spacing: 1px; }

    /* 3. ARENA GAME PLAY */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: #020204; z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
      overflow: hidden;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(5, 5, 8, 0.98); border-bottom: 1.5px solid #ffb703;
      z-index: 20; box-shadow: 0 4px 15px rgba(0,0,0,0.9);
    }

    .btn-back-lobby {
      background: linear-gradient(180deg, #80000a, #4a0005);
      color: #fff; border: 1.5px solid #ffea00; padding: 6px 18px; border-radius: 16px;
      font-weight: bold; cursor: pointer; box-shadow: 0 3px 6px #000;
