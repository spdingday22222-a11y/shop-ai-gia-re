  <!-- POPUP BẢNG SOI CẦU MỞ RỘNG -->
  <div class="chart-modal-overlay" id="chart-modal">
    <div class="chart-modal-box">
      <div class="chart-header">
        <div class="chart-title">📊 BẢNG SOI CẦU TÀI XỈU MD5 - GO88 VIP</div>
        <div class="btn-close-chart" onclick="closeChartModal()">X</div>
      </div>
      <div class="chart-body-wrapper" id="chart-scroll-area">
        <div class="grid-cau-container" id="grid-cau"></div>
      </div>
    </div>
  </div>

  <script>
    let balance = 1500000000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    
    // Quản lý thời gian thực tế toàn cục (50 giây đếm ngược + 10 giây xem/nặn kết quả)
    let globalTimerInterval = null;
    let globalSessionStartTime = Date.now();
    const ROUND_DURATION = 60; 

    let currentResultSide = null;
    let totalTaiAmount = 0;
    let totalXiuAmount = 0;
    let taiPlayersCount = 0;
    let xiuPlayersCount = 0;

    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 },
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 }
    ];

    let isNanMode = false;
    let isDraggingCover = false;
    let coverStartX = 0, coverStartY = 0;
    let coverCurX = 0, coverCurY = 0;

    let isDraggingBoard = false;
    let boardStartX = 0, boardStartY = 0;
    let boardPosX = 0, boardPosY = 0;

    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
        startGlobalGameLoop();
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      initBoardDrag();
      syncGameStateToUI();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn tay (Kéo thả tự do)');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    function openBetPanel(side) {
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Đã chọn cửa ' + side + '. Chọn chip cược!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In toàn bộ số tiền!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      showToast('Đã hủy thao tác cược!');
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược!');
        return;
      }

      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
      
      showToast('Đặt cược thành công ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      const el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      document.getElementById('chip-panel').classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    function initBoardDrag() {
      const board = document.getElementById('game-board-container');

      const onStart = (e) => {
        if (isDraggingCover || e.target.closest('.plate-cover') || e.target.closest('.circle-btn') || e.target.closest('.btn-cuoc-oval') || e.target.closest('.chip-panel-real')) return;
        
        isDraggingBoard = true;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        boardStartX = clientX - boardPosX;
        boardStartY = clientY - boardPosY;
      };

      const onMove = (e) => {
        if (!isDraggingBoard || isDraggingCover) return;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        boardPosX = clientX - boardStartX;
        boardPosY = clientY - boardStartY;
        board.style.transform = `translate(${boardPosX}px, ${boardPosY}px)`;
      };

      const onEnd = () => { isDraggingBoard = false; };

      board.addEventListener('mousedown', onStart);
      window.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      board.addEventListener('touchstart', onStart, { passive: true });
      window.addEventListener('touchmove', onMove, { passive: true });
      window.addEventListener('touchend', onEnd);
    }

    // Vòng lặp thời gian thực tế toàn cục
    function startGlobalGameLoop() {
      if (globalTimerInterval) return;

      globalTimerInterval = setInterval(() => {
        const elapsedSeconds = Math.floor((Date.now() - globalSessionStartTime) / 1000);
        const currentSecondInRound = elapsedSeconds % ROUND_DURATION;

        if (currentSecondInRound === 0) {
          // Bắt đầu phiên mới: Reset toàn bộ tiền và người chơi về 0
          totalTaiAmount = 0;
          totalXiuAmount = 0;
          taiPlayersCount = Math.floor(Math.random() * 20) + 15;
          xiuPlayersCount = Math.floor(Math.random() * 20) + 15;
        }

        if (currentSecondInRound < 50) {
          let timerVal = 50 - currentSecondInRound;
          
          if (document.getElementById('arena-screen').classList.contains('active')) {
            document.getElementById('timer-text').innerText = timerVal < 10 ? '0' + timerVal : timerVal;
            document.getElementById('timer-text').style.display = 'block';
            document.getElementById('dice-container').style.display = 'none';
            document.getElementById('win-overlay').style.display = 'none';
            document.getElementById('plate-cover').style.display = 'none';
            document.getElementById('dim-overlay').classList.remove('active');
            document.getElementById('title-TAI').classList.remove('highlight-pulse');
            document.getElementById('title-XIU').classList.remove('highlight-pulse');
          }

          if (timerVal > 1) {
            // Cơ chế tự động tăng cược từ nhỏ lên lớn, dần dần lên tới vài trăm triệu và gần 2 tỷ rưỡi
            let incrementTai = Math.floor(Math.random() * 45000000) + 2000000;
            let incrementXiu = Math.floor(Math.random() * 45000000) + 2000000;

            totalTaiAmount += incrementTai;
            totalXiuAmount += incrementXiu;

            // Giới hạn cận trên đạt ngưỡng gần 2 tỷ rưỡi (~9.450.000.000)
            if (totalTaiAmount > 9450000000) totalTaiAmount = 9450000000;
            if (totalXiuAmount > 9450000000) totalXiuAmount = 9450000000;

            // Thêm ngẫu nhiên số lượng người chơi cho sinh động
            if (Math.random() > 0.4) {
              taiPlayersCount += Math.floor(Math.random() * 3) + 1;
              xiuPlayersCount += Math.floor(Math.random() * 3) + 1;
            }

            if (document.getElementById('arena-screen').classList.contains('active')) {
              const taiAmtEl = document.getElementById('tai-amount');
              const xiuAmtEl = document.getElementById('xiu-amount');
              const taiPlEl = document.getElementById('tai-players');
              const xiuPlEl = document.getElementById('xiu-players');

              taiAmtEl.innerText = totalTaiAmount.toLocaleString();
              xiuAmtEl.innerText = totalXiuAmount.toLocaleString();
              taiPlEl.innerText = taiPlayersCount;
              xiuPlEl.innerText = xiuPlayersCount;

              // Hiệu ứng nảy mượt mà cho số tiền và số người chơi theo từng lượt
              taiAmtEl.classList.add('bounce-val');
              xiuAmtEl.classList.add('bounce-val');
              taiPlEl.classList.add('bounce-val');
              xiuPlEl.classList.add('bounce-val');

              setTimeout(() => {
                taiAmtEl.classList.remove('bounce-val');
                xiuAmtEl.classList.remove('bounce-val');
                taiPlEl.classList.remove('bounce-val');
                xiuPlEl.classList.remove('bounce-val');
              }, 250);
            }
          }
        } 
        else if (currentSecondInRound === 50) {
          if (document.getElementById('arena-screen').classList.contains('active') && document.getElementById('timer-text').style.display !== 'none') {
            triggerRoundResult();
          }
        }
      }, 1000);
    }

    function syncGameStateToUI() {
      const elapsedSeconds = Math.floor((Date.now() - globalSessionStartTime) / 1000);
      const currentSecondInRound = elapsedSeconds % ROUND_DURATION;

      if (currentSecondInRound < 50) {
        let timerVal = 50 - currentSecondInRound;
        document.getElementById('timer-text').innerText = timerVal < 10 ? '0' + timerVal : timerVal;
        document.getElementById('timer-text').style.display = 'block';
        document.getElementById('dice-container').style.display = 'none';
        document.getElementById('plate-cover').style.display = 'none';
        document.getElementById('dim-overlay').classList.remove('active');
      } else {
        triggerRoundResult();
      }
    }

    function renderSingleDice(diceId, value) {
      const diceEl = document.getElementById(diceId);
      const faceMap = {
        1: [[2,2]],
        2: [[1,1],[3,3]],
        3: [[1,1],[2,2],[3,3]],
        4: [[1,1],[1,3],[3,1],[3,3]],
        5: [[1,1],[1,3],[2,2],[3,1],[3,3]],
        6: [[1,1],[1,3],[2,1],[2,3],[3,1],[3,3]]
      };

      const faces = diceEl.querySelectorAll('.dice-face');
      faces.forEach((face, idx) => {
        face.innerHTML = '';
        let faceVal = value;
        if (idx === 1) faceVal = 7 - value;
        else if (idx === 2) faceVal = (value % 6) + 1;
        else if (idx === 3) faceVal = ((value + 4) % 6) + 1;
        else if (idx === 4) faceVal = ((value + 1) % 6) + 1;
        else if (idx === 5) faceVal = ((value + 3) % 6) + 1;

        const dots = faceMap[faceVal] || faceMap[1];
        dots.forEach(pos => {
          const dot = document.createElement('div');
          dot.className = 'dot';
          dot.style.gridColumn = pos[1];
          dot.style.gridRow = pos[0];
          face.appendChild(dot);
        });
      });
    }

    function triggerRoundResult() {
      document.getElementById('timer-text').style.display = 'none';
      const diceContainer = document.getElementById('dice-container');
      const plateCover = document.getElementById('plate-cover');

      const d1 = Math.floor(Math.random() * 6) + 1;
      const d2 = Math.floor(Math.random() * 6) + 1;
      const d3 = Math.floor(Math.random() * 6) + 1;

      renderSingleDice('dice1', d1);
      renderSingleDice('dice2', d2);
      renderSingleDice('dice3', d3);

      diceContainer.style.display = 'block';

      const total = d1 + d2 + d3;
      currentResultSide = total >= 11 ? 'TAI' : 'XIU';

      historyResults.push({ side: currentResultSide, total: total });

      if (isNanMode) {
        coverCurX = 0;
        coverCurY = 0;
        plateCover.style.transition = 'none';
        plateCover.style.transform = 'translate(0px, 0px)';
        plateCover.style.opacity = '1';
        plateCover.style.display = 'flex';
        
        showToast('Giữ và kéo nắp tự do. Thả tay để mở nắp công bố kết quả!');
        setupCoverDrag(total);
      } else {
        plateCover.style.display = 'none';
        document.getElementById('dim-overlay').classList.remove('active');
        finishRound(total);
      }
    }

    function setupCoverDrag(total) {
      const plateCover = document.getElementById('plate-cover');
      document.getElementById('dim-overlay').classList.add('active');

      const onDragStart = (e) => {
        e.stopPropagation();
        isDraggingCover = true;
        plateCover.style.transition = 'none';
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        coverStartX = clientX - coverCurX;
        coverStartY = clientY - coverCurY;
      };

      const onDragMove = (e) => {
        if (!isDraggingCover) return;
        e.stopPropagation();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        coverCurX = clientX - coverStartX;
        coverCurY = clientY - coverStartY;
        plateCover.style.transform = `translate(${coverCurX}px, ${coverCurY}px)`;
      };

      const onDragEnd = () => {
        if (!isDraggingCover) return;
        cleanup();
        hideCoverSmoothly(total);
      };

      const cleanup = () => {
        isDraggingCover = false;
        plateCover.removeEventListener('mousedown', onDragStart);
        window.removeEventListener('mousemove', onDragMove);
        window.removeEventListener('mouseup', onDragEnd);
        plateCover.removeEventListener('touchstart', onDragStart);
        window.removeEventListener('touchmove', onDragMove);
        window.removeEventListener('touchend', onDragEnd);
      };

      plateCover.addEventListener('mousedown', onDragStart);
      window.addEventListener('mousemove', onDragMove);
      window.addEventListener('mouseup', onDragEnd);
      plateCover.addEventListener('touchstart', onDragStart, { passive: true });
      window.addEventListener('touchmove', onDragMove, { passive: true });
      window.addEventListener('touchend', onDragEnd);
    }

    function hideCoverSmoothly(total) {
      const plateCover = document.getElementById('plate-cover');
      plateCover.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
      plateCover.style.opacity = '0';
      plateCover.style.transform += ' scale(1.4) translate(100px, 100px)';
      
      setTimeout(() => {
        plateCover.style.display = 'none';
        document.getElementById('dim-overlay').classList.remove('active');
        finishRound(total);
      }, 300);
    }

    function finishRound(total) {
      const winSide = currentResultSide;
      // Hiệu ứng nhấp nháy sinh động thực tế khi về TÀI hoặc XỈU
      const titleEl = document.getElementById('title-' + winSide);
      titleEl.classList.add('highlight-pulse');

      let wonAmount = 0;
      if (confirmedBets[winSide] > 0) {
        const rawWin = confirmedBets[winSide] * 2;
        const fee = rawWin * 0.02;
        wonAmount = rawWin - fee;

        balance += wonAmount;
        // Giới hạn số dư tối đa lên tới ~2,5 tỷ
        if (balance > 26600000000) balance = 26600000000;

        document.getElementById('user-balance').innerText = '$ ' + Math.floor(balance).toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + Math.floor(balance).toLocaleString();

        const winOverlay = document.getElementById('win-overlay');
        winOverlay.innerText = '+' + Math.floor(wonAmount).toLocaleString();
        winOverlay.style.display = 'block';
      }

      showToast('Kết quả: ' + total + ' (' + winSide + ')');

      confirmedBets = { TAI: 0, XIU: 0 };
      ['TAI', 'XIU'].forEach(s => {
        const el = document.getElementById('val-' + s);
        el.innerText = 'CƯỢC';
        el.className = 'bet-text-val label-cuoc';
      });
    }

    function openChartModal() {
      document.getElementById('chart-modal').classList.add('active');
      renderChartGrid();
      initChartDrag();
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    function renderChartGrid() {
      const container = document.getElementById('grid-cau');
      container.innerHTML = '';

      let columns = [];
      let currentCol = [];
      let lastSide = null;

      historyResults.forEach(item => {
        if (!lastSide || item.side === lastSide) {
          if (currentCol.length >= 5) {
            columns.push(currentCol);
            currentCol = [item];
          } else {
            currentCol.push(item);
          }
        } else {
          columns.push(currentCol);
          currentCol = [item];
        }
        lastSide = item.side;
      });
      if (currentCol.length > 0) columns.push(currentCol);

      while (columns.length < 20) {
        columns.push([]);
      }

      columns.forEach(colData => {
        for (let r = 0; r < 5; r++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';
          if (colData[r]) {
            const dot = document.createElement('div');
            dot.className = 'dot-result ' + (colData[r].side === 'TAI' ? 'tai' : 'xiu');
            dot.innerText = colData[r].total;
            cell.appendChild(dot);
          }
          container.appendChild(cell);
        }
      });
    }

    function initChartDrag() {
      const area = document.getElementById('chart-scroll-area');
      let isDown = false;
      let startX;
      let scrollLeft;

      area.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - area.offsetLeft;
        scrollLeft = area.scrollLeft;
      });
      area.addEventListener('mouseleave', () => { isDown = false; });
      area.addEventListener('mouseup', () => { isDown = false; });
      area.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - area.offsetLeft;
        const walk = (x - startX) * 2;
        area.scrollLeft = scrollLeft - walk;
      });
    }
  </script>
</body>
</html>
