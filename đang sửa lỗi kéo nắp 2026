  <script>
    // State Game
    let balance = 1096000;
    let currentBetSide = null;
    let tempBetAmount = 0;
    let confirmedBets = { TAI: 0, XIU: 0 };
    let timer = 15;
    let timerInterval = null;
    let currentSessionId = 5122;

    // Lịch sử kết quả cầu (Mẫu thực tế có bệt)
    let historyResults = [
      { side: 'TAI', total: 14 }, { side: 'TAI', total: 12 }, { side: 'XIU', total: 8 },
      { side: 'XIU', total: 6 }, { side: 'XIU', total: 9 }, { side: 'XIU', total: 5 },
      { side: 'XIU', total: 7 }, { side: 'XIU', total: 10 }, 
      { side: 'TAI', total: 15 }, { side: 'TAI', total: 11 }, { side: 'TAI', total: 13 }
    ];

    // Lịch sử cược cá nhân thực tế (Theo hình chuẩn Sunwin/Go88)
    let userBetHistory = [
      { session: 5122, time: '28-04-2023 00:29', betSide: 'XIU', totalBet: 200000160, winAmount: -200000160, detail: 'Đặt Xỉu Kết quả 6-3-4 Tài, Tổng đặt 200,000,160 Hoàn trả 0, Nhận 0' },
      { session: 5121, time: '28-04-2023 00:28', betSide: 'XIU', totalBet: 300000000, winAmount: -300000000, detail: 'Đặt Xỉu Kết quả 6-5-1 Tài, Tổng đặt 300,000,000 Hoàn trả 0, Nhận 0' },
      { session: 5120, time: '28-04-2023 00:27', betSide: 'TAI', totalBet: 300000000, winAmount: -300000000, detail: 'Đặt Tài Kết quả 6-1-2 Xỉu, Tổng đặt 300,000,000 Hoàn trả 0, Nhận 0' },
      { session: 5119, time: '28-04-2023 00:26', betSide: 'XIU', totalBet: 100000000, winAmount: -100000000, detail: 'Đặt Xỉu Kết quả 3-4-4 Tài, Tổng đặt 100,000,000 Hoàn trả 0, Nhận 0' },
      { session: 5117, time: '28-04-2023 00:24', betSide: 'TAI', totalBet: 69600000, winAmount: -69600000, detail: 'Đặt Tài Kết quả 2-4-4 Xỉu, Tổng đặt 69,600,000 Hoàn trả 0, Nhận 0' },
      { session: 5116, time: '28-04-2023 00:23', betSide: 'XIU', totalBet: 10000000, winAmount: 19800000, detail: 'Đặt Xỉu Kết quả 2-1-4 Xỉu, Tổng đặt 10,000,000 Hoàn trả 0, Nhận 19,800,000' }
    ];

    // Chế độ nặn
    let isNanMode = false;
    let isDraggingCover = false;
    let coverStartX = 0, coverStartY = 0;
    let coverCurX = 0, coverCurY = 0;

    // Loading Bar
    let loadProgress = 0;
    const loaderFill = document.getElementById('loader-fill');
    const loadInt = setInterval(() => {
      loadProgress += 4;
      loaderFill.style.width = loadProgress + '%';
      if (loadProgress >= 100) {
        clearInterval(loadInt);
        document.getElementById('loading-screen').classList.remove('active');
        document.getElementById('lobby-screen').classList.add('active');
      }
    }, 30);

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      startTimer();
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
      clearInterval(timerInterval);
    }

    function toggleNanMode() {
      isNanMode = !isNanMode;
      const btn = document.getElementById('btn-nan');
      if (isNanMode) {
        btn.classList.add('active');
        showToast('Đã bật chế độ Nặn tay');
      } else {
        btn.classList.remove('active');
        showToast('Đã tắt chế độ Nặn');
      }
    }

    function openBetPanel(side) {
      currentBetSide = side;
      tempBetAmount = 0;
      updateBetDisplay();
      document.getElementById('chip-panel').classList.remove('hidden');
      showToast('Đã chọn cửa ' + side + '. Chọn chip cược!');
    }

    function addChip(val) {
      if (!currentBetSide) return;
      if (tempBetAmount + val > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      tempBetAmount += val;
      updateBetDisplay();
    }

    function allInBet() {
      if (!currentBetSide) return;
      if (balance <= 0) {
        showToast('Số dư hiện tại bằng 0!');
        return;
      }
      tempBetAmount = balance;
      updateBetDisplay();
      showToast('Đã chọn All-In toàn bộ số tiền!');
    }

    function updateBetDisplay() {
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (tempBetAmount > 0) {
          el.innerText = tempBetAmount.toLocaleString();
          el.className = 'bet-text-val active-bet';
        } else {
          el.innerText = '0';
          el.className = 'bet-text-val';
        }
      }
    }

    function cancelBet() {
      showToast('Đã hủy thao tác cược!');
      if (currentBetSide) {
        const el = document.getElementById('val-' + currentBetSide);
        if (confirmedBets[currentBetSide] === 0) {
          el.innerText = 'CƯỢC';
          el.className = 'bet-text-val label-cuoc';
        } else {
          el.innerText = confirmedBets[currentBetSide].toLocaleString();
          el.className = 'bet-text-val active-bet';
        }
      }
      tempBetAmount = 0;
      currentBetSide = null;
      document.getElementById('chip-panel').classList.add('hidden');
    }

    function confirmBet() {
      if (!currentBetSide || tempBetAmount <= 0) {
        showToast('Vui lòng chọn số tiền cược!');
        return;
      }

      balance -= tempBetAmount;
      confirmedBets[currentBetSide] += tempBetAmount;
      
      document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
      document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();
      
      showToast('Đặt cược thành công ' + tempBetAmount.toLocaleString() + 'đ vào ' + currentBetSide);

      const el = document.getElementById('val-' + currentBetSide);
      el.innerText = confirmedBets[currentBetSide].toLocaleString();
      el.className = 'bet-text-val active-bet';

      document.getElementById('chip-panel').classList.add('hidden');
      tempBetAmount = 0;
      currentBetSide = null;
    }

    /* ĐỒNG HỒ ĐẾM NGƯỢC & HIỂN THỊ KẾT QUẢ THỜI GIAN THỰC */
    function startTimer() {
      clearInterval(timerInterval);
      timer = 15;
      currentSessionId++;
      document.getElementById('lobby-session-id').innerText = '#' + currentSessionId;

      document.getElementById('timer-text').style.display = 'block';
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('win-overlay').style.display = 'none';
      document.getElementById('plate-cover').style.display = 'none';
      document.getElementById('dim-overlay').classList.remove('active');
      document.getElementById('title-TAI').classList.remove('highlight-pulse');
      document.getElementById('title-XIU').classList.remove('highlight-pulse');

      // Reset cược
      confirmedBets = { TAI: 0, XIU: 0 };
      document.getElementById('val-TAI').innerText = 'CƯỢC';
      document.getElementById('val-TAI').className = 'bet-text-val label-cuoc';
      document.getElementById('val-XIU').innerText = 'CƯỢC';
      document.getElementById('val-XIU').className = 'bet-text-val label-cuoc';

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer < 10 ? '0' + timer : timer;

        if (timer <= 0) {
          clearInterval(timerInterval);
          renderDiceResult();
        }
      }, 1000);
    }

    function renderDiceResult() {
      document.getElementById('timer-text').style.display = 'none';
      const diceContainer = document.getElementById('dice-container');
      const plateCover = document.getElementById('plate-cover');

      // Tạo kết quả ngẫu nhiên
      const d1 = Math.floor(Math.random() * 6) + 1;
      const d2 = Math.floor(Math.random() * 6) + 1;
      const d3 = Math.floor(Math.random() * 6) + 1;
      const total = d1 + d2 + d3;
      const winSide = total >= 11 ? 'TAI' : 'XIU';

      drawDice('dice1', d1);
      drawDice('dice2', d2);
      drawDice('dice3', d3);

      diceContainer.style.display = 'block';

      if (isNanMode) {
        document.getElementById('dim-overlay').classList.add('active');
        plateCover.style.display = 'flex';
        plateCover.style.transform = 'translate(0px, 0px)';
        showToast('Kéo nắp bát để nặn kết quả!');
      } else {
        finishRound(winSide, total, d1, d2, d3);
      }
    }

    function drawDice(id, value) {
      const el = document.getElementById(id);
      el.innerHTML = '';
      const pips = {
        1: [5], 2: [1, 9], 3: [1, 5, 9],
        4: [1, 3, 7, 9], 5: [1, 3, 5, 7, 9], 6: [1, 3, 4, 6, 7, 9]
      };

      if (value === 1) {
        const p = document.createElement('div');
        p.className = 'pip center-red';
        el.appendChild(p);
      } else {
        for (let i = 1; i <= 9; i++) {
          const p = document.createElement('div');
          p.className = 'pip p-' + i;
          if (pips[value].includes(i)) p.style.display = 'block';
          el.appendChild(p);
        }
      }
    }

    function finishRound(winSide, total, d1, d2, d3) {
      document.getElementById('dim-overlay').classList.remove('active');
      document.getElementById('title-' + winSide).classList.add('highlight-pulse');

      historyResults.push({ side: winSide, total: total });

      // Tính tiền cược
      const betUser = confirmedBets[winSide];
      const lossUser = confirmedBets[winSide === 'TAI' ? 'XIU' : 'TAI'];
      let winText = '';

      const nowStr = new Date().toLocaleString('vi-VN');

      if (betUser > 0) {
        const winVal = Math.floor(betUser * 1.98);
        balance += winVal;
        document.getElementById('user-balance').innerText = '$ ' + balance.toLocaleString();
        document.getElementById('arena-balance').innerText = '$ ' + balance.toLocaleString();

        winText = '+' + winVal.toLocaleString();
        document.getElementById('win-overlay').innerText = winText;
        document.getElementById('win-overlay').style.display = 'block';

        userBetHistory.unshift({
          session: currentSessionId,
          time: nowStr,
          betSide: winSide,
          totalBet: betUser,
          winAmount: winVal - betUser,
          detail: `Đặt ${winSide} Kết quả ${d1}-${d2}-${d3} ${winSide}, Tổng đặt ${betUser.toLocaleString()} Hoàn trả 0, Nhận ${winVal.toLocaleString()}`
        });
      } else if (lossUser > 0) {
        userBetHistory.unshift({
          session: currentSessionId,
          time: nowStr,
          betSide: winSide === 'TAI' ? 'XIU' : 'TAI',
          totalBet: lossUser,
          winAmount: -lossUser,
          detail: `Đặt ${winSide === 'TAI' ? 'Xỉu' : 'Tài'} Kết quả ${d1}-${d2}-${d3} ${winSide}, Tổng đặt ${lossUser.toLocaleString()} Hoàn trả 0, Nhận 0`
        });
      }

      setTimeout(() => startTimer(), 5000);
    }

    /* DRAG BÁT NẶN THỰC TẾ */
    const plateCover = document.getElementById('plate-cover');
    plateCover.addEventListener('pointerdown', (e) => {
      isDraggingCover = true;
      coverStartX = e.clientX;
      coverStartY = e.clientY;
      plateCover.setPointerCapture(e.pointerId);
    });

    plateCover.addEventListener('pointermove', (e) => {
      if (!isDraggingCover) return;
      const dx = e.clientX - coverStartX;
      const dy = e.clientY - coverStartY;
      plateCover.style.transform = `translate(${dx}px, ${dy}px)`;

      const dist = Math.hypot(dx, dy);
      if (dist > 90) {
        isDraggingCover = false;
        plateCover.style.display = 'none';
        const lastRes = historyResults[historyResults.length - 1] || { side: 'TAI', total: 12 };
        finishRound(lastRes.side, lastRes.total, 4, 4, 4);
      }
    });

    plateCover.addEventListener('pointerup', () => { isDraggingCover = false; });

    /* 4. RENDER BẢNG SOI CẦU 5 CỘT DỌC SỐ CHẤM TRÒN & BỆT SANG BÊN CẠNH */
    function renderChartGrid() {
      const container = document.getElementById('grid-cau');
      container.innerHTML = '';

      // Ma trận 5 hàng
      let columns = [];
      let currentCol = [];
      let currentSide = null;

      historyResults.forEach(res => {
        if (!currentSide) {
          currentSide = res.side;
          currentCol.push(res);
        } else if (res.side === currentSide) {
          if (currentCol.length < 5) {
            currentCol.push(res);
          } else {
            // Bệt quá 5 -> Tràn bệt sang cột bên cạnh
            columns.push({ side: currentSide, items: [...currentCol] });
            currentCol = [res];
          }
        } else {
          columns.push({ side: currentSide, items: [...currentCol] });
          currentSide = res.side;
          currentCol = [res];
        }
      });
      if (currentCol.length > 0) {
        columns.push({ side: currentSide, items: [...currentCol] });
      }

      // Render các ô
      columns.forEach(col => {
        for (let row = 0; row < 5; row++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';

          if (col.items[row]) {
            const item = col.items[row];
            const dot = document.createElement('div');
            dot.className = `dot-result ${item.side.toLowerCase()}`;
            dot.innerText = item.total;
            cell.appendChild(dot);
          }
          container.appendChild(cell);
        }
      });
    }

    function openChartModal() {
      renderChartGrid();
      document.getElementById('chart-modal').classList.add('active');
    }

    function closeChartModal() {
      document.getElementById('chart-modal').classList.remove('active');
    }

    /* 5. DRAGGABLE & EXPANDABLE BẢNG LỊCH SỬ CƯỢC */
    function renderHistoryTable() {
      const tbody = document.getElementById('history-table-body');
      tbody.innerHTML = '';

      userBetHistory.forEach(item => {
        const tr = document.createElement('tr');
        const isWin = item.winAmount > 0;
        const winClass = isWin ? 'val-win' : 'val-loss';
        const winTxt = isWin ? '+' + item.winAmount.toLocaleString() : item.winAmount.toLocaleString();

        tr.innerHTML = `
          <td>${item.session}</td>
          <td>${item.time}</td>
          <td>${item.totalBet.toLocaleString()}</td>
          <td class="${winClass}">${winTxt}</td>
          <td style="text-align: left; font-size:11px; max-width:280px; font-weight:normal;">${item.detail}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function openHistoryModal() {
      renderHistoryTable();
      document.getElementById('history-modal').classList.add('active');
    }

    function closeHistoryModal() {
      document.getElementById('history-modal').classList.remove('active');
    }

    function toggleExpandHistory() {
      const box = document.getElementById('history-box');
      box.classList.toggle('expanded');
    }

    /* TÍNH NĂNG KÉO THẢ BẢNG LỊCH SỬ (DRAGGABLE) */
    function makeDraggable(boxId, handleId) {
      const box = document.getElementById(boxId);
      const handle = document.getElementById(handleId);
      let isDragging = false;
      let startX, startY, initialLeft, initialTop;

      handle.addEventListener('mousedown', (e) => {
        if (box.classList.contains('expanded')) return;
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        const rect = box.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;
        box.style.position = 'absolute';
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        
        let newLeft = initialLeft + dx;
        let newTop = initialTop + dy;

        // Giới hạn trong màn hình sảnh
        newLeft = Math.max(10, Math.min(window.innerWidth - box.offsetWidth - 10, newLeft));
        newTop = Math.max(10, Math.min(window.innerHeight - box.offsetHeight - 10, newTop));

        box.style.left = newLeft + 'px';
        box.style.top = newTop + 'px';
      });

      window.addEventListener('mouseup', () => { isDragging = false; });
    }

    makeDraggable('history-box', 'history-drag-header');
    makeDraggable('chart-box', 'chart-drag-header');

    /* TÍNH NĂNG KÉO MƯỢT LƯỚI SOI CẦU (SMOOTH DRAG SCROLL) */
    const chartWrapper = document.getElementById('chart-scroll-area');
    let isMouseDown = false;
    let startX, scrollLeft;

    chartWrapper.addEventListener('mousedown', (e) => {
      isMouseDown = true;
      startX = e.pageX - chartWrapper.offsetLeft;
      scrollLeft = chartWrapper.scrollLeft;
    });
    chartWrapper.addEventListener('mouseleave', () => { isMouseDown = false; });
    chartWrapper.addEventListener('mouseup', () => { isMouseDown = false; });
    chartWrapper.addEventListener('mousemove', (e) => {
      if (!isMouseDown) return;
      e.preventDefault();
      const x = e.pageX - chartWrapper.offsetLeft;
      const walk = (x - startX) * 2;
      chartWrapper.scrollLeft = scrollLeft - walk;
    });
  </script>
</body>
</html>
