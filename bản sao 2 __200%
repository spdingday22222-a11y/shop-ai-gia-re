  <script>
    // --- BIẾN TOÀN CỤC & TRẠNG THÁI ---
    let userBalance = 57300755;
    let selectedSide = null; // 'TAI' hoặc 'XIU'
    let currentSelectedChip = null; // Giá trị chip đang được chọn
    let selectedChipElem = null; // Phần tử HTML chip đang chọn
    let activeBetAmount = 0; // Tiền tạm tính chưa bấm "ĐẶT CƯỢC"
    let confirmedBets = { TAI: 0, XIU: 0 }; // Tiền đã chốt
    
    let timer = 26;
    let timerInterval = null;
    let isSqueezeMode = false;
    let currentGameType = 'MD5';
    let isRolling = false;
    let diceResults = [1, 2, 3];

    // --- KHỞI TẠO GAME ---
    window.onload = function() {
      let fill = document.getElementById('loader-fill');
      let w = 0;
      let loadInt = setInterval(() => {
        w += 5;
        fill.style.width = w + '%';
        if(w >= 100) {
          clearInterval(loadInt);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
          updateBalanceDisplay();
        }
      }, 30);

      initBowlDrag();
    };

    function formatNum(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function updateBalanceDisplay() {
      document.getElementById('user-balance').innerText = "$ " + formatNum(userBalance);
      document.getElementById('arena-balance').innerText = "$ " + formatNum(userBalance);
    }

    function showToast(msg, duration = 2500) {
      let toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, duration);
    }

    // --- ENTER / EXIT ARENA ---
    function enterArena(type) {
      currentGameType = type;
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => {
        document.getElementById('arena-screen').classList.add('active');
      }, 10);

      let board = document.getElementById('main-board');
      let title = document.getElementById('arena-title');
      if(type === 'MD5') {
        board.className = "real-taixiu-board theme-md5";
        title.innerText = "TÀI XỈU MD5";
      } else {
        board.className = "real-taixiu-board theme-thuong";
        title.innerText = "TÀI XỈU THƯỜNG";
      }

      resetRoundState();
      startTimer();
    }

    function exitArena() {
      clearInterval(timerInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    // --- LOGIC XỬ LÝ ĐẶT CƯỢC ---
    function handleBetClick(side) {
      if(timer <= 3) {
        showToast("Hết thời gian đặt cược phiên này!");
        return;
      }

      // Đổi cửa cược nếu nhấn cửa khác
      if(selectedSide !== side) {
        selectedSide = side;
        document.getElementById('btn-bet-TAI').classList.remove('active-bet');
        document.getElementById('btn-bet-XIU').classList.remove('active-bet');
        document.getElementById('btn-bet-' + side).classList.add('active-bet');
        
        // Hiện thanh chip cược
        document.getElementById('chip-bar').classList.remove('hidden-bet');
      }

      // Giữ nguyên số 0 cho ô tiền cược tạm thời nếu chưa từng chọn & chốt chip
      updateBetValDisplay();
    }

    function selectChip(val, elem) {
      if(!selectedSide) {
        showToast("Vui lòng chọn cửa Tài hoặc Xỉu trước!");
        return;
      }

      // NẾU LÀ CHIP ĐÃ ĐƯỢC CHỌN -> ẤN LẦN NỮA MỚI TỰ ĐỘNG CỘNG DỒN TIỀN
      if(currentSelectedChip === val && selectedChipElem === elem) {
        if(userBalance < (activeBetAmount + val)) {
          showToast("Số dư tài khoản không đủ!");
          return;
        }
        activeBetAmount += val;
        updateBetValDisplay();
      } else {
        // Lần ấn đầu tiên: Chỉ highlight chip, KHÔNG cộng dồn tiền
        if(selectedChipElem) selectedChipElem.classList.remove('selected');
        currentSelectedChip = val;
        selectedChipElem = elem;
        elem.classList.add('selected');
      }
    }

    function updateBetValDisplay() {
      let valTai = document.getElementById('val-TAI');
      let valXiu = document.getElementById('val-XIU');

      if(selectedSide === 'TAI') {
        valTai.innerText = formatNum(confirmedBets.TAI + activeBetAmount);
      } else if(selectedSide === 'XIU') {
        valXiu.innerText = formatNum(confirmedBets.XIU + activeBetAmount);
      }
    }

    function confirmBet() {
      if(!selectedSide || activeBetAmount <= 0) {
        showToast("Vui lòng chọn chip để đặt cược!");
        return;
      }

      if(userBalance < activeBetAmount) {
        showToast("Số dư không đủ!");
        return;
      }

      userBalance -= activeBetAmount;
      confirmedBets[selectedSide] += activeBetAmount;
      activeBetAmount = 0;
      
      updateBalanceDisplay();
      updateBetValDisplay();
      showToast("Đặt cược thành công!");

      // Ẩn thanh chip sau khi đặt cược thành công
      cancelBet();
    }

    function cancelBet() {
      activeBetAmount = 0;
      selectedSide = null;
      currentSelectedChip = null;
      if(selectedChipElem) {
        selectedChipElem.classList.remove('selected');
        selectedChipElem = null;
      }

      document.getElementById('btn-bet-TAI').classList.remove('active-bet');
      document.getElementById('btn-bet-XIU').classList.remove('active-bet');
      document.getElementById('chip-bar').classList.add('hidden-bet');

      document.getElementById('val-TAI').innerText = formatNum(confirmedBets.TAI);
      document.getElementById('val-XIU').innerText = formatNum(confirmedBets.XIU);
    }

    function doAllIn(side) {
      if(timer <= 3) {
        showToast("Hết thời gian cược!");
        return;
      }
      if(userBalance <= 0) {
        showToast("Số dư không đủ để Alin!");
        return;
      }

      selectedSide = side;
      activeBetAmount = userBalance;
      confirmBet();
    }

    // --- GAME LOOP & ĐẾM NGƯỢC ---
    function startTimer() {
      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer > 0 ? timer : "00";

        // Tạo biến động ngẫu nhiên cho số người chơi & tiền bàn cược
        if(timer > 3) {
          let addTai = Math.floor(Math.random() * 5000000);
          let addXiu = Math.floor(Math.random() * 5000000);
          let curTai = parseInt(document.getElementById('tai-amount').innerText.replace(/\./g, '')) + addTai;
          let curXiu = parseInt(document.getElementById('xiu-amount').innerText.replace(/\./g, '')) + addXiu;
          document.getElementById('tai-amount').innerText = formatNum(curTai);
          document.getElementById('xiu-amount').innerText = formatNum(curXiu);
        }

        if(timer === 3) {
          cancelBet(); // Khóa cược
          showToast("Khóa cược! Đang chuẩn bị xóc đĩa...");
        }

        if(timer <= 0) {
          clearInterval(timerInterval);
          rollDiceSequence();
        }
      }, 1000);
    }

    function resetRoundState() {
      timer = 26;
      confirmedBets = { TAI: 0, XIU: 0 };
      activeBetAmount = 0;
      selectedSide = null;
      currentSelectedChip = null;

      document.getElementById('val-TAI').innerText = "0";
      document.getElementById('val-XIU').innerText = "0";
      document.getElementById('title-TAI').classList.remove('blink-winner');
      document.getElementById('title-XIU').classList.remove('blink-winner');
      document.getElementById('win-popup').classList.remove('show');
      document.getElementById('lose-popup').classList.remove('show');
      
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('timer-text').style.display = 'block';
      
      let bowl = document.getElementById('bowl-cover');
      bowl.style.display = 'none';
      bowl.style.transform = 'translate(0px, 0px)';
    }

    // --- XÓC XÚC XẮC 3D VÀ TRẢ KẾT QUẢ ---
    function rollDiceSequence() {
      document.getElementById('timer-text').style.display = 'none';
      let diceBox = document.getElementById('dice-container');
      diceBox.style.display = 'block';

      let cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];
      cubes.forEach(c => c.classList.add('rolling'));

      setTimeout(() => {
        cubes.forEach(c => c.classList.remove('rolling'));

        // Kết quả ngẫu nhiên 3 xúc xắc
        diceResults = [
          Math.floor(Math.random() * 6) + 1,
          Math.floor(Math.random() * 6) + 1,
          Math.floor(Math.random() * 6) + 1
        ];

        setCubeFaces(cubes[0], diceResults[0]);
        setCubeFaces(cubes[1], diceResults[1]);
        setCubeFaces(cubes[2], diceResults[2]);

        if(isSqueezeMode) {
          showToast("Bắt đầu nặn bát!");
          document.getElementById('bowl-cover').style.display = 'flex';
        } else {
          setTimeout(finishRound, 800);
        }
      }, 1200);
    }

    function setCubeFaces(cube, val) {
      let rotations = {
        1: 'rotateY(0deg)',
        6: 'rotateY(180deg)',
        2: 'rotateY(90deg)',
        5: 'rotateY(-90deg)',
        3: 'rotateX(-90deg)',
        4: 'rotateX(90deg)'
      };
      cube.style.transform = rotations[val];
    }

    function finishRound() {
      let sum = diceResults[0] + diceResults[1] + diceResults[2];
      let winSide = sum >= 11 ? 'TAI' : 'XIU';

      // Hiệu ứng nhấp nháy cửa thắng
      document.getElementById('title-' + winSide).classList.add('blink-winner');

      // Thêm nút kết quả vào lịch sử cầu
      let dotsContainer = document.getElementById('history-dots');
      let newDot = document.createElement('div');
      newDot.className = "dot " + (winSide === 'TAI' ? 'tai' : 'xiu');
      dotsContainer.appendChild(newDot);
      if(dotsContainer.children.length > 10) {
        dotsContainer.removeChild(dotsContainer.children[0]);
      }

      // Xử lý cộng tiền hoặc báo thua
      let userWon = confirmedBets[winSide];
      let userLost = confirmedBets[winSide === 'TAI' ? 'XIU' : 'TAI'];

      if(userWon > 0) {
        let winAmount = userWon * 2;
        userBalance += winAmount;
        updateBalanceDisplay();

        document.getElementById('win-amount-text').innerText = "+ " + formatNum(winAmount);
        document.getElementById('win-popup').classList.add('show');
      } else if(userLost > 0) {
        document.getElementById('lose-desc-text').innerText = "Bạn đã mất " + formatNum(userLost) + " đ";
        document.getElementById('lose-popup').classList.add('show');
      }

      // Chuẩn bị cho phiên mới sau 4 giây
      setTimeout(() => {
        resetRoundState();
        startTimer();
      }, 4000);
    }

    // --- TÍNH NĂNG NẶN BÁT DRAG TỰ DO ---
    function toggleSqueezeMode() {
      isSqueezeMode = !isSqueezeMode;
      let btn = document.getElementById('btn-squeeze-toggle');
      if(isSqueezeMode) {
        btn.classList.add('active-squeeze');
        showToast("Đã BẬT chế độ Nặn");
      } else {
        btn.classList.remove('active-squeeze');
        showToast("Đã TẮT chế độ Nặn");
      }
    }

    function initBowlDrag() {
      let bowl = document.getElementById('bowl-cover');
      let isDragging = false;
      let startX, startY;

      function onStart(e) {
        isDragging = true;
        let p = e.touches ? e.touches[0] : e;
        startX = p.clientX;
        startY = p.clientY;
      }

      function onMove(e) {
        if(!isDragging) return;
        let p = e.touches ? e.touches[0] : e;
        let dx = p.clientX - startX;
        let dy = p.clientY - startY;
        
        bowl.style.transform = `translate(${dx}px, ${dy}px)`;

        // Kéo đi xa hơn 90px xem như hoàn tất nặn
        if(Math.hypot(dx, dy) > 90) {
          isDragging = false;
          bowl.style.display = 'none';
          finishRound();
        }
      }

      function onEnd() {
        isDragging = false;
      }

      bowl.addEventListener('mousedown', onStart);
      window.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      bowl.addEventListener('touchstart', onStart);
      window.addEventListener('touchmove', onMove);
      window.addEventListener('touchend', onEnd);
    }

    // --- CHAT BOX ---
    function toggleChat() {
      let chat = document.getElementById('chat-box');
      chat.style.display = (chat.style.display === 'none') ? 'flex' : 'none';
    }

    function sendChatMessage() {
      let input = document.getElementById('chat-input-field');
      let txt = input.value.trim();
      if(txt) {
        let msgList = document.getElementById('chat-msg-list');
        let div = document.createElement('div');
        div.className = "chat-item";
        div.innerHTML = `<span class="chat-user">hilohi123:</span> <span class="chat-text">${txt}</span>`;
        msgList.appendChild(div);
        msgList.scrollTop = msgList.scrollHeight;
        input.value = '';
      }
    }
  </script>
</body>
