<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ Thống Phân Tích & Dự Đoán Tài Xỉu</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: linear-gradient(135deg, #1e1e2f, #111119);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .card {
            background: #282a36;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 450px;
            text-align: center;
            border: 1px solid #44475a;
        }
        h2 {
            margin-bottom: 20px;
            color: #ff79c6;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: #bd93f9;
        }
        input[type="number"], input[type="text"] {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #6272a4;
            background: #44475a;
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: border 0.3s;
        }
        input[type="number"]:focus, input[type="text"]:focus {
            border-color: #ff79c6;
        }
        .dice-inputs {
            display: flex;
            gap: 10px;
        }
        .dice-inputs input {
            text-align: center;
        }
        .btn-submit {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #ff79c6, #bd93f9);
            color: #fff;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 121, 198, 0.4);
        }
        .result-box {
            margin-top: 25px;
            padding: 15px;
            border-radius: 10px;
            background: #44475a;
            display: none;
        }
        .result-box.show {
            display: block;
            animation: fadeIn 0.5s ease-in-out;
        }
        .result-title {
            font-size: 0.9rem;
            color: #f8f8f2;
        }
        .result-value {
            font-size: 1.8rem;
            font-weight: bold;
            margin-top: 5px;
        }
        .tai { color: #50fa7b; }
        .xiu { color: #ff5555; }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<div class="card">
    <h2>Dự Đoán Tài Xỉu</h2>
    
    <div class="form-group">
        <label for="sessionCode">Mã Phiên Cần Dự Đoán</label>
        <input type="number" id="sessionCode" placeholder="Nhập mã phiên (VD: 102938)">
    </div>

    <div class="form-group">
        <label>Kết Quả Phiên Trước (3 Xúc Xắc)</label>
        <div class="dice-inputs">
            <input type="number" id="dice1" min="1" max="6" placeholder="Xúc xắc 1">
            <input type="number" id="dice2" min="1" max="6" placeholder="Xúc xắc 2">
            <input type="number" id="dice3" min="1" max="6" placeholder="Xúc xắc 3">
        </div>
    </div>

    <button class="btn-submit" onclick="predictResult()">Dự Đoán Kết Quả</button>

    <div class="result-box" id="resultBox">
        <div class="result-title">Dự đoán cho phiên tiếp theo:</div>
        <div class="result-value" id="predictionText">---</div>
    </div>
</div>

<script>
    function predictResult() {
        const sessionCode = document.getElementById('sessionCode').value;
        const d1 = parseInt(document.getElementById('dice1').value);
        const d2 = parseInt(document.getElementById('dice2').value);
        const d3 = parseInt(document.getElementById('dice3').value);

        if (!sessionCode || isNaN(d1) || isNaN(d2) || isNaN(d3)) {
            alert("Vui lòng điền đầy đủ mã phiên và kết quả 3 xúc xắc của phiên trước!");
            return;
        }

        if (d1 < 1 || d1 > 6 || d2 < 1 || d2 > 6 || d3 < 1 || d3 > 6) {
            alert("Giá trị xúc xắc phải từ 1 đến 6!");
            return;
        }

        const totalLast = d1 + d2 + d3;
        
        // Thuật toán dự đoán mẫu dựa trên tổng điểm phiên trước và mã phiên
        const predictionFactor = (totalLast + parseInt(sessionCode.slice(-2))) % 2;
        
        const resultBox = document.getElementById('resultBox');
        const predictionText = document.getElementById('predictionText');

        resultBox.classList.add('show');
        
        if (predictionFactor === 0) {
            predictionText.textContent = "TÀI (Tổng > 10)";
            predictionText.className = "result-value tai";
        } else {
            predictionText.textContent = "XỈU (Tổng <= 10)";
            predictionText.className = "result-value xiu";
        }
    }
</script>

</body>
</html>
