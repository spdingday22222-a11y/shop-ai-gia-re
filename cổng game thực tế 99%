  <script>
    // Game State Engine
    let userBalance = 57300755;
    let selectedChipValue = 1000;
    let currentTaiBet = 0;
    let currentXiuBet = 0;
    let timeRemaining = 45;
    let isRolling = false;
    let timerInterval = null;
    let toastTimeout = null;

    // Định vị góc xoay 3D chính xác cho từng mặt xúc xắc (1-6)
    const diceRotations = {
      1: { x: 0, y: 0 },
      6: { x: 0, y: 180 },
      2: { x: 0, y: 90 },
      5: { x: 0, y: -90 },
      3: { x: -90, y: 0 },
      4: { x: 90, y: 0 }
    };

    // Khởi tạo Loading Screen
    window.addEventListener('DOMContentLoaded', () => {
      let progress = 0;
      const fill = document.getElementById('loader-fill');
      const text = document.getElementById('loader-text');

      const loaderTimer = setInterval(() => {
        progress += Math.floor(Math.random() * 15) + 5;
        if (progress >= 100) {
          progress = 100;
          clearInterval(loaderTimer);
          setTimeout(() => {
            switchScreen('loading-screen', 'lobby-screen');
          }, 300);
        }
        fill.style.width = progress + '%';
        text.innerText = `Đang khởi tạo Engine 3D... ${progress}%`;
      }, 60);
    });

    // Chuyển đổi màn hình mượt mà
    function switchScreen(fromId, toId) {
      const fromEl = document.getElementById(fromId);
      const toEl = document.getElementById(toId);
      fromEl.classList.remove('active');
      setTimeout(() => {
        fromEl.style.display = 'none';
        toEl.style.display = 'flex';
        setTimeout(() => toEl.classList.add('active'), 20);
      }, 300);
    }

    // Hiển thị Thông Báo Thực Tế trong vài giây
    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('show');
      }, 3000); // Tự động ẩn sau 3 giây thực tế
    }

    // Chọn Đồng Chip Tiền Cược
    function selectChip(val, el) {
      selectedChipValue = val;
      document.querySelectorAll('.chip-item').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      showToast(`Đã chọn mệnh giá chip: ${formatMoney(val)} VNĐ`);
    }

    // Đặt Cược Trực Tiếp Bằng Chip Chọn Khi Nhấp Vào Cửa
    function placeChipBet(side) {
      if (isRolling || timeRemaining <= 5) {
        showToast('Đã hết thời gian đặt cược phiên này!');
        return;
      }

      if (userBalance < selectedChipValue) {
        showToast('Số dư tài khoản không đủ để đặt cược!');
        return;
      }

      userBalance -= selectedChipValue;
      updateBalanceDisplays();

      if (side === 'TÀI') {
        currentTaiBet += selectedChipValue;
        const tag = document.getElementById('my-tai-bet');
        tag.style.display = 'block';
        tag.innerText = `Cược: ${formatMoney(currentTaiBet)}`;
        showToast(`Đặt thành công ${formatMoney(selectedChipValue)} vào cửa TÀI`);
      } else {
        currentXiuBet += selectedChipValue;
        const tag = document.getElementById('my-xiu-bet');
        tag.style.display = 'block';
        tag.innerText = `Cược: ${formatMoney(currentXiuBet)}`;
        showToast(`Đặt thành công ${formatMoney(selectedChipValue)} vào cửa XỈU`);
