            </div>

            <!-- Cube 2 -->
            <div class="cube" id="cube2">
              <div class="face face-1"><div class="dot-pip red p5"></div></div>
              <div class="face face-6"><div class="dot-pip p1"></div><div class="dot-pip p3"></div><div class="dot-pip p4"></div><div class="dot-pip p6"></div><div class="dot-pip p7"></div><div class="dot-pip p9"></div></div>
              <div class="face face-2"><div class="dot-pip p1"></div><div class="dot-pip p9"></div></div>
              <div class="face face-5"><div class="dot-pip p1"></div><div class="dot-pip p3"></div><div class="dot-pip p5"></div><div class="dot-pip p7"></div><div class="dot-pip p9"></div></div>
              <div class="face face-3"><div class="dot-pip p1"></div><div class="dot-pip p5"></div><div class="dot-pip p9"></div></div>
