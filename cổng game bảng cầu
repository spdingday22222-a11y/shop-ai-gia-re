  <script>
    /* GAME DATA & STATE */
    let balance = 57300755;
    let selectedChip = 0;
    let currentSide = null;
    let betValues = { TAI: 0, XIU: 0 };
    let tempBetValues = { TAI: 0, XIU: 0 };
    
    let timer = 30;
    let timerInterval = null;
    let isSqueeze = false;
    let historyResults = [];
    let myBetHistory = [];
    let currentSession = 612621;
    let currentGameMode = 'MD5';
    let isCovered = true;
    let currentDices = [1, 2, 3];

    // Khởi tạo lịch sử giả lập cho đẹp bảng cầu
    for (let i = 0; i < 25; i++) {
      let d1 = Math.floor(Math.random() * 6) + 1;
      let d2 = Math.floor(Math.random() * 6) + 1;
      let d3 = Math.floor(Math.random() * 6) + 1;
      let total = d1 + d2 + d3;
      historyResults.push({
        session: currentSession - (25 - i),
        dices: [d1, d2, d3],
        total: total,
        type: total >= 11 ? 'TAI' : 'XIU'
      });
    }

    /* INITIALIZATION & LOADING ANIMATION */
    window.addEventListener('load', () => {
      let fill = document.getElementById('loader-fill');
      let width = 0;
      let interval = setInterval(() => {
        width += 4;
        fill.style.width = width + '%';
        if (width >= 100) {
          clearInterval(interval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
          updateBalanceDisplay();
        }
      }, 30);

      setupBowlDrag();
    });

    function updateBalanceDisplay() {
      let formatted = balance.toLocaleString('vi-VN') + ' đ';
      document.getElementById('user-balance').innerText = formatted;
      document.getElementById('arena-balance').innerText = formatted;
    }

    function showToast(msg, duration = 2000) {
      let toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), duration);
    }

    /* NAVIGATION */
    function enterArena(mode) {
      currentGameMode = mode;
      document.getElementById('arena-title').innerText = mode === 'MD5' ? 'TÀI XỈU MD5' : 'TÀI XỈU CAN CUA';
      let board = document.getElementById('main-board');
      board.className = 'real-taixiu-board theme-' + mode.toLowerCase();
      
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);
      
      startNewGameLoop();
    }

    function exitArena() {
      clearInterval(timerInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    /* BÁT NẮP & KÉO THẢ (DRAG & DROP) */
    function setupBowlDrag() {
      let bowl = document.getElementById('bowl-cover');
      let isDragging = false;
      let startX, startY, initialX = 0, initialY = 0;

      function onStart(e) {
        if (!isCovered) return;
        isDragging = true;
        bowl.classList.add('dragging');
        let clientX = e.touches ? e.touches[0].clientX : e.clientX;
        let clientY = e.touches ? e.touches[0].clientY : e.clientY;
        startX = clientX - initialX;
        startY = clientY - initialY;
      }

      function onMove(e) {
        if (!isDragging) return;
        e.preventDefault();
        let clientX = e.touches ? e.touches[0].clientX : e.clientX;
        let clientY = e.touches ? e.touches[0].clientY : e.clientY;
        initialX = clientX - startX;
        initialY = clientY - startY;
        bowl.style.transform = `translate(${initialX}px, ${initialY}px)`;
      }

      function onEnd() {
        isDragging = false;
        bowl.classList.remove('dragging');
      }

      bowl.addEventListener('mousedown', onStart);
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onEnd);

      bowl.addEventListener('touchstart', onStart, { passive: false });
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onEnd);
    }

    function resetBowlPosition() {
      let bowl = document.getElementById('bowl-cover');
      bowl.style.transform = 'translate(0px, 0px)';
    }

    /* GAME LOOP & TIMER */
    function startNewGameLoop() {
      clearInterval(timerInterval);
      timer = 30;
      isCovered = true;
      resetBowlPosition();
      document.getElementById('bowl-cover').style.display = 'flex';
      document.getElementById('dice-container').style.display = 'none';
      
      // Reset Bet State
      betValues = { TAI: 0, XIU: 0 };
      tempBetValues = { TAI: 0, XIU: 0 };
      currentSide = null;
      updateBetUI();
      
      document.getElementById('title-TAI').classList.remove('blink-winner');
      document.getElementById('title-XIU').classList.remove('blink-winner');
      document.getElementById('win-popup').classList.remove('show');
      document.getElementById('lose-popup').classList.remove('show');

      timerInterval = setInterval(() => {
        timer--;
        document.getElementById('timer-text').innerText = timer;

        // Giả lập nhảy tiền cược cửa
        document.getElementById('tai-amount').innerText = (200000000 + (30 - timer) * 2500000 + Math.floor(Math.random()*500000)).toLocaleString('vi-VN');
        document.getElementById('xiu-amount').innerText = (180000000 + (30 - timer) * 2300000 + Math.floor(Math.random()*500000)).toLocaleString('vi-VN');

        if (timer === 5) {
          // Khóa cược
          document.getElementById('chip-bar').classList.add('hidden-bet');
          showToast('HẾT GIỜ ĐẶT CƯỢC!', 1500);
        }

        if (timer <= 0) {
          clearInterval(timerInterval);
          processResultPhase();
        }
      }, 1000);
    }

    /* XOAY XÚC XẮC THỰC TẾ & XỬ LÝ KẾT QUẢ */
    function processResultPhase() {
      document.getElementById('dice-container').style.display = 'flex';
      
      // Bật hiệu ứng lắc đảo nhanh 3 viên xúc xắc
      let cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];
      cubes.forEach(c => c.classList.add('rolling'));

      // Tạo kết quả ngẫu nhiên
      let d1 = Math.floor(Math.random() * 6) + 1;
      let d2 = Math.floor(Math.random() * 6) + 1;
      let d3 = Math.floor(Math.random() * 6) + 1;
      currentDices = [d1, d2, d3];
      let total = d1 + d2 + d3;
      let winSide = total >= 11 ? 'TAI' : 'XIU';

      setTimeout(() => {
        // Dừng lắc và gán góc xoay 3D chính xác cho mặt xúc xắc
        cubes.forEach((cube, index) => {
          cube.classList.remove('rolling');
          setCubeFace(cube, currentDices[index]);
        });

        // Xử lý nặn / mở bát
        if (!isSqueeze) {
          document.getElementById('bowl-cover').style.display = 'none';
          isCovered = false;
          showWinResult(winSide, total);
        } else {
          showToast('MỜI BẠN NẶN BÁT!', 2000);
          // Cho phép mở bát thủ công khi kéo bát ra xa
          let checkOpen = setInterval(() => {
            let bowl = document.getElementById('bowl-cover');
            let transform = bowl.style.transform;
            if (transform && transform !== 'translate(0px, 0px)') {
              clearInterval(checkOpen);
              showWinResult(winSide, total);
            }
          }, 300);
        }

        // Lưu lịch sử
        currentSession++;
        historyResults.push({ session: currentSession, dices: currentDices, total: total, type: winSide });

      }, 1200); // Đảo nhanh trong 1.2s
    }

    function setCubeFace(cube, value) {
      let rotations = {
        1: 'rotateY(0deg) rotateX(0deg)',
        6: 'rotateY(180deg) rotateX(0deg)',
        2: 'rotateY(90deg) rotateX(0deg)',
        5: 'rotateY(-90deg) rotateX(0deg)',
        3: 'rotateX(-90deg) rotateY(0deg)',
        4: 'rotateX(90deg) rotateY(0deg)'
      };
      cube.style.transform = rotations[value];
    }

    function showWinResult(winSide, total) {
      document.getElementById('title-' + winSide).classList.add('blink-winner');
      
      let myBet = betValues[winSide];
      let loseBet = betValues[winSide === 'TAI' ? 'XIU' : 'TAI'];

      if (myBet > 0) {
        let winAmt = myBet * 1.98;
        balance += winAmt;
        updateBalanceDisplay();
        document.getElementById('win-amount-text').innerText = '+' + Math.floor(winAmt).toLocaleString('vi-VN') + ' đ';
        document.getElementById('win-popup').classList.add('show');
        
        myBetHistory.unshift({
          session: currentSession,
          side: winSide,
          amount: myBet,
          result: `${total} (${currentDices.join('-')})`,
          payout: '+' + Math.floor(winAmt).toLocaleString('vi-VN')
        });
      } else if (loseBet > 0) {
        document.getElementById('lose-desc-text').innerText = `Kết quả ra ${winSide} ${total} điểm!`;
        document.getElementById('lose-popup').classList.add('show');
        
        myBetHistory.unshift({
          session: currentSession,
          side: winSide === 'TAI' ? 'XIU' : 'TAI',
          amount: loseBet,
          result: `${total} (${currentDices.join('-')})`,
          payout: '-' + loseBet.toLocaleString('vi-VN')
        });
      }

      setTimeout(() => startNewGameLoop(), 4000);
    }

    /* ĐẶT CƯỢC & CHIP SYSTEM */
    function handleBetClick(side) {
      if (timer <= 5) return;
      currentSide = side;
      document.getElementById('btn-bet-TAI').classList.remove('active-side');
      document.getElementById('btn-bet-XIU').classList.remove('active-side');
      document.getElementById('btn-bet-' + side).classList.add('active-side');
      document.getElementById('chip-bar').classList.remove('hidden-bet');
    }

    function selectChip(val, el) {
      selectedChip = val;
      document.querySelectorAll('.chip-item-sq').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');

      if (currentSide) {
        tempBetValues[currentSide] += val;
        document.getElementById('val-' + currentSide).innerText = (betValues[currentSide] + tempBetValues[currentSide]).toLocaleString('vi-VN');
      }
    }

    function confirmBet() {
      if (!currentSide || tempBetValues[currentSide] <= 0) return;
      let totalAdd = tempBetValues[currentSide];
      
      if (balance < totalAdd) {
        showToast('SỐ DƯ KHÔNG ĐỦ!', 2000);
        return;
      }

      balance -= totalAdd;
      betValues[currentSide] += totalAdd;
      tempBetValues[currentSide] = 0;
      updateBalanceDisplay();
      showToast('ĐẶT CƯỢC THÀNH CÔNG!', 1500);
      document.getElementById('chip-bar').classList.add('hidden-bet');
    }

    function cancelBet() {
      if (currentSide) {
        tempBetValues[currentSide] = 0;
        document.getElementById('val-' + currentSide).innerText = betValues[currentSide].toLocaleString('vi-VN');
      }
      document.getElementById('chip-bar').classList.add('hidden-bet');
    }

    function doAllIn(side) {
      if (timer <= 5 || balance <= 0) return;
      currentSide = side;
      tempBetValues[side] = balance;
      confirmBet();
    }

    function updateBetUI() {
      document.getElementById('val-TAI').innerText = '0';
      document.getElementById('val-XIU').innerText = '0';
      document.getElementById('btn-bet-TAI').classList.remove('active-side');
      document.getElementById('btn-bet-XIU').classList.remove('active-side');
    }

    function toggleSqueezeMode() {
      isSqueeze = !isSqueeze;
      document.getElementById('btn-squeeze-toggle').style.background = isSqueeze ? '#00ff66' : '';
      showToast(isSqueeze ? 'ĐÃ BẬT CHẾ ĐỘ NẶN' : 'ĐÃ TẮT CHẾ ĐỘ NẶN', 1500);
    }

    /* BẢNG CẦU LỊCH SỬ MA TRẬN 5 DÒNG (BỆT TRÀN CỘT) & ĐỒ THỊ ZIC-ZAC */
    function openBangCauModal() {
      document.getElementById('modal-bang-cau').classList.add('active');
      renderCauMatrix5Row();
      renderCauGraphZicZac();
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    // Logic Bệt tràn cột ma trận 5 dòng
    function renderCauMatrix5Row() {
      let matrixContainer = document.getElementById('cau-matrix-5row');
      matrixContainer.innerHTML = '';

      let columns = [];
      let currentCol = [];
      let lastType = null;

      let taiCount = 0, xiuCount = 0;

      historyResults.forEach(res => {
        if (res.type === 'TAI') taiCount++; else xiuCount++;

        if (!lastType) {
          lastType = res.type;
          currentCol.push(res);
        } else if (res.type === lastType) {
          // Bệt tiếp tục
          if (currentCol.length < 5) {
            currentCol.push(res);
          } else {
            // Đã đủ 5 dòng -> Bệt tràn sang cột bên cạnh
            columns.push(currentCol);
            currentCol = [res];
          }
        } else {
          // Đổi cầu sang Tai/Xiu khác
          columns.push(currentCol);
          currentCol = [res];
          lastType = res.type;
        }
      });
      if (currentCol.length > 0) columns.push(currentCol);

      document.getElementById('summary-tai-count').innerText = taiCount;
      document.getElementById('summary-xiu-count').innerText = xiuCount;
      document.getElementById('summary-total-count').innerText = historyResults.length;

      // Render lưới HTML
      columns.forEach(col => {
        for (let r = 0; r < 5; r++) {
          let item = col[r];
          let cell = document.createElement('div');
          cell.className = 'cau-cell-5row';
          if (item) {
            cell.classList.add(item.type.toLowerCase());
            cell.innerText = item.total;
          }
          matrixContainer.appendChild(cell);
        }
      });
    }

    // Đồ thị Zic-Zac hiển thị logo & điểm chuẩn xác
    function renderCauGraphZicZac() {
      let canvas = document.getElementById('cau-canvas');
      let ctx = canvas.getContext('2d');
      let nodesLayer = document.getElementById('cau-nodes-layer');
      
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      nodesLayer.innerHTML = '';

      let data = historyResults.slice(-20); // Lấy 20 phiên gần nhất
      if (data.length === 0) return;

      let stepX = canvas.width / 20;
      let points = [];

      // Tính tọa độ Y dựa trên tổng điểm (3 đến 18)
      data.forEach((item, index) => {
        let x = index * stepX + stepX / 2;
        // Map 3 -> 18 tương ứng Y từ (height - 15) đến 15
        let y = canvas.height - 15 - ((item.total - 3) / 15) * (canvas.height - 30);
        points.push({ x, y, item });
      });

      // Vẽ đường zic-zac
      ctx.beginPath();
      ctx.strokeStyle = '#ffe066';
      ctx.lineWidth = 2;
      points.forEach((pt, idx) => {
        if (idx === 0) ctx.moveTo(pt.x, pt.y);
        else ctx.lineTo(pt.x, pt.y);
      });
      ctx.stroke();

      // Vẽ Node tròn hiển thị logo / số điểm
      points.forEach(pt => {
        let ball = document.createElement('div');
        ball.className = `node-ball ${pt.item.type.toLowerCase()}`;
        ball.style.left = pt.x + 'px';
        ball.style.top = pt.y + 'px';
        ball.innerText = pt.item.total;
        nodesLayer.appendChild(ball);
      });
    }

    /* MODAL LỊCH SỬ CƯỢC */
    function openLichSuCuocModal() {
      document.getElementById('modal-lich-su').classList.add('active');
      let tbody = document.getElementById('history-table-body');
      tbody.innerHTML = '';

      if (myBetHistory.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5">Bạn chưa đặt cược phiên nào</td></tr>';
        return;
      }

      myBetHistory.forEach(h => {
        let tr = document.createElement('tr');
        tr.innerHTML = `
          <td>#${h.session}</td>
          <td><b style="color:${h.side === 'TAI' ? '#ffe066' : '#00b4d8'}">${h.side}</b></td>
          <td>${h.amount.toLocaleString('vi-VN')}</td>
          <td>${h.result}</td>
          <td class="${h.payout.startsWith('+') ? 'txt-green' : 'txt-red'}">${h.payout}</td>
        `;
        tbody.appendChild(tr);
      });
    }
  </script>
</body>
