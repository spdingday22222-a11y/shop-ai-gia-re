      if (mode === 'HOT_TAIXIU') {
        screen.classList.add('hot-theme');
        title.innerText = 'SẢNH HOT TÀI XỈU 3D REAL';
      } else {
        screen.classList.remove('hot-theme');
        title.innerText = 'SẢNH TÀI XỈU MD5 MINH BẠCH 3D';
      }

      switchScreen('lobby-screen', 'arena-screen');
      startGameLoop();
    }

    // Rời Sảnh Game
    function exitArena() {
      clearInterval(timerInterval);
      switchScreen('arena-screen', 'lobby-screen');
    }

    // Vòng Lặp Game Đếm Nhược & Lăn Xúc Xắc 3D Real
    function startGameLoop() {
      if (timerInterval) clearInterval(timerInterval);
      timeRemaining = 45;
      isRolling = false;
      resetBoardState();

      timerInterval = setInterval(() => {
        timeRemaining--;
        document.getElementById('timer').innerText = timeRemaining < 10 ? '0' + timeRemaining : timeRemaining;

        if (timeRemaining === 5) {
          showToast('Hệ thống đang dừng cược để lắc xúc xắc!');
        }

        if (timeRemaining <= 0) {
          clearInterval(timerInterval);
          triggerDiceRoll3D();
        }
      }, 1000);
    }

    // Kích Hoạt Lắc Xúc Xắc Lăn Đảo Nảy 100% Chân Thực
    function triggerDiceRoll3D() {
      isRolling = true;
      showToast('Đang đảo cầu và mở kết quả...');

      const w1 = document.getElementById('wrap1');
      const w2 = document.getElementById('wrap2');
      const w3 = document.getElementById('wrap3');

      const c1 = document.getElementById('cube1');
      const c2 = document.getElementById('cube2');
      const c3 = document.getElementById('cube3');

      // Bật hiệu ứng lăn đảo nẩy cao
      w1.classList.add('rolling-1');
      w2.classList.add('rolling-2');
      w3.classList.add('rolling-3');

      c1.classList.add('rolling');
      c2.classList.add('rolling');
      c3.classList.add('rolling');

      // Random kết quả xúc xắc
      const d1 = Math.floor(Math.random() * 6) + 1;
      const d2 = Math.floor(Math.random() * 6) + 1;
      const d3 = Math.floor(Math.random() * 6) + 1;
      const total = d1 + d2 + d3;
      const isTai = total >= 11;

      setTimeout(() => {
        // Tắt hiệu ứng lăn đảo
        w1.classList.remove('rolling-1');
        w2.classList.remove('rolling-2');
        w3.classList.remove('rolling-3');

        c1.classList.remove('rolling');
        c2.classList.remove('rolling');
        c3.classList.remove('rolling');

        // Định vị 3D xoay chuẩn mặt kết quả
        applyDiceRotation(c1, d1);
        applyDiceRotation(c2, d2);
        applyDiceRotation(c3, d3);

        // Hiển thị thắng thua
        setTimeout(() => {
          showResultOutcome(d1, d2, d3, total, isTai);
        }, 600);
      }, 2200);
    }

    // Áp dụng góc xoay mặt 3D
    function applyDiceRotation(cubeEl, val) {
      const rot = diceRotations[val];
      cubeEl.style.transform = `rotateX(${rot.x + 1440}deg) rotateY(${rot.y + 1440}deg)`;
    }

    // Xử Lý Kết Quả Thắng Lớn
    function showResultOutcome(d1, d2, d3, total, isTai) {
      const resultText = `${d1} - ${d2} - ${d3} (${total} Nút - ${isTai ? 'TÀI' : 'XỈU'})`;
      showToast(`Kết quả: ${resultText}`);

      const winSide = isTai ? document.getElementById('side-tai') : document.getElementById('side-xiu');
      winSide.classList.add('active-win');

      let winnings = 0;
      if (isTai && currentTaiBet > 0) winnings = currentTaiBet * 1.98;
      if (!isTai && currentXiuBet > 0) winnings = currentXiuBet * 1.98;

      if (winnings > 0) {
        userBalance += winnings;
        updateBalanceDisplays();

        const banner = document.getElementById('win-banner');
        document.getElementById('win-money-text').innerText = `+${formatMoney(winnings)}`;
        banner.classList.add('show');

        setTimeout(() => banner.classList.remove('show'), 3500);
      }

      // Thêm nút lịch sử
      const dotsContainer = document.getElementById('history-dots');
      const dot = document.createElement('div');
      dot.className = `dot ${isTai ? 'tai' : 'xiu'}`;
      if (dotsContainer.children.length >= 8) dotsContainer.removeChild(dotsContainer.firstChild);
      dotsContainer.appendChild(dot);

      // Chờ vài giây rồi reset vòng chơi mới
      setTimeout(() => {
        startGameLoop();
      }, 4000);
    }

    // Reset Bàn Game Sau Mỗi Phiên
    function resetBoardState() {
      currentTaiBet = 0;
      currentXiuBet = 0;
      document.getElementById('my-tai-bet').style.display = 'none';
      document.getElementById('my-xiu-bet').style.display = 'none';
      document.getElementById('side-tai').classList.remove('active-win');
      document.getElementById('side-xiu').classList.remove('active-win');
    }

    // Cập nhật hiển thị số dư
    function updateBalanceDisplays() {
      document.getElementById('user-balance').innerText = formatMoney(userBalance);
      document.getElementById('arena-balance').innerText = formatMoney(userBalance);
    }

    // Định dạng tiền tệ
    function formatMoney(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    // Bật/Tắt Góc Nhìn Camera 3D
    function toggleCamera3D() {
      const stage = document.getElementById('arena-stage');
      stage.classList.toggle('pan-angle');
      showToast('Đã thay đổi góc quay Camera Real 3D!');
    }
  </script>
</body>
</html>
