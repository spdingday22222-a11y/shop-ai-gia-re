    .chart-header {
      height: 50px; background: linear-gradient(180deg, #3d312c, #221b18);
      border-bottom: 2px solid #ffb703; display: flex; justify-content: space-between;
      align-items: center; padding: 0 20px;
    }

    .chart-title {
      font-size: 17px; font-weight: 900; color: #ffea00;
      text-shadow: 0 2px 4px #000; letter-spacing: 1px;
    }

    .btn-close-chart {
      width: 30px; height: 30px; border-radius: 50%; background: #a00; border: 1.5px solid #fff;
      color: #fff; font-weight: bold; display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: 0 2px 4px #000;
    }

    .chart-body-wrapper {
      flex: 1; padding: 18px; overflow-x: auto; overflow-y: hidden;
      display: flex; flex-direction: column; gap: 12px;
      cursor: grab; touch-action: none;
    }
    .chart-body-wrapper:active { cursor: grabbing; }

    /* LƯỚI BẢNG CẦU 5 HÀNG CÓ KẺ VẠCH ĐẬM */
    .grid-cau-container {
      display: grid;
      grid-template-rows: repeat(5, 42px); /* ĐÚNG 5 HÀNG NGANG CỘT DỌC */
      grid-auto-columns: 42px;
      grid-auto-flow: column;
      gap: 2px;
      background: #0a0807;
      border: 2px solid #ffb703;
      padding: 4px;
      border-radius: 8px;
      width: max-content;
      min-width: 100%;
    }

    .grid-cell {
      width: 42px; height: 42px;
      background: #181311;
      border: 1px solid #483933; /* Kẻ vạch đậm sắc nét */
      display: flex; justify-content: center; align-items: center;
      border-radius: 4px;
    }

    /* CHẤM TRÒN KẾT QUẢ TÀI / XỈU HIỆN SỐ NỔI BẬT */
    .dot-result {
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      font-size: 13px; font-weight: 900; color: #fff;
