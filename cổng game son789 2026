                <div class="chip-item chip-100k" onclick="selectChip(100000, this)">100K</div>
                <div class="chip-item chip-500k" onclick="selectChip(500000, this)">500K</div>
                <div class="chip-item chip-1m" onclick="selectChip(1000000, this)">1M</div>
                <div class="chip-item chip-5m" onclick="selectChip(5000000, this)">5M</div>
                <div class="chip-item chip-10m" onclick="selectChip(10000000, this)">10M</div>
                <div class="chip-item chip-50m" onclick="selectChip(50000000, this)">50M</div>
            </div>

            <div class="lobby-widget">
                <div>
                    <div class="widget-title">MỨC CHIP DÙNG</div>
                    <div class="widget-val" id="selected-chip-val" style="color: #f1c40f;">1,000 đ</div>
