  <script>
    /* CORE LOGIC & STATE MANAGEMENT */
    let userBalance = 57300755;
    let selectedSide = null; // 'TAI' hoặc 'XIU'
    let accumulatedBet = 0;
    let currentMode = 'MD5';
    let countdown = 10;
    let timerInterval = null;
    let toastTimeout = null;

    let taiMoney = 265337546;
    let xiuMoney = 237436422;
    let taiUsers = 344;
    let xiuUsers = 357;

    // Giả lập Loading Screen
    window.onload = () => {
      let fill = document.getElementById('loader-fill');
      let w = 0;
      let interval = setInterval(() => {
        w += 5;
        fill.style.width = w + '%';
        if (w >= 100) {
          clearInterval(interval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
        }
      }, 30);

      initBowlDragLogic();
    };

    /* THÔNG BÁO VÀI GIÂY (TOAST NOTIFICATION REAL) */
    function showToast(msg, duration = 2500) {
      let t = document.getElementById('toast');
      t.innerText = msg;
      t.classList.add('show');
      
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        t.classList.remove('show');
      }, duration);
    }

    function formatNumber(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function formatShortMoney(num) {
      if (num >= 1000000) return (num / 1000000) + 'M';
      if (num >= 1000) return (num / 1000) + 'K';
      return num;
    }

    function updateDisplays() {
      document.getElementById('user-balance').innerText = '$ ' + formatNumber(userBalance);
      document.getElementById('arena-balance').innerText = '$ ' + formatNumber(userBalance);
      document.getElementById('tai-amount').innerText = formatNumber(taiMoney);
      document.getElementById('xiu-amount').innerText = formatNumber(xiuMoney);
      document.getElementById('tai-players').innerText = taiUsers;
      document.getElementById('xiu-players').innerText = xiuUsers;
    }

    function enterArena(mode) {
      currentMode = mode;
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);

      let board = document.getElementById('main-board');
      let title = document.getElementById('arena-title');

      if (mode === 'MD5') {
        board.className = 'real-taixiu-board theme-md5';
        title.innerText = 'TÀI XỈU MD5';
        taiMoney = 265337546; xiuMoney = 237436422;
      } else {
        board.className = 'real-taixiu-board theme-thuong';
        title.innerText = 'TÀI XỈU THƯỜNG';
        taiMoney = 443809158; xiuMoney = 216193290;
      }

      updateDisplays();
      startNewGameCycle();
    }

    function exitArena() {
      clearInterval(timerInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    /* HIỆU ỨNG NẨY SỐ VÀNG CAM THỰC TẾ */
    function bumpMoneyEffect(elementId) {
      let el = document.getElementById(elementId);
      el.classList.remove('bump-orange');
      void el.offsetWidth;
      el.classList.add('bump-orange');
    }

    /* QUY TRÌNH QUAY / LẮC / MỞ NẮP 10 SỰ CỐ THỰC TẾ */
    function startNewGameCycle() {
      clearInterval(timerInterval);
      let bowl = document.getElementById('bowl-cover');
      let cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];

      // BƯỚC 1: Mở bát cho 3 viên xúc xắc lăn đảo trước
      bowl.style.display = 'none';
      cubes.forEach(c => c.classList.add('rolling'));

      showToast('Đang đảo xúc xắc khởi tạo phiên...', 2000);

      // BƯỚC 2: Sau 2 giây đậy nắp lại & dừng xoay xúc xắc -> bắt đầu đếm ngược 10s
      setTimeout(() => {
        cubes.forEach(c => c.classList.remove('rolling'));
        bowl.style.display = 'flex';
        bowl.classList.remove('smooth-reset');
        bowl.style.transform = 'translate(0px, 0px)';

        countdown = 10;
        document.getElementById('timer-text').innerText = '10';

        timerInterval = setInterval(() => {
          countdown--;
          document.getElementById('timer-text').innerText = countdown < 10 ? '0' + countdown : countdown;

          // Giả lập tiền cược nhảy liên tục
          if (countdown > 2) {
            if (Math.random() > 0.3) {
              taiMoney += Math.floor(Math.random() * 3500000);
              bumpMoneyEffect('tai-amount');
            }
            if (Math.random() > 0.3) {
              xiuMoney += Math.floor(Math.random() * 3500000);
              bumpMoneyEffect('xiu-amount');
            }
            taiUsers += Math.random() > 0.5 ? 1 : 0;
            xiuUsers += Math.random() > 0.5 ? 1 : 0;
            updateDisplays();
          } else if (countdown === 0) {
            clearInterval(timerInterval);
            finishRoundAndReLoop();
          }
        }, 1000);

      }, 2000);
    }

    /* HẾT 10S: LẮN ĐẢO NHANH VÀ LẶP LẠI PHIÊN MỚI */
    function finishRoundAndReLoop() {
      showToast('Hết thời gian! Đang lắc xúc xắc kết quả...', 2000);
      cancelBet();

      let cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];
      cubes.forEach(c => c.classList.add('rolling'));

      // Lắc đảo nhanh trong 1.5s rồi khởi tạo lại vòng đếm 10s mới
      setTimeout(() => {
        cubes.forEach(c => c.classList.remove('rolling'));
        // Random kết quả ngẫu nhiên
        cubes.forEach(c => {
          let rx = Math.floor(Math.random() * 4) * 90;
          let ry = Math.floor(Math.random() * 4) * 90;
          c.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
        });

        setTimeout(() => {
          startNewGameCycle();
        }, 1500);
      }, 1500);
    }

    /* BẬT LOGIC ĐẶT CƯỢC CHO CỬA TÀI HOẶC XỈU */
    function activateBetSide(side) {
      if (selectedSide !== side) {
        // Reset cửa cũ
        if (selectedSide) {
          document.getElementById('btn-bet-' + selectedSide).classList.remove('active-bet');
          document.getElementById('val-' + selectedSide).innerText = '0';
        }
        selectedSide = side;
        accumulatedBet = 0;
        document.getElementById('btn-bet-' + side).classList.add('active-bet');
      }

      // Xuất hiện thanh chip vuông Neon bên dưới
      document.getElementById('chip-bar').classList.remove('hidden-bet');
    }

    /* CHỌN SỐ TIỀN MUỐN CƯỢC TÍCH LŨY */
    function addChipValue(val) {
      if (!selectedSide) return;
      accumulatedBet += val;
      document.getElementById('val-' + selectedSide).innerText = formatShortMoney(accumulatedBet);
    }

    /* NÚT ALIN (ALL-IN) SỐ DƯ */
    function doAllIn(side) {
      activateBetSide(side);
      accumulatedBet = userBalance;
      document.getElementById('val-' + side).innerText = formatShortMoney(accumulatedBet);
      showToast('Đã chọn Tất Tay (Alin): $' + formatNumber(userBalance), 2000);
    }

    /* XÁC NHẬN ĐẶT CƯỢC */
    function confirmBet() {
      if (!selectedSide || accumulatedBet <= 0) {
        showToast('Vui lòng chọn cửa và số tiền cược hợp lệ!', 2500);
        return;
      }

      if (accumulatedBet > userBalance) {
        showToast('Số dư tài khoản không đủ để đặt cược!', 2500);
        return;
      }

      // Trừ tiền thực tế
      userBalance -= accumulatedBet;
      updateDisplays();

      if (selectedSide === 'TAI') {
        taiMoney += accumulatedBet;
        bumpMoneyEffect('tai-amount');
      } else {
        xiuMoney += accumulatedBet;
        bumpMoneyEffect('xiu-amount');
      }

      showToast(`Đặt cược thành công $${formatNumber(accumulatedBet)} vào ${selectedSide}!`, 2500);

      // Thu gọn thanh chip
      cancelBet();
    }

    /* HỦY TRẠNG THÁI CƯỢC & THU GỌN CHIP */
    function cancelBet() {
      if (selectedSide) {
        document.getElementById('btn-bet-' + selectedSide).classList.remove('active-bet');
        document.getElementById('val-' + selectedSide).innerText = '0';
      }
      selectedSide = null;
      accumulatedBet = 0;
      document.getElementById('chip-bar').classList.add('hidden-bet');
    }

    /* LOGIC KÉO THẢ NẶN BÁT VÀ TỰ ĐỘNG TRƯỢT VỀ */
    function initBowlDragLogic() {
      let bowl = document.getElementById('bowl-cover');
      let isDragging = false;
      let startX = 0, startY = 0;
      let currentX = 0, currentY = 0;

      function onPointerDown(e) {
        isDragging = true;
        bowl.classList.remove('smooth-reset');
        let pageX = e.touches ? e.touches[0].pageX : e.pageX;
        let pageY = e.touches ? e.touches[0].pageY : e.pageY;
        startX = pageX - currentX;
        startY = pageY - currentY;
      }

      function onPointerMove(e) {
        if (!isDragging) return;
        let pageX = e.touches ? e.touches[0].pageX : e.pageX;
        let pageY = e.touches ? e.touches[0].pageY : e.pageY;
        currentX = pageX - startX;
        currentY = pageY - startY;

        // Giới hạn kéo bát trong phạm vi bàn
        let dist = Math.sqrt(currentX * currentX + currentY * currentY);
        if (dist > 160) {
          currentX = (currentX / dist) * 160;
          currentY = (currentY / dist) * 160;
        }

        bowl.style.transform = `translate(${currentX}px, ${currentY}px)`;
      }

      function onPointerUp() {
        if (!isDragging) return;
        isDragging = false;
        // Tự động trượt từ từ về vị trí ban đầu thực tế
        bowl.classList.add('smooth-reset');
        currentX = 0;
        currentY = 0;
        bowl.style.transform = 'translate(0px, 0px)';
      }

      bowl.addEventListener('mousedown', onPointerDown);
      window.addEventListener('mousemove', onPointerMove);
      window.addEventListener('mouseup', onPointerUp);

      bowl.addEventListener('touchstart', onPointerDown, { passive: true });
      window.addEventListener('touchmove', onPointerMove, { passive: true });
      window.addEventListener('touchend', onPointerUp);
    }

    /* GỬI CHAT */
    function sendChat() {
      let input = document.getElementById('chat-input-field');
      let txt = input.value.trim();
      if (!txt) return;

      let list = document.getElementById('chat-msg-list');
      let item = document.createElement('div');
      item.className = 'chat-item';
      item.innerHTML = `<span class="chat-user">hilohi123:</span> <span class="chat-text">${txt}</span>`;
      list.appendChild(item);
      list.scrollTop = list.scrollHeight;
      input.value = '';
    }

    function toggleChat() {
      let box = document.getElementById('chat-box');
      box.style.display = box.style.display === 'none' ? 'flex' : 'none';
    }
  </script>
