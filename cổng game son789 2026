                    <div class="bet-amount" id="bet-xiu">395,466,010</div>
                    <button class="btn-cuoc" onclick="placeBet('xiu')">CƯỢC</button>
                    <!-- LOGO LOGIC VÀ SỐ TIỀN CƯỢC -->
                    <div class="my-bet-tag" id="my-bet-xiu">
