            <!-- THẮNG CỘNG TIỀN MÀU VÀNG CAM THỰC TẾ -->
            <div class="win-effect" id="win-text">+ 0 đ</div>
        </div>

        <div class="banking-modal" id="banking-modal">
            <h3 id="bank-title">NẠP TIỀN</h3>
            <select class="bank-input">
                <option>Thẻ Cào Quét Mã QR</option>
                <option>Ngân Hàng Chuyển Khoản Fast 24/7</option>
                <option>Ví MoMo / ViettelMoney</option>
            </select>
            <input type="text" class="bank-input" placeholder="Nhập số tiền...">
            <button class="btn-submit-bank" onclick="closeBanking()">XÁC NHẬN</button>
            <button class="btn-submit-bank" style="background: #7f8c8d; margin-top: 5px;" onclick="closeBanking()">ĐÓNG</button>
        </div>
    </div>

    <script>
        // --- LOGIC LOADING SCREEN 1-100% ---
        let loadPercent = 0;
        const progressBar = document.getElementById('progress-bar');
        const loadingText = document.getElementById('loading-text');
        const loadingScreen = document.getElementById('loading-screen');
        const mainApp = document.getElementById('main-app');

        let loadInterval = setInterval(() => {
            loadPercent += Math.floor(Math.random() * 5) + 2;
            if (loadPercent >= 100) {
                loadPercent = 100;
                clearInterval(loadInterval);
                setTimeout(() => {
                    loadingScreen.style.opacity = '0';
                    setTimeout(() => {
                        loadingScreen.style.display = 'none';
                        mainApp.style.display = 'block';
                        showToast("Kết nối hệ thống thành công! Chúc bạn may mắn!");
                    }, 500);
                }, 300);
            }
            progressBar.style.width = loadPercent + '%';
            loadingText.innerText = `Đang tải... ${loadPercent}%`;
        }, 50);

        // --- KHỞI TẠO BIẾN TRẠNG THÁI ---
        let userBalance = 100000000;
        let selectedChip = 1000;
        let myBetTai = 0;
        let myBetXiu = 0;
        let currentSession = 177407;

        let gameTimer = 32;
        let nanTimer = 10;
        let gameState = "BETTING"; // BETTING, ROLLING, NAN, RESULT
        let timerInterval = null;
        let diceValues = [1, 2, 3];

        // Layout chấm cho 6 mặt của xúc xắc
        const pipPositions = {
            1: [5],
            2: [1, 9],
            3: [1, 5, 9],
            4: [1, 3, 7, 9],
            5: [1, 3, 5, 7, 9],
            6: [1, 3, 4, 6, 7, 9]
        };

        // --- THÔNG BÁO TOAST THỰC TẾ ---
        function showToast(msg) {
            const toast = document.getElementById('toast-notification');
            toast.innerText = msg;
            toast.style.display = 'block';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 2500);
        }

        // --- CHỌN MỨC CHIP ---
        function selectChip(val, element) {
            selectedChip = val;
            document.querySelectorAll('.chip-item').forEach(c => c.classList.remove('active'));
            if(element) element.classList.add('active');
            document.getElementById('selected-chip-val').innerText = val.toLocaleString() + ' đ';
            showToast(`Đã chọn mức chip: ${val.toLocaleString()} đ`);
        }

        // --- ĐẶT CƯỢC LINH HOẠT ---
        function placeBet(side) {
            if (gameState !== "BETTING") {
                showToast("Đã hết thời gian đặt cược!");
                return;
            }
            if (userBalance < selectedChip) {
                showToast("Số dư không đủ! Vui lòng nạp thêm.");
                return;
            }

            userBalance -= selectedChip;
            document.getElementById('user-balance').innerText = userBalance.toLocaleString() + ' đ';

            if (side === 'tai') {
                myBetTai += selectedChip;
                document.getElementById('my-bet-tai').style.display = 'flex';
                document.getElementById('my-amount-tai').innerText = myBetTai.toLocaleString();
            } else {
                myBetXiu += selectedChip;
                document.getElementById('my-bet-xiu').style.display = 'flex';
                document.getElementById('my-amount-xiu').innerText = myBetXiu.toLocaleString();
            }

            let totalBet = myBetTai + myBetXiu;
            document.getElementById('lobby-bet-status').innerText = `Đã cược: ${totalBet.toLocaleString()} đ`;
            showToast(`Cược thành công ${selectedChip.toLocaleString()} đ vào ${side.toUpperCase()}`);
        }

        // --- HIỂN THỊ MẶT XÚC XẮC CHUẨN ---
        function renderDice(dieId, val) {
            const die = document.getElementById(dieId);
            const pips = die.querySelectorAll('.dot-pip');
            pips.forEach(p => p.style.display = 'none');

            // Đổi màu chấm đỏ cho mặt 1 và 4
            if (val === 1 || val === 4) {
                die.classList.add('red-pip');
            } else {
                die.classList.remove('red-pip');
            }

            const activeIndices = pipPositions[val];
            const pipsArr = Array.from(pips);
            
            // Render theo lưới 3x3
            const gridMap = [1, 3, 2, 4, 5, 6, 7, 9, 8]; 
            // hiển thị các chấm tương ứng
            if(val === 1) pips[2].style.display = 'block'; // center
            else if(val === 2) { pips[0].style.display = 'block'; pips[4].style.display = 'block'; }
            else if(val === 3) { pips[0].style.display = 'block'; pips[2].style.display = 'block'; pips[4].style.display = 'block'; }
            else if(val === 4) { pips[0].style.display = 'block'; pips[1].style.display = 'block'; pips[3].style.display = 'block'; pips[4].style.display = 'block'; }
            else if(val === 5) { pips[0].style.display = 'block'; pips[1].style.display = 'block'; pips[2].style.display = 'block'; pips[3].style.display = 'block'; pips[4].style.display = 'block'; }
            else if(val === 6) { pips[0].style.display = 'block'; pips[1].style.display = 'block'; pips[3].style.display = 'block'; pips[4].style.display = 'block'; }
        }

        // --- MỞ/ĐÓNG GAME ---
        function openGame(type) {
            const modal = document.getElementById('game-board');
            modal.className = 'game-modal ' + (type === 'md5' ? 'theme-red' : 'theme-blue');
            document.getElementById('md5-container').style.display = (type === 'md5' ? 'flex' : 'none');
            modal.style.display = 'block';
            startMainLoop();
        }

        function closeGame() {
            document.getElementById('game-board').style.display = 'none';
        }

        // --- HỆ THỐNG VÒNG LẶP PHIÊN CHÍNH (32s CƯỢC -> 4s LẮC -> 10s NẶN) ---
        function startMainLoop() {
            if (timerInterval) return;

            timerInterval = setInterval(() => {
                if (gameState === "BETTING") {
                    gameTimer--;
                    document.getElementById('timer-text').innerText = gameTimer;

                    // Giả lập tiền cược nhảy linh hoạt
                    let bTai = parseInt(document.getElementById('bet-tai').innerText.replace(/,/g, '')) + Math.floor(Math.random()*500000);
                    let bXiu = parseInt(document.getElementById('bet-xiu').innerText.replace(/,/g, '')) + Math.floor(Math.random()*500000);
                    document.getElementById('bet-tai').innerText = bTai.toLocaleString();
                    document.getElementById('bet-xiu').innerText = bXiu.toLocaleString();

                    if (gameTimer <= 0) {
                        gameState = "ROLLING";
                        startRollingPhase();
                    }
                }
            }, 1000);
        }

        // --- PHA LẮC ĐẢO XÚC XẮC 4 GIÂY THỰC TẾ ---
        function startRollingPhase() {
            document.getElementById('timer-text').style.display = 'none';
            const blurRing = document.getElementById('blur-ring');
            const diceGroup = document.getElementById('dice-group');

            blurRing.style.display = 'block';
            diceGroup.style.display = 'flex';
            diceGroup.classList.add('dice-rolling-high');

            showToast("Đang lắc đĩa thực tế...");

            // Kết quả ngẫu nhiên trước
            diceValues = [
                Math.floor(Math.random()*6)+1,
                Math.floor(Math.random()*6)+1,
                Math.floor(Math.random()*6)+1
            ];

            // Sau đúng 4 GIÂY dừng lắc và đậy bát nặn
            setTimeout(() => {
                blurRing.style.display = 'none';
                diceGroup.classList.remove('dice-rolling-high');

                renderDice('d1', diceValues[0]);
                renderDice('d2', diceValues[1]);
                renderDice('d3', diceValues[2]);

                // Chuyển sang pha nặn 10 giây
                gameState = "NAN";
                startNanPhase();
            }, 4000);
        }

        // --- PHA NẶN BÁT 10 GIÂY THỰC TẾ ---
        function startNanPhase() {
            const bowl = document.getElementById('bowl-cover');
            const nanBadge = document.getElementById('nan-timer');
            bowl.style.display = 'block';
            bowl.style.left = '0px';
            bowl.style.top = '0px';
            bowl.style.opacity = '1';
            nanBadge.style.display = 'block';

            nanTimer = 10;
            nanBadge.innerText = `NẶN: ${nanTimer}s`;

            let nanInterval = setInterval(() => {
                nanTimer--;
                nanBadge.innerText = `NẶN: ${nanTimer}s`;

                if (nanTimer <= 0 || bowl.style.display === 'none') {
                    clearInterval(nanInterval);
                    finishRound();
                }
            }, 1000);
        }

        // --- KẾT THÚC VÒNG VÀ TÍNH TIỀN ---
        function finishRound() {
            document.getElementById('bowl-cover').style.display = 'none';
            document.getElementById('nan-timer').style.display = 'none';

            let totalPoints = diceValues[0] + diceValues[1] + diceValues[2];
            let resultSide = totalPoints >= 11 ? 'tai' : 'xiu';

            showToast(`KẾT QUẢ: ${totalPoints} ĐIỂM (${resultSide.toUpperCase()})`);

            let winAmount = 0;
            if (resultSide === 'tai' && myBetTai > 0) winAmount = myBetTai * 1.98;
            if (resultSide === 'xiu' && myBetXiu > 0) winAmount = myBetXiu * 1.98;

            if (winAmount > 0) {
                userBalance += winAmount;
                document.getElementById('user-balance').innerText = userBalance.toLocaleString() + ' đ';

                const winText = document.getElementById('win-text');
                winText.innerText = `+ ${winAmount.toLocaleString()} đ`;
                winText.style.display = 'block';
                setTimeout(() => winText.style.display = 'none', 2000);
            }

            // Reset chuẩn bị cho phiên mới sau 4s
            setTimeout(() => {
                resetNewRound();
            }, 4000);
        }

        function resetNewRound() {
            currentSession++;
            document.getElementById('session-label').innerText = `#${currentSession}`;
            gameTimer = 32;
            gameState = "BETTING";

            myBetTai = 0;
            myBetXiu = 0;
            document.getElementById('my-bet-tai').style.display = 'none';
            document.getElementById('my-bet-xiu').style.display = 'none';
            document.getElementById('lobby-bet-status').innerText = 'Chờ Đặt Cược';

            document.getElementById('dice-group').style.display = 'none';
            document.getElementById('timer-text').style.display = 'block';
            document.getElementById('timer-text').innerText = gameTimer;
        }

        // --- LẬP TRÌNH KÉO THẢ NẮP (BÁT) NẶN 10S THỰC TẾ ---
        const bowl = document.getElementById('bowl-cover');
        let isDragging = false;
        let startX, startY, initialLeft, initialTop;

        function onPointerDown(e) {
            if (gameState !== "NAN") return;
            isDragging = true;
            bowl.style.transition = 'none'; // Tắt transition khi đang kéo thủ công
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            
            startX = clientX;
            startY = clientY;
            initialLeft = bowl.offsetLeft;
            initialTop = bowl.offsetTop;
        }

        function onPointerMove(e) {
            if (!isDragging) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;

            const deltaX = clientX - startX;
            const deltaY = clientY - startY;

            bowl.style.left = (initialLeft + deltaX) + 'px';
            bowl.style.top = (initialTop + deltaY) + 'px';

            // Nếu kéo mở ra xa quá thì tự động mở hết
            let dist = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
            if (dist > 110) {
                isDragging = false;
                bowl.style.transition = 'all 0.3s ease-out';
                bowl.style.opacity = '0';
                setTimeout(() => {
                    bowl.style.display = 'none';
                }, 300);
            }
        }

        function onPointerUp() {
            if (!isDragging) return;
            isDragging = false;
            // KHI THẢ RA: Nắp tự động trượt từ từ trở về vị trí cũ thực tế hơn kịch tính hơn
            bowl.style.transition = 'all 0.4s cubic-bezier(0.25, 1, 0.5, 1)';
            bowl.style.left = '0px';
            bowl.style.top = '0px';
        }

        bowl.addEventListener('mousedown', onPointerDown);
        document.addEventListener('mousemove', onPointerMove);
        document.addEventListener('mouseup', onPointerUp);

        bowl.addEventListener('touchstart', onPointerDown, {passive: false});
        document.addEventListener('touchmove', onPointerMove, {passive: false});
        document.addEventListener('touchend', onPointerUp);

        // --- CÁC HÀM TIỆN ÍCH KHÁC ---
        function copyMD5() {
            const hash = document.getElementById('md5-hash').innerText;
            navigator.clipboard.writeText(hash);
            showToast("Đã copy chuỗi MD5 thành công!");
        }

        function openBanking(title) {
            document.getElementById('bank-title').innerText = title;
            document.getElementById('banking-modal').style.display = 'block';
        }

        function closeBanking() {
            document.getElementById('banking-modal').style.display = 'none';
            showToast("Thao tác thành công!");
        }
    </script>
