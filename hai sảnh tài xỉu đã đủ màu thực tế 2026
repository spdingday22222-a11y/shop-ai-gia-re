              <div class="face face-5"><div class="dot-pip p1"></div><div class="dot-pip p3"></div><div class="dot-pip p5"></div><div class="dot-pip p7"></div><div class="dot-pip p9"></div></div>
              <div class="face face-3"><div class="dot-pip p1"></div><div class="dot-pip p5"></div><div class="dot-pip p9"></div></div>
              <div class="face face-4"><div class="dot-pip p1"></div><div class="dot-pip p3"></div><div class="dot-pip p7"></div><div class="dot-pip p9"></div></div>
            </div></div>
          </div>
        </div>

        <!-- CỬA XỈU -->
        <div class="bet-side">
          <div class="player-count">👤 <span id="xiu-players">357</span></div>
          <div class="bet-title">XỈU</div>
          <div class="bet-amount" id="xiu-amount">237.436.422</div>
          <button class="btn-cuoc" onclick="showToast('Chọn mức cược bên dưới')">CƯỢC</button>
        </div>

        <!-- BẢNG CẦU -->
        <div class="history-dots">
          <div class="dot tai"></div><div class="dot xiu"></div><div class="dot xiu"></div>
          <div class="dot tai"></div><div class="dot tai"></div><div class="dot xiu"></div>
          <div class="dot tai"></div><div class="dot xiu"></div><div class="dot tai"></div>
        </div>
      </div>

      <!-- CHIP CƯỢC NGANG LOGIC -->
      <div class="chip-bar-container">
        <div class="chip-item chip-1k selected" onclick="selectChip(this, 1000)">1K</div>
        <div class="chip-item chip-10k" onclick="selectChip(this, 10000)">10K</div>
        <div class="chip-item chip-50k" onclick="selectChip(this, 50000)">50K</div>
        <div class="chip-item chip-500k" onclick="selectChip(this, 500000)">500K</div>
        <div class="chip-item chip-1m" onclick="selectChip(this, 1000000)">1M</div>
        <div class="chip-item chip-10m" onclick="selectChip(this, 10000000)">10M</div>
        <button class="btn-chip-action btn-chip-confirm" onclick="confirmBet()">ĐẶT CƯỢC</button>
        <button class="btn-chip-action btn-chip-cancel" onclick="showToast('Đã hủy đặt')">HỦY</button>
      </div>

      <!-- KHUNG CHAT BÊN PHẢI CHUẨN IMAGE 1 -->
      <div class="chat-box-real" id="chat-box">
        <div class="chat-messages" id="chat-msg-list">
          <div class="chat-item"><span class="chat-user">binh123457986:</span> <span class="chat-text">win tao loc</span></div>
          <div class="chat-item"><span class="chat-user">tipclubvl:</span> <span class="chat-text">đéo ham lắm</span></div>
          <div class="chat-item"><span class="chat-user">xxxxxxs:</span> <span class="chat-text">an roi =)))))))))</span></div>
          <div class="chat-item"><span class="chat-user">bebo2015:</span> <span class="chat-text">T danh xiu</span></div>
          <div class="chat-item"><span class="chat-user">taixiuhupsml86:</span> <span class="chat-text">đéo bẻ nữa đm</span></div>
        </div>
        <div class="chat-input-row">
          <input type="text" id="chat-input-field" class="chat-input" placeholder="Nhập nội dung chat..." onkeydown="if(event.key==='Enter') sendChat()">
          <button class="btn-send-chat" onclick="sendChat()">GỬI</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    /* CORE LOGIC & ANIMATIONS */
    let userBalance = 57300755;
    let selectedChipValue = 1000;
    let currentMode = 'MD5'; // 'MD5' hoặc 'THUONG'
    let countdown = 25;
    let timerInterval = null;

    let taiMoney = 265337546;
    let xiuMoney = 237436422;
    let taiUsers = 344;
    let xiuUsers = 357;

    // Giả lập Loading
    window.onload = () => {
      let fill = document.getElementById('loader-fill');
      let w = 0;
      let interval = setInterval(() => {
        w += 5;
        fill.style.width = w + '%';
        if (w >= 100) {
          clearInterval(interval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
        }
      }, 50);

      initCanvasFX();
    };

    function showToast(msg) {
      let t = document.getElementById('toast');
      t.innerText = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2000);
    }

    function enterArena(mode) {
      currentMode = mode;
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => document.getElementById('arena-screen').classList.add('active'), 10);

      let board = document.getElementById('main-board');
      let title = document.getElementById('arena-title');

      if (mode === 'MD5') {
        board.className = 'real-taixiu-board theme-md5';
        title.innerText = 'TÀI XỈU MD5';
        taiMoney = 265337546; xiuMoney = 237436422;
      } else {
        board.className = 'real-taixiu-board theme-thuong';
        title.innerText = 'TÀI XỈU THƯỜNG';
        taiMoney = 443809158; xiuMoney = 216193290;
      }

      updateDisplays();
      startTimer();
    }

    function exitArena() {
      clearInterval(timerInterval);
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    /* BẬT HIỆU ỨNG NẨY SỐ VÀNG CAM THỰC TẾ TRONG GAME */
    function bumpMoneyEffect(elementId) {
      let el = document.getElementById(elementId);
      el.classList.remove('bump-orange');
      void el.offsetWidth; // Trigger reflow
      el.classList.add('bump-orange');
    }

    function startTimer() {
      clearInterval(timerInterval);
      countdown = 25;
      document.getElementById('dice-container').style.display = 'none';
      document.getElementById('timer-text').style.display = 'block';

      timerInterval = setInterval(() => {
        countdown--;
        document.getElementById('timer-text').innerText = countdown < 10 ? '0' + countdown : countdown;

        // Giả lập nhảy số nhảy người chơi liên tục sống động
        if (countdown > 5) {
          if (Math.random() > 0.3) {
            taiMoney += Math.floor(Math.random() * 2000000);
            bumpMoneyEffect('tai-amount');
          }
          if (Math.random() > 0.3) {
            xiuMoney += Math.floor(Math.random() * 2000000);
            bumpMoneyEffect('xiu-amount');
          }
          taiUsers += Math.random() > 0.5 ? 1 : 0;
          xiuUsers += Math.random() > 0.5 ? 1 : 0;
          updateDisplays();
        }

        if (countdown <= 0) {
          clearInterval(timerInterval);
          rollDiceResult();
        }
      }, 1000);
    }

    function rollDiceResult() {
      document.getElementById('timer-text').style.display = 'none';
      let diceContainer = document.getElementById('dice-container');
      diceContainer.style.display = 'block';

      let cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];
      cubes.forEach(c => c.classList.add('rolling'));

      setTimeout(() => {
        cubes.forEach(c => c.classList.remove('rolling'));
        let d1 = Math.floor(Math.random() * 6) + 1;
        let d2 = Math.floor(Math.random() * 6) + 1;
        let d3 = Math.floor(Math.random() * 6) + 1;

        applyCubeRotation('cube1', d1);
        applyCubeRotation('cube2', d2);
        applyCubeRotation('cube3', d3);

        let total = d1 + d2 + d3;
        let isTai = total >= 11;
        showToast(`KẾT QUẢ: ${total} DIỂM (${isTai ? 'TÀI' : 'XỈU'})`);
        triggerFirework();

        setTimeout(startTimer, 5000);
      }, 1500);
    }

    function applyCubeRotation(cubeId, value) {
      let cube = document.getElementById(cubeId);
      let rotations = {
        1: 'rotateY(0deg)', 6: 'rotateY(180deg)',
        2: 'rotateY(90deg)', 5: 'rotateY(-90deg)',
        3: 'rotateX(-90deg)', 4: 'rotateX(90deg)'
      };
      cube.style.transform = rotations[value];
    }

    function updateDisplays() {
      document.getElementById('tai-amount').innerText = taiMoney.toLocaleString('vi-VN');
      document.getElementById('xiu-amount').innerText = xiuMoney.toLocaleString('vi-VN');
      document.getElementById('tai-players').innerText = taiUsers;
      document.getElementById('xiu-players').innerText = xiuUsers;
    }

    function selectChip(el, val) {
      document.querySelectorAll('.chip-item').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      selectedChipValue = val;
    }

    function confirmBet() {
      if (userBalance >= selectedChipValue) {
        userBalance -= selectedChipValue;
        document.getElementById('user-balance').innerText = '$ ' + userBalance.toLocaleString('vi-VN');
        document.getElementById('arena-balance').innerText = '$ ' + userBalance.toLocaleString('vi-VN');
        showToast(`Đặt cược thành công $ ${selectedChipValue.toLocaleString('vi-VN')}`);
      } else {
        showToast('Số dư không đủ!');
      }
    }

    function toggleChat() {
      let chat = document.getElementById('chat-box');
      chat.style.display = chat.style.display === 'none' ? 'flex' : 'none';
    }

    function sendChat() {
      let input = document.getElementById('chat-input-field');
      if (input.value.trim() !== '') {
        let list = document.getElementById('chat-msg-list');
        let div = document.createElement('div');
        div.className = 'chat-item';
        div.innerHTML = `<span class="chat-user">hilohi123:</span> <span class="chat-text">${input.value}</span>`;
        list.appendChild(div);
        list.scrollTop = list.scrollHeight;
        input.value = '';
      }
    }

    /* CANVAS PHÁO HOA TÓE MÀU VÀNG CAM */
    function initCanvasFX() {
      let canvas = document.getElementById('fx-canvas');
      let ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      window.particles = [];
      window.triggerFirework = () => {
        for (let i = 0; i < 60; i++) {
          particles.push({
            x: canvas.width / 2,
            y: canvas.height / 2,
            vx: (Math.random() - 0.5) * 12,
            vy: (Math.random() - 0.5) * 12,
            color: Math.random() > 0.5 ? '#ff9d00' : '#ff3600',
            size: Math.random() * 4 + 2,
            alpha: 1
          });
        }
      };

      function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p, idx) => {
          p.x += p.vx; p.y += p.vy; p.alpha -= 0.015;
          ctx.globalAlpha = Math.max(p.alpha, 0);
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
          if (p.alpha <= 0) particles.splice(idx, 1);
        });
        requestAnimationFrame(loop);
      }
      loop();
    }
  </script>
</body>
</html>
