  <script>
    // State Quản Lý Game
    let balance = 57300755;
    let timerVal = 45;
    let mainLoop = null;
    let currentSideBet = '';
    let userBets = { TAI: 0, XIU: 0 };
    let isRolling = false;

    // Góc quay 3D mặt chuẩn xác [X, Y] để hiện đúng con số mặt trên cùng
    const rotationMap = {
      1: { x: 0, y: 0 },
      6: { x: 0, y: 180 },
      2: { x: 0, y: 90 },
      5: { x: 0, y: -90 },
      3: { x: -90, y: 0 },
      4: { x: 90, y: 0 }
    };

    // Tự động tải Loader
    window.addEventListener('DOMContentLoaded', () => {
      let fill = document.getElementById('loader-fill');
      let text = document.getElementById('loader-text');
      let progress = 0;

      let interval = setInterval(() => {
        progress += Math.floor(Math.random() * 12) + 5;
        if (progress >= 100) {
          progress = 100;
          clearInterval(interval);
          setTimeout(() => {
            switchScreen('loading-screen', 'lobby-screen');
            startGlobalTimer();
          }, 300);
        }
        fill.style.width = progress + '%';
        text.innerText = `Đang khởi tạo Engine 3D... ${progress}%`;
      }, 50);
    });

    function switchScreen(fromId, toId) {
      document.getElementById(fromId).classList.remove('active');
      setTimeout(() => {
        document.getElementById(fromId).style.display = 'none';
        let target = document.getElementById(toId);
        target.style.display = 'flex';
        setTimeout(() => target.classList.add('active'), 20);
      }, 300);
    }

    function showToast(msg) {
      let toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2200);
    }

    function formatNum(num) {
      return num.toLocaleString('en-US');
    }

    function enterArena(mode) {
      let arena = document.getElementById('arena-screen');
      if (mode === 'HOT_TAIXIU') {
        arena.classList.add('hot-theme');
        document.getElementById('arena-title-text').innerText = 'SẢNH HOT TÀI XỈU 3D';
      } else {
        arena.classList.remove('hot-theme');
        document.getElementById('arena-title-text').innerText = 'SẢNH TÀI XỈU MD5 PRO';
      }
      switchScreen('lobby-screen', 'arena-screen');
    }

    function exitArena() {
      switchScreen('arena-screen', 'lobby-screen');
