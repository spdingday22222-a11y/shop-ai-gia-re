  <script>
    /* GAME STATE MANAGEMENT */
    let balance = 57300755;
    let selectedSide = null; // 'TÀI' or 'XỈU'
    let pendingBetAmount = 0;
    let myBet = { 'TÀI': 0, 'XỈU': 0 };
    let countdown = 45;
    let timerInterval = null;
    let isRolling = false;
    let isCamera3D = false;

    // Góc xoay 3D chuẩn cho từng mặt xúc xắc
    const faceRotations = {
      1: { x: 0, y: 0 },
      2: { x: 0, y: 90 },
      3: { x: -90, y: 0 },
      4: { x: 90, y: 0 },
      5: { x: 0, y: -90 },
      6: { x: 0, y: 180 }
    };

    /* INITIALIZATION & LOADING */
    window.onload = function() {
      let fill = document.getElementById('loader-fill');
      let text = document.getElementById('loader-text');
      let progress = 0;
      
      let loadInterval = setInterval(() => {
        progress += 5;
        fill.style.width = progress + '%';
        if (progress === 40) text.innerText = 'Đang tải tài nguyên WebGL 3D...';
        if (progress === 80) text.innerText = 'Đang kết nối Máy chủ...';
        
        if (progress >= 100) {
          clearInterval(loadInterval);
          document.getElementById('loading-screen').classList.remove('active');
          document.getElementById('lobby-screen').classList.add('active');
          startTimer();
        }
      }, 50);
      
      updateBalanceUI();
    };

    /* UTILS & UI FUNCTIONS */
    function formatNumber(num) {
      return num.toLocaleString('en-US');
    }

    function updateBalanceUI() {
      document.getElementById('user-balance').innerText = formatNumber(balance);
      document.getElementById('arena-balance').innerText = formatNumber(balance);
    }

    function showToast(msg) {
      let toast = document.getElementById('toast');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    /* SCREEN NAVIGATION */
    function enterArena(mode) {
      document.getElementById('lobby-screen').classList.remove('active');
      document.getElementById('arena-screen').style.display = 'flex';
      setTimeout(() => {
        document.getElementById('arena-screen').classList.add('active');
      }, 10);
      
      if(mode === 'MD5_TAIXIU') {
        document.getElementById('arena-title-text').innerText = 'SẢNH TÀI XỈU MD5 3D';
      } else {
        document.getElementById('arena-title-text').innerText = 'SẢNH TÀI XỈU REAL 3D';
      }
    }

    function exitArena() {
      document.getElementById('arena-screen').classList.remove('active');
      setTimeout(() => {
        document.getElementById('arena-screen').style.display = 'none';
        document.getElementById('lobby-screen').classList.add('active');
      }, 300);
    }

    function toggleCamera3D() {
      let stage = document.getElementById('arena-stage');
      isCamera3D = !isCamera3D;
      if (isCamera3D) {
        stage.style.transform = 'rotateX(25deg) rotateY(-10deg) scale(0.95)';
        showToast('Góc nhìn 3D: Bật');
      } else {
        stage.style.transform = 'none';
        showToast('Góc nhìn 3D: Tắt');
      }
    }

    /* BETTING LOGIC */
    function selectSide(side) {
      if (countdown <= 5) {
        showToast('Đã hết thời gian đặt cược!');
        return;
      }

      selectedSide = side;
      document.getElementById('side-tai').classList.remove('selected-side');
      document.getElementById('side-xiu').classList.remove('selected-side');
      
      if (side === 'TÀI') {
        document.getElementById('side-tai').classList.add('selected-side');
      } else {
        document.getElementById('side-xiu').classList.add('selected-side');
      }

      document.getElementById('bottom-dock').classList.add('active-dock');
    }

    function addChip(amount) {
      if (!selectedSide) {
        showToast('Vui lòng chọn cửa cược (Tài hoặc Xỉu) trước!');
        return;
      }
      if (pendingBetAmount + amount > balance) {
        showToast('Số dư không đủ để cược thêm!');
        return;
      }
      pendingBetAmount += amount;
      updatePendingUI();
    }

    function multiplyBet(factor) {
      if (!selectedSide || pendingBetAmount === 0) return;
      if (pendingBetAmount * factor > balance) {
        showToast('Số dư không đủ!');
        return;
      }
      pendingBetAmount *= factor;
      updatePendingUI();
    }

    function allInBet() {
      if (!selectedSide) {
        showToast('Vui lòng chọn cửa cược trước!');
        return;
      }
      pendingBetAmount = balance;
      updatePendingUI();
    }

    function clearPendingBet() {
      pendingBetAmount = 0;
      updatePendingUI();
    }

    function updatePendingUI() {
      let pTai = document.getElementById('pending-tai-bet');
      let pXiu = document.getElementById('pending-xiu-bet');

      if (selectedSide === 'TÀI' && pendingBetAmount > 0) {
        pTai.innerText = '+' + formatNumber(pendingBetAmount);
        pTai.style.display = 'block';
        pXiu.style.display = 'none';
      } else if (selectedSide === 'XỈU' && pendingBetAmount > 0) {
        pXiu.innerText = '+' + formatNumber(pendingBetAmount);
        pXiu.style.display = 'block';
        pTai.style.display = 'none';
      } else {
        pTai.style.display = 'none';
        pXiu.style.display = 'none';
      }
    }

    function confirmBet() {
      if (!selectedSide || pendingBetAmount <= 0) return;

      balance -= pendingBetAmount;
      myBet[selectedSide] += pendingBetAmount;
      
      updateBalanceUI();

      if (selectedSide === 'TÀI') {
        let tag = document.getElementById('my-tai-bet');
        tag.innerText = 'Đã Cược: ' + formatNumber(myBet['TÀI']);
        tag.style.display = 'block';
      } else {
        let tag = document.getElementById('my-xiu-bet');
        tag.innerText = 'Đã Cược: ' + formatNumber(myBet['XỈU']);
        tag.style.display = 'block';
      }

      showToast(`Đã cược ${formatNumber(pendingBetAmount)} vào cửa ${selectedSide}`);
      pendingBetAmount = 0;
      updatePendingUI();
    }

    /* GAME LOOP & TIMER */
    function startTimer() {
      timerInterval = setInterval(() => {
        countdown--;
        if (countdown < 0) countdown = 50; // Reset phiên

        // Cập nhật Timer hiển thị
        let displaySec = countdown > 45 ? 0 : countdown;
        let strSec = displaySec < 10 ? '0' + displaySec : displaySec;
        
        document.getElementById('timer').innerText = strSec;
        document.getElementById('lobby-time-1').innerText = '00:' + strSec;
        document.getElementById('lobby-time-2').innerText = '00:' + strSec;

        // Bắt đầu quay xúc xắc khi đếm ngược về 0
        if (countdown === 0 && !isRolling) {
          runDiceRoll();
        }

        // Tự động biến đổi tiền cược ảo trong phòng tạo cảm giác thực tế
        if (countdown > 5) {
          fakeRandomBets();
        } else {
          document.getElementById('bottom-dock').classList.remove('active-dock');
        }
      }, 1000);
    }

    function fakeRandomBets() {
      let currentTai = parseInt(document.getElementById('tai-amount').innerText.replace(/,/g, ''));
      let currentXiu = parseInt(document.getElementById('xiu-amount').innerText.replace(/,/g, ''));
      
      currentTai += Math.floor(Math.random() * 500) * 10000;
      currentXiu += Math.floor(Math.random() * 500) * 10000;

      document.getElementById('tai-amount').innerText = formatNumber(currentTai);
      document.getElementById('xiu-amount').innerText = formatNumber(currentXiu);
    }

    /* 3D DICE ROLL LOGIC */
    function runDiceRoll() {
      isRolling = true;
      showToast('Đang xóc đĩa...');

      let cubes = [document.getElementById('cube1'), document.getElementById('cube2'), document.getElementById('cube3')];
      let wrappers = [document.getElementById('wrap1'), document.getElementById('wrap2'), document.getElementById('wrap3')];

      // Thêm class animation nảy và xoay
      cubes.forEach(c => c.classList.add('rolling'));
      wrappers.forEach((w, idx) => w.classList.add(`rolling-${idx+1}`));

      setTimeout(() => {
        // Dừng animation
        cubes.forEach(c => c.classList.remove('rolling'));
        wrappers.forEach((w, idx) => w.classList.remove(`rolling-${idx+1}`));

        // Tạo ngẫu nhiên kết quả 3 viên (1-6)
        let r1 = Math.floor(Math.random() * 6) + 1;
        let r2 = Math.floor(Math.random() * 6) + 1;
        let r3 = Math.floor(Math.random() * 6) + 1;

        setCubeResult(cubes[0], r1);
        setCubeResult(cubes[1], r2);
        setCubeResult(cubes[2], r3);

        let total = r1 + r2 + r3;
        let resultSide = total >= 11 ? 'TÀI' : 'XỈU';

        setTimeout(() => {
          handleWin(resultSide, total);
          isRolling = false;
        }, 800);

      }, 1200);
    }

    function setCubeResult(cube, val) {
      let rot = faceRotations[val];
      // Xoay thêm 360 độ để tạo cảm giác chuyển đổi mượt
      cube.style.transform = `rotateX(${rot.x + 720}deg) rotateY(${rot.y + 720}deg)`;
    }

    function handleWin(resultSide, total) {
      showToast(`Kết quả: ${total} điểm - ${resultSide}`);

      // Highlight cửa thắng
      let winElem = resultSide === 'TÀI' ? document.getElementById('side-tai') : document.getElementById('side-xiu');
      winElem.classList.add('active-win');

      // Thêm điểm vào lịch sử
      let historyBox = document.getElementById('history-dots');
      let newDot = document.createElement('div');
      newDot.className = `dot ${resultSide.toLowerCase()}`;
      historyBox.appendChild(newDot);
      if (historyBox.children.length > 10) historyBox.removeChild(historyBox.children[0]);

      // Xử lý trả thưởng nếu cược trúng
      if (myBet[resultSide] > 0) {
        let winMoney = myBet[resultSide] * 2;
        balance += winMoney;
        updateBalanceUI();

        // Hiển thị Banner thắng
        document.getElementById('win-money-text').innerText = '+' + formatNumber(winMoney);
        let banner = document.getElementById('win-banner');
        banner.classList.add('show');
        setTimeout(() => banner.classList.remove('show'), 3000);
      }

      // Reset phiên cược sau 4 giây
      setTimeout(() => {
        winElem.classList.remove('active-win');
        document.getElementById('side-tai').classList.remove('selected-side');
        document.getElementById('side-xiu').classList.remove('selected-side');
        document.getElementById('my-tai-bet').style.display = 'none';
        document.getElementById('my-xiu-bet').style.display = 'none';
        
        myBet = { 'TÀI': 0, 'XỈU': 0 };
        selectedSide = null;
      }, 4000);
    }
  </script>
