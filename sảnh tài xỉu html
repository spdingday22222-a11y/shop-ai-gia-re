<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Go88 Real - Tài Xỉu MD5 VIP</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Arial Black', 'Arial', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #020204;
      color: #ffffff;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app-screen {
      position: absolute;
      top: 0; left: 0; width: 100vw; height: 100vh;
      display: none; opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex; opacity: 1; z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle, #101018 0%, #020204 100%);
      flex-direction: column; justify-content: center; align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 40px; font-weight: 900;
      background: linear-gradient(180deg, #1f1f1e 0%, #222222 45%, #e65c00 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 20px rgba(31, 31, 30, 0.7));
      letter-spacing: 2px; text-transform: uppercase;
    }

    .loader-box {
      width: 320px; height: 14px; background: rgba(0,0,0,0.9);
      border: 1.5px solid #ffb703; border-radius: 10px; padding: 2px; margin-top: 20px;
      box-shadow: 0 0 15px rgba(255, 183, 3, 0.3);
    }

    .loader-fill {
      height: 100%; width: 0%;
      background: linear-gradient(90deg, #ff8000, #ffea00);
      border-radius: 10px; transition: width 0.05s linear;
      box-shadow: 0 0 10px #ffea00;
    }

    /* 2. LOBBY */
    .game-lobby {
      position: relative; width: 100vw; height: 100vh;
      background: radial-gradient(circle at center, #0d0e0d 0%, #030303 50%, #0f0f0f 100%);
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .top-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 24px; background: rgba(15, 15, 15, 0.95);
      border-bottom: 2px solid #181717; z-index: 20;
      box-shadow: 0 4px 20px rgba(20, 20, 20, 0.8);
    }

    .user-info { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 42px; height: 42px; border-radius: 10px; border: 2px solid #df0a0a; background-size: cover; box-shadow: 0 0 8px rgba(255,183,3,0.5); }
    .balance-box {
      background: #08080c; border: 1.5px solid #242423;
      border-radius: 18px; padding: 4px 16px; color: #666565;
      font-weight: bold; font-size: 15px; text-shadow: 0 0 8px rgba(41, 41, 40, 0.5);
      box-shadow: inset 0 0 6px rgba(0,0,0,0.8);
    }

    .lobby-content { display: flex; justify-content: center; align-items: center; gap: 30px; flex: 1; }

    .game-card {
      width: 210px; height: 270px; border-radius: 18px; border: 2px solid #161616;
      display: flex; flex-direction: column; justify-content: space-between; padding: 18px;
      cursor: pointer; transition: transform 0.25s, box-shadow 0.25s;
      background: linear-gradient(180deg, #1f1f2e 0%, #0a0a10 100%);
      box-shadow: 0 0 25px rgba(255, 183, 3, 0.25), inset 0 0 15px rgba(255, 255, 255, 0.05);
    }
    .game-card:hover { transform: translateY(-5px) scale(1.03); box-shadow: 0 0 35px rgba(236, 170, 1, 0.5); }

    .card-title {
      font-size: 20px; font-weight: 900; text-align: center;
      background: linear-gradient(180deg, #ffffff 0%, #1f1c02 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }
    .card-sub { font-size: 11px; text-align: center; color: #00ffcc; font-weight: bold; letter-spacing: 1px; }

    /* 3. ARENA GAME PLAY */
    .arena-screen {
      position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(2, 2, 5, 0.98); z-index: 100; display: none;
      flex-direction: column; justify-content: space-between;
    }

    .arena-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 24px; background: rgba(10, 10, 15, 0.98); border-bottom: 1.5px solid #0d0e0d;
      z-index: 20; box-shadow: 0 4px 15px rgba(0,0,0,0.8);
    }

    .btn-back-lobby {
      background: linear-gradient(180deg, #80000a, #4a0005);
    }

    .arena-stage { flex: 1; display: flex; justify-content: center; align-items: center; position: relative; }

    .dim-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      z-index: 11; opacity: 0; pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .dim-overlay.active { opacity: 1; }

    .real-taixiu-board {
      position: absolute; width: 740px; height: 360px;
      border-radius: 180px; display: flex; justify-content: space-between; align-items: center;
      padding: 20px 40px;
      background: radial-gradient(circle at center, #470707 0%, #5a0606 60%, #5a0202 100%);
      border: 4px solid #c5c3c3;
      box-shadow: 0 0 60px rgba(36, 36, 36, 0.35), inset 0 0 30px rgba(43, 43, 43, 0.9), inset 0 0 10px rgba(26, 25, 25, 0.3);
      cursor: grab;
      touch-action: none;
      transition: transform 0.05s linear;
    }
    .real-taixiu-board:active { cursor: grabbing; }

    .board-logo {
      position: absolute; top: 18px; left: 50%; transform: translateX(-50%);
      font-size: 16px; font-weight: 900; letter-spacing: 2px;
      background: linear-gradient(180deg, #eb0404 0%, #e90404 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 8px rgba(224, 9, 9, 0.904));
      z-index: 5; pointer-events: none;
    }

    .circle-btn {
      position: absolute; width: 36px; height: 36px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center; color: #fff;
      font-size: 14px; font-weight: bold; cursor: pointer;
      background: linear-gradient(180deg, #2a2a38, #1e1e1f);
      border: 1.5px solid #292928; z-index: 15; box-shadow: 0 4px 8px #242424, 0 0 8px rgba(31, 31, 30, 0.3);
      transition: transform 0.15s;
    }
    .circle-btn:active { transform: scale(0.9); }

    .btn-info { top: 22px; left: 145px; }
    .btn-chart { top: 88px; left: 60px; background: linear-gradient(180deg, #0077b6, #023e8a); }
    .btn-help { top: 158px; left: 25px; }
    .btn-history { top: 228px; left: 60px; }

    .btn-close { top: 22px; right: 145px; background: linear-gradient(180deg, #9e1a22, #500000); }
    .btn-rank { top: 88px; right: 60px; }
    .btn-chat-toggle { top: 158px; right: 25px; }

    .btn-nan-hand {
      position: absolute; right: 105px; bottom: 25px; width: 46px; height: 46px;
      border-radius: 50%; background: radial-gradient(circle, #252525, #161616);
      border: 2px solid #0e0d0d; box-shadow: 0 0 12px #2b2a2a, 0 4px 8px #202020;
      display: flex; justify-content: center; align-items: center; font-size: 22px;
      cursor: pointer; z-index: 16; transition: transform 0.2s, background 0.3s;
    }
    .btn-nan-hand.active { background: radial-gradient(circle, #333333, #474747); border-color: #161616; box-shadow: 0 0 15px #00ffff; }

    .bet-side {
      width: 200px; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 10;
    }

    .player-count {
      font-size: 13px; color: #252525; font-weight: bold; margin-bottom: 2px;
      text-shadow: 0 0 5px #242423; transition: transform 0.2s ease;
    }

    .bet-title {
      font-size: 56px; font-weight: 900; color: #cfd1cf;
      text-shadow: 0 4px 10px rgba(15, 15, 15, 0.9), 0 0 15px rgba(48, 47, 47, 0.3);
      letter-spacing: 3px; transition: all 0.3s ease;
    }
    .bet-title.highlight-pulse {
      color: #080808; text-shadow: 0 0 25px #0a0a0a, 0 0 50px #0c0c0c;
      animation: pulseGlow 0.6s infinite alternate;
    }
    @keyframes pulseGlow {
      from { transform: scale(1); }
      to { transform: scale(1.12); }
    }

    .bet-amount {
      font-size: 18px; font-weight: 900; color: #51bb14;
      text-shadow: 0 0 8px rgba(58, 187, 18, 0.6), 0 2px 4px #272727; margin-bottom: 8px;
      transition: transform 0.15s ease;
    }

    .bounce-val {
      display: inline-block;
      animation: bounceNumber 0.25s ease;
    }
    @keyframes bounceNumber {
      0% { transform: scale(1); }
      50% { transform: scale(1.18); color: #20be12; }
      100% { transform: scale(1); }
    }

    .btn-cuoc-oval {
      width: 145px; height: 40px;
      background: radial-gradient(circle, #111111 0%, #181818 100%);
      border: 2px solid #242324; border-radius: 20px;
      display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: inset 0 0 8px rgba(27, 27, 27, 0.9), 0 4px 10px rgba(22, 22, 22, 0.8), 0 0 10px rgba(255, 183, 3, 0.2);
      transition: transform 0.1s, border-color 0.2s;
    }
    .btn-cuoc-oval:active { transform: scale(0.95); }

    .bet-text-val { font-size: 16px; font-weight: 900; color: #f0b105; text-shadow: 0 1px 2px #000; }
    .bet-text-val.label-cuoc {
      color: #161616;
      background: linear-gradient(180deg, #f7f5f5 0%, #f5f4f4 60%, #f8f7f7 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 3px rgba(49, 49, 49, 0.9));
      font-size: 18px; letter-spacing: 1px;
    }
    .bet-text-val.active-bet { color: #ddb503; text-shadow: 0 0 8px rgba(214, 193, 4, 0.9); }

    .center-plate {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 215px; height: 215px; border-radius: 50%;
      background: radial-gradient(circle, #242424 0%, #1d1d1d 70%, #1a1919 100%);
      border: 4px solid #353534; display: flex; justify-content: center; align-items: center;
      box-shadow: 0 0 40px rgba(14, 14, 14, 0.9), inset 0 0 20px rgba(41, 41, 41, 0.3); z-index: 12;
    }

    .plate-cover {
      position: absolute; width: 210px; height: 210px; border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #292929 0%, #1a1a24 60%, #131313 100%);
      border: 3px solid #353534; box-shadow: 0 10px 30px rgba(0,0,0,0.95), inset 0 2px 10px rgba(255,255,255,0.4);
      z-index: 25; display: none; cursor: grab; justify-content: center; align-items: center;
      touch-action: none; transition: filter 0.2s ease;
    }
    .plate-cover:active { cursor: grabbing; filter: drop-shadow(0px 0px 18px rgba(54, 54, 54, 0.9)); }
    .plate-cover-knob { width: 48px; height: 48px; border-radius: 50%; background: radial-gradient(circle, #2c2c2c, #b8860b); border: 2px solid #fff; box-shadow: 0 4px 8px #000; }

    .timer-display { font-size: 64px; font-weight: 900; color: #05e650; text-shadow: 0 0 20px rgba(37, 37, 37, 0.9); z-index: 6; }

    /* 3 XÚC XẮC TO HƠN, DẤU CHẤM TO RÕ NÉT (7.5px) */
    .dice-3d-scene {
      position: absolute; width: 160px; height: 120px; display: none; z-index: 8;
      perspective: 900px;
    }
    .dice-box {
      position: absolute; width: 50px; height: 50px;
      transform-style: preserve-3d;
      transform: rotateX(-4deg) rotateY(4deg) translateZ(0px);
    }
    #dice1 { top: 2px; left: 55px; }
    #dice2 { bottom: 4px; left: 14px; }
    #dice3 { bottom: 4px; right: 14px; }

    .dice-face {
      position: absolute; width: 50px; height: 50px;
      background: radial-gradient(circle at 30% 30%, #e41313 0%, #d30303 70%, #db0202 100%);
      border: 1.5px solid #ff9999; border-radius: 9px;
      box-shadow: inset 0 0 8px rgba(0,0,0,0.5), 0 0 6px rgba(255,0,0,0.5);
      display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);
      padding: 5px; align-items: center; justify-items: center;
      backface-visibility: hidden;
    }
    .face-front  { transform: translateZ(25px); }
    .face-back   { transform: rotateY(180deg) translateZ(25px); }
    .face-right  { transform: rotateY(90deg) translateZ(25px); }
    .face-left   { transform: rotateY(-90deg) translateZ(25px); }
    .face-top    { transform: rotateX(90deg) translateZ(25px); }
    .face-bottom { transform: rotateX(-90deg) translateZ(25px); }

    .dot {
      width: 7.5px; height: 7.5px; background: #f8f7f7; border-radius: 50%;
      box-shadow: 0 0 4px #f7f6f6, inset 0 1px 1px rgba(26, 25, 25, 0.4);
    }

    .win-text-overlay {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-size: 36px; font-weight: 900; color: #dd9905;
      text-shadow: 0 0 15px #1b1b1b, 0 4px 10px #e2ba05; z-index: 30; display: none; white-space: nowrap;
      animation: popWin 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popWin {
      0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    .chip-panel-real {
      position: absolute; bottom: 0px; left: 50%;
      transform: translate(-50%, 80%);
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      background: rgba(5, 5, 5, 0) !important;
      border: none !important;
      box-shadow: none !important;
      padding: 8px 20px 10px 20px; border-radius: 16px; z-index: 100;
      transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 1;
    }

    .chip-panel-real.hidden {
      opacity: 0; pointer-events: none;
      transform: translate(-50%, 130%);
    }

    .chip-list { display: flex; gap: 8px; }

    .chip-btn {
      width: 60px; height: 38px; border-radius: 8px;
      background: linear-gradient(180deg, #01251f 0%, #013f3f 60%, #016168 100%);
      border: 1.5px solid #c0c0bf; color: #f0f0ee; font-size: 13px; font-weight: 900;
      display: flex; justify-content: center; align-items: center; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(224, 224, 224, 0.8), 0 4px 8px #000000;
      text-shadow: 0 1px 2px rgba(31, 30, 30, 0.9); transition: transform 0.1s, box-shadow 0.1s;
    }
    .chip-btn:active { transform: translateY(-2px); box-shadow: 0 0 12px #3a3a3a; }

    .chip-actions { display: flex; gap: 12px; width: 100%; justify-content: center; margin-top: 2px; }

    .btn-action-x2 {
      background: linear-gradient(180deg, #2e2e2e, #3a6073); border: 1px solid #3f3f3f;
      color: #e0dede; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: 0 3px 6px rgba(0,0,0,0.6);
    }

    .btn-action-bet {
      background: linear-gradient(180deg, #3f3f3f 0%, #212524 50%, #1b1b1b 100%);
      border: 1.5px solid #f0f0f0;
      color: #cacac8; padding: 6px 32px; border-radius: 18px; font-weight: 900; font-size: 14px; cursor: pointer;
      box-shadow: 0 0 15px rgba(14, 13, 13, 0.9), 0 3px 6px rgba(0,0,0,0.6);
      text-shadow: 0 1px 0 rgba(88, 88, 88, 0.6);
    }

    .btn-action-cancel {
      background: linear-gradient(180deg, #68272d 0%, #801e23 60%, #801313 100%);
      border: 1.5px solid #dad7da;
      color: #fff; padding: 6px 20px; border-radius: 18px; font-weight: 900; font-size: 13px; cursor: pointer;
      box-shadow: inset 0 1px 2px rgba(32, 32, 32, 0.4), 0 3px 6px rgba(51, 51, 51, 0.8);
      text-shadow: 0 1px 2px #222121;
    }

    .chart-modal-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(12, 12, 12, 0.75); z-index: 1000; display: none;
      justify-content: center; align-items: center; backdrop-filter: blur(4px);
    }
    .chart-modal-overlay.active { display: flex; }

    .chart-modal-box {
      width: 820px; height: 480px;
      background: linear-gradient(180deg, #2d2623 0%, #1c1816 100%);
      border: 3px solid #2f302f; border-radius: 20px;
      box-shadow: 0 0 50px rgba(53, 53, 53, 0.95), 0 0 20px rgba(34, 34, 34, 0.4);
      display: flex; flex-direction: column; overflow: hidden; position: relative;
    }

    .chart-header {
      height: 48px; background: linear-gradient(180deg, #423631, #241e1b);
      border-bottom: 2px solid #2f302f; display: flex; justify-content: space-between;
      align-items: center; padding: 0 20px;
    }

    .chart-title {
      font-size: 16px; font-weight: 900; color: #0a0a0a;
      text-shadow: 0 2px 4px #7e0363; letter-spacing: 1px;
    }

    .btn-close-chart {
      width: 28px; height: 28px; border-radius: 50%; background: rgb(46, 45, 45); border: 1.5px solid #333333;
      color: #111111; font-weight: bold; display: flex; justify-content: center; align-items: center;
      cursor: pointer; box-shadow: 0 2px 4px #1e1f1e;
    }

    .chart-body-wrapper {
      flex: 1; padding: 15px; overflow-x: auto; overflow-y: hidden;
      display: flex; flex-direction: column; gap: 12px;
      cursor: grab; touch-action: none;
    }
    .chart-body-wrapper:active { cursor: grabbing; }

    .grid-cau-container {
      display: grid;
      grid-template-rows: repeat(5, 42px);
      grid-auto-columns: 42px;
      grid-auto-flow: column;
      gap: 2px;
      background: #363636;
      border: 2px solid #2e2d2d;
      padding: 4px;
      border-radius: 8px;
      width: max-content;
      min-width: 100%;
    }

    .grid-cell {
      width: 42px; height: 42px;
      background: #313131;
      border: 1px solid #131212;
      display: flex; justify-content: center; align-items: center;
      border-radius: 4px;
    }

    .dot-result {
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; justify-content: center; align-items: center;
      font-size: 13px; font-weight: 900; color: #fcfafa;
      box-shadow: 0 2px 5px rgba(36, 35, 35, 0.8), inset 0 1px 2px rgba(34, 33, 33, 0.6);
    }
    .dot-result.tai {
      background: radial-gradient(circle at 35% 35%, #080808, #0a0a0a);
      border: 1.5px solid #0e0d0d; color: #d8dad8; text-shadow: 0 0 2px #242524;
    }
    .dot-result.xiu {
      background: radial-gradient(circle at 35% 35%, #fcfafa, #0a0a0a);
      border: 1.5px solid #0a0a0a; color: #070707;
    }

    .toast-msg {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-50px);
      background: rgba(129, 59, 2, 0.98); border: 2px solid #212221; color: #2d2e2d;
      padding: 10px 24px; border-radius: 20px; font-weight: bold; font-size: 13px;
      z-index: 9999; opacity: 0; transition: all 0.3s ease; pointer-events: none;
      box-shadow: 0 0 20px rgba(255,183,3,0.5);
    }
    .toast-msg.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

