<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cổng Game Thực Tế - Tài Xỉu Online Ultimate Pro 3D</title>
  <style>
    /* Reset & Base */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #030206;
      color: #e0e0e0;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Canvas cho hiệu ứng tóe màu pháo hoa */
    #fx-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 9999;
    }

    /* Screen Transition Core */
    .app-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      z-index: 1;
    }

    .app-screen.active {
      display: flex;
      opacity: 1;
      z-index: 10;
    }

    /* 1. LOADING SCREEN */
    #loading-screen {
      background: radial-gradient(circle at center, #11081c 0%, #030108 100%);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .loader-brand {
      font-size: 30px;
      font-weight: 900;
      background: linear-gradient(180deg, #ffea85 0%, #d4af37 50%, #aa7c11 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
      letter-spacing: 2px;
      margin-bottom: 25px;
      text-transform: uppercase;
    }

    .loader-box {
      width: 300px;
      height: 16px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(212, 175, 55, 0.4);
      border-radius: 20px;
      padding: 2px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);
      position: relative;
    }

    .loader-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #00e676, #00b0ff);
      border-radius: 20px;
      transition: width 0.05s linear;
      box-shadow: 0 0 10px rgba(0,230,118,0.5);
    }

    .loader-text {
      margin-top: 12px;
      font-size: 13px;
      color: #aaa;
      font-weight: bold;
    }

    /* 2. GAME LOBBY */
    .game-lobby {
      position: relative;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at center, #061a10 0%, #020a05 100%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 24px;
      background: rgba(4, 18, 10, 0.92);
      border-bottom: 1px solid rgba(0, 230, 118, 0.25);
      box-shadow: 0 4px 20px rgba(0,0,0,0.8);
      z-index: 20;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }

    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 2px solid #00e676;
      background-size: cover;
      background-position: center;
      box-shadow: 0 0 8px rgba(0, 230, 118, 0.3);
      transition: transform 0.2s;
    }
    .avatar:active { transform: scale(0.92); }

    .balance-box {
      background: #021008;
      border: 1px solid rgba(0, 230, 118, 0.6);
      border-radius: 20px;
      padding: 4px 16px;
      color: #00e676;
      font-weight: 800;
      font-size: 15px;
      box-shadow: inset 0 0 6px rgba(0, 230, 118, 0.2);
      letter-spacing: 0.5px;
    }

    .top-nav {
      display: flex;
      gap: 12px;
      font-weight: 700;
      color: #52a373;
      text-transform: uppercase;
      font-size: 12px;
    }

    .top-nav span {
      cursor: pointer;
      transition: all 0.2s;
      padding: 6px 12px;
      border-radius: 12px;
    }

    .top-nav span:hover, .top-nav span.active {
      color: #fff;
      background: rgba(0, 230, 118, 0.12);
      border: 1px solid rgba(0, 230, 118, 0.3);
      text-shadow: 0 0 6px rgba(0,230,118,0.5);
    }

    .header-actions {
      display: flex;
      gap: 10px;
    }

    .btn-action {
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 800;
      font-size: 12px;
      cursor: pointer;
      border: none;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      transition: transform 0.1s, filter 0.2s;
    }
    .btn-action:active { transform: scale(0.95); }
    .btn-nap { background: linear-gradient(180deg, #00e676, #00897b); color: #000; font-weight: 900; }
    .btn-rut { background: linear-gradient(180deg, #ff5252, #c62828); color: #fff; }

    .lobby-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 40px;
      flex: 1;
      gap: 20px;
      overflow-x: auto;
    }

    .sidebar-left {
      width: 220px;
      background: rgba(4, 20, 10, 0.85);
      border: 1px solid rgba(0, 230, 118, 0.2);
      border-radius: 16px;
      padding: 14px;
      backdrop-filter: blur(8px);
    }

    .sidebar-title {
      color: #00e676;
      font-size: 12px;
      font-weight: 800;
      text-align: center;
      margin-bottom: 12px;
      border-bottom: 1px solid rgba(0, 230, 118, 0.15);
      padding-bottom: 6px;
    }

    .rank-item {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      margin-bottom: 10px;
      color: #bbb;
    }
    .rank-item .win-amount { color: #00e676; font-weight: 700; }

    .game-grid {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .game-card {
      width: 190px;
      height: 250px;
      border-radius: 22px;
      border: 2px solid rgba(0, 230, 118, 0.3);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 12px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.7);
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      position: relative;
      overflow: hidden;
      background-size: cover;
      background-position: center;
    }

    .game-card:hover {
      transform: translateY(-6px) scale(1.02);
      border-color: #00e676;
      box-shadow: 0 12px 25px rgba(0, 230, 118, 0.25);
    }

    .game-card:active { transform: scale(0.96); }

    .card-hot-taixiu {
      background: linear-gradient(135deg, #072b14 0%, #021007 100%);
      border-color: #00e676;
    }

    .card-md5-taixiu {
      background: linear-gradient(135deg, #023e8a 0%, #001233 100%);
      border-color: #00b4d8;
    }

    .card-quayhu {
      background: linear-gradient(135deg, #6a040f 0%, #1a0003 100%);
    }

    .card-tag {
      align-self: flex-start;
      background: #00e676;
      color: #000;
      font-size: 9px;
      font-weight: 900;
      padding: 2px 8px;
      border-radius: 10px;
      text-transform: uppercase;
    }

    .card-title-box { text-align: center; }
    .card-title {
      font-weight: 900;
      font-size: 15px;
      color: #fff;
      text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      letter-spacing: 0.5px;
    }
    .card-sub {
      font-size: 10px;
      color: #00e676;
      font-weight: bold;
      margin-top: 2px;
    }

    .lobby-bet-preview {
      background: rgba(0, 0, 0, 0.65);
      border-radius: 12px;
      padding: 6px;
      border: 1px solid rgba(0, 230, 118, 0.2);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .lobby-bet-row {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      font-weight: bold;
    }
    .lobby-bet-tai { color: #ff5252; }
    .lobby-bet-xiu { color: #00e676; }
    .lobby-timer {
      font-size: 11px;
      color: #00e676;
      text-align: center;
      font-weight: 900;
      border-top: 1px dashed rgba(255,255,255,0.15);
      padding-top: 2px;
    }

    .bottom-bar {
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: rgba(2, 10, 5, 0.95);
      padding: 10px 0;
      border-top: 1px solid rgba(0, 230, 118, 0.15);
    }

    .bottom-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 11px;
      color: #888;
      cursor: pointer;
      transition: 0.2s;
      font-weight: bold;
    }
    .bottom-item:hover { color: #00e676; }
    .bottom-icon { font-size: 18px; margin-bottom: 2px; }

    /* 3. ARENA REALISTIC 3D & DICE ENGINE */
    .arena-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle, #061c10 0%, #010704 100%);
      z-index: 100;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      perspective: 1200px;
    }

    .arena-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 24px;
      background: rgba(2, 12, 6, 0.9);
      border-bottom: 1px solid rgba(0, 230, 118, 0.25);
      z-index: 20;
    }

    .arena-title {
      font-size: 16px;
      font-weight: 900;
      color: #00e676;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-shadow: 0 0 8px rgba(0, 230, 118, 0.4);
    }

    .btn-back-lobby {
      background: #c62828;
      color: #fff;
      border: 1px solid #ff5252;
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: bold;
      font-size: 11px;
      cursor: pointer;
      transition: 0.2s;
    }
    .btn-back-lobby:active { transform: scale(0.92); }

    .arena-stage {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .real-taixiu-board {
      position: relative;
      width: 760px;
      height: 380px;
      background: radial-gradient(circle, #083319 0%, #021208 100%);
      border: 3px solid #00e676;
      border-radius: 200px;
      box-shadow: 0 0 35px rgba(0, 230, 118, 0.25), inset 0 0 25px rgba(0, 230, 118, 0.15);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 45px;
      transform-style: preserve-3d;
    }

    .circle-btn {
      position: absolute;
      width: 38px;
      height: 38px;
      background: radial-gradient(circle, #083017, #021007);
      border: 1px solid #00e676;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #00e676;
      font-size: 14px;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      z-index: 10;
    }
    .circle-btn:active { transform: scale(0.9); }
    .circle-btn:hover { color: #fff; border-color: #00e676; box-shadow: 0 0 10px #00e676; }

    .btn-chart { top: 50px; left: 40px; }
    .btn-help { top: 125px; left: 20px; }
    .btn-history { top: 200px; left: 40px; }
    .btn-rank { top: 50px; right: 40px; }
    .btn-cam { top: 125px; right: 20px; }
    .btn-sound { top: 200px; right: 40px; }

    /* KHUNG CƯỢC HAI BÊN TÀI / XỈU NẨY SỐ */
    .bet-side {
      width: 190px;
      height: 150px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      border-radius: 70px;
      background: rgba(2, 14, 7, 0.85);
      border: 2px solid rgba(0, 230, 118, 0.3);
      position: relative;
      transition: transform 0.15s ease, border-color 0.2s, box-shadow 0.2s;
    }

    /* Hiệu ứng Nẩy nhẹ sinh động khi cập nhật số tiền */
    .bet-side.bounce-effect {
      transform: scale(1.05);
      border-color: #ffb74d;
      box-shadow: 0 0 15px rgba(255, 183, 77, 0.4);
    }

    .bet-side.active-win {
      border: 3px solid #00e676;
      background: rgba(0, 230, 118, 0.2);
      box-shadow: 0 0 30px rgba(0, 230, 118, 0.6);
      animation: winGlow 0.6s infinite alternate;
    }

    @keyframes winGlow {
      0% { transform: scale(1); }
      100% { transform: scale(1.04); }
    }

    .bet-title {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #fff;
    }

    .player-count { 
      font-size: 11px; 
      color: #00e676; 
      margin-bottom: 2px; 
      transition: all 0.2s;
    }
    .bet-amount { 
      font-size: 15px; 
      font-weight: 800; 
      color: #00e676; 
      transition: all 0.2s;
    }

    /* Nhấp nháy nhẹ nhàng số tiền/người chơi */
    .pulse-text {
      animation: softPulse 0.4s ease-in-out;
    }
    @keyframes softPulse {
      0% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 1; color: #ffeb3b; }
      100% { transform: scale(1); opacity: 1; }
    }

    .my-bet-tag {
      font-size: 10px;
      color: #ffeb3b;
      background: rgba(0,0,0,0.6);
      padding: 2px 10px;
      border-radius: 10px;
      border: 1px solid #ffb74d;
      margin-top: 3px;
      display: none;
      font-weight: bold;
    }

    /* LOGO LOGIC CƯỢC VUÔNG GÓC SẮC NÉT - GIẢM CHÓI */
    .btn-real-bet-logo {
      margin-top: 6px;
      background: linear-gradient(135deg, #1b5e20 0%, #004d40 100%);
      border: 1px solid #00e676;
      border-radius: 6px; /* Vuông góc logic chuẩn */
      padding: 5px 18px;
      color: #00e676;
      font-size: 11px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0,0,0,0.5);
      transition: all 0.2s;
      letter-spacing: 1px;
    }

    .btn-real-bet-logo:hover {
      background: linear-gradient(135deg, #2e7d32 0%, #00695c 100%);
      color: #fff;
      border-color: #00ff66;
    }

    .btn-real-bet-logo:active {
      transform: scale(0.92);
    }

    .btn-real-bet-logo.selected-active {
      border: 1px solid #ffb74d;
      background: linear-gradient(135deg, #e65100, #f57c00);
      color: #fff;
      box-shadow: 0 0 10px rgba(255, 183, 77, 0.5);
    }

    /* HÌNH TRÒN ĐỎ - ĐĨA ĐEN TRONG CHỨA XÚC XẮC */
    .center-plate {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, #0e0507 0%, #060203 60%, #800a16 92%, #00e676 100%);
      border: 4px solid #00e676;
      border-radius: 50%;
      box-shadow: 0 0 30px rgba(0, 230, 118, 0.3), inset 0 0 20px rgba(0,0,0,0.95);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 5;
      transform-style: preserve-3d;
    }

    .timer-display {
      position: absolute;
      top: 10px;
      font-size: 24px;
      font-weight: 900;
      color: #00e676;
      text-shadow: 0 0 8px rgba(0, 230, 118, 0.6);
      z-index: 20;
    }

    /* KHU VỰC VẬT LÝ XÚC XẮC 3D */
    .dice-3d-arena {
      position: relative;
      width: 90px;
      height: 90px;
      margin-top: 18px;
      transform-style: preserve-3d;
    }

    .cube-wrapper {
      position: absolute;
      width: 38px;
      height: 38px;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.1, 0.8, 0.2, 1);
    }

    #wrap1 { top: 6px; left: 8px; }
    #wrap2 { top: 6px; right: 8px; }
    #wrap3 { bottom: 6px; left: 26px; }

    .dice-shadow {
      position: absolute;
      width: 38px;
      height: 38px;
      background: radial-gradient(ellipse at center, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 75%);
      border-radius: 50%;
      transform: rotateX(90deg) translateZ(-19px);
      transition: transform 0.1s linear, opacity 0.1s linear;
      pointer-events: none;
    }

    .cube {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    /* HIỆU ỨNG LẮN ĐẢO NẨY CAO THỰC TẾ */
    .cube-wrapper.rolling-1 { animation: physicsThrow1 1.1s cubic-bezier(0.2, 0.8, 0.25, 1.1) infinite; }
    .cube-wrapper.rolling-2 { animation: physicsThrow2 1.1s cubic-bezier(0.2, 0.8, 0.25, 1.1) infinite; }
    .cube-wrapper.rolling-3 { animation: physicsThrow3 1.1s cubic-bezier(0.2, 0.8, 0.25, 1.1) infinite; }

    .cube-wrapper.rolling-1 .dice-shadow,
    .cube-wrapper.rolling-2 .dice-shadow,
    .cube-wrapper.rolling-3 .dice-shadow { animation: shadowPulse 1.1s ease-in-out infinite; }

    @keyframes physicsThrow1 {
      0%   { transform: translate3d(0, 0, 0); }
      35%  { transform: translate3d(-18px, -110px, 170px); }
      65%  { transform: translate3d(15px, 12px, 20px); }
      85%  { transform: translate3d(-6px, -10px, 40px); }
      100% { transform: translate3d(0, 0, 0); }
    }

    @keyframes physicsThrow2 {
      0%   { transform: translate3d(0, 0, 0); }
      35%  { transform: translate3d(22px, -120px, 190px); }
      65%  { transform: translate3d(-12px, 15px, 25px); }
      85%  { transform: translate3d(8px, -8px, 35px); }
      100% { transform: translate3d(0, 0, 0); }
    }

    @keyframes physicsThrow3 {
      0%   { transform: translate3d(0, 0, 0); }
      35%  { transform: translate3d(-4px, -130px, 200px); }
      65%  { transform: translate3d(10px, -15px, 20px); }
      85%  { transform: translate3d(-12px, -4px, 45px); }
      100% { transform: translate3d(0, 0, 0); }
    }

    @keyframes shadowPulse {
      0%, 100% { transform: rotateX(90deg) translateZ(-19px) scale(1); opacity: 0.9; }
      35%      { transform: rotateX(90deg) translateZ(-19px) scale(3.2); opacity: 0.1; }
      65%      { transform: rotateX(90deg) translateZ(-19px) scale(1.1); opacity: 0.8; }
    }

    .cube.rolling { animation: rollSpin 0.16s linear infinite; }

    @keyframes rollSpin {
      0%   { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
      100% { transform: rotateX(720deg) rotateY(1080deg) rotateZ(360deg); }
    }

    /* MẶT XÚC XẮC NHỰA CASINO */
    .face {
      position: absolute;
      width: 38px;
      height: 38px;
      background: radial-gradient(circle at 35% 35%, #ffffff 0%, #f4f0e6 75%, #d1cbbd 100%);
      border: 1px solid rgba(0, 0, 0, 0.25);
      border-radius: 8px;
      box-shadow: inset 0 0 4px #fff, inset -2px -2px 5px rgba(0,0,0,0.35);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
      padding: 3px;
      align-items: center;
      justify-items: center;
      backface-visibility: hidden;
    }

    .face-1 { transform: rotateY(0deg) translateZ(19px); }
    .face-6 { transform: rotateY(180deg) translateZ(19px); }
    .face-2 { transform: rotateY(-90deg) translateZ(19px); }
    .face-5 { transform: rotateY(90deg) translateZ(19px); }
    .face-3 { transform: rotateX(90deg) translateZ(19px); }
    .face-4 { transform: rotateX(-90deg) translateZ(19px); }

    .dot-pip {
      width: 7px;
      height: 7px;
      background: radial-gradient(circle at 35% 35%, #3a3a3a 0%, #111111 75%, #000000 100%);
      border-radius: 50%;
      box-shadow: inset 0 1px 2px #000;
      display: none;
    }

    .face-1 .dot-pip.red-giant {
      display: block;
      width: 15px;
      height: 15px;
      background: radial-gradient(circle at 35% 35%, #ff2a2a 0%, #b30000 75%, #550000 100%);
      grid-column: 2;
      grid-row: 2;
    }

    .p1 { grid-column: 1; grid-row: 1; }
    .p3 { grid-column: 3; grid-row: 1; }
    .p4 { grid-column: 1; grid-row: 2; }
    .p5 { grid-column: 2; grid-row: 2; }
    .p6 { grid-column: 3; grid-row: 2; }
    .p7 { grid-column: 1; grid-row: 3; }
    .p9 { grid-column: 3; grid-row: 3; }

    .face-1 .p5 { display: block; }
    .face-2 .p1, .face-2 .p9 { display: block; }
    .face-3 .p1, .face-3 .p5, .face-3 .p9 { display: block; }
    .face-4 .p1, .face-4 .p3, .face-4 .p7, .face-4 .p9 { display: block; }
    .face-5 .p1, .face-5 .p3, .face-5 .p5, .face-5 .p7, .face-5 .p9 { display: block; }
